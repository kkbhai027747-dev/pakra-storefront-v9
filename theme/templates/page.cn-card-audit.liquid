<main id="cn-card-audit-root" class="cn-catalog">
  <header class="cn-catalog__header">
    <div>
      <p class="cn-catalog__eyebrow">KAYOU MY LITTLE PONY</p>
      <h1>Chinese Card Catalog</h1>
      <p class="cn-catalog__intro">Browse Chinese-edition cards by product line, series and rarity. Single-card listings and complete rarity bundles are clearly identified.</p>
    </div>
    <dl class="cn-catalog__stats" id="cn-catalog-stats"></dl>
  </header>
  <nav class="cn-catalog__toolbar" aria-label="Card catalog filters">
    <label class="cn-catalog__search"><span>Search cards</span><input id="cn-catalog-search" type="search" placeholder="Series, rarity or card code"></label>
    <label><span>Product line</span><select id="cn-catalog-family"><option value="">All product lines</option></select></label>
    <label><span>Listing type</span><select id="cn-catalog-mode"><option value="">All listing types</option><option value="single_variant_product">Single cards</option><option value="bundle_single_sku_product">Card bundles</option></select></label>
    <label><span>Availability</span><select id="cn-catalog-availability"><option value="">All availability</option><option value="available">Available</option><option value="unavailable">Unavailable</option></select></label>
  </nav>
  <p class="cn-catalog__result" id="cn-catalog-result" aria-live="polite"></p>
  <section id="cn-catalog-list" class="cn-catalog__list"></section>
</main>
<script id="cn-catalog-data" type="application/json">{{ 'cn-card-audit-data.json' | asset_url }}</script>
<script>
(function () {
  var dataUrl = document.getElementById('cn-catalog-data').textContent.trim();
  var state = { products: [], query: '', family: '', mode: '', availability: '' };
  var list = document.getElementById('cn-catalog-list');
  var stats = document.getElementById('cn-catalog-stats');
  var result = document.getElementById('cn-catalog-result');
  var search = document.getElementById('cn-catalog-search');
  var family = document.getElementById('cn-catalog-family');
  var mode = document.getElementById('cn-catalog-mode');
  var availability = document.getElementById('cn-catalog-availability');

  fetch(dataUrl).then(function (response) {
    if (!response.ok) throw new Error('Catalog data is unavailable.');
    return response.json();
  }).then(function (data) {
    state.products = data.products || [];
    stats.innerHTML = stat(data.summary.cardCount, 'cards') + stat(data.summary.productCount, 'listings') + stat(data.summary.availableProductCount, 'available');
    fillSelect(family, unique(state.products.map(function (item) { return item.family; })));
    render();
  }).catch(function (error) {
    list.innerHTML = '<p class="cn-catalog__empty">' + escapeHtml(error.message) + '</p>';
  });

  search.addEventListener('input', function () { state.query = search.value.toLowerCase().trim(); render(); });
  family.addEventListener('change', function () { state.family = family.value; render(); });
  mode.addEventListener('change', function () { state.mode = mode.value; render(); });
  availability.addEventListener('change', function () { state.availability = availability.value; render(); });

  function render() {
    var products = state.products.filter(matchesFilters);
    var cards = products.reduce(function (total, product) { return total + product.cards.length; }, 0);
    result.textContent = products.length + ' listings, ' + cards + ' cards';
    if (!products.length) {
      list.innerHTML = '<p class="cn-catalog__empty">No cards match these filters.</p>';
      return;
    }
    list.innerHTML = products.map(renderProduct).join('');
  }

  function matchesFilters(product) {
    if (state.family && product.family !== state.family) return false;
    if (state.mode && product.mode !== state.mode) return false;
    if (state.availability === 'available' && !product.available) return false;
    if (state.availability === 'unavailable' && product.available) return false;
    if (!state.query) return true;
    var haystack = [product.title, product.series, product.family, product.grade, product.cards.map(function (card) { return card.code; }).join(' ')].join(' ').toLowerCase();
    return haystack.indexOf(state.query) !== -1;
  }

  function renderProduct(product) {
    var statusClass = product.available ? ' is-available' : '';
    var action = product.available && product.productUrl ? '<a class="cn-catalog__action" href="' + escapeAttribute(product.productUrl) + '">View product</a>' : '<span class="cn-catalog__disabled">Unavailable</span>';
    return '<details class="cn-catalog__product" data-family="' + escapeAttribute(product.family) + '">' +
      '<summary><span class="cn-catalog__summary-copy"><span class="cn-catalog__line">' + escapeHtml(product.family) + ' / ' + escapeHtml(product.series) + ' / ' + escapeHtml(product.grade) + '</span><strong>' + escapeHtml(product.title) + '</strong><small>' + escapeHtml(product.listingLabel) + ' / ' + product.cards.length + ' cards</small></span>' +
      '<span class="cn-catalog__summary-side"><span class="cn-catalog__status' + statusClass + '">' + escapeHtml(product.publicStatus) + '</span><b>' + priceText(product.priceUsdRange) + '</b></span></summary>' +
      '<div class="cn-catalog__product-bar"><span>' + escapeHtml(product.listingLabel) + '</span><span>' + product.cards.length + ' cards</span><span>' + priceText(product.priceUsdRange) + '</span>' + action + '</div>' +
      '<div class="cn-catalog__grid">' + product.cards.map(function (card) { return renderCard(card, product); }).join('') + '</div>' +
      '</details>';
  }

  function renderCard(card, product) {
    var image = card.imageUrl ? '<img loading="lazy" src="' + escapeAttribute(card.imageUrl) + '" alt="' + escapeAttribute(card.code + ' KAYOU My Little Pony card') + '">' : '<div class="cn-catalog__placeholder" role="img" aria-label="Image unavailable"><span>Image unavailable</span></div>';
    var price = product.mode === 'single_variant_product' ? '<span>' + (card.saleUsd ? '$' + escapeHtml(wholeUsd(card.saleUsd)) : 'Unavailable') + '</span>' : '';
    return '<figure class="cn-catalog__card">' + image + '<figcaption><strong>' + escapeHtml(card.code) + '</strong>' + price + '</figcaption></figure>';
  }

  function stat(value, label) { return '<div><dt>' + escapeHtml(value) + '</dt><dd>' + escapeHtml(label) + '</dd></div>'; }
  function priceText(value) {
    if (!value) return 'Price unavailable';
    return String(value).split('-').map(function (part) { return '$' + escapeHtml(wholeUsd(part)); }).join(' - ');
  }
  function wholeUsd(value) {
    var numeric = Number(value);
    return Number.isFinite(numeric) ? String(Math.ceil(numeric)) : String(value || '');
  }
  function fillSelect(select, values) { values.forEach(function (value) { var option = document.createElement('option'); option.value = value; option.textContent = value; select.appendChild(option); }); }
  function unique(values) { var out = []; values.forEach(function (value) { if (value && out.indexOf(value) === -1) out.push(value); }); return out.sort(); }
  function escapeHtml(value) { return String(value === undefined || value === null ? '' : value).replace(/[&<>"']/g, function (char) { return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[char]; }); }
  function escapeAttribute(value) { return escapeHtml(value).replace(/\x60/g, '&#96;'); }
})();
</script>
<style>
.cn-catalog{max-width:1480px;margin:0 auto;padding:30px 22px 64px;color:#17191f;background:#f6f7f9}
.cn-catalog__header{display:flex;justify-content:space-between;gap:28px;align-items:flex-start;padding-bottom:24px;border-bottom:2px solid #17191f}
.cn-catalog__eyebrow{margin:0 0 6px;font-size:12px;font-weight:800;color:#b31d55;letter-spacing:0}
.cn-catalog h1{margin:0;font-size:36px;line-height:1.12;letter-spacing:0}
.cn-catalog__intro{max-width:760px;margin:10px 0 0;color:#5b6270;font-size:15px;line-height:1.55}
.cn-catalog__stats{display:flex;gap:22px;margin:0;padding:0}
.cn-catalog__stats div{min-width:86px}
.cn-catalog__stats dt{font-size:26px;font-weight:800;line-height:1.1}
.cn-catalog__stats dd{margin:3px 0 0;color:#697080;font-size:12px;text-transform:uppercase}
.cn-catalog__toolbar{display:grid;grid-template-columns:minmax(260px,1fr) repeat(3,minmax(160px,210px));gap:12px;padding:18px 0 10px;background:#f6f7f9}
.cn-catalog__toolbar label{display:grid;gap:5px;color:#4d5563;font-size:12px;font-weight:700}
.cn-catalog__toolbar input,.cn-catalog__toolbar select{height:44px;width:100%;border:1px solid #c9ced8;border-radius:6px;background:#fff;padding:0 12px;color:#17191f;font:inherit;font-size:14px}
.cn-catalog__result{margin:0 0 12px;color:#697080;font-size:13px}
.cn-catalog__list{border-top:1px solid #cfd4dc}
.cn-catalog__product{border-bottom:1px solid #cfd4dc;background:#fff}
.cn-catalog__product summary{display:flex;justify-content:space-between;gap:20px;align-items:center;min-height:88px;padding:15px 18px;cursor:pointer;list-style:none}
.cn-catalog__product summary::-webkit-details-marker{display:none}
.cn-catalog__summary-copy{display:grid;gap:4px;min-width:0}
.cn-catalog__summary-copy strong{font-size:16px;line-height:1.3;overflow-wrap:anywhere}
.cn-catalog__summary-copy small,.cn-catalog__line{color:#687080;font-size:12px}
.cn-catalog__summary-side{display:grid;grid-template-columns:auto minmax(110px,auto);gap:12px;align-items:center;text-align:right;white-space:nowrap}
.cn-catalog__status{display:inline-flex;justify-content:center;border:1px solid #c7ccd4;border-radius:999px;padding:5px 9px;color:#626a77;font-size:11px;font-weight:800;text-transform:uppercase}
.cn-catalog__status.is-available{border-color:#23865f;color:#176345;background:#edf8f3}
.cn-catalog__product-bar{display:flex;align-items:center;gap:16px;flex-wrap:wrap;padding:11px 18px;border-top:1px solid #e4e7ec;border-bottom:1px solid #e4e7ec;background:#f4f5f7;color:#565e6b;font-size:12px}
.cn-catalog__action{margin-left:auto;background:#17191f;color:#fff!important;border-radius:5px;padding:9px 14px;text-decoration:none;font-weight:800}
.cn-catalog__disabled{margin-left:auto;color:#7a808a;font-weight:700}
.cn-catalog__grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(138px,1fr));gap:12px;padding:16px 18px 22px}
.cn-catalog__card{margin:0;border:1px solid #dfe3e9;border-radius:6px;overflow:hidden;background:#fff}
.cn-catalog__card img,.cn-catalog__placeholder{display:block;width:100%;aspect-ratio:3/4;object-fit:contain;background:#f1f3f6}
.cn-catalog__placeholder{display:grid;place-items:center;color:#858c98;font-size:11px;text-align:center}
.cn-catalog__card figcaption{display:flex;justify-content:space-between;gap:8px;align-items:flex-start;min-height:48px;padding:8px 9px;background:#f7f8fa}
.cn-catalog__card figcaption strong{font-size:12px;line-height:1.3;overflow-wrap:anywhere}
.cn-catalog__card figcaption span{font-size:12px;font-weight:800;white-space:nowrap}
.cn-catalog__empty{padding:28px 18px;background:#fff;color:#697080}
@media(max-width:900px){.cn-catalog__header{display:block}.cn-catalog__stats{margin-top:18px}.cn-catalog__toolbar{grid-template-columns:1fr 1fr}.cn-catalog__search{grid-column:1/-1}}
@media(max-width:620px){.cn-catalog{padding:20px 12px 48px}.cn-catalog h1{font-size:29px}.cn-catalog__stats{gap:14px}.cn-catalog__toolbar{grid-template-columns:1fr}.cn-catalog__search{grid-column:auto}.cn-catalog__product summary{align-items:flex-start;padding:13px}.cn-catalog__summary-side{grid-template-columns:1fr;gap:7px}.cn-catalog__product-bar{padding:10px 13px}.cn-catalog__action,.cn-catalog__disabled{margin-left:0}.cn-catalog__grid{grid-template-columns:repeat(2,minmax(0,1fr));padding:12px;gap:10px}}
</style>