{% layout none %}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex,follow">
  <title>Links - pakracards</title>
  
  <!-- Loads the social media icons (FontAwesome) -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

  <style>
    /* 1. Full-Screen Background */
    body, html {
      margin: 0;
      padding: 0;
      min-height: 100vh;
      font-family: 'Helvetica Neue', Arial, sans-serif;
      /* Replace with your background image link */
      background-image: url('https://cdn.shopify.com/s/files/1/0746/1014/7516/files/1_04a5ab23-18fb-49fe-8b07-c23b2e4559d0.png?v=1778911027');
      background-size: cover;
      background-position: center;
      background-attachment: fixed;
      background-repeat: no-repeat;
    }

    /* Dark overlay to ensure text and buttons are readable */
    .overlay {
      background-color: rgba(0, 0, 0, 0.15); 
      min-height: 100vh;
      padding: 60px 20px;
      display: flex;
      flex-direction: column;
      align-items: center;
      box-sizing: border-box;
    }

    /* 2. Avatar & Bio Section */
    .profile-container {
      text-align: center;
      margin-bottom: 25px;
      color: #ffffff;
      text-shadow: 1px 1px 4px rgba(0,0,0,0.6);
    }
    
    .profile-pic {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid #ffffff;
      margin-bottom: 15px;
      box-shadow: 0 4px 10px rgba(0,0,0,0.3);
    }

    .store-name {
      font-size: 26px;
      font-weight: 800;
      margin: 0 0 10px 0;
      letter-spacing: 0.5px;
    }

    .bio {
      font-size: 15px;
      max-width: 420px;
      margin: 0 auto;
      line-height: 1.5;
    }

    /* 3. Small Social Icons Row */
    .social-icons-row {
      display: flex;
      justify-content: center;
      gap: 24px;
      margin-bottom: 35px;
    }
    
    .social-icon {
      color: #ffffff; /* Change to #000000 if you want black icons */
      font-size: 28px; 
      text-decoration: none;
      transition: transform 0.2s ease;
      filter: drop-shadow(1px 1px 2px rgba(0,0,0,0.5)); /* Adds visibility */
    }
    
    .social-icon:hover {
      transform: scale(1.1);
    }

    /* 4. Main Stacked Link Buttons */
    .links-container {
      width: 100%;
      max-width: 450px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .link-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      padding: 18px 20px;
      background-color: #ffffff;
      color: #333333;
      text-decoration: none;
      border-radius: 30px;
      font-size: 16px;
      font-weight: 600;
      box-shadow: 0 4px 15px rgba(0,0,0,0.1);
      transition: all 0.3s ease;
      box-sizing: border-box;
    }

    .link-btn:hover {
      transform: translateY(-3px);
      box-shadow: 0 6px 20px rgba(0,0,0,0.2);
    }

    .link-note {
      color: #ffffff;
      display: block;
      font-size: 13px;
      line-height: 1.4;
      margin: -6px 6px 6px;
      text-align: center;
      text-shadow: 1px 1px 4px rgba(0,0,0,0.65);
    }
  </style>
</head>
<body>
  <div class="overlay">
    
    <!-- Profile Section -->
    <div class="profile-container">
      <img src="https://cdn.shopify.com/s/files/1/0746/1014/7516/files/20260514225356_1458_9.jpg?v=1778770511" alt="pakracards" class="profile-pic" width="100" height="100">
      <h1 class="store-name">pakracards</h1>
      <p class="bio">Your home for magical collectible cards, singles, sealed boxes, and new drops.</p>
    </div>

    <!-- Small Social Icons Row -->
    <div class="social-icons-row">
      <a href="https://www.facebook.com/profile.php?id=61584458474464" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Facebook"><i class="fa-brands fa-facebook"></i></a>
      <a href="https://www.instagram.com/amberponycove/" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
      <a href="https://www.tiktok.com/@amberpony" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="TikTok"><i class="fa-brands fa-tiktok"></i></a>
      <a href="https://www.youtube.com/@AmberPonyCove" target="_blank" rel="noopener noreferrer" class="social-icon" aria-label="YouTube"><i class="fa-brands fa-youtube"></i></a>
    </div>

    <!-- Main Stacked Buttons -->
    <div class="links-container">
      <a href="https://pakracards.com/products/pre-order-mlp-moon-edition-chinese-series-11-t4w11" class="link-btn" data-primary-moon11>Shop Moon 11 Sealed Box</a>
      <span class="link-note">Kayou MLP Moon Edition 11 | Ships in 1-3 business days | Free shipping over $60</span>
      <a href="https://discord.gg/f32nsf2Yfx" target="_blank" rel="noopener noreferrer" class="link-btn">Hang Out &amp; Trade in Discord</a>
      <!-- Add more buttons here by copying the line above -->
    </div>

  </div>


<!-- codex-growth-linktree-start -->
<script>
  (function () {
    var button = document.querySelector('[data-primary-moon11]');
    if (!button) return;
    var params = new URLSearchParams(window.location.search || '');
    var cleaned = new URLSearchParams();
    params.forEach(function (value, key) {
      var normalizedKey = String(key || '').trim().replace(/^\+/, '');
      if (normalizedKey && !/^(view|cache_check)$/i.test(normalizedKey)) cleaned.set(normalizedKey, value);
    });
    var query = cleaned.toString();
    if (query) button.href = button.href.split('?')[0] + '?' + query;
  })();
</script>
<!-- codex-growth-linktree-end -->
</body>
</html>