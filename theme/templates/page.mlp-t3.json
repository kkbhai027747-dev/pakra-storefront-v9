                                                                   "custom_liquid":  "{% comment %} TCG Wiki Guide Grid {% endcomment %}\n\u003cstyle\u003e\n  .tcg-wiki-grid {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 15px;\n    padding: 20px 15px;\n    max-width: 1200px;\n    margin: 0 auto;\n  }\n\n  @media screen and (min-width: 768px) {\n    .tcg-wiki-grid {\n      grid-template-columns: repeat(3, 1fr);\n      gap: 20px;\n    }\n  }\n\n  .wiki-item {\n    display: flex;\n    flex-direction: column;\n    text-decoration: none;\n    color: #121212;\n    transition: transform 0.2s;\n  }\n\n  .wiki-item:hover {\n    transform: translateY(-5px);\n  }\n\n  .wiki-img-wrapper {\n    width: 100%;\n    aspect-ratio: 1 / 1;\n    border-radius: 8px;\n    overflow: hidden;\n    background-color: #f4f4f4;\n  }\n\n  .wiki-img-wrapper img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n  }\n\n  .wiki-title {\n    margin-top: 10px;\n    font-size: 16px;\n    font-weight: 600;\n    text-align: center;\n    line-height: 1.3;\n  }\n\u003c/style\u003e\n\n\u003cdiv class=\"tcg-wiki-grid\"\u003e\n  {% for article in blogs[\u0027tcg-database\u0027].articles %}\n    \u003ca href=\"{{ article.url }}\" class=\"wiki-item\"\u003e\n      \u003cdiv class=\"wiki-img-wrapper\"\u003e\n        {% if article.image %}\n          \u003cimg src=\"{{ article.image | image_url: width: 600 }}\" alt=\"{{ article.title }}\"\u003e\n        {% else %}\n          \u003cdiv style=\"width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#999;\"\u003eNo Image\u003c/div\u003e\n        {% endif %}\n      \u003c/div\u003e\n      \u003cspan class=\"wiki-title\"\u003e{{ article.title }}\u003c/span\u003e\n    \u003c/a\u003e\n  {% endfor %}\n\u003c/div\u003e"
                                                               }
