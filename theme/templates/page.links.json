    "custom_liquid_RAt4qa": {
      "type": "custom-liquid",
      "disabled": true,
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "{% comment %} TCG Wiki Guide Grid {% endcomment %}\n<style>\n  .tcg-wiki-grid {\n    display: grid;\n    grid-template-columns: repeat(2, 1fr);\n    gap: 15px;\n    padding: 20px 15px;\n    max-width: 1200px;\n    margin: 0 auto;\n  }\n\n  @media screen and (min-width: 768px) {\n    .tcg-wiki-grid {\n      grid-template-columns: repeat(3, 1fr);\n      gap: 20px;\n    }\n  }\n\n  .wiki-item {\n    display: flex;\n    flex-direction: column;\n    text-decoration: none;\n    color: #121212;\n    transition: transform 0.2s;\n  }\n\n  .wiki-item:hover {\n    transform: translateY(-5px);\n  }\n\n  .wiki-img-wrapper {\n    width: 100%;\n    aspect-ratio: 1 / 1;\n    border-radius: 8px;\n    overflow: hidden;\n    background-color: #f4f4f4;\n  }\n\n  .wiki-img-wrapper img {\n    width: 100%;\n    height: 100%;\n    object-fit: cover;\n  }\n\n  .wiki-title {\n    margin-top: 10px;\n    font-size: 16px;\n    font-weight: 600;\n    text-align: center;\n    line-height: 1.3;\n  }\n</style>\n\n<div class=\"tcg-wiki-grid\">\n  {% for article in blogs['tcg-database'].articles %}\n    <a href=\"{{ article.url }}\" class=\"wiki-item\">\n      <div class=\"wiki-img-wrapper\">\n        {% if article.image %}\n          <img src=\"{{ article.image | image_url: width: 600 }}\" alt=\"{{ article.title }}\">\n        {% else %}\n          <div style=\"width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:#999;\">No Image</div>\n        {% endif %}\n      </div>\n      <span class=\"wiki-title\">{{ article.title }}</span>\n    </a>\n  {% endfor %}\n</div>"
      }
    },
