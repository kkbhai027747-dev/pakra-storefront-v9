<script>
document.addEventListener('DOMContentLoaded', function () {
  var reviewWidget = document.querySelector('.jdgm-widget');

  if (!reviewWidget) return;

  reviewWidget.style.opacity = '0';

  var observer = new IntersectionObserver(function (entries) {
    entries.forEach(function (entry) {
      if (!entry.isIntersecting) return;

      reviewWidget.style.opacity = '1';
      reviewWidget.style.transition = 'opacity 0.5s ease-in';
      observer.unobserve(reviewWidget);
    });
  }, { rootMargin: '300px' });

  observer.observe(reviewWidget);
});
</script>
