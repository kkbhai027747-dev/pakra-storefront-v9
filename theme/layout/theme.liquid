<!-- p10-shell-performance: idle support widget v2 -->
<script>
  (() => {
    const prismaSupportWidgetSrc = 'https://prisma-ai-support.sreylekcheat.workers.dev/widget.js';
    let loaded = false;
    let idleId = null;
    let delayId = null;
    const events = ['keydown'];

    const cleanup = () => {
      events.forEach((eventName) => window.removeEventListener(eventName, loadWidget, true));
      if (idleId && window.cancelIdleCallback) window.cancelIdleCallback(idleId);
      if (delayId) window.clearTimeout(delayId);
    };

    function loadWidget() {
      if (loaded) return;
      loaded = true;
      cleanup();
      const script = document.createElement('script');
      script.src = prismaSupportWidgetSrc;
      script.async = true;
      document.head.appendChild(script);
    }

    const scheduleWidget = () => {
      window.setTimeout(loadWidget, 12000);
      delayId = window.setTimeout(() => {
        delayId = null;
        if ('requestIdleCallback' in window) {
          idleId = window.requestIdleCallback(loadWidget, { timeout: 2200 });
        } else {
          loadWidget();
        }
      }, 8500);
    };

    events.forEach((eventName) => window.addEventListener(eventName, loadWidget, { once: true, passive: true, capture: true }));

    if (document.readyState === 'complete') {
      scheduleWidget();
    } else {
      window.addEventListener('load', scheduleWidget, { once: true });
    }
  })();
</script>



