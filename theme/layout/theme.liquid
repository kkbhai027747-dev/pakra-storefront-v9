<script>
  (function () {
    var moon11Path = '/products/pre-order-mlp-moon-edition-chinese-series-11-t4w11';
    var freeShippingCents = 6000;

    function formatMoney(cents) {
      return 'US$' + (Math.max(0, cents) / 100).toFixed(2);
    }

    function trackedMoon11Url() {
      var params = new URLSearchParams(window.location.search || '');
      var cleaned = new URLSearchParams();
      params.forEach(function (value, key) {
        var normalizedKey = String(key || '').trim().replace(/^\+/, '');
        if (normalizedKey && !/^(view|cache_check)$/i.test(normalizedKey)) cleaned.set(normalizedKey, value);
      });
      var query = cleaned.toString();
      return moon11Path + (query ? '?' + query : '');
    }

    function patchLinksPage() {
      if (window.location.pathname.replace(/\/$/, '') !== '/pages/links') return;
      var links = Array.prototype.slice.call(document.querySelectorAll('a[href]'));
      var primary = links.find(function (link) {
        return /enter the pony cove/i.test(link.textContent || '');
      }) || links.find(function (link) {
        try {
          var url = new URL(link.href, window.location.origin);
          return url.hostname === window.location.hostname && (url.pathname === '/' || url.pathname === '');
        } catch (error) {
          return false;
        }
      });
      if (!primary || primary.dataset.codexGrowthTarget === 'moon11') return;
      primary.href = trackedMoon11Url();
      primary.textContent = 'Shop Moon 11 Sealed Box';
      primary.dataset.codexGrowthTarget = 'moon11';
      if (!primary.nextElementSibling || !primary.nextElementSibling.classList.contains('prisma-growth-link-note')) {
        var note = document.createElement('span');
        note.className = 'prisma-growth-link-note';
        note.textContent = 'KAYOU MLP Moon Edition 11. See the product page and shipping policy for current availability and delivery details.';
        primary.insertAdjacentElement('afterend', note);
      }
    }

    function patchMoon11Product() {
      if (window.location.pathname.replace(/\/$/, '') !== moon11Path) return;
      if (document.querySelector('[data-codex-growth-card="moon11"]')) return;
      var card = document.createElement('div');
      card.className = 'prisma-growth-card';
      card.dataset.codexGrowthCard = 'moon11';
      card.innerHTML = [
        '<span class="prisma-growth-card__title">Moon Edition 11 order information</span>',
        '<ul>',
        '<li>Choose the sealed-box shipping option when available.</li>',
        '<li>Dispatch and transit estimates depend on the shipping method. Please check our shipping policy.</li>',
        '<li>Eligible China-origin orders: US$10 below US$60; free shipping at US$60 or more. Check destination terms at checkout.</li>',
        '<li>Authentic Kayou MLP cards with collector-safe packaging.</li>',
        '</ul>'
      ].join('');
      var form = document.querySelector('form[action*="/cart/add"]');
      if (form && form.parentNode) {
        form.parentNode.insertBefore(card, form);
      } else {
        var title = document.querySelector('h1');
        if (title) title.insertAdjacentElement('afterend', card);
      }
    }

    function mountShippingProgress(cart) {
      var subtotal = cart && typeof cart.items_subtotal_price === 'number'
        ? cart.items_subtotal_price
        : cart && typeof cart.total_price === 'number' ? cart.total_price : null;
      var usdEstimate = cart && cart.currency === 'USD' && Number.isFinite(subtotal) && subtotal >= 0;
      var remaining = usdEstimate ? Math.max(0, freeShippingCents - subtotal) : 0;
      var percent = usdEstimate ? Math.max(0, Math.min(100, Math.round((subtotal / freeShippingCents) * 100))) : 0;
      var text = 'Shipping rates and free-shipping eligibility are confirmed in your selected currency at checkout.';
      if (usdEstimate) {
        text = remaining > 0
          ? 'Eligible China-origin orders: ' + formatMoney(remaining) + ' to the US$60 free-shipping threshold.'
          : 'Eligible China-origin orders meet the US$60 threshold; confirm shipping at checkout.';
      }
      var html = '<strong>' + text + '</strong><div class="prisma-growth-shipping__bar"' + (usdEstimate ? '' : ' style="visibility:hidden"') + '><div class="prisma-growth-shipping__fill" style="width:' + percent + '%"></div></div>';
      var selectors = [
        'form[action="/cart"]',
        'form[action*="/cart"]',
        '.cart__footer',
        '.cart-footer',
        '.cart-sidebar',
        '.cart-drawer',
        '#CartDrawer',
        '.previewCart'
      ];
      selectors.forEach(function (selector) {
        Array.prototype.slice.call(document.querySelectorAll(selector)).forEach(function (mount) {
          if (!mount) return;
          var box = mount.querySelector(':scope > .prisma-growth-shipping');
          if (!box) {
            box = document.createElement('div');
            box.className = 'prisma-growth-shipping';
            mount.insertBefore(box, mount.firstChild);
          }
          box.innerHTML = html;
        });
      });
    }

    function patchShippingProgress() {
      if (!/\/cart\/?$/.test(window.location.pathname) && !document.querySelector('.cart-sidebar, .cart-drawer, #CartDrawer, .previewCart')) return;
      fetch('/cart.js', { credentials: 'same-origin' })
        .then(function (response) { return response.ok ? response.json() : null; })
        .then(function (cart) { if (cart) mountShippingProgress(cart); })
        .catch(function () {});
    }

    function runGrowthPatches() {
      patchLinksPage();
      patchMoon11Product();
      patchShippingProgress();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', runGrowthPatches);
    } else {
      runGrowthPatches();
    }
    document.addEventListener('cart:updated', patchShippingProgress);
    document.addEventListener('ajaxCart:updated', patchShippingProgress);
    setTimeout(runGrowthPatches, 600);
    setTimeout(runGrowthPatches, 1800);
  })();
</script>
<!-- codex-growth-conversion-end -->
