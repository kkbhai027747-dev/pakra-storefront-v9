(function () {
  var canonical = '/pages/kayou-mlp-card-catalog';
  var path = window.location.pathname.replace(/\/+$/, '');
  var search = window.location.search || '';
  if (path === '/pages/kayou-mlp-single-card-finder' || path === '/collections/single') {
    window.location.replace(canonical);
    return;
  }
  if (path === canonical && /(?:\?|&)view=single-cards-v\d+/i.test(search)) {
    window.history.replaceState(null, '', canonical);
  }
})();
</script>
