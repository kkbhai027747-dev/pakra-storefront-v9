{% render 'p10-single-card-mobile-menu-guard' %}
{{ 'p10-single-card-catalog.css' | asset_url | stylesheet_tag }}
<script src="{{ 'p10-single-card-catalog-20260719-v6.js' | asset_url }}" defer></script>

{%- liquid
  assign section_id = 'p10-single-card-catalog-' | append: section.id
  assign anchor_id = section.settings.anchor_id | default: 'single-card-gallery'
  assign single_shop_collection = section.settings.source_collection
  assign catalog_collection_url = blank
  if single_shop_collection != blank
    assign catalog_collection_url = single_shop_collection.url | append: '/products.json?limit=250'
  endif
  assign directory_url = '/pages/kayou-mlp-card-catalog'
  assign is_box_landing = section.settings.box_landing
  assign single_shop_url = single_shop_collection.url | default: '/collections/single'
-%}

<section
  id="{{ section_id }}"
  class="p10-single-card-catalog"
  data-single-card-catalog
  data-box-browser
  data-catalog-directory-url="{{ directory_url }}"
  data-ip-browser
  data-box-data-url="{{ 'p10-single-card-boxes.json' | asset_url }}"
  data-catalog-data-url="{{ 'p10-single-card-catalog-20260715-v6.json' | asset_url }}"
  data-catalog-collection-url="{{ catalog_collection_url }}"
  data-catalog-source-handle="{{ single_shop_collection.handle }}"
  data-catalog-source-count="{{ single_shop_collection.products_count }}"
  data-all-cards-url="{{ single_shop_url }}"
  aria-busy="true"
>
  <span id="{{ anchor_id }}" class="p10-single-card-catalog__anchor" aria-hidden="true"></span>

  {%- if is_box_landing and page.content != blank -%}
    {{ page.content }}
    <script type="application/ld+json">
    {"@context":"https://schema.org","@graph":[{"@type":"CollectionPage","@id":{{ canonical_url | append: '#collection' | json }},"url":{{ canonical_url | json }},"name":{{ page.title | json }},"description":{{ page.metafields.global.description_tag.value | default: page_description | json }}},{"@type":"BreadcrumbList","itemListElement":[{"@type":"ListItem","position":1,"name":"Single cards","item":{{ shop.url | append: directory_url | json }}},{"@type":"ListItem","position":2,"name":"My Little Pony","item":{{ shop.url | append: directory_url | append: '?ip=mlp' | json }}},{"@type":"ListItem","position":3,"name":{{ page.title | json }},"item":{{ canonical_url | json }}}]}]}
    </script>
  {%- else -%}
  <header class="p10-box-header">
    <nav class="p10-box-breadcrumb" aria-label="Breadcrumb">
      <a href="{{ directory_url }}" data-ip-back>Single cards</a>
      <a href="{{ directory_url }}?ip=mlp" data-box-back hidden>My Little Pony</a>
      <span data-box-breadcrumb hidden></span>
    </nav>
    <div class="p10-box-header__content">
      <div class="p10-box-header__image" data-box-image hidden></div>
      <div>
        <p class="p10-box-eyebrow" data-box-eyebrow>CARD GALLERY</p>
        <h1 data-box-title tabindex="-1">Single cards</h1>
        <p class="p10-box-description" data-box-description>Choose an IP to explore its boxes and single cards.</p>
        <dl class="p10-box-facts" data-box-facts hidden></dl>
        <p class="p10-box-meta" data-box-meta></p>
      </div>
    </div>
  </header>
  {%- endif -%}

  <div class="p10-ip-home" data-ip-home>
    <section class="p10-ip-section" aria-labelledby="ip-heading-{{ section.id }}">
      <h2 id="ip-heading-{{ section.id }}">Browse by IP</h2>
      <div class="p10-ip-grid" data-ip-directory></div>
    </section>
  <section class="p10-character-entry" data-character-entry aria-labelledby="character-entry-heading-{{ section.id }}">
    <div>
      <p class="p10-box-eyebrow">A favorite in every set</p>
      <h2 id="character-entry-heading-{{ section.id }}">Find your favorite character</h2>
      <p>Choose a region or group, then explore your favorite character’s single cards.</p>
    </div>
    <div class="p10-character-entry__actions">
      <button type="button" class="p10-character-entry__primary" data-all-cards>Find cards by character <span aria-hidden="true">→</span></button>
      <div class="p10-character-entry__quicklinks" aria-label="Character shortcuts">
        <button type="button" data-character-link="rarity">Rarity</button>
        <button type="button" data-character-link="maud-pie">Maud Pie</button>
      </div>
    </div>
  </section>

    <section class="p10-ip-section" aria-labelledby="recommendations-heading-{{ section.id }}">
      <h2 id="recommendations-heading-{{ section.id }}">Recommended cards</h2>
      <div class="p10-ip-recommendations" data-ip-recommendations></div>
      <p class="p10-ip-empty" data-ip-recommendations-empty hidden>Choose an IP above to explore the available cards.</p>
    </section>
  </div>

  <div data-box-detail hidden>
    <div class="p10-box-detail-nav">
      <a class="p10-box-back" href="{{ directory_url }}" data-box-back><span aria-hidden="true">←</span> All boxes &amp; sets</a>
    </div>

    <div class="p10-single-card-catalog__mobile-filter-bar" data-mobile-filter-bar>
      <div>
        <span data-filter-summary>All rarities</span>
        <strong><span data-mobile-result-count>0</span> <span data-count-label>cards</span></strong>
      </div>
      <button type="button" data-mobile-filter-trigger aria-haspopup="dialog" aria-expanded="false">
        <span aria-hidden="true">☷</span><span data-filter-open-label>Filter BOXes</span>
      </button>
    </div>
    <div class="p10-single-card-catalog__mobile-active" data-mobile-active-filters aria-live="polite"></div>

    <div class="p10-single-card-catalog__browser">
      <aside class="p10-single-card-catalog__desktop-filters" data-desktop-filters aria-labelledby="collection-index-heading-{{ section.id }}">
        <div class="p10-single-card-catalog__filter-heading">
          <div>
            <span data-filter-context>Within this set</span>
            <h2 id="collection-index-heading-{{ section.id }}" data-filter-title>Browse BOXes</h2>
          </div>
          <strong><span data-result-count>0</span> <span data-count-label>cards</span></strong>
        </div>
        <div class="p10-single-card-catalog__refine" data-desktop-refine>
          <details class="p10-single-card-catalog__facet p10-single-card-catalog__refine-section" data-desktop-facet="character" open>
            <summary>
              <span>Character</span>
              <span class="p10-single-card-catalog__refine-status" data-desktop-facet-summary="character">Any character</span>
              <span class="p10-single-card-catalog__refine-toggle" aria-hidden="true"></span>
            </summary>
            <div class="p10-world-picker">
              <div class="p10-map-switch" role="group" aria-label="Character discovery view">
  <button type="button" data-character-map-toggle="desktop" data-map-view="list" aria-pressed="true"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 5h2m3 0h9M3 10h2m3 0h9M3 15h2m3 0h9"/></svg>List</button>
  <button type="button" data-character-map-toggle="desktop" data-map-view="map" aria-pressed="false" aria-expanded="false" aria-controls="character-map-desktop-{{ section.id }}"><svg viewBox="0 0 20 20" aria-hidden="true"><path d="m2 4 5-2 6 2 5-2v14l-5 2-6-2-5 2ZM7 2v14M13 4v14"/></svg>Map</button>
</div>
              <label for="character-group-desktop-{{ section.id }}"><span>1</span> World / group</label>
              <select id="character-group-desktop-{{ section.id }}" data-character-group="desktop" aria-describedby="character-picker-status-desktop-{{ section.id }}"><option value="browse">Choose a group…</option></select>
              <div class="p10-world-shortcuts" data-character-group-shortcuts="desktop" aria-label="Popular groups">
                <button type="button" data-character-group-link="mane-six" aria-pressed="false">Mane 6</button>
                <button type="button" data-character-group-link="apple-family" aria-pressed="false">Apple family</button>
                <button type="button" data-character-group-link="ponyville" aria-pressed="false">Ponyville</button>
              </div>
              <p id="character-picker-status-desktop-{{ section.id }}" data-character-picker-status="desktop" aria-live="polite">Choose a group above, or search any character name.</p>
            </div>
            <label class="p10-character-search" for="character-search-desktop-{{ section.id }}">
              <span class="p10-world-step"><span>2</span> Character</span>
              <span class="p10-visually-hidden">Search character names across all groups</span>
              <input id="character-search-desktop-{{ section.id }}" type="text" role="searchbox" inputmode="search" data-character-search="desktop" placeholder="Any character name" autocomplete="off">
            </label>
            <div class="p10-single-card-catalog__refine-options p10-character-options" data-desktop-options="character"></div>
            <p class="p10-character-options__empty" data-character-options-empty="desktop" hidden>No matching characters. Try another name.</p>
            <p class="p10-character-coverage" data-character-coverage-note>Character details are still being added. Some cards may not appear in character results.</p>
          </details>
          <details class="p10-single-card-catalog__facet p10-single-card-catalog__refine-section" data-desktop-facet="rarity" open>
            <summary>
              <span>Card rarity</span>
              <span class="p10-single-card-catalog__refine-status" data-desktop-facet-summary="rarity">Any rarity</span>
              <span class="p10-single-card-catalog__refine-toggle" aria-hidden="true"></span>
            </summary>
            <div class="p10-single-card-catalog__refine-options" data-desktop-options="rarity"></div>
          </details>
        </div>
        <div class="p10-single-card-catalog__filter-footer">
          <div class="p10-single-card-catalog__desktop-active" data-active-filters aria-live="polite"></div>
          <button type="button" data-filter-clear>Clear filters</button>
        </div>
      </aside>

      <div class="p10-single-card-catalog__main">
