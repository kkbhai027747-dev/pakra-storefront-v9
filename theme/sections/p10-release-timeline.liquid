{% javascript %}
  (() => {
    const initTimeline = (root) => {
      if (!root || root.dataset.releaseTimelineReady === 'true') return;
      root.dataset.releaseTimelineReady = 'true';

      const track = root.querySelector('[data-release-track]');
      const viewport = root.querySelector('[data-release-viewport]');
      const buttons = Array.from(root.querySelectorAll('[data-release-filter]'));
      const items = Array.from(root.querySelectorAll('[data-release-item]'));
      const empty = root.querySelector('[data-release-filter-empty]');
      if (!track || !viewport || !items.length) return;

      items
        .sort((a, b) => Number(b.dataset.releaseSort || 0) - Number(a.dataset.releaseSort || 0))
        .forEach((item) => track.appendChild(item));

      const applyFilter = (filter) => {
        let visible = 0;
        items.forEach((item) => {
          const show = filter === 'all' || item.dataset.releaseCategory === filter;
          item.hidden = !show;
          if (show) visible += 1;
        });
        buttons.forEach((button) => {
          const active = button.dataset.releaseFilter === filter;
          button.classList.toggle('is-active', active);
          button.setAttribute('aria-selected', String(active));
        });
        track.dataset.visibleCount = String(visible);
        if (empty) empty.hidden = visible !== 0;
        viewport.scrollTo({ left: 0, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      };

      buttons.forEach((button) => {
        button.addEventListener('click', () => applyFilter(button.dataset.releaseFilter || 'all'));
      });

      root.querySelectorAll('[data-release-nav]').forEach((button) => {
        button.addEventListener('click', () => {
          const direction = button.dataset.releaseNav === 'prev' ? -1 : 1;
          viewport.scrollBy({
            left: direction * Math.max(280, viewport.clientWidth * 0.75),
            behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth',
          });
        });
      });
    };

    const initIpShowcase = (root) => {
      const showcase = root?.querySelector('[data-p10-ip-showcase]');
      if (!showcase || showcase.dataset.ipShowcaseReady === 'true') return;
      showcase.dataset.ipShowcaseReady = 'true';

      const buttons = Array.from(showcase.querySelectorAll('[data-ip-showcase-select]'));
      const panels = Array.from(showcase.querySelectorAll('[data-ip-showcase-panel]'));
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      let switching = false;

      const applyState = (nextIndex, animate) => {
        const nextPanel = panels.find((panel) => panel.dataset.ipShowcasePanel === nextIndex);
        const currentPanel = panels.find((panel) => panel.classList.contains('is-active'));
        if (!nextPanel || nextPanel === currentPanel || switching) return;

        buttons.forEach((button) => {
          const active = button.dataset.ipShowcaseSelect === nextIndex;
          button.classList.toggle('is-active', active);
          button.setAttribute('aria-selected', String(active));
        });

        if (!animate) {
          panels.forEach((panel) => {
            const active = panel === nextPanel;
            panel.classList.toggle('is-active', active);
            panel.classList.remove('is-entering', 'is-leaving');
            panel.setAttribute('aria-hidden', String(!active));
          });
          return;
        }

        switching = true;
        currentPanel?.classList.add('is-leaving');
        currentPanel?.setAttribute('aria-hidden', 'true');
        nextPanel.classList.add('is-active', 'is-entering');
        nextPanel.setAttribute('aria-hidden', 'false');

        window.setTimeout(() => {
          currentPanel?.classList.remove('is-active', 'is-leaving');
          nextPanel.classList.remove('is-entering');
          switching = false;
        }, 380);
      };

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          applyState(button.dataset.ipShowcaseSelect, !reduceMotion.matches);
        });
      });
    };

    const init = () => {
      document.querySelectorAll('[data-p10-release-timeline]').forEach((root) => {
        initTimeline(root);
        initIpShowcase(root);
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      init();
    }

    document.addEventListener('shopify:section:load', (event) => {
      const root = event.target?.querySelector?.('[data-p10-release-timeline]');
      initTimeline(root);
      initIpShowcase(root);
    });
  })();
{% endjavascript %}

