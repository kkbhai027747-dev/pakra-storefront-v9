{% liquid
  assign release_year = section.settings.release_year | default: '2026'
  assign current_year = 'now' | date: '%Y'
  assign current_month = 'now' | date: '%m'
  assign active_month_key = current_year | append: current_month
  assign timeline_blocks = section.blocks | where: 'type', 'timeline_product'
  assign showcase_blocks = section.blocks | where: 'type', 'ip_showcase'
  assign homepage_faq = blank
  if request.page_type == 'index' and pages['faq'].content != blank
    assign homepage_faq = pages['faq']
  endif
%}

<section class="p10-release-timeline{% if showcase_blocks.size > 0 %} p10-release-timeline--has-mobile-showcase{% endif %}{% if homepage_faq != blank %} p10-release-timeline--faq-replaced{% endif %}" data-p10-release-timeline data-release-year="{{ release_year | escape }}">
  {% if showcase_blocks.size > 0 %}
    <div class="p10-ip-showcase" data-p10-ip-showcase aria-label="IP showcase">
      <div class="p10-ip-showcase__heading">
        <p><span>Star: Edition 3</span><strong>New Arrivals</strong></p>
      </div>
      <div class="p10-ip-showcase__stage">
        <div class="p10-ip-showcase__selector" role="tablist" aria-label="Featured IP collections">
          {% for block in showcase_blocks limit: 3 %}
            {% liquid
              assign ip_collection = collections[block.settings.collection]
              assign ip_products = ip_collection.products | slice: 0, 4
              assign ip_image = ip_collection.image
              if ip_image == blank and ip_products.size > 0
                assign ip_image = ip_products.first.featured_image
              endif
              assign ip_title = block.settings.title | default: ip_collection.title
            %}
            <button
              type="button"
              class="p10-ip-showcase__tab{% if block.settings.collection == blank %} p10-ip-showcase__tab--shell{% endif %}{% if forloop.first %} is-active{% endif %}"
              data-ip-showcase-select="{{ forloop.index0 }}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="p10-ip-showcase-panel-{{ section.id }}-{{ forloop.index0 }}"
              {{ block.shopify_attributes }}
            >
              {% if block.settings.collection == 'ip-my-little-pony' %}
                <img class="p10-ip-showcase__tab-art" src="{{ 'p10-mlp-star-edition-3-poster.jpg' | asset_url }}" width="375" height="490" loading="eager" alt="{{ ip_title | escape }}">
              {% elsif ip_image != blank %}
                {{ ip_image | image_url: width: 120 | image_tag: loading: 'lazy', widths: '80, 120', sizes: '68px', alt: ip_title }}
              {% endif %}
              <span>{{ ip_title | default: 'Choose IP' | escape }}</span>
            </button>
          {% endfor %}
        </div>

        <div class="p10-ip-showcase__panels">
          {% for block in showcase_blocks limit: 3 %}
            {% liquid
              assign ip_collection = collections[block.settings.collection]
              assign ip_products = ip_collection.products | slice: 0, 4
              assign ip_image = ip_collection.image
              if ip_image == blank and ip_products.size > 0
                assign ip_image = ip_products.first.featured_image
              endif
              assign ip_title = block.settings.title | default: ip_collection.title
              assign ip_label = block.settings.label | default: 'COLLECTOR WORLD'
              assign ip_link = ip_collection.url | default: block.settings.fallback_link
            %}
            <article
              id="p10-ip-showcase-panel-{{ section.id }}-{{ forloop.index0 }}"
              class="p10-ip-showcase__panel{% if block.settings.collection == blank %} p10-ip-showcase__panel--shell{% endif %}{% if block.settings.collection == 'ip-my-little-pony' %} p10-ip-showcase__panel--mlp{% endif %}{% if forloop.first %} is-active{% endif %}"
              data-ip-showcase-panel="{{ forloop.index0 }}"
              role="tabpanel"
              aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
            >
              {% if block.settings.collection == 'ip-my-little-pony' %}
                <div class="p10-ip-showcase__mlp-hero">
                  <img class="p10-ip-showcase__backdrop p10-ip-showcase__backdrop--mlp" src="{{ 'p10-mlp-star-edition-3-fluttershy-feature.png' | asset_url }}" width="317" height="341" loading="eager" alt="Official My Little Pony Fluttershy card artwork">
                </div>
                {% assign mlp_star_assets = 'p10-mlp-star-edition-3-pure-twilight.png|p10-mlp-star-edition-3-pure-celestia.png|p10-mlp-star-edition-3-pure-nightmare-moon.png|p10-mlp-star-edition-3-pure-cadance.png' | split: '|' %}
                <div class="p10-ip-showcase__tiles p10-ip-showcase__tiles--mlp" aria-label="Star: Edition 3 card artwork">
                  {% for card_asset in mlp_star_assets %}
                    <div class="p10-ip-showcase__tile p10-ip-showcase__tile--mlp" style="--p10-ip-tile-index: {{ forloop.index0 }}">
                      <img src="{{ card_asset | asset_url }}" width="420" height="590" loading="lazy" alt="Official My Little Pony Star: Edition 3 card artwork">
                    </div>
                  {% endfor %}
                </div>
              {% else %}
                {% if ip_image != blank %}
                  {{ ip_image | image_url: width: 960 | image_tag: class: 'p10-ip-showcase__backdrop', loading: 'lazy', widths: '480, 720, 960', sizes: '66vw', alt: '' }}
                {% endif %}
                <div class="p10-ip-showcase__wash"></div>
                <div class="p10-ip-showcase__copy">
                  <p>{{ ip_label | escape }}</p>
                  <h2>{{ ip_title | default: 'Featured IP' | escape }}</h2>
                  {% if ip_link != blank %}
                    <a href="{{ ip_link }}">Explore collection <span aria-hidden="true">→</span></a>
                  {% endif %}
                </div>
                <div class="p10-ip-showcase__tiles" aria-label="Featured products">
                  {% for product in ip_products limit: 4 %}
                    <a href="{{ product.url }}" class="p10-ip-showcase__tile" style="--p10-ip-tile-index: {{ forloop.index0 }}">
                      {% if product.featured_image != blank %}
                        {{ product.featured_image | image_url: width: 360 | image_tag: loading: 'lazy', widths: '180, 260, 360', sizes: '28vw', alt: product.title }}
                      {% endif %}
                    </a>
                  {% endfor %}
                </div>
              {% endif %}
            </article>
          {% endfor %}
        </div>
      </div>
    </div>
  {% endif %}

  <div class="p10-release-timeline__desktop">
  <div class="p10-release-timeline__shell">
    <header class="p10-release-timeline__intro">
      <div>
        <p class="p10-release-timeline__eyebrow">{{ section.settings.eyebrow | default: 'KAYOU · MY LITTLE PONY' | escape }}</p>
        <h2>{{ section.settings.heading | default: '2026 Release Timeline' | escape }}</h2>
      </div>
      <p>{{ section.settings.text | default: 'Track official release months for KAYOU My Little Pony CCG, TCG, and collector goods in one clean timeline.' | escape }}</p>
    </header>

    <div class="p10-release-timeline__tools" aria-label="Release filters">
      <div class="p10-release-timeline__filters" role="tablist" aria-label="Product type">
        <button type="button" class="is-active" data-release-filter="all" aria-selected="true">All</button>
        <button type="button" data-release-filter="ccg" aria-selected="false">CCG</button>
        <button type="button" data-release-filter="tcg" aria-selected="false">TCG</button>
        <button type="button" data-release-filter="merch" aria-selected="false">Merch</button>
      </div>
      <div class="p10-release-timeline__legend" aria-label="Date confidence">
        <span><i class="p10-release-timeline__dot p10-release-timeline__dot--confirmed"></i>Confirmed</span>
        <span><i class="p10-release-timeline__dot p10-release-timeline__dot--expected"></i>Expected</span>
        <span><i class="p10-release-timeline__dot p10-release-timeline__dot--research"></i>Unconfirmed</span>
      </div>
    </div>

    {% if timeline_blocks.size > 0 %}
      <div class="p10-release-timeline__stage">
        <button type="button" class="p10-release-timeline__nav p10-release-timeline__nav--prev" data-release-nav="prev" aria-label="Scroll timeline left">
          <span aria-hidden="true">‹</span>
        </button>
        <div class="p10-release-timeline__viewport" data-release-viewport tabindex="0" aria-label="{{ release_year | escape }} KAYOU My Little Pony release timeline">
          <ol class="p10-release-timeline__track" data-release-track aria-live="polite">
            {% for block in timeline_blocks %}
              {% liquid
                assign product = all_products[block.settings.product]
                assign release_month = block.settings.release_month | default: '00'
                assign month_key = release_year | append: release_month
                assign sort_key = month_key
                if release_month == '00'
                  assign sort_key = release_year | append: '00'
                endif
                assign category = block.settings.category | default: 'ccg'
                assign confidence = block.settings.confidence | default: 'expected'
                assign confidence_label = confidence | capitalize
                if confidence == 'research'
                  assign confidence_label = 'Unconfirmed'
                endif
                assign date_label = release_year | append: '.' | append: release_month
                if release_month == '00'
                  assign date_label = 'Date TBC'
                endif
                assign time_label = 'Coming soon'
                if release_month == '00'
                  assign time_label = 'Unconfirmed'
                elsif month_key < active_month_key
                  assign time_label = 'Released'
                elsif month_key == active_month_key
                  assign time_label = 'This month'
                endif
                assign product_title = block.settings.fallback_title
                assign product_url = block.settings.fallback_link
                if product != blank
                  assign product_title = product.title
                  assign product_url = product.url
                endif
                assign product_alt = product_title
                if product.featured_image != blank and product.featured_image.alt != blank
                  assign product_alt = product.featured_image.alt
                endif
              %}
              {% if product != blank or request.design_mode %}
                <li
                  class="p10-release-timeline__item"
                  data-release-item
                  data-release-category="{{ category | escape }}"
                  data-release-sort="{{ sort_key | escape }}"
                  data-release-confidence="{{ confidence | escape }}"
                  {{ block.shopify_attributes }}
                >
                  <div class="p10-release-timeline__node">
                    <time datetime="{% if release_month != '00' %}{{ release_year | escape }}-{{ release_month | escape }}{% else %}{{ release_year | escape }}{% endif %}">{{ date_label | escape }}</time>
                    <span>{{ time_label | escape }}</span>
                  </div>

                  <article class="p10-release-timeline__card">
                    <a class="p10-release-timeline__media" href="{{ product_url | default: '#' }}">
                      {% if product.featured_image != blank %}
                        {{
                          product.featured_image
                          | image_url: width: 760
                          | image_tag:
                            loading: 'lazy',
                            widths: '260, 380, 520, 760',
                            sizes: '(min-width: 1100px) 300px, 78vw',
                            alt: product_alt
                        }}
                      {% else %}
                        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                      {% endif %}
                    </a>

                    <div class="p10-release-timeline__body">
                      <div class="p10-release-timeline__tags">
                        <span class="p10-release-timeline__chip">{{ category | upcase }}</span>
                        <span class="p10-release-timeline__chip p10-release-timeline__chip--{{ confidence }}">{{ confidence_label | escape }}</span>
                      </div>
                      <h3>
                        <a href="{{ product_url | default: '#' }}">
                          {% if product_title != blank %}
                            {{ product_title | escape }}
                          {% else %}
                            Select a product for this release
                          {% endif %}
                        </a>
                      </h3>
                      <div class="p10-release-timeline__meta">
                        <span>
                          {% if product != blank %}
                            {% if product.price_varies %}From {% endif %}{{ product.price_min | money }}
                          {% else %}
                            Product pending
                          {% endif %}
                        </span>
                        <small>
                          {% if product != blank %}
                            {% if product.available %}In stock{% else %}Sold out{% endif %}
                          {% else %}
                            Theme editor
                          {% endif %}
                        </small>
                      </div>
                      <a class="p10-release-timeline__cta" href="{{ product_url | default: '#' }}">
                        <span>{% if product != blank %}View product{% else %}Set product{% endif %}</span>
                        <span aria-hidden="true">→</span>
                      </a>
                    </div>
                  </article>
                </li>
              {% endif %}
            {% endfor %}
          </ol>
          <p class="p10-release-timeline__filter-empty" data-release-filter-empty hidden>No releases in this lane yet. Add products in the theme editor as the {{ release_year | escape }} calendar fills in.</p>
        </div>
        <button type="button" class="p10-release-timeline__nav p10-release-timeline__nav--next" data-release-nav="next" aria-label="Scroll timeline right">
          <span aria-hidden="true">›</span>
        </button>
      </div>
      <p class="p10-release-timeline__note">{{ section.settings.note | default: 'Release months are maintained manually from official KAYOU/product-source references. 2026.XX means the product is included but the exact month still needs confirmation.' | escape }}</p>
    {% else %}
      <div class="p10-release-timeline__empty">
        <p>Add release blocks in the theme editor to build the {{ release_year | escape }} timeline.</p>
      </div>
    {% endif %}
  </div>
  </div>
</section>

{% if homepage_faq != blank %}
  {% render 'p10-faq', mode: 'home', faq_page: homepage_faq, section_id: section.id %}
{% endif %}

{% stylesheet %}
  .p10-release-timeline {
    --release-ink: #17181c;
    --release-muted: #68707c;
    --release-line: #dde3eb;
    --release-paper: #fffdfb;
    --release-soft: #f6f8fb;
    --release-blue: #78addf;
    --release-pink: #ef8fb2;
    --release-pink-deep: #d94c72;
    --release-gold: #d9bd6c;
    padding: 0 0 26px;
    background:
      linear-gradient(180deg, rgba(255, 246, 250, 0.78), rgba(255, 255, 255, 0) 32%),
      var(--release-paper);
    color: var(--release-ink);
  }

  .p10-release-timeline *,
  .p10-release-timeline *::before,
  .p10-release-timeline *::after {
    box-sizing: border-box;
  }

  .p10-release-timeline__shell {
    width: min(1320px, calc(100% - 32px));
    margin: 0 auto;
  }

  .p10-release-timeline__intro {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(260px, 0.55fr);
    align-items: end;
    gap: 20px;
    padding: 18px 0 10px;
    border-top: 1px solid var(--release-line);
  }

  .p10-release-timeline__eyebrow {
    margin: 0 0 4px;
    color: var(--release-pink-deep);
    font-size: 9px;
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .p10-release-timeline__intro h2 {
    max-width: 760px;
    margin: 0;
    font-size: clamp(22px, 2vw, 28px);
    font-weight: 950;
    line-height: 0.98;
    letter-spacing: 0;
  }

  .p10-release-timeline__intro > p {
    margin: 0;
    color: var(--release-muted);
    font-size: 12px;
    line-height: 1.4;
  }

  .p10-release-timeline__tools {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 6px 0 8px;
    border-top: 1px solid var(--release-line);
  }

  .p10-release-timeline__filters,
  .p10-release-timeline__legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  .p10-release-timeline__filters button {
    min-height: 26px;
    padding: 0 10px;
    border: 1px solid var(--release-line);
    border-radius: 999px;
    background: #fff;
    color: var(--release-ink);
    font-size: 9px;
    font-weight: 900;
    letter-spacing: 0;
    text-transform: uppercase;
    cursor: pointer;
    transition: background 160ms ease, border-color 160ms ease, transform 160ms ease;
  }

  .p10-release-timeline__filters button:hover {
    border-color: color-mix(in srgb, var(--release-pink) 55%, var(--release-line));
    transform: translateY(-1px);
  }

  .p10-release-timeline__filters button:focus-visible,
  .p10-release-timeline__nav:focus-visible,
  .p10-release-timeline__cta:focus-visible,
  .p10-release-timeline__media:focus-visible,
  .p10-release-timeline__card h3 a:focus-visible,
  .p10-release-timeline__viewport:focus-visible {
    outline: 3px solid #2e7fdb;
    outline-offset: 3px;
  }

  .p10-release-timeline__filters button.is-active {
    border-color: var(--release-ink);
    background: var(--release-ink);
    color: #fff;
  }

  .p10-release-timeline__legend {
    color: var(--release-muted);
    font-size: 9px;
    font-weight: 850;
    text-transform: uppercase;
  }

  .p10-release-timeline__legend span {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .p10-release-timeline__dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--release-blue);
  }

  .p10-release-timeline__dot--expected {
    background: var(--release-pink);
  }

  .p10-release-timeline__dot--research {
    background: var(--release-gold);
  }

  .p10-release-timeline__stage {
    position: relative;
  }

  .p10-release-timeline__stage::before,
  .p10-release-timeline__stage::after {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    z-index: 2;
    width: 54px;
    pointer-events: none;
  }

  .p10-release-timeline__stage::before {
    left: 0;
    background: linear-gradient(90deg, var(--release-paper), rgba(255, 253, 251, 0));
  }

  .p10-release-timeline__stage::after {
    right: 0;
    background: linear-gradient(270deg, var(--release-paper), rgba(255, 253, 251, 0));
  }

  .p10-release-timeline__viewport {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    scroll-padding: 0 8px;
    scrollbar-width: thin;
  }

  .p10-release-timeline__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 182px;
    gap: 14px;
    width: max-content;
    min-width: 0;
    margin: 0 auto;
    padding: 2px 4px 6px;
    list-style: none;
  }

  .p10-release-timeline__item {
    position: relative;
    display: grid;
    grid-template-rows: 44px minmax(0, 1fr);
    scroll-snap-align: start;
  }

  .p10-release-timeline__item[hidden] {
    display: none;
  }

  .p10-release-timeline__item::before {
    content: "";
    position: absolute;
    top: 22px;
    right: -18px;
    left: 10px;
    height: 1px;
    background: var(--release-line);
  }

  .p10-release-timeline__node {
    position: relative;
    z-index: 1;
    display: grid;
    align-content: start;
    gap: 4px;
    padding-left: 0;
  }

  .p10-release-timeline__node::before {
    content: "";
    width: 12px;
    height: 12px;
    margin: 16px 0 0;
    border: 3px solid #fff;
    border-radius: 50%;
    background: var(--release-blue);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--release-blue) 70%, var(--release-line));
  }

  .p10-release-timeline__item[data-release-confidence="expected"] .p10-release-timeline__node::before {
    background: var(--release-pink);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--release-pink) 70%, var(--release-line));
  }

  .p10-release-timeline__node time {
    position: absolute;
    top: 0;
    left: 0;
    font-size: 10px;
    font-weight: 950;
    line-height: 1;
  }

  .p10-release-timeline__node span {
    position: absolute;
    top: 28px;
    left: 0;
    color: var(--release-muted);
    font-size: 7px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .p10-release-timeline__card {
    display: grid;
    grid-template-rows: 150px minmax(122px, auto);
    min-height: 100%;
    overflow: hidden;
    border: 1px solid var(--release-line);
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 12px 30px rgba(30, 31, 37, 0.05);
    transition: border-color 160ms ease, box-shadow 160ms ease, transform 160ms ease;
  }

  .p10-release-timeline__card:hover {
    border-color: color-mix(in srgb, var(--release-pink) 42%, var(--release-line));
    box-shadow: 0 18px 42px rgba(30, 31, 37, 0.09);
    transform: translateY(-2px);
  }

  .p10-release-timeline__media {
    display: grid;
    place-items: center;
    min-width: 0;
    min-height: 0;
    overflow: hidden;
    padding: 9px;
    border-bottom: 1px solid var(--release-line);
    background:
      radial-gradient(circle at 22% 18%, rgba(239, 143, 178, 0.13), transparent 32%),
      linear-gradient(180deg, #fff, var(--release-soft));
  }

  .p10-release-timeline__media img,
  .p10-release-timeline__media svg {
    display: block;
    width: 100%;
    height: 100%;
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  .p10-release-timeline__body {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-rows: 17px minmax(30px, auto) 22px 26px;
    gap: 4px;
    min-width: 0;
    padding: 7px;
    background: #fff;
  }

  .p10-release-timeline__tags,
  .p10-release-timeline__meta,
  .p10-release-timeline__cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }

  .p10-release-timeline__chip {
    display: inline-flex;
    align-items: center;
    min-height: 15px;
    padding: 0 5px;
    border-radius: 999px;
    background: rgba(120, 173, 223, 0.14);
    color: color-mix(in srgb, var(--release-blue) 72%, var(--release-ink));
    font-size: 7px;
    font-weight: 950;
    text-transform: uppercase;
  }

  .p10-release-timeline__chip--expected {
    background: rgba(239, 143, 178, 0.16);
    color: var(--release-pink-deep);
  }

  .p10-release-timeline__chip--research {
    background: rgba(217, 189, 108, 0.18);
    color: #856917;
  }

  .p10-release-timeline__body h3 {
    margin: 0;
    font-size: 11px;
    font-weight: 900;
    line-height: 1.3;
    letter-spacing: 0;
  }

  .p10-release-timeline__body h3 a {
    display: -webkit-box;
    overflow: hidden;
    color: var(--release-ink);
    text-decoration: none;
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .p10-release-timeline__meta {
    align-items: end;
    border-top: 1px solid var(--release-line);
    padding-top: 5px;
  }

  .p10-release-timeline__meta span {
    font-size: 11px;
    font-weight: 950;
  }

  .p10-release-timeline__meta small {
    color: var(--release-muted);
    font-size: 7px;
    font-weight: 900;
    text-align: right;
    text-transform: uppercase;
  }

  .p10-release-timeline__cta {
    min-height: 26px;
    padding: 0 7px;
    border: 1px solid var(--release-line);
    border-radius: 6px;
    background: #fff;
    color: var(--release-ink);
    font-size: 8px;
    font-weight: 950;
    text-decoration: none;
