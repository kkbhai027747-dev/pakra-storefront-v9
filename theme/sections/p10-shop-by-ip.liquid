<section
  class="p10-shop-by-ip"
  id="P10ShopByIp-{{ section.id }}"
  data-p10-ip-directory-navigator
>
  <div class="p10-shop-by-ip__inner">
    <header class="p10-shop-by-ip__header">
      <div class="p10-shop-by-ip__title-wrap">
        <p class="p10-shop-by-ip__eyebrow">{{ section.settings.eyebrow | default: 'Collector directory' | escape }}</p>
        {%- if section.settings.heading != blank -%}
          <h1 class="p10-shop-by-ip__heading">{{ section.settings.heading | escape }}</h1>
        {%- endif -%}
      </div>
      {%- if section.settings.intro != blank -%}
        <p class="p10-shop-by-ip__intro">{{ section.settings.intro | escape }}</p>
      {%- endif -%}
    </header>

    <div class="p10-shop-by-ip__board" role="list" aria-label="Shop by IP">
      {%- assign secondary_tier_started = false -%}
      {%- for block in section.blocks -%}
        {%- if block.settings.secondary_tier and secondary_tier_started == false -%}
          <div class="p10-shop-by-ip__tier-divider display-empty" role="presentation" aria-hidden="true"></div>
          {%- assign secondary_tier_started = true -%}
        {%- endif -%}
        {%- liquid
          assign card_collection = block.settings.collection
          assign display_title = block.settings.title
          if display_title == blank and card_collection != blank
            assign display_title = card_collection.title
          endif
          if display_title == blank
            assign display_title = 'Collector world'
          endif

          assign card_url = block.settings.link
          if card_url == blank and card_collection != blank
            assign card_url = card_collection.url
          endif

          assign card_image = block.settings.image

          assign fallback_image_url = block.settings.image_url
          assign p10_icon_asset = ''
          assign p10_match_key = block.settings.ip_key
          if p10_match_key == blank or p10_match_key == 'custom'
            assign p10_match_key = display_title | handleize
          endif
          if p10_match_key == blank and card_collection != blank
            assign p10_match_key = card_collection.handle
          endif

          assign card_lane = block.settings.lane
          assign card_description = block.settings.description
          assign card_best = block.settings.best_for
          assign card_find_1 = block.settings.tag_1
          assign card_find_2 = block.settings.tag_2
          assign card_find_3 = block.settings.tag_3
          assign card_cta = block.settings.cta_label
          assign card_accent = block.settings.accent
          assign card_soft = block.settings.soft

          case p10_match_key
            when 'my-little-pony', 'mlp-1'
              assign p10_icon_asset = 'p10-ip-my-little-pony.webp'
              if card_lane == blank
                assign card_lane = 'KAYOU MLP cards'
              endif
              if card_description == blank
                assign card_description = 'Card releases and licensed collectibles.'
              endif
              if card_best == blank
                assign card_best = 'Sealed card releases and licensed collectibles'
              endif
              if card_find_1 == blank
                assign card_find_1 = 'Moon / Rainbow / Star'
              endif
              if card_find_2 == blank
                assign card_find_2 = 'Fun Moments'
              endif
              if card_find_3 == blank
                assign card_find_3 = 'Merch & Collectibles'
              endif
              if card_cta == blank
                assign card_cta = 'Explore MLP'
              endif
              if card_accent == blank
                assign card_accent = '#d49a25'
              endif
              if card_soft == blank
                assign card_soft = '#fff8e8'
              endif
            when 'naruto', 'ninjia'
              assign p10_icon_asset = 'p10-ip-naruto.webp'
              if card_lane == blank
                assign card_lane = 'KAYOU Naruto cards'
              endif
              if card_description == blank
                assign card_description = 'KAYOU sealed card boxes and anime collector releases.'
              endif
              if card_best == blank
                assign card_best = 'Sealed Naruto card boxes'
              endif
              if card_find_1 == blank
                assign card_find_1 = 'Display boxes'
              endif
              if card_find_2 == blank
                assign card_find_2 = 'Booster boxes'
              endif
              if card_find_3 == blank
                assign card_find_3 = 'Chinese Edition'
              endif
              if card_cta == blank
                assign card_cta = 'Explore Naruto'
              endif
              if card_accent == blank
                assign card_accent = '#f06f24'
              endif
              if card_soft == blank
                assign card_soft = '#fff2e8'
              endif
            when 'harry-potter'
              assign p10_icon_asset = 'p10-ip-harry-potter.webp'
              if card_lane == blank
                assign card_lane = 'Harry Potter collector goods'
              endif
              if card_description == blank
                assign card_description = 'Card releases, badges, standees, notebooks, and display goods.'
              endif
              if card_best == blank
                assign card_best = 'Badges, standees, and paper goods'
              endif
              if card_find_1 == blank
                assign card_find_1 = 'Badges'
              endif
              if card_find_2 == blank
                assign card_find_2 = 'Standees'
              endif
              if card_find_3 == blank
                assign card_find_3 = 'Notebooks'
              endif
              if card_cta == blank
                assign card_cta = 'Explore Harry Potter'
              endif
              if card_accent == blank
                assign card_accent = '#8f2f2f'
              endif
              if card_soft == blank
                assign card_soft = '#fff6ea'
              endif
            when 'the-powerpuff-girls', 'powerpuff-girls'
              assign p10_icon_asset = 'p10-ip-powerpuff-girls.webp'
              if card_lane == blank
                assign card_lane = 'Powerpuff goods'
              endif
              if card_description == blank
                assign card_description = 'Badges, charms, figures, and character collectibles.'
              endif
              if card_best == blank
                assign card_best = 'Character accessories and figures'
              endif
              if card_find_1 == blank
                assign card_find_1 = 'Badges'
              endif
              if card_find_2 == blank
                assign card_find_2 = 'Charms'
              endif
              if card_find_3 == blank
                assign card_find_3 = 'Figures'
              endif
              if card_cta == blank
                assign card_cta = 'Explore Powerpuff Girls'
              endif
              if card_accent == blank
                assign card_accent = '#ec6f9d'
              endif
              if card_soft == blank
                assign card_soft = '#fff0f7'
              endif
            when 'inuyasha'
              assign p10_icon_asset = 'p10-ip-inuyasha.webp'
              if card_lane == blank
                assign card_lane = 'Inuyasha collectibles'
              endif
              if card_description == blank
                assign card_description = 'CCG card products, figure blind boxes, and anime collectibles.'
              endif
              if card_best == blank
                assign card_best = 'Blind boxes and CCG products'
              endif
              if card_find_1 == blank
                assign card_find_1 = 'CCG booster box'
              endif
              if card_find_2 == blank
                assign card_find_2 = 'Figure blind box'
              endif
              if card_find_3 == blank
                assign card_find_3 = 'Anime collectible'
              endif
              if card_cta == blank
                assign card_cta = 'Explore Inuyasha'
              endif
              if card_accent == blank
                assign card_accent = '#b7282d'
              endif
              if card_soft == blank
                assign card_soft = '#fff1ed'
              endif
            when 'arknights'
              assign p10_icon_asset = 'p10-ip-arknights.png'
              if card_lane == blank
                assign card_lane = 'KAYOU Arknights goods'
              endif
              if card_description == blank
                assign card_description = 'Card products, figures, blind boxes, and character goods.'
              endif
              if card_best == blank
                assign card_best = 'Cards and character goods'
              endif
              if card_find_1 == blank
                assign card_find_1 = 'Card boxes'
              endif
              if card_find_2 == blank
                assign card_find_2 = 'Blind boxes'
              endif
              if card_find_3 == blank
                assign card_find_3 = 'Character goods'
              endif
              if card_cta == blank
                assign card_cta = 'Explore Arknights'
              endif
              if card_accent == blank
                assign card_accent = '#4f63c6'
              endif
              if card_soft == blank
                assign card_soft = '#eef2ff'
              endif
            when 'pokemon'
              assign p10_icon_asset = 'p10-ip-pokemon.webp'
              if card_lane == blank
                assign card_lane = 'Pokémon trading cards'
              endif
              if card_description == blank
                assign card_description = 'A dedicated Pokémon Trading Card Game route.'
              endif
              if card_best == blank
                assign card_best = 'Pokémon TCG discovery'
              endif
              if card_find_1 == blank
                assign card_find_1 = 'TCG'
              endif
              if card_find_2 == blank
                assign card_find_2 = 'Trading Card Game'
              endif
              if card_find_3 == blank
                assign card_find_3 = 'Sealed Cards'
              endif
              if card_cta == blank
                assign card_cta = 'Explore Pokémon'
              endif
              if card_accent == blank
                assign card_accent = '#2f75bb'
              endif
              if card_soft == blank
                assign card_soft = '#fff8da'
              endif
            when 'disney'
              assign p10_icon_asset = 'p10-ip-disney.webp'
              if card_lane == blank
                assign card_lane = 'Disney collector hub'
              endif
              if card_description == blank
                assign card_description = 'CCG, TCG, merchandise, and collectibles routes.'
              endif
              if card_best == blank
                assign card_best = 'Cards and character collectibles'
              endif
              if card_find_1 == blank
                assign card_find_1 = 'CCG'
              endif
              if card_find_2 == blank
                assign card_find_2 = 'TCG'
              endif
              if card_find_3 == blank
                assign card_find_3 = 'Merch & Collectibles'
              endif
              if card_cta == blank
                assign card_cta = 'Explore Disney'
              endif
              if card_accent == blank
                assign card_accent = '#1e5aa8'
              endif
              if card_soft == blank
                assign card_soft = '#f2f7fd'
              endif
            when 'marvel'
              assign p10_icon_asset = 'p10-ip-marvel.webp'
              if card_lane == blank
                assign card_lane = 'Marvel collector hub'
              endif
              if card_description == blank
                assign card_description = 'CCG, TCG, merchandise, and collectibles routes.'
              endif
              if card_best == blank
                assign card_best = 'Cards and superhero collectibles'
              endif
              if card_find_1 == blank
                assign card_find_1 = 'CCG'
              endif
              if card_find_2 == blank
                assign card_find_2 = 'TCG'
              endif
              if card_find_3 == blank
                assign card_find_3 = 'Merch & Collectibles'
              endif
              if card_cta == blank
                assign card_cta = 'Explore Marvel'
              endif
              if card_accent == blank
                assign card_accent = '#ed1d24'
              endif
              if card_soft == blank
                assign card_soft = '#fff1f1'
              endif
            when 'dc'
              assign p10_icon_asset = 'p10-ip-dc.webp'
              if card_lane == blank
                assign card_lane = 'DC collector hub'
              endif
              if card_description == blank
                assign card_description = 'CCG, TCG, merchandise, and collectibles routes.'
              endif
              if card_best == blank
                assign card_best = 'Cards and superhero collectibles'
              endif
              if card_find_1 == blank
                assign card_find_1 = 'CCG'
              endif
              if card_find_2 == blank
                assign card_find_2 = 'TCG'
              endif
              if card_find_3 == blank
                assign card_find_3 = 'Merch & Collectibles'
              endif
              if card_cta == blank
                assign card_cta = 'Explore DC'
              endif
              if card_accent == blank
                assign card_accent = '#0b76b7'
              endif
              if card_soft == blank
                assign card_soft = '#edf7fd'
              endif
            when 'one-piece'
              assign p10_icon_asset = 'p10-ip-icon-one-piece.png'
            when 'final-fantasy'
              assign p10_icon_asset = 'p10-ip-magic-the-gathering.png'
          endcase

          assign p10_icon_asset = block.settings.logo_asset | strip | default: p10_icon_asset

          if card_lane == blank
            assign card_lane = 'Collector world'
          endif
          if card_description == blank
            assign card_description = 'Browse this collector world through a focused product route.'
          endif
          if card_best == blank
            assign card_best = 'Focused browsing by IP'
          endif
          if card_find_1 == blank
            assign card_find_1 = 'Featured products'
          endif
          if card_find_2 == blank and block.settings.secondary_tier != true
            assign card_find_2 = 'New arrivals'
          endif
          if card_find_3 == blank and block.settings.secondary_tier != true
            assign card_find_3 = 'Collector goods'
          endif
          if card_cta == blank
            assign card_cta = 'Explore collection'
          endif
          if card_accent == blank
            assign card_accent = '#8f6a2d'
          endif
          if card_soft == blank
            assign card_soft = '#f5f0e7'
          endif

          assign navigator_panel_id = 'P10IpNavigator-' | append: section.id | append: '-' | append: block.id

          assign image_alt = display_title | append: ' logo'
          if p10_match_key == 'final-fantasy'
            assign image_alt = 'Magic: The Gathering logo'
          endif
          if p10_icon_asset == blank and card_image != blank and card_image.alt != blank
            assign image_alt = card_image.alt
          endif
        -%}

        {%- capture media_content -%}
          {%- if p10_icon_asset != blank -%}
            <img
              src="{{ p10_icon_asset | asset_url }}"
              alt="{{ image_alt | escape }}"
              width="700"
              height="700"
              loading="lazy"
              decoding="async"
              class="p10-shop-by-ip__image p10-shop-by-ip__image--asset{% if p10_match_key == 'one-piece' %} p10-shop-by-ip__image--one-piece{% elsif p10_match_key == 'final-fantasy' %} p10-shop-by-ip__image--wordmark{% endif %}"
            >
          {%- elsif card_image != blank -%}
            {{
              card_image
              | image_url: width: 700
              | image_tag:
                loading: 'lazy',
                widths: '160, 220, 320, 480, 600, 700',
                sizes: '(min-width: 1200px) 9vw, (min-width: 750px) 14vw, 28vw',
                alt: image_alt,
                class: 'p10-shop-by-ip__image'
            }}
          {%- elsif fallback_image_url != blank -%}
            <img
              src="{{ fallback_image_url | escape }}"
              alt="{{ image_alt | escape }}"
              width="700"
              height="700"
              loading="lazy"
              decoding="async"
              class="p10-shop-by-ip__image"
            >
          {%- else -%}
            <span class="p10-shop-by-ip__fallback" aria-hidden="true">{{ display_title | slice: 0, 2 | upcase }}</span>
          {%- endif -%}
        {%- endcapture -%}

        {%- capture card_content -%}
          <span class="p10-shop-by-ip__main">
            <span class="p10-shop-by-ip__media">
              {{ media_content }}
            </span>

            <span class="p10-shop-by-ip__content">
              <span class="p10-shop-by-ip__topline">
                <span class="p10-shop-by-ip__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                <span class="p10-shop-by-ip__lane">{{ card_lane | escape }}</span>
                <span
                  class="p10-shop-by-ip__default-publisher"
                  data-p10-ip-default-publisher
                  hidden
                ></span>
              </span>
              <span class="p10-shop-by-ip__title-line">
                <span class="p10-shop-by-ip__title">{{ display_title | escape }}</span>
                <span class="p10-shop-by-ip__publisher-badge" data-p10-ip-publisher-badge hidden></span>
              </span>
              <span class="p10-shop-by-ip__description p10-shop-by-ip__description--legacy">{{ card_description | escape }}</span>
              <span
                class="p10-shop-by-ip__description p10-shop-by-ip__description--default"
                data-p10-ip-default-description
                hidden
              ></span>
            </span>
          </span>

          <span class="p10-shop-by-ip__find p10-shop-by-ip__find--legacy" aria-label="Browse options">
            <span>{{ card_find_1 | escape }}</span>
            {%- if card_find_2 != blank -%}<span>{{ card_find_2 | escape }}</span>{%- endif -%}
            {%- if card_find_3 != blank -%}<span>{{ card_find_3 | escape }}</span>{%- endif -%}
          </span>

          <span
            class="p10-shop-by-ip__find p10-shop-by-ip__find--default"
            data-p10-ip-default-product-types
            aria-label="Product types"
            hidden
          ></span>

          <span class="p10-shop-by-ip__best">
            <span class="p10-shop-by-ip__best-label">Best for</span>
            <span class="p10-shop-by-ip__best-copy">{{ card_best | escape }}</span>
          </span>

          <span class="p10-shop-by-ip__footer">
            <span class="p10-shop-by-ip__cta">
              <span>{{ card_cta | escape }}</span>
              <span class="p10-shop-by-ip__arrow" aria-hidden="true">&rarr;</span>
            </span>
            {%- if card_collection != blank and card_collection.all_products_count > 0 -%}
              <span class="p10-shop-by-ip__count">{{ card_collection.all_products_count }} items</span>
            {%- endif -%}
          </span>
        {%- endcapture -%}

        <div
          class="p10-shop-by-ip__card{% if block.settings.secondary_tier %} p10-shop-by-ip__card--secondary{% endif %}"
          role="listitem"
          data-p10-ip-desktop-only="{{ block.settings.desktop_only }}"
          style="--p10-ip-accent: {{ card_accent }}; --p10-ip-soft: {{ card_soft }};"
          {{ block.shopify_attributes }}
        >
          {%- if card_url != blank -%}
            <a
              class="p10-shop-by-ip__card-link"
              href="{{ card_url }}"
              aria-label="{{ card_cta | escape }}"
              data-p10-ip-directory-card
              data-p10-ip-key="{{ p10_match_key | escape }}"
              data-p10-ip-name="{{ display_title | escape }}"
              aria-controls="{{ navigator_panel_id }}"
            >
              {{ card_content }}
            </a>
          {%- else -%}
            <div class="p10-shop-by-ip__card-link">
              {{ card_content }}
            </div>
          {%- endif -%}

          <div
            class="p10-shop-by-ip__navigator"
            id="{{ navigator_panel_id }}"
            data-p10-ip-navigator-panel
            hidden
          ></div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": {{ section.settings.heading | default: 'Shop by IP' | json }},
    "description": {{ section.settings.intro | default: 'Browse collector products by IP.' | json }},
    "url": {{ canonical_url | json }},
    "mainEntity": {
      "@type": "ItemList",
      "numberOfItems": {{ section.blocks.size | json }},
      "itemListElement": [
        {%- for block in section.blocks -%}
          {%- liquid
            assign schema_collection = block.settings.collection
            assign schema_title = block.settings.title
            if schema_title == blank and schema_collection != blank
              assign schema_title = schema_collection.title
            endif
            assign schema_url = block.settings.link
            if schema_url == blank and schema_collection != blank
              assign schema_url = schema_collection.url
            endif
            if schema_url contains '://'
              assign schema_absolute_url = schema_url
            else
              assign schema_absolute_url = request.origin | append: schema_url
            endif
          -%}
          {
            "@type": "ListItem",
            "position": {{ forloop.index | json }},
            "name": {{ schema_title | json }},
            "url": {{ schema_absolute_url | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  }
</script>

<script src="{{ 'gsap.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'p10-ip-directory-navigator-config.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'p10-ip-directory-navigator.js' | asset_url }}" defer="defer"></script>

{% stylesheet %}
  .p10-shop-by-ip {
    --p10-ip-page: #f7f3ec;
    --p10-ip-panel: #fffdf9;
    --p10-ip-ink: #17151c;
    --p10-ip-copy: #65606c;
    --p10-ip-line: rgba(23, 21, 28, 0.14);
    --p10-ip-chip: rgba(255, 255, 255, 0.82);
    --p10-ip-mobile-board: #fff4bd;
    --p10-ip-mobile-tile: #fffdf8;
    background:
      radial-gradient(circle at 92% 0%, rgba(218, 194, 151, 0.16), transparent 29rem),
      var(--p10-ip-page);
    color: var(--p10-ip-ink);
    padding: 54px 0 64px;
  }

  .p10-shop-by-ip__inner {
    width: min(100% - 56px, 1540px);
    margin: 0 auto;
  }

  .p10-shop-by-ip__header {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(280px, 0.8fr);
    gap: 48px;
    align-items: end;
    margin-bottom: 26px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--p10-ip-line);
  }

  .p10-shop-by-ip__eyebrow {
    margin: 0 0 9px;
    color: #9c6816;
    font-size: 11px;
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .p10-shop-by-ip__heading {
    margin: 0;
    color: var(--p10-ip-ink);
    font-size: clamp(38px, 4vw, 62px);
    font-weight: 900;
    line-height: 0.93;
    letter-spacing: -0.045em;
    text-transform: uppercase;
  }

  .p10-shop-by-ip__intro {
    max-width: 520px;
    margin: 0;
    color: var(--p10-ip-copy);
    font-size: 15px;
    font-weight: 650;
    line-height: 1.6;
  }

  .p10-shop-by-ip__board {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
  }

  .p10-shop-by-ip__tier-divider {
    grid-column: 1 / -1;
    margin-block: 10px;
    border-top: 1px solid var(--p10-ip-line);
  }

  .p10-shop-by-ip__card {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 348px;
    overflow: hidden;
    flex-direction: column;
    padding: 22px;
    border: 1px solid color-mix(in srgb, var(--p10-ip-accent) 24%, var(--p10-ip-line));
    border-radius: 18px;
    background:
      linear-gradient(135deg, var(--p10-ip-panel) 0 62%, color-mix(in srgb, var(--p10-ip-soft) 72%, var(--p10-ip-panel)) 100%);
    box-shadow: 0 16px 40px rgba(39, 31, 21, 0.07);
    color: var(--p10-ip-ink);
    text-decoration: none;
    transition:
      border-color 220ms ease,
      box-shadow 220ms ease,
      transform 220ms ease;
  }

  .p10-shop-by-ip__card-link {
    display: flex;
    min-width: 0;
    flex: 1 1 auto;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }

  .p10-shop-by-ip__card::before {
    position: absolute;
    inset: 18px auto 18px 0;
    width: 4px;
    border-radius: 0 99px 99px 0;
    background: var(--p10-ip-accent);
    content: '';
  }

  .p10-shop-by-ip__card:hover,
  .p10-shop-by-ip__card:focus-visible {
    border-color: color-mix(in srgb, var(--p10-ip-accent) 56%, var(--p10-ip-line));
    box-shadow: 0 22px 52px rgba(39, 31, 21, 0.12);
    transform: translateY(-3px);
  }

  .p10-shop-by-ip__card:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--p10-ip-accent) 42%, #ffffff);
    outline-offset: 3px;
  }

  .p10-shop-by-ip__main {
    display: grid;
    grid-template-columns: 116px minmax(0, 1fr);
    gap: 18px;
    align-items: center;
  }

  .p10-shop-by-ip__media {
    display: flex;
