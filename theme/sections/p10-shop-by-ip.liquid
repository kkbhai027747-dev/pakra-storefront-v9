      border-radius: 18px;
    }

    .p10-shop-by-ip.is-mobile-navigator-active .p10-shop-by-ip__card.is-mobile-navigator-active .p10-shop-by-ip__card-link {
      display: none;
    }

    .p10-shop-by-ip.is-mobile-navigator-active .p10-shop-by-ip__card.is-mobile-navigator-active .p10-shop-by-ip__navigator {
      display: block;
    }

    .p10-shop-by-ip__mobile-stage {
      position: relative;
      overflow: hidden;
      padding: 12px 14px 10px;
      border: 1px solid var(--p10-ip-mobile-line);
      border-radius: 18px;
      background: var(--p10-ip-mobile-board);
      color: var(--p10-ip-ink);
      box-shadow: var(--p10-ip-mobile-shadow);
    }

    .p10-shop-by-ip__mobile-toolbar {
      display: flex;
      min-height: 44px;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .p10-shop-by-ip__mobile-all-ip,
    .p10-shop-by-ip__mobile-back {
      min-height: 44px;
      padding: 10px 12px;
      border: 1px solid var(--p10-ip-mobile-line);
      border-radius: 999px;
      background: var(--p10-ip-mobile-tile);
      color: var(--p10-ip-ink);
      font: inherit;
      font-size: 12px;
      font-weight: 600;
      line-height: 1.25;
      cursor: pointer;
    }

    .p10-shop-by-ip__mobile-back[hidden] {
      display: none;
    }

    .p10-shop-by-ip__mobile-directory-search {
      width: fit-content;
      max-width: 100%;
      margin-bottom: 12px;
    }

    .p10-shop-by-ip__mobile-directory-search[hidden],
    .p10-shop-by-ip__mobile-ip-result[hidden] {
      display: none;
    }

    .p10-shop-by-ip__mobile-all-ip:focus-visible,
    .p10-shop-by-ip__mobile-back:focus-visible,
    .p10-shop-by-ip__mobile-option:focus-visible,
    .p10-shop-by-ip__mobile-submit:focus-visible,
    .p10-shop-by-ip__mobile-node:focus-visible,
    .p10-shop-by-ip__mobile-page-button:focus-visible,
    .p10-shop-by-ip__mobile-ip-dialog-close:focus-visible,
    .p10-shop-by-ip__mobile-ip-search:focus-visible,
    .p10-shop-by-ip__mobile-ip-search-clear:focus-visible,
    .p10-shop-by-ip__mobile-ip-result:focus-visible,
    .p10-shop-by-ip__mobile-ip-show-all:focus-visible {
      outline: 2px solid var(--p10-ip-mobile-selected);
      outline-offset: 3px;
    }

    .p10-shop-by-ip__mobile-context {
      margin: 16px 0;
      text-align: left;
    }

    .p10-shop-by-ip__mobile-kicker,
    .p10-shop-by-ip__mobile-trail,
    .p10-shop-by-ip__mobile-selection-hint,
    .p10-shop-by-ip__mobile-choice-dock-label,
    .p10-shop-by-ip__mobile-status,
    .p10-shop-by-ip__mobile-switch-label {
      margin: 0;
    }

    .p10-shop-by-ip .p10-shop-by-ip__mobile-stage .p10-shop-by-ip__mobile-kicker {
      color: var(--p10-ip-copy);
      font-size: 10px;
      font-weight: 650;
      letter-spacing: 0.08em;
      line-height: 1.4;
      text-transform: uppercase;
    }

    .p10-shop-by-ip .p10-shop-by-ip__mobile-stage .p10-shop-by-ip__mobile-trail {
      margin-top: 4px;
      overflow-wrap: anywhere;
      color: var(--p10-ip-ink);
      font-size: clamp(18px, 5.3vw, 23px);
      font-weight: 700;
      letter-spacing: -0.02em;
      line-height: 1.3;
    }

    .p10-shop-by-ip .p10-shop-by-ip__mobile-stage .p10-shop-by-ip__mobile-selection-hint {
      margin-top: 4px;
      color: var(--p10-ip-copy);
      font-size: 12px;
      font-weight: 500;
      line-height: 1.45;
    }

    .p10-shop-by-ip__mobile-choice-dock {
      margin: 0;
      padding: 0;
    }

    .p10-shop-by-ip__mobile-choice-dock[hidden],
    .p10-shop-by-ip__mobile-market[hidden] {
      display: none;
    }

    .p10-shop-by-ip .p10-shop-by-ip__mobile-stage .p10-shop-by-ip__mobile-choice-dock-label {
      margin-bottom: 8px;
      color: var(--p10-ip-ink);
      font-size: 13px;
      font-weight: 650;
      line-height: 1.4;
      text-align: left;
    }

    .p10-shop-by-ip__mobile-choice-options {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }

    .p10-shop-by-ip__mobile-option {
      display: flex;
      min-width: 0;
      min-height: 62px;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 3px;
      padding: 10px 12px;
      border: 2px solid var(--p10-ip-mobile-line);
      border-radius: 12px;
      background: var(--p10-ip-mobile-tile);
      color: var(--p10-ip-ink);
      font: inherit;
      text-align: left;
      cursor: pointer;
      transition: background-color 160ms ease, border-color 160ms ease;
    }

    .p10-shop-by-ip__mobile-option:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }

    .p10-shop-by-ip__mobile-option[aria-pressed='true'] {
      border-color: var(--p10-ip-mobile-selected);
      background: var(--p10-ip-mobile-selected-soft);
    }

    .p10-shop-by-ip__mobile-option:hover:not(:disabled) {
      border-color: var(--p10-ip-mobile-selected);
    }

    .p10-shop-by-ip__mobile-option:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .p10-shop-by-ip__mobile-option-title {
      overflow-wrap: anywhere;
      font-size: 14px;
      font-weight: 650;
      line-height: 1.3;
    }

    .p10-shop-by-ip__mobile-option-detail {
      color: var(--p10-ip-copy);
      font-size: 11px;
      font-weight: 450;
      line-height: 1.35;
    }

    .p10-shop-by-ip__mobile-market {
      margin-top: 14px;
    }

    .p10-shop-by-ip .p10-shop-by-ip__mobile-stage .p10-shop-by-ip__mobile-status {
      min-height: 18px;
      margin: 10px 0 8px;
      color: var(--p10-ip-copy);
      font-size: 12px;
      font-weight: 500;
      line-height: 1.5;
    }

    .p10-shop-by-ip__mobile-submit {
      display: flex;
      min-height: 46px;
      align-items: center;
      justify-content: center;
      padding: 12px 16px;
      border: 1px solid transparent;
      border-radius: 12px;
      background: var(--p10-ip-mobile-action);
      color: var(--p10-ip-mobile-action-ink);
      font-size: 14px;
      font-weight: 650;
      line-height: 1.4;
      text-align: center;
      text-decoration: none;
      transition: background-color 160ms ease;
    }

    .p10-shop-by-ip__mobile-submit[aria-disabled='true'] {
      --p10-ip-mobile-action-ink: var(--p10-ip-copy);
      background: var(--p10-ip-mobile-field);
      cursor: not-allowed;
    }

    /* Keep the action legible when the theme's footer link colors use !important. */
    .p10-shop-by-ip .p10-shop-by-ip__mobile-stage .p10-shop-by-ip__mobile-submit[aria-disabled] {
      color: var(--p10-ip-mobile-action-ink) !important;
    }

    .p10-shop-by-ip .p10-shop-by-ip__mobile-stage .p10-shop-by-ip__mobile-switch-label {
      margin-top: 18px;
      padding-top: 14px;
      border-top: 1px solid var(--p10-ip-mobile-line);
      color: var(--p10-ip-copy);
      font-size: 12px;
      font-weight: 550;
      line-height: 1.4;
      text-align: center;
    }

    .p10-shop-by-ip__mobile-orbit {
      position: relative;
      height: 288px;
      margin-top: 4px;
      touch-action: pan-y pinch-zoom;
    }

    .p10-shop-by-ip__mobile-orbit-items {
      position: absolute;
      inset: 0;
    }

    .p10-shop-by-ip__mobile-node {
      position: absolute;
      top: 50%;
      left: 50%;
      display: flex;
      width: 76px;
      min-height: 80px;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      gap: 5px;
      padding: 4px 0;
      border: 0;
      background: transparent;
      color: var(--p10-ip-ink);
      font: inherit;
      text-align: center;
      transform: translate(-50%, -50%) translate(var(--p10-ip-node-x, 0px), var(--p10-ip-node-y, 0px));
      cursor: pointer;
    }

    .p10-shop-by-ip__mobile-node--root {
      width: 90px;
      min-height: 96px;
      gap: 7px;
      color: var(--p10-ip-ink);
      cursor: default;
    }

    .p10-shop-by-ip .p10-shop-by-ip__mobile-stage .p10-shop-by-ip__mobile-node-media {
      display: flex;
      width: 44px;
      height: 44px;
      overflow: hidden;
      align-items: center;
      justify-content: center;
      flex: 0 0 auto;
      margin: 0;
      padding: 2px;
      border: 1px solid var(--p10-ip-mobile-line);
      border-radius: 50%;
      background: var(--p10-ip-mobile-logo);
      box-shadow: var(--p10-ip-mobile-shadow);
      transition: border-color 160ms ease;
    }

    .p10-shop-by-ip__mobile-node-media .p10-shop-by-ip__image,
    .p10-shop-by-ip__mobile-node-media .p10-shop-by-ip__fallback {
      width: 100%;
      max-width: none;
      height: 100%;
      max-height: none;
      border-radius: 50%;
      object-fit: contain;
    }

    .p10-shop-by-ip .p10-shop-by-ip__mobile-stage .p10-shop-by-ip__mobile-node--root .p10-shop-by-ip__mobile-node-media {
      width: 64px;
      height: 64px;
      border-color: var(--p10-ip-mobile-selected);
      box-shadow: 0 0 0 4px var(--p10-ip-mobile-selected-soft);
    }

    .p10-shop-by-ip .p10-shop-by-ip__mobile-stage .p10-shop-by-ip__mobile-node--ip:hover .p10-shop-by-ip__mobile-node-media {
      border-color: var(--p10-ip-mobile-selected);
    }

    .p10-shop-by-ip__mobile-node-label {
      display: block;
      max-width: 100%;
      overflow-wrap: anywhere;
      font-size: 10.5px;
      font-weight: 550;
      letter-spacing: 0;
      line-height: 1.3;
      text-align: center;
    }

    .p10-shop-by-ip__mobile-node--root .p10-shop-by-ip__mobile-node-label {
      font-size: 11px;
      font-weight: 650;
    }

    .p10-shop-by-ip__mobile-orbit-pagination {
      display: grid;
      min-height: 48px;
      grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
      align-items: center;
      gap: 10px;
      padding: 2px 0;
    }

    .p10-shop-by-ip__mobile-orbit-pagination[hidden],
    .p10-shop-by-ip__mobile-ip-search-clear[hidden] {
      display: none;
    }

    .p10-shop-by-ip__mobile-page-button,
    .p10-shop-by-ip__mobile-ip-dialog-close,
    .p10-shop-by-ip__mobile-ip-search-clear,
    .p10-shop-by-ip__mobile-ip-show-all {
      min-width: 44px;
      min-height: 44px;
      padding: 10px 12px;
      border: 1px solid var(--p10-ip-mobile-line);
      border-radius: 10px;
      background: var(--p10-ip-mobile-tile);
      color: var(--p10-ip-ink);
      font: inherit;
      font-size: 12px;
      font-weight: 600;
      line-height: 1.4;
      text-align: center;
      cursor: pointer;
    }

    .p10-shop-by-ip__mobile-page-button:disabled,
    .p10-shop-by-ip__mobile-ip-dialog-close:disabled,
    .p10-shop-by-ip__mobile-ip-search-clear:disabled,
    .p10-shop-by-ip__mobile-ip-show-all:disabled {
      background: var(--p10-ip-mobile-field);
      color: var(--p10-ip-copy);
      cursor: not-allowed;
    }

    .p10-shop-by-ip__mobile-page-status {
      min-width: 44px;
      color: var(--p10-ip-copy);
      font-size: 12px;
      font-weight: 550;
      line-height: 1.4;
      text-align: center;
      font-variant-numeric: tabular-nums;
    }

    .p10-shop-by-ip__mobile-ip-dialog {
      box-sizing: border-box;
      width: min(calc(100% - 24px), 480px);
      max-width: none;
      max-height: min(80dvh, 720px);
      overflow: hidden;
      padding: 16px;
      border: 1px solid var(--p10-ip-mobile-line);
      border-radius: 18px;
      background: var(--p10-ip-mobile-board);
      color: var(--p10-ip-ink);
      box-shadow: 0 24px 64px rgba(0, 0, 0, 0.24);
    }

    .p10-shop-by-ip__mobile-ip-dialog[open] {
      display: grid;
      grid-template-rows: auto auto auto minmax(0, 1fr) auto;
      gap: 12px;
    }

    .p10-shop-by-ip__mobile-ip-dialog::backdrop {
      background: rgba(22, 17, 29, 0.48);
    }

    .p10-shop-by-ip__mobile-ip-dialog-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
    }

    .p10-shop-by-ip .p10-shop-by-ip__mobile-ip-dialog .p10-shop-by-ip__mobile-ip-dialog-title {
      margin: 0;
      color: var(--p10-ip-ink);
      font-size: 20px;
      font-weight: 650;
      line-height: 1.3;
    }

    .p10-shop-by-ip__mobile-ip-search-wrap {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
    }

    .p10-shop-by-ip .p10-shop-by-ip__mobile-ip-dialog .p10-shop-by-ip__mobile-ip-search-wrap label {
      flex-basis: 100%;
      margin: 0;
      color: var(--p10-ip-copy);
      font-size: 12px;
      font-weight: 550;
      line-height: 1.4;
    }

    .p10-shop-by-ip__mobile-ip-search {
      min-width: 0;
      min-height: 44px;
      flex: 1 1 0;
      padding: 10px 12px;
      border: 1px solid var(--p10-ip-mobile-line);
      border-radius: 10px;
      background: var(--p10-ip-mobile-field);
      color: var(--p10-ip-ink);
      font: inherit;
      font-size: 16px;
      line-height: 1.4;
    }

    .p10-shop-by-ip__mobile-ip-search::placeholder {
      color: var(--p10-ip-copy);
      opacity: 1;
    }

    .p10-shop-by-ip__mobile-ip-search::-webkit-search-cancel-button {
      display: none;
    }

    .p10-shop-by-ip .p10-shop-by-ip__mobile-ip-dialog .p10-shop-by-ip__mobile-ip-search-status {
      min-height: 18px;
      margin: 0;
      color: var(--p10-ip-copy);
      font-size: 12px;
      font-weight: 500;
      line-height: 1.5;
    }

    .p10-shop-by-ip__mobile-ip-results {
      display: grid;
      min-height: 0;
      overflow-y: auto;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      grid-auto-rows: max-content;
      align-content: start;
      gap: 8px;
      padding: 4px;
      overscroll-behavior: contain;
      scrollbar-gutter: stable;
      touch-action: pan-y pinch-zoom;
    }

    .p10-shop-by-ip__mobile-ip-results:empty {
      min-height: 80px;
    }

    .p10-shop-by-ip__mobile-ip-result {
      display: flex;
      min-width: 0;
      min-height: 108px;
      flex-direction: column;
      align-items: center;
      justify-content: flex-start;
      gap: 8px;
      padding: 12px 6px;
      border: 2px solid var(--p10-ip-mobile-line);
      border-radius: 12px;
      background: var(--p10-ip-mobile-tile);
      color: var(--p10-ip-ink);
      font: inherit;
      text-align: center;
      cursor: pointer;
    }

    .p10-shop-by-ip__mobile-ip-result[aria-pressed='true'] {
      border-color: var(--p10-ip-mobile-selected);
      background: var(--p10-ip-mobile-selected-soft);
    }

    .p10-shop-by-ip__mobile-ip-result:hover:not(:disabled),
    .p10-shop-by-ip__mobile-page-button:hover:not(:disabled),
    .p10-shop-by-ip__mobile-ip-dialog-close:hover:not(:disabled),
    .p10-shop-by-ip__mobile-ip-search-clear:hover:not(:disabled),
    .p10-shop-by-ip__mobile-ip-show-all:hover:not(:disabled) {
      border-color: var(--p10-ip-mobile-selected);
    }

    .p10-shop-by-ip__mobile-ip-result:disabled {
      background: var(--p10-ip-mobile-field);
      color: var(--p10-ip-copy);
      cursor: not-allowed;
    }

    .p10-shop-by-ip .p10-shop-by-ip__mobile-ip-dialog .p10-shop-by-ip__mobile-node-media {
      display: flex;
      width: 48px;
      height: 48px;
      overflow: hidden;
      align-items: center;
      justify-content: center;
      flex: 0 0 auto;
      margin: 0;
      padding: 2px;
      border: 1px solid var(--p10-ip-mobile-line);
      border-radius: 50%;
      background: var(--p10-ip-mobile-logo);
      box-shadow: var(--p10-ip-mobile-shadow);
    }

    .p10-shop-by-ip__mobile-ip-result-name {
      display: block;
      max-width: 100%;
      flex: 0 0 auto;
      overflow-wrap: anywhere;
      font-size: 12px;
      font-weight: 600;
      line-height: 1.4;
    }

    .p10-shop-by-ip__mobile-ip-show-all {
      width: 100%;
      background: var(--p10-ip-mobile-field);
    }
  }

  @media (max-width: 359px) {
    .p10-shop-by-ip__mobile-node--root {
      width: 64px;
      min-height: 64px;
    }

    .p10-shop-by-ip .p10-shop-by-ip__mobile-stage .p10-shop-by-ip__mobile-node--root .p10-shop-by-ip__mobile-node-media {
      width: 48px;
      height: 48px;
    }

    .p10-shop-by-ip__mobile-node--root .p10-shop-by-ip__mobile-node-label {
      display: none;
    }

    .p10-shop-by-ip__mobile-ip-results {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 749px) and (max-height: 480px) {
    .p10-shop-by-ip__mobile-ip-dialog[open] {
      max-height: calc(100dvh - 24px);
      overflow-y: auto;
      grid-template-rows: auto;
    }

    .p10-shop-by-ip__mobile-ip-results {
      overflow-y: visible;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .p10-shop-by-ip__card,
    .p10-shop-by-ip__arrow,
    .p10-shop-by-ip__navigator-option,
    .p10-shop-by-ip__mobile-option,
    .p10-shop-by-ip__mobile-submit,
    .p10-shop-by-ip__mobile-node-media {
      transition: none;
    }

    .p10-shop-by-ip__card:hover,
    .p10-shop-by-ip__card:focus-visible,
    .p10-shop-by-ip__card:hover .p10-shop-by-ip__arrow,
    .p10-shop-by-ip__card:focus-visible .p10-shop-by-ip__arrow {
      transform: none;
    }
  }

  .p10-shop-by-ip .p10-shop-by-ip__image--one-piece {
    background: #ffffff;
    border-radius: 0;
    object-fit: contain;
    padding: 2px;
  }
  .p10-shop-by-ip .p10-shop-by-ip__image--wordmark {
    padding: 5px;
    background: #19171f;
    object-fit: contain;
  }
{% endstylesheet %}

