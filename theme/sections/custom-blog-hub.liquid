{{ 'p10-editorial.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gsap.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'p10-editorial.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign hub_heading = section.settings.heading | default: 'Collector Guides'
  assign hub_label = section.settings.section_label | default: 'Blog'
  assign hub_description = section.settings.description
  assign hub_tag = section.settings.heading_tag | default: 'h2'
-%}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": {{ hub_heading | strip_html | json }},
  "itemListElement": [
    {%- for block in section.blocks -%}
      {
        "@type": "ListItem",
        "position": {{ forloop.index }},
        "name": {{ block.settings.title_text | strip_html | json }},
        "url": {{ block.settings.link_url | json }}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]
}
</script>

<section class="p10-blog-hub" id="P10BlogHub-{{ section.id }}" {{ section.shopify_attributes }}>
  <div class="p10-blog-hub__inner">
    <header class="p10-blog-hub__header">
      <div class="p10-blog-hub__heading-group">
        <p class="p10-editorial-eyebrow">{{ hub_label | escape }}</p>
        <{{ hub_tag }} class="p10-blog-hub__title">{{ hub_heading | escape }}</{{ hub_tag }}>
      </div>
      <div class="p10-blog-hub__intro">
        {%- if hub_description != blank -%}
          <p class="p10-blog-hub__description">{{ hub_description }}</p>
        {%- endif -%}
        {%- if section.settings.cta_text != blank and section.settings.cta_link != blank -%}
          <a class="p10-blog-hub__cta" href="{{ section.settings.cta_link }}">
            {{ section.settings.cta_text | escape }}
          </a>
        {%- endif -%}
      </div>
    </header>

    <div class="p10-blog-hub__grid">
      {% for block in section.blocks %}
        {%- liquid
          assign card_style = block.settings.card_style | default: 'standard'
          assign card_label = block.settings.label_text | default: 'Collector read'
          assign card_summary = block.settings.summary_text
          assign cover_image_url = block.settings.cover_image_url | strip
        -%}
        <a href="{{ block.settings.link_url }}" class="p10-blog-hub__card{% if forloop.first %} p10-blog-hub__card--feature{% endif %}{% if card_style == 'diy_corner' %} p10-blog-hub__card--diy{% endif %}" style="--p10-card-index: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
          <span class="p10-blog-hub__media">
            {% if block.settings.cover_image != blank %}
              <img
                src="{{ block.settings.cover_image | img_url: '900x506', crop: 'center' }}"
                srcset="{{ block.settings.cover_image | img_url: '420x236', crop: 'center' }} 420w, {{ block.settings.cover_image | img_url: '720x405', crop: 'center' }} 720w, {{ block.settings.cover_image | img_url: '900x506', crop: 'center' }} 900w"
                sizes="(min-width: 990px) 31vw, (min-width: 700px) 48vw, 100vw"
                loading="lazy"
                alt="{{ block.settings.title_text | escape }}"
                width="900"
                height="506">
            {% elsif cover_image_url != blank %}
              <img
                src="{{ cover_image_url | escape }}"
                sizes="(min-width: 990px) 31vw, (min-width: 700px) 48vw, 100vw"
                loading="lazy"
                alt="{{ block.settings.title_text | escape }}"
                width="900"
                height="506">
            {% else %}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {% endif %}
          </span>
          <span class="p10-blog-hub__content">
            <span class="p10-blog-hub__meta">
              <span class="p10-blog-hub__number">{% if forloop.index < 10 %}0{% endif %}{{ forloop.index }}</span>
              <span>{{ card_label | escape }}</span>
            </span>
            <span class="p10-blog-hub__card-title">{{ block.settings.title_text }}</span>
            {%- if card_summary != blank -%}
              <span class="p10-blog-hub__card-summary">{{ card_summary }}</span>
            {%- endif -%}
            <span class="p10-blog-hub__read">Read now</span>
          </span>
        </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Horizontal Blog Hub",
  "settings": [
    {
      "type": "text",
      "id": "section_label",
      "label": "Section label",
      "default": "Collector guides"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "KAYOU MLP card guides"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Read collecting guides, store stories, and practical notes before choosing My Little Pony cards and related collectibles."
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        }
      ]
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "CTA text"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA link"
    }
  ],
  "blocks": [
    {
      "type": "article_card",
      "name": "Horizontal Card",
      "settings": [
        {
          "type": "image_picker",
          "id": "cover_image",
          "label": "Cover image"
        },
        {
          "type": "text",
          "id": "cover_image_url",
          "label": "External cover image URL"
        },
        {
          "type": "text",
          "id": "title_text",
          "label": "Article title",
          "default": "The Best Cards of the Week"
        },
        {
          "type": "text",
          "id": "label_text",
          "label": "Card label",
          "default": "Collector read"
        },
        {
          "type": "textarea",
          "id": "summary_text",
          "label": "Card summary"
        },
        {
          "type": "select",
          "id": "card_style",
          "label": "Card style",
          "default": "standard",
          "options": [
            {
              "value": "standard",
              "label": "Standard"
            },
            {
              "value": "diy_corner",
              "label": "DIY corner"
            }
          ]
        },
        {
          "type": "url",
          "id": "link_url",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Horizontal Blog Hub",
      "category": "Custom",
      "blocks": [
        {
          "type": "article_card"
        },
        {
          "type": "article_card"
        }
      ]
    }
  ]
}
{% endschema %}
