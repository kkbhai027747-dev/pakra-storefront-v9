{%- capture recommended_articles -%}
  {%- for block in section.blocks -%}
    {%- assign recommended_article = block.settings.article -%}
    {%- if recommended_article != blank -%}
      <div class="p10-home-articles__item" {{ block.shopify_attributes }}>
        {%- render 'p10-blog-card',
          article: recommended_article,
          style_override: 'BLOG-01',
          label: block.settings.label,
          loading: 'lazy',
          sizes: '(max-width: 749px) 112px, (min-width: 1352px) 424px, 32vw'
        -%}
      </div>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if recommended_articles != blank or request.design_mode -%}
  <section class="p10-home-articles" aria-labelledby="p10-home-articles-heading-{{ section.id }}">
    <div class="p10-home-articles__inner">
      <header class="p10-home-articles__header">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="p10-home-articles__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          <h2 id="p10-home-articles-heading-{{ section.id }}" class="p10-home-articles__heading">{{ section.settings.heading | escape }}</h2>
        </div>
        {%- if section.settings.journal_link != blank and section.settings.journal_label != blank -%}
          <a class="p10-home-articles__more" href="{{ section.settings.journal_link | escape }}">
            {{- section.settings.journal_label | escape }} <span aria-hidden="true">&rarr;</span>
          </a>
        {%- endif -%}
      </header>
      <div class="p10-home-articles__grid">{{ recommended_articles }}</div>
    </div>
  </section>
{%- endif -%}

{% stylesheet %}
  .p10-home-articles {
    --stories-paper: #fff;
    --stories-ink: #17181c;
    --stories-muted: #68707c;
    --stories-line: #dde3eb;
    --stories-accent: #b73762;
    --stories-soft: #faf0f4;
    padding: 0 0 36px;
    background: var(--stories-paper);
    color: var(--stories-ink);
  }

  html[data-p10-color-mode='dark'] .p10-home-articles {
    --stories-paper: var(--p10-dark-canvas);
    --stories-ink: var(--p10-dark-text);
    --stories-muted: var(--p10-dark-secondary);
    --stories-line: var(--p10-dark-line);
    --stories-accent: var(--p10-dark-pink);
    --stories-soft: var(--p10-dark-raised);
  }

  .p10-home-articles__inner {
    width: min(1320px, calc(100% - 32px));
    margin: 0 auto;
  }

  .p10-home-articles__header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 0;
    border-top: 1px solid var(--stories-line);
  }

  .p10-home-articles__eyebrow {
    margin: 0 0 6px;
    color: var(--stories-accent);
    font-size: 10px;
    font-weight: 800;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .p10-home-articles__heading {
    margin: 0;
    color: inherit;
    font-size: clamp(22px, 2vw, 28px);
    font-weight: 800;
    line-height: 1.15;
  }

  .p10-home-articles__more {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 44px;
    color: inherit;
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
  }

  .p10-home-articles__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }

  .p10-home-articles .p10-blog-card,
  .p10-home-articles .p10-blog-card__link {
    height: 100%;
  }

  .p10-home-articles .p10-blog-card__link {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--stories-line);
    border-radius: 8px;
    color: inherit;
    text-decoration: none;
  }

  .p10-home-articles .p10-blog-card__media {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--stories-soft);
  }

  .p10-home-articles .p10-blog-card__image-frame,
  .p10-home-articles .p10-blog-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .p10-home-articles .p10-blog-card--focal-left .p10-blog-card__image {
    object-position: left center;
  }

  .p10-home-articles .p10-blog-card--focal-right .p10-blog-card__image {
    object-position: right center;
  }

  .p10-home-articles .p10-blog-card__text-image {
    display: grid;
    height: 100%;
    place-items: center;
    padding: 20px;
    box-sizing: border-box;
    color: var(--stories-accent);
    font-size: 20px;
    font-weight: 700;
    text-align: center;
  }

  .p10-home-articles .p10-blog-card__copy {
    display: flex;
    flex: 1;
    flex-direction: column;
    align-items: start;
    gap: 10px;
    min-width: 0;
    padding: 18px;
  }

  .p10-home-articles .p10-blog-card__label {
    color: var(--stories-accent);
    font-size: 10px;
    font-weight: 800;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .p10-home-articles .p10-blog-card__title {
    margin: 0;
    color: inherit;
    font-size: 18px;
    font-weight: 700;
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .p10-home-articles .p10-blog-card__excerpt {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    color: var(--stories-muted);
    font-size: 13px;
    line-height: 1.6;
  }

  .p10-home-articles .p10-blog-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    align-self: stretch;
    margin-top: auto;
    padding-top: 6px;
    font-size: 11px;
    line-height: 1.5;
  }

  .p10-home-articles .p10-blog-card__read-time {
    color: var(--stories-muted);
  }

  .p10-home-articles .p10-blog-card__read {
    font-weight: 700;
  }

  .p10-home-articles a:focus-visible {
    outline: 2px solid #2e7fdb;
    outline-offset: 4px;
  }

  .p10-home-articles .p10-blog-card__link:hover {
    border-color: var(--stories-accent);
  }

  .p10-home-articles__more:hover {
    text-decoration: underline;
  }

  @media (max-width: 749px) {
    .p10-home-articles {
      padding-bottom: 24px;
    }

    .p10-home-articles__header {
      align-items: start;
      flex-direction: column;
      gap: 0;
      padding: 16px 0 10px;
    }

    .p10-home-articles__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 12px;
    }

    .p10-home-articles .p10-blog-card__link {
      display: grid;
      grid-template-columns: 112px minmax(0, 1fr);
    }

    .p10-home-articles .p10-blog-card__media {
      height: 100%;
      aspect-ratio: auto;
    }

    .p10-home-articles .p10-blog-card__copy {
      gap: 7px;
      padding: 12px;
    }

    .p10-home-articles .p10-blog-card__title {
      font-size: 15px;
    }

    .p10-home-articles .p10-blog-card__text-image {
      padding: 12px;
      font-size: 14px;
      overflow-wrap: anywhere;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "P10 Product Stories",
  "tag": "div",
  "enabled_on": { "templates": ["index"] },
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "THE COLLECTOR JOURNAL" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Product Stories & Guides" },
    { "type": "text", "id": "journal_label", "label": "All articles label", "default": "Explore the journal" },
    { "type": "url", "id": "journal_link", "label": "All articles link" }
  ],
  "blocks": [
    {
      "type": "article",
      "name": "Recommended article",
      "settings": [
        { "type": "article", "id": "article", "label": "Article", "info": "Choose a published product story, review, or buying guide." },
        { "type": "text", "id": "label", "label": "Category label", "default": "Product story" }
      ]
    }
  ],
  "presets": [
    {
      "name": "P10 Product Stories",
      "blocks": [{ "type": "article" }, { "type": "article" }, { "type": "article" }]
    }
  ]
}
{% endschema %}
