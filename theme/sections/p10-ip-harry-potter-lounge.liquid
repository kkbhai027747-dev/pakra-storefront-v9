      radial-gradient(circle at 14% 24%, rgba(91,24,34,0.06) 0 1px, transparent 1.6px),
      radial-gradient(circle at 78% 68%, rgba(158,116,49,0.08) 0 1px, transparent 1.7px),
      linear-gradient(180deg, rgba(255,247,231,0.95), rgba(255,253,247,0.96)),
      repeating-linear-gradient(0deg, rgba(158,116,49,0.08) 0 1px, transparent 1px 32px);
