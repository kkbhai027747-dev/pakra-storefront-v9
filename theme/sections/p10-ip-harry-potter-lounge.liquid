{% liquid
  assign section_id = 'p10-ip-hp-' | append: section.id
  assign hp_collection = section.settings.source_collection
  if hp_collection == blank
    assign hp_collection = collections['harry-potter']
  endif

  assign collection_url = section.settings.primary_link
  if collection_url == blank and hp_collection != blank
    assign collection_url = hp_collection.url
  endif
  if collection_url == blank
    assign collection_url = '/collections/harry-potter'
  endif

  assign standee_url = section.settings.standee_link
  if standee_url == blank
    assign standee_url = collection_url
  endif

  assign badge_url = section.settings.badge_link
  if badge_url == blank
    assign badge_url = collection_url
  endif

  assign guardian_badge_url = section.settings.guardian_badge_link
  if guardian_badge_url == blank
    assign guardian_badge_url = badge_url
  endif

  assign christmas_badge_url = section.settings.christmas_badge_link
  if christmas_badge_url == blank
    assign christmas_badge_url = badge_url
  endif

  assign notebook_url = section.settings.notebook_link
  if notebook_url == blank
    assign notebook_url = collection_url
  endif
%}

<section id="{{ section_id }}" class="p10-ip-hp" data-p10-ip-hp>
  <div class="p10-ip-hp__anchor" id="{{ section.settings.anchor_id | default: 'harry-potter-collector-zone' | escape }}"></div>

  <div class="p10-ip-hp__atmosphere" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
    <span></span>
  </div>

  <div class="p10-ip-hp__nav">
    <a class="p10-ip-hp__back" href="{{ section.settings.back_link | default: '/collections' }}">
      <span aria-hidden="true">&larr;</span>
      <span>{{ section.settings.back_label | default: 'Back' | escape }}</span>
    </a>
  </div>

  <div class="p10-ip-hp__shell">
    <div class="p10-ip-hp__hero">
      <div class="p10-ip-hp__copy">
        <p class="p10-ip-hp__eyebrow">{{ section.settings.eyebrow | default: 'KAYOU collector archive' | escape }}</p>
        <h1 class="p10-ip-hp__heading">{{ section.settings.heading | default: 'Harry Potter' | escape }}</h1>
        <p class="p10-ip-hp__subheading">
          {{ section.settings.subheading | default: 'Browse KAYOU Harry Potter cards and collectible formats through a focused archive for sealed boxes, badges, acrylic standees, and notebooks.' | escape }}
        </p>
        <details class="p10-ip-hp__read-more">
          <summary>Read details</summary>
          <p>{{ section.settings.subheading | default: 'Browse KAYOU Harry Potter cards and collectible formats through a focused archive for sealed boxes, badges, acrylic standees, and notebooks.' | escape }}</p>
        </details>
        <div class="p10-ip-hp__actions">
          <a class="p10-ip-hp__primary-link" href="{{ collection_url }}">Shop Harry Potter</a>
          <a class="p10-ip-hp__secondary-link" href="{{ badge_url }}">Browse badges</a>
        </div>
        <div class="p10-ip-hp__format-strip" aria-label="Featured formats">
          <span>Sealed cards</span>
          <span>Badges</span>
          <span>Standees</span>
          <span>Notebooks</span>
        </div>
      </div>

      <div class="p10-ip-hp__insignia" aria-label="KAYOU Harry Potter collector archive">
        <div class="p10-ip-hp__crest-image">
          <img
            src="{{ 'p10-ip-harry-potter.webp' | asset_url }}"
            alt="Harry Potter"
            width="720"
            height="720"
            loading="eager"
            decoding="async"
          >
        </div>
        {% if hp_collection != blank and hp_collection.all_products_count > 0 %}
          <div class="p10-ip-hp__hero-products" aria-label="Harry Potter product preview">
            {% for product in hp_collection.products limit: 3 %}
              {% liquid
                assign preview_image_alt = product.title
                if product.featured_image != blank and product.featured_image.alt != blank
                  assign preview_image_alt = product.featured_image.alt
                endif
              %}
              <a class="p10-ip-hp__hero-product" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                {% if product.featured_image != blank %}
                  {{
                    product.featured_image
                    | image_url: width: 260
                    | image_tag:
                      loading: 'eager',
                      widths: '120, 180, 260',
                      sizes: '(min-width: 990px) 9vw, 23vw',
                      alt: preview_image_alt
                  }}
                {% else %}
                  <img
                    src="{{ 'p10-ip-harry-potter.webp' | asset_url }}"
                    alt="{{ product.title | escape }}"
                    width="260"
                    height="260"
                    loading="eager"
                    decoding="async"
                  >
                {% endif %}
              </a>
            {% endfor %}
          </div>
        {% endif %}
        <div class="p10-ip-hp__crest-copy">
          <span>KAYOU archive</span>
          <strong>Cards &amp; Goods</strong>
          <small>Curated routes for sealed boxes, badges, acrylic goods, and stationery.</small>
        </div>
      </div>
    </div>

    <div class="p10-ip-hp__path-grid" aria-label="Harry Potter shopping paths">
      <a href="{{ collection_url }}">
        <span>Cards</span>
        <strong>Sealed boxes and card products</strong>
      </a>
      <a href="{{ badge_url }}">
        <span>Badges</span>
        <strong>Badge assortment</strong>
      </a>
      <a href="{{ standee_url }}">
        <span>Acrylic</span>
        <strong>Acrylic standees</strong>
      </a>
      <a href="{{ notebook_url }}">
        <span>Stationery</span>
        <strong>Notebook blind packs</strong>
      </a>
    </div>

    <div class="p10-ip-hp__routes" aria-label="Harry Potter product routes">
      <a href="{{ badge_url }}">
        <span>Badge Assortment</span>
        <strong>Character badge shelf</strong>
      </a>
      <a href="{{ guardian_badge_url }}">
        <span>Guardian Oath</span>
        <strong>Badge display shelf</strong>
      </a>
      <a href="{{ badge_url }}">
        <span>Holiday Badge</span>
        <strong>Holiday badge shelf</strong>
      </a>
      <a href="{{ standee_url }}">
        <span>Acrylic Standee</span>
        <strong>Acrylic standee shelf</strong>
      </a>
      <a href="{{ notebook_url }}">
        <span>Notebook Blind Pack</span>
        <strong>Stationery shelf</strong>
      </a>
    </div>

    <div id="harry-potter-product-paths" class="p10-ip-hp__products">
      <div class="p10-ip-hp__products-header">
        <div>
          <p class="p10-ip-hp__eyebrow">Collector shelves</p>
          <h2>Harry Potter arrivals</h2>
        </div>
        <a href="{{ collection_url }}">View all</a>
      </div>

      <div class="p10-ip-hp__filters" aria-label="Product categories">
        <button type="button" class="is-active" data-hp-filter="all" aria-pressed="true">All</button>
        <button type="button" data-hp-filter="cards" aria-pressed="false">Cards</button>
        <button type="button" data-hp-filter="badges" aria-pressed="false">Badges</button>
        <button type="button" data-hp-filter="acrylic" aria-pressed="false">Acrylic</button>
        <button type="button" data-hp-filter="stationery" aria-pressed="false">Stationery</button>
      </div>

      <div class="p10-ip-hp__lane" data-hp-products>
        {% if hp_collection != blank and hp_collection.all_products_count > 0 %}
          {% for product in hp_collection.products limit: 12 %}
            {% liquid
              assign product_image_alt = product.title
              if product.featured_image != blank and product.featured_image.alt != blank
                assign product_image_alt = product.featured_image.alt
              endif

              assign product_keywords = product.title | append: ' ' | append: product.type | downcase
              for tag in product.tags
                assign tag_downcase = tag | downcase
                assign product_keywords = product_keywords | append: ' ' | append: tag_downcase
              endfor

              assign product_filter = 'cards'
              if product_keywords contains 'badge'
                assign product_filter = 'badges'
              elsif product_keywords contains 'standee' or product_keywords contains 'acrylic'
                assign product_filter = 'acrylic'
              elsif product_keywords contains 'notebook' or product_keywords contains 'pen' or product_keywords contains 'stationery'
                assign product_filter = 'stationery'
              endif
            %}
            <article class="p10-ip-hp__tile" data-hp-kind="{{ product_filter }}">
              <a class="p10-ip-hp__tile-image" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
                {% if product.featured_image != blank %}
                  {{
                    product.featured_image
                    | image_url: width: 560
                    | image_tag:
                      loading: 'lazy',
                      widths: '220, 320, 420, 560',
                      sizes: '(min-width: 990px) 19vw, 44vw',
                      alt: product_image_alt,
                      class: 'p10-ip-hp__tile-img'
                  }}
                {% else %}
                  <img
                    src="{{ 'p10-ip-harry-potter.webp' | asset_url }}"
                    alt="{{ product.title | escape }}"
                    width="560"
                    height="560"
                    loading="lazy"
                    decoding="async"
                    class="p10-ip-hp__tile-img"
                  >
                {% endif %}
              </a>
              <div class="p10-ip-hp__tile-body">
                <span>{{ product.vendor | default: 'KAYOU' | escape }}</span>
                <h3>{{ product.title | escape }}</h3>
                <div class="p10-ip-hp__tile-price" aria-label="Lowest price {{ product.price_min | money | strip_html | escape }}">
                  <span>{% if product.price_varies %}From{% else %}Price{% endif %}</span>
                  <strong>{{ product.price_min | money }}</strong>
                </div>
                <div class="p10-ip-hp__tile-meta">
                  <span>{{ product.variants.size }} option{% unless product.variants.size == 1 %}s{% endunless %}</span>
                  <span>{% if product.available %}In stock{% else %}View details{% endif %}</span>
                </div>
              </div>
            </article>
          {% endfor %}
        {% else %}
          <article class="p10-ip-hp__empty">
            <strong>Harry Potter collection connected</strong>
            <span>Products will appear here when the collection is available in this theme preview.</span>
          </article>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .p10-ip-hp {
    --hp-night: #090b12;
    --hp-ink: #17100c;
    --hp-parchment: #f4e6cc;
    --hp-parchment-soft: #fff7e7;
    --hp-gold: #d7b56d;
    --hp-gold-deep: #9e7431;
    --hp-ruby: #5b1822;
    --hp-blue: #111b33;
    --hp-muted: #7a6a57;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 34px 0 84px;
    background:
      linear-gradient(180deg, var(--hp-night) 0 39%, #2a1b17 39%, #f5ebd8 39.1%, #fff8ea 100%);
    color: var(--hp-parchment-soft);
  }

  .p10-ip-hp *,
  .p10-ip-hp *::before,
  .p10-ip-hp *::after {
    box-sizing: border-box;
  }

  .p10-ip-hp::before,
  .p10-ip-hp::after {
    position: absolute;
    inset: 0;
    z-index: 0;
    content: "";
    pointer-events: none;
  }

  .p10-ip-hp::before {
    background:
      linear-gradient(180deg, rgba(215,181,109,0.14) 0 1px, transparent 1px 72px),
      linear-gradient(90deg, rgba(244,230,204,0.05) 0 1px, transparent 1px 92px);
    opacity: 0.95;
    mask-image: linear-gradient(180deg, #000 0 43%, transparent 68%);
  }

  .p10-ip-hp::after {
    background:
      linear-gradient(90deg, rgba(9,11,18,0.96), rgba(9,11,18,0.72) 34%, rgba(91,24,34,0.58) 72%, rgba(9,11,18,0.92)),
      repeating-linear-gradient(0deg, rgba(215,181,109,0.08) 0 2px, transparent 2px 46px);
    height: 760px;
    opacity: 0.86;
    mask-image: linear-gradient(180deg, #000 0 72%, transparent 100%);
  }

  .p10-ip-hp__anchor {
    position: absolute;
    top: 0;
  }

  .p10-ip-hp__atmosphere {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .p10-ip-hp__atmosphere span {
    position: absolute;
    display: block;
  }

  .p10-ip-hp__atmosphere span:nth-child(1) {
    top: 98px;
    left: 7%;
    width: min(42vw, 620px);
    height: 360px;
    border: 1px solid rgba(215,181,109,0.2);
    border-bottom-color: rgba(215,181,109,0.48);
    background:
      repeating-linear-gradient(90deg, rgba(244,230,204,0.08) 0 1px, transparent 1px 42px),
      linear-gradient(180deg, rgba(255,255,255,0.03), transparent);
  }

  .p10-ip-hp__atmosphere span:nth-child(2) {
    top: 134px;
    right: 8%;
    width: min(36vw, 500px);
    height: 420px;
    border: 1px solid rgba(215,181,109,0.18);
    background:
      repeating-linear-gradient(0deg, rgba(215,181,109,0.11) 0 1px, transparent 1px 54px),
      linear-gradient(180deg, rgba(91,24,34,0.22), rgba(17,27,51,0.08));
  }

  .p10-ip-hp__atmosphere span:nth-child(3) {
    top: 214px;
    left: 18%;
    width: 160px;
    height: 1px;
    background: rgba(215,181,109,0.68);
    box-shadow:
      0 82px 0 rgba(215,181,109,0.28),
      0 164px 0 rgba(215,181,109,0.18);
  }

  .p10-ip-hp__atmosphere span:nth-child(4) {
    right: 15%;
    top: 118px;
    width: 92px;
    height: 260px;
    border-top: 2px solid rgba(215,181,109,0.48);
    border-bottom: 2px solid rgba(215,181,109,0.35);
    background: linear-gradient(90deg, transparent, rgba(244,230,204,0.06), transparent);
  }

  .p10-ip-hp__nav,
  .p10-ip-hp__shell {
    position: relative;
    z-index: 2;
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
  }

  .p10-ip-hp__nav {
    display: flex;
    justify-content: flex-start;
    margin-bottom: 20px;
  }

  .p10-ip-hp__back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 36px;
    padding: 0 14px;
    border: 1px solid rgba(215,181,109,0.36);
    border-radius: 6px;
    background: rgba(9,11,18,0.72);
    color: var(--hp-parchment-soft);
    font-size: 12px;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
    box-shadow: 0 14px 38px rgba(0,0,0,0.24);
  }

  .p10-ip-hp__hero {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(390px, 0.86fr);
    align-items: center;
    gap: 56px;
    min-height: 570px;
    padding: 30px 0 66px;
  }

  .p10-ip-hp__copy {
    max-width: 620px;
  }

  .p10-ip-hp__eyebrow {
    margin: 0 0 14px;
    color: var(--hp-gold);
    font-size: 12px;
    font-weight: 900;
    letter-spacing: 0;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .p10-ip-hp__heading {
    margin: 0;
    color: #f7df9a;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: clamp(56px, 8vw, 112px);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 0.9;
    text-shadow: 0 4px 0 rgba(91,24,34,0.42), 0 22px 44px rgba(0,0,0,0.4);
  }

  .p10-ip-hp__subheading {
    max-width: 560px;
    margin: 24px 0 0;
    color: rgba(255,247,231,0.82);
    font-size: 15px;
    line-height: 1.78;
  }

  .p10-ip-hp__read-more {
    display: none;
  }

  .p10-ip-hp__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }

  .p10-ip-hp__primary-link,
  .p10-ip-hp__secondary-link,
  .p10-ip-hp__products-header > a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 42px;
    padding: 0 18px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 900;
    line-height: 1;
    text-decoration: none;
    transition: transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
  }

  .p10-ip-hp__primary-link {
    border: 1px solid rgba(247,223,154,0.5);
    background: linear-gradient(180deg, #f1cc75, #a87a31);
    color: #160e0b;
    box-shadow: 0 16px 32px rgba(0,0,0,0.28);
  }

  .p10-ip-hp__secondary-link {
    border: 1px solid rgba(215,181,109,0.38);
    background: rgba(244,230,204,0.09);
    color: var(--hp-parchment-soft);
  }

  .p10-ip-hp__products-header > a {
    border: 1px solid rgba(91,24,34,0.2);
    background: #fffdf7;
    color: var(--hp-ink);
  }

  .p10-ip-hp__primary-link:hover,
  .p10-ip-hp__secondary-link:hover,
  .p10-ip-hp__products-header > a:hover {
    transform: translateY(-2px);
  }

  .p10-ip-hp__format-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 22px;
  }

  .p10-ip-hp__format-strip span {
    display: inline-flex;
    align-items: center;
    min-height: 30px;
    padding: 0 10px;
    border: 1px solid rgba(215,181,109,0.38);
    border-radius: 999px;
    background: rgba(9,11,18,0.48);
    color: #f9e3a2;
    font-size: 11px;
    font-weight: 900;
    white-space: nowrap;
  }

  .p10-ip-hp__insignia {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 18px;
    padding: 28px 26px 30px;
    border: 1px solid rgba(215,181,109,0.38);
    border-radius: 8px;
    background:
      linear-gradient(180deg, rgba(17,27,51,0.9), rgba(9,11,18,0.92)),
      repeating-linear-gradient(90deg, rgba(244,230,204,0.08) 0 1px, transparent 1px 52px);
    box-shadow: 0 34px 80px rgba(0,0,0,0.38), inset 0 0 0 1px rgba(255,255,255,0.06);
  }

  .p10-ip-hp__insignia::before,
  .p10-ip-hp__insignia::after {
    position: absolute;
    left: 18px;
    right: 18px;
    height: 1px;
    background: rgba(215,181,109,0.38);
    content: "";
  }

  .p10-ip-hp__insignia::before {
    top: 18px;
  }

  .p10-ip-hp__insignia::after {
    bottom: 18px;
  }

  .p10-ip-hp__crest-image {
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(78%, 300px);
    aspect-ratio: 1;
    border: 1px solid rgba(215,181,109,0.3);
    border-radius: 8px;
    background:
      linear-gradient(180deg, rgba(18,27,51,0.96), rgba(10,13,25,0.98)),
      repeating-linear-gradient(0deg, rgba(215,181,109,0.08) 0 1px, transparent 1px 34px);
    box-shadow: inset 0 0 36px rgba(0,0,0,0.42);
  }

  .p10-ip-hp__crest-image img {
    display: block;
    width: 82%;
    height: 82%;
    object-fit: contain;
    filter: drop-shadow(0 18px 28px rgba(0,0,0,0.42));
  }

  .p10-ip-hp__hero-products {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    width: 100%;
  }

  .p10-ip-hp__hero-product {
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1;
    min-width: 0;
    padding: 8px;
    border: 1px solid rgba(215,181,109,0.24);
    border-radius: 7px;
    background:
      linear-gradient(180deg, rgba(255,247,231,0.08), rgba(9,11,18,0.18)),
      radial-gradient(circle at 30% 25%, rgba(215,181,109,0.14), transparent 46%);
    box-shadow: inset 0 0 24px rgba(0,0,0,0.2);
    text-decoration: none;
  }

  .p10-ip-hp__hero-product img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 12px 18px rgba(0,0,0,0.34));
  }

  .p10-ip-hp__crest-copy {
    display: grid;
    justify-items: center;
    gap: 8px;
    text-align: center;
  }

  .p10-ip-hp__crest-copy span {
    color: var(--hp-gold);
    font-size: 11px;
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
  }

  .p10-ip-hp__crest-copy strong {
    color: #fff5da;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 34px;
    font-weight: 900;
    letter-spacing: 0;
    line-height: 1;
  }

  .p10-ip-hp__crest-copy small {
    max-width: 270px;
    color: rgba(255,247,231,0.72);
    font-size: 12px;
    line-height: 1.5;
  }

  .p10-ip-hp__path-grid,
  .p10-ip-hp__routes {
    display: grid;
    gap: 12px;
  }

  .p10-ip-hp__path-grid {
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: -30px;
  }

  .p10-ip-hp__routes {
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-top: 20px;
  }

  .p10-ip-hp__path-grid a,
  .p10-ip-hp__routes a {
    position: relative;
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 8px;
    min-height: 116px;
    padding: 15px;
    border: 1px solid rgba(91,24,34,0.22);
    border-radius: 8px;
    background:
      radial-gradient(circle at 14% 24%, rgba(91,24,34,0.08) 0 1px, transparent 1.6px),
      radial-gradient(circle at 78% 68%, rgba(158,116,49,0.1) 0 1px, transparent 1.7px),
      linear-gradient(180deg, rgba(255,253,247,0.96), rgba(244,230,204,0.94)),
      repeating-linear-gradient(0deg, rgba(158,116,49,0.08) 0 1px, transparent 1px 26px);
    background-size: 31px 31px, 47px 47px, auto, auto;
    color: var(--hp-ink);
    text-decoration: none;
    box-shadow: 0 18px 40px rgba(56,32,18,0.08);
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .p10-ip-hp__path-grid a::before,
  .p10-ip-hp__routes a::before {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 4px;
    border-radius: 8px 8px 0 0;
    background: linear-gradient(90deg, var(--hp-ruby), var(--hp-gold));
    content: "";
  }

  .p10-ip-hp__path-grid a:hover,
  .p10-ip-hp__routes a:hover {
    border-color: rgba(158,116,49,0.5);
