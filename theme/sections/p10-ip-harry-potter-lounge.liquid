    }

    .p10-ip-hp__routes a {
      flex: 0 0 154px;
      min-height: 74px;
      padding: 11px;
      scroll-snap-align: start;
    }

    .p10-ip-hp__path-grid span,
    .p10-ip-hp__routes span {
      font-size: 10px;
    }

    .p10-ip-hp__path-grid strong,
    .p10-ip-hp__routes strong {
      font-size: 12px;
      line-height: 1.28;
    }

    .p10-ip-hp__products {
      margin-top: 28px;
      padding-top: 28px;
    }

    .p10-ip-hp__products-header {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
    }

    .p10-ip-hp__products-header h2 {
      font-size: 26px;
    }

    .p10-ip-hp__filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 2px;
      scrollbar-width: none;
    }

    .p10-ip-hp__filters::-webkit-scrollbar {
      display: none;
    }

    .p10-ip-hp__filters button {
      flex: 0 0 auto;
    }

    .p10-ip-hp__lane {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
  }

  @media (max-width: 480px) {
    .p10-ip-hp {
      background:
        linear-gradient(180deg, var(--hp-night) 0 39%, #f5ebd8 39.1%, #fff8ea 100%);
    }

    .p10-ip-hp__heading {
      font-size: 42px;
    }

    .p10-ip-hp__path-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .p10-ip-hp__path-grid a {
      min-height: 72px;
    }

    .p10-ip-hp__routes a {
      flex-basis: 148px;
      min-height: 72px;
    }

    .p10-ip-hp__tile-body {
      min-height: 158px;
      padding: 11px;
    }

    .p10-ip-hp__tile-body h3 {
      font-size: 11.5px;
      line-height: 1.3;
      min-height: 54px;
      -webkit-line-clamp: 3;
    }

    .p10-ip-hp__tile-meta {
      font-size: 10px;
    }

    .p10-ip-hp__tile-price {
      min-height: 32px;
      padding: 7px 8px;
    }

    .p10-ip-hp__tile-price strong {
      font-size: 15px;
    }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-p10-ip-hp]').forEach((section) => {
    const reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const gsap = window.gsap;
    if (gsap && !reduceMotion) {
      const revealItems = [
        section.querySelector('.p10-ip-hp__eyebrow'),
        section.querySelector('.p10-ip-hp__heading'),
        section.querySelector('.p10-ip-hp__subheading'),
        section.querySelector('.p10-ip-hp__actions'),
        section.querySelector('.p10-ip-hp__format-strip'),
        section.querySelector('.p10-ip-hp__insignia')
      ].filter(Boolean);

      gsap.set(revealItems, { autoAlpha: 0, y: 18 });
      gsap.timeline({ defaults: { duration: 0.54, ease: 'power2.out' } })
        .to(revealItems, { autoAlpha: 1, y: 0, stagger: 0.055 })
        .fromTo(
          section.querySelectorAll('.p10-ip-hp__path-grid a, .p10-ip-hp__routes a'),
          { autoAlpha: 0, y: 16 },
          { autoAlpha: 1, y: 0, duration: 0.34, stagger: 0.025 },
          '-=0.16'
        );
    }

    const buttons = Array.from(section.querySelectorAll('[data-hp-filter]'));
    const tiles = Array.from(section.querySelectorAll('[data-hp-kind]'));
    if (!buttons.length || !tiles.length) return;

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.getAttribute('data-hp-filter') || 'all';
        buttons.forEach((item) => {
          const isActive = item === button;
          item.classList.toggle('is-active', isActive);
          item.setAttribute('aria-pressed', isActive ? 'true' : 'false');
        });
        tiles.forEach((tile) => {
          const kind = tile.getAttribute('data-hp-kind') || 'cards';
          tile.hidden = filter !== 'all' && kind !== filter;
        });
      });
    });
  });
{% endjavascript %}

