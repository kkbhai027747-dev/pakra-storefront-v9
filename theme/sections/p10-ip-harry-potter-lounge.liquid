  @keyframes p10HpDrift {
    0%, 100% { transform: translateY(0) rotate(-7deg); }
    50% { transform: translateY(-7px) rotate(-5deg); }
  }

  @keyframes p10HpDriftCenter {
    0%, 100% { transform: translateY(-20px) rotate(0deg) scale(1.08); }
    50% { transform: translateY(-28px) rotate(1deg) scale(1.08); }
  }

  @keyframes p10HpDriftRight {
    0%, 100% { transform: translateY(6px) rotate(7deg); }
    50% { transform: translateY(-5px) rotate(5deg); }
  }

  @media (prefers-reduced-motion: no-preference) {
    .p10-ip-hp__hero-product:nth-child(1) {
      animation: p10HpDrift 5.8s ease-in-out infinite;
