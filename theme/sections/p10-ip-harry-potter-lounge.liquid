    font-size: 30px;
  }

  .p10-ip-hp__path-grid {
    position: relative;
    z-index: 4;
    margin-top: -58px;
  }

  .p10-ip-hp__path-grid a,
  .p10-ip-hp__routes a {
    border-color: rgba(102,47,23,0.2);
    background:
      radial-gradient(circle at 12% 24%, rgba(93,44,21,0.08) 0 1px, transparent 1.5px),
      radial-gradient(circle at 80% 70%, rgba(158,116,49,0.11) 0 1px, transparent 1.7px),
      linear-gradient(135deg, rgba(255,248,226,0.97), rgba(229,209,169,0.96) 58%, rgba(249,235,204,0.98)),
      repeating-linear-gradient(0deg, rgba(158,116,49,0.075) 0 1px, transparent 1px 24px);
