    justify-content: center;
    gap: 0;
    width: auto;
    pointer-events: auto;
  }

  .p10-ip-hp__hero-product {
    flex: 0 0 31%;
    aspect-ratio: 0.82;
    padding: 10px;
    border-color: rgba(231,191,101,0.34);
