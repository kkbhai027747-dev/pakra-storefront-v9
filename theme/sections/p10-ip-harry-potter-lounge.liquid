    border-radius: 6px;
    background:
      radial-gradient(circle at 50% 36%, rgba(37,53,100,0.98), rgba(13,20,42,0.98) 62%, rgba(6,7,13,1)),
      repeating-linear-gradient(90deg, rgba(231,191,101,0.05) 0 1px, transparent 1px 38px);
