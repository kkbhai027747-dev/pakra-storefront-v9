  .p10-ip-hp__path-grid a {
    min-height: 104px;
  }

  .p10-ip-hp__routes a {
    min-height: 92px;
    padding: 14px;
  }

  .p10-ip-hp__path-grid a::before,
  .p10-ip-hp__routes a::before {
    height: 5px;
    background: linear-gradient(90deg, #1c3158, #e2b95e 52%, #0f1c39);
