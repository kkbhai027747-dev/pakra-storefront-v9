    .p10-ip-hp__hero-product:nth-child(2) {
      animation: p10HpDriftCenter 6.2s ease-in-out infinite;
    }

    .p10-ip-hp__hero-product:nth-child(3) {
      animation: p10HpDriftRight 6.6s ease-in-out infinite;
    }
  }

