      radial-gradient(circle at 10% 18%, rgba(36,56,95,0.07) 0 1px, transparent 1.8px),
      radial-gradient(circle at 82% 24%, rgba(158,116,49,0.12) 0 1.2px, transparent 2px),
      radial-gradient(circle at 38% 74%, rgba(33,50,82,0.075) 0 1px, transparent 1.7px),
      linear-gradient(90deg, transparent 0 8%, rgba(33,50,82,0.045) 8.1% 8.3%, transparent 8.5%),
      repeating-linear-gradient(90deg, rgba(255,255,255,0.18) 0 1px, transparent 1px 78px),
      linear-gradient(180deg, #ead6aa, #fff0cf 42%, #fff5dd 100%),
      repeating-linear-gradient(0deg, rgba(158,116,49,0.07) 0 1px, transparent 1px 42px);
  }

  .p10-ip-hp__tile,
  .p10-ip-hp__empty {
    border-radius: 6px;
    background: rgba(255,250,238,0.96);
    box-shadow: 0 20px 42px rgba(63,38,20,0.12);
