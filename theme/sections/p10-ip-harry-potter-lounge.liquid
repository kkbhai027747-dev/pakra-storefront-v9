    justify-items: start;
    padding: 16px 18px;
    border: 1px solid rgba(231,191,101,0.34);
    background:
      linear-gradient(90deg, rgba(6,7,13,0.9), rgba(16,29,58,0.72)),
      linear-gradient(180deg, rgba(255,242,208,0.08), transparent);
    text-align: left;
    box-shadow: 0 18px 36px rgba(0,0,0,0.28);
