{% liquid
  assign heat_collection = collections['daily-store-heat-top-5']
  assign heat_count = heat_collection.products.size | at_most: 5
%}

{% if section.settings.enabled and heat_collection != blank and heat_count > 0 %}
  <section
    class="p10-daily-store-heat p10-daily-store-heat--count-{{ heat_count }}"
    data-p10-daily-store-heat
    aria-labelledby="P10DailyStoreHeatHeading-{{ section.id }}"
    style="--heat-accent: {{ section.settings.accent | escape }}; --heat-image-fit: {{ section.settings.image_fit | escape }};"
  >
    <div class="p10-daily-store-heat__shell">
      <header class="p10-daily-store-heat__header">
        <div class="p10-daily-store-heat__heading">
          <p class="p10-daily-store-heat__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          <h2 id="P10DailyStoreHeatHeading-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
        </div>
        <p class="p10-daily-store-heat__intro">{{ section.settings.text | escape }}</p>
      </header>

      <ol class="p10-daily-store-heat__ranking">
        {% for product in heat_collection.products limit: 5 %}
          {% liquid
            assign product_label = product.type
            if product_label == blank
              assign product_label = product.vendor
            endif

            assign display_variant = product.selected_or_first_available_variant
            if display_variant == blank
              assign display_variant = product.variants.first
            endif
            assign display_variant_is_minimum = false
            assign product_alt = product.featured_image.alt | default: product.title
            assign image_sizes = '(max-width: 430px) 88px, (min-width: 990px) 116px, 116px'
            if forloop.first
              assign image_sizes = '(min-width: 1320px) 520px, (min-width: 990px) 41vw, 100vw'
            endif
          %}

          {% if product.price_varies %}
            {% for price_variant in product.variants %}
              {% if price_variant.price == product.price_min %}
                {% liquid
                  assign display_variant = price_variant
                  assign display_variant_is_minimum = true
                %}
                {% break %}
              {% endif %}
            {% endfor %}
          {% endif %}

          <li class="p10-daily-store-heat__item{% if forloop.first %} p10-daily-store-heat__item--champion{% endif %}">
            <span class="p10-daily-store-heat__sr-only">Rank {{ forloop.index }}: {{ product.title | escape }}</span>
            <span class="p10-daily-store-heat__rank" aria-hidden="true">{{ forloop.index | prepend: '0' }}</span>

            <a class="p10-daily-store-heat__media" href="{{ product.url }}" aria-label="View product: {{ product.title | escape }}">
              {% if product.featured_image != blank %}
                {{ product.featured_image | image_url: width: 900 | image_tag:
                  loading: 'lazy',
                  widths: '88, 116, 160, 240, 360, 520, 720, 900',
                  sizes: image_sizes,
                  alt: product_alt
                }}
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {% endif %}
            </a>

            <div class="p10-daily-store-heat__body">
              {% if product_label != blank %}
                <p class="p10-daily-store-heat__label">{{ product_label | escape }}</p>
              {% endif %}

              <h3><a href="{{ product.url }}">{{ product.title | escape }}</a></h3>

              <div class="p10-daily-store-heat__meta">
                <div class="p10-daily-store-heat__price">
                  <span>
                  {% if product.price_varies and display_variant_is_minimum %}
                    From {{ display_variant.price | money }}
                  {% else %}
                    {{ display_variant.price | money }}
                  {% endif %}
                  </span>
                  {% if display_variant != blank and display_variant.compare_at_price != blank and display_variant.compare_at_price > display_variant.price %}
                    <s>{{ display_variant.compare_at_price | money }}</s>
                  {% endif %}
                </div>

                {% unless product.available %}
                  <small>Sold out</small>
                {% endunless %}

                <a
                  class="p10-daily-store-heat__action"
                  href="{{ product.url }}"
                  aria-label="View product: {{ product.title | escape }}"
                >
                  View product
                  <span aria-hidden="true">&rarr;</span>
                </a>
              </div>
            </div>
          </li>
        {% endfor %}
      </ol>

      <p class="p10-daily-store-heat__footer">{{ section.settings.footer | escape }}</p>
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .p10-daily-store-heat,
  .p10-daily-store-heat *,
  .p10-daily-store-heat *::before,
  .p10-daily-store-heat *::after {
    box-sizing: border-box;
  }

  .p10-daily-store-heat {
    --heat-ink: #151923;
    --heat-muted: #5d6675;
    --heat-paper: #f3f6fa;
    --heat-surface: #ffffff;
    --heat-line: #cfd9e7;
    --heat-structure: #17698f;
    --heat-focus: #0b4f71;
    --heat-rank: #b61f3e;
    padding-block: 36px;
    padding-inline: 26px;
    background-color: var(--heat-paper);
    background-image:
      linear-gradient(rgba(23, 105, 143, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(23, 105, 143, 0.035) 1px, transparent 1px);
    background-size: 32px 32px;
    color: var(--heat-ink);
    font-family: var(--font-body-family, "Avenir Next", "Trebuchet MS", sans-serif);
  }

  .p10-daily-store-heat__shell {
    width: 100%;
    max-width: 1320px;
    margin: 0 auto;
  }

  .p10-daily-store-heat__header {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 440px);
    gap: 32px;
    align-items: end;
    margin-bottom: 18px;
    padding: 4px 0 22px;
    border-bottom: 2px solid var(--heat-structure);
  }

  .p10-daily-store-heat__header::before {
    position: absolute;
    top: 0;
    left: 0;
    width: 58px;
    height: 3px;
    background: var(--heat-accent);
    content: "";
  }

  .p10-daily-store-heat__eyebrow {
    margin: 0;
    color: var(--heat-rank);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.14em;
    line-height: 1.4;
  }

  .p10-daily-store-heat__header h2 {
    margin: 7px 0 0;
    color: var(--heat-ink);
    font-family: "Iowan Old Style", "Baskerville", "Bodoni 72", serif;
    font-size: clamp(30px, 3.1vw, 50px);
    font-weight: 900;
    letter-spacing: -0.035em;
    line-height: 0.95;
  }

  .p10-daily-store-heat__intro {
    max-width: 42ch;
    margin: 0;
    color: var(--heat-muted);
    font-size: 14px;
    line-height: 1.55;
  }

  .p10-daily-store-heat__ranking {
    display: grid;
    grid-template-columns: minmax(0, 41fr) minmax(0, 59fr);
    grid-template-rows: repeat(4, minmax(88px, auto));
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .p10-daily-store-heat__item {
    position: relative;
    min-width: 0;
    border: 1px solid var(--heat-line);
    border-top: 3px solid var(--heat-structure);
    background: var(--heat-surface);
    box-shadow: 0 8px 22px rgba(19, 32, 48, 0.055);
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease,
      transform 160ms ease;
  }

  .p10-daily-store-heat__item:hover {
    border-color: #9dafc3;
    box-shadow: 0 12px 28px rgba(19, 32, 48, 0.09);
    transform: translateY(-1px);
  }

  .p10-daily-store-heat__item:focus-within {
    box-shadow: 0 0 0 2px var(--heat-focus);
  }

  .p10-daily-store-heat__item:not(.p10-daily-store-heat__item--champion) {
    display: grid;
    grid-column: 2;
    grid-template-columns: 68px 116px minmax(0, 1fr);
    min-height: 88px;
  }

  .p10-daily-store-heat__item--champion {
    display: grid;
    grid-column: 1;
    grid-row: 1 / span 4;
    grid-template-columns: 1fr;
    grid-template-rows: minmax(300px, 1fr) auto;
  }

  .p10-daily-store-heat__rank {
    display: grid;
    min-width: 0;
    place-items: center;
    border-right: 1px solid var(--heat-line);
    color: var(--heat-rank);
    font-family: var(--font-heading-family, "DIN Condensed", "Franklin Gothic Medium", sans-serif);
    font-size: clamp(32px, 4vw, 54px);
    font-weight: 900;
    letter-spacing: -0.06em;
    line-height: 1;
  }

  .p10-daily-store-heat__item--champion .p10-daily-store-heat__rank {
    position: absolute;
    z-index: 2;
    top: 14px;
    left: 14px;
    border: 0;
    color: var(--heat-rank);
    font-size: clamp(64px, 9vw, 124px);
    opacity: 0.18;
    pointer-events: none;
  }

  .p10-daily-store-heat__media {
    display: block;
    min-width: 0;
    min-height: 88px;
    padding: 8px;
    overflow: hidden;
    background:
      linear-gradient(135deg, rgba(23, 105, 143, 0.055), transparent 64%),
      #f8fafe;
  }

  .p10-daily-store-heat__item--champion .p10-daily-store-heat__media {
    min-height: 300px;
    padding: 22px;
  }

  .p10-daily-store-heat__media img,
  .p10-daily-store-heat__media svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: var(--heat-image-fit);
    object-position: center;
    transition: transform 220ms ease;
  }

  .p10-daily-store-heat__item:hover .p10-daily-store-heat__media img {
    transform: scale(1.018);
  }

  .p10-daily-store-heat__body {
    display: flex;
    min-width: 0;
    padding: 11px 14px 12px;
    flex-direction: column;
    justify-content: center;
    overflow-wrap: anywhere;
  }

  .p10-daily-store-heat__item--champion .p10-daily-store-heat__body {
    padding: 18px 20px 20px;
    border-top: 1px solid var(--heat-line);
  }

  .p10-daily-store-heat__label {
    margin: 0 0 3px;
    color: var(--heat-structure);
    font-size: 10px;
    font-weight: 850;
    letter-spacing: 0.09em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .p10-daily-store-heat__body h3 {
    margin: 0;
    color: var(--heat-ink);
    font-size: 15px;
    font-weight: 800;
    line-height: 1.25;
  }

  .p10-daily-store-heat__item--champion .p10-daily-store-heat__body h3 {
    font-size: clamp(19px, 2vw, 28px);
    line-height: 1.12;
  }

  .p10-daily-store-heat__body h3 a {
    display: -webkit-box;
    min-height: 44px;
    overflow: hidden;
    color: inherit;
    text-decoration: none;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .p10-daily-store-heat__meta {
    display: flex;
    margin-top: 7px;
    flex-wrap: wrap;
    gap: 6px 14px;
    align-items: center;
  }

  .p10-daily-store-heat__price {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: baseline;
    color: var(--heat-ink);
    font-size: 14px;
    font-weight: 850;
  }

  .p10-daily-store-heat__price s {
    color: #697586;
    font-size: 12px;
    font-weight: 500;
  }

  .p10-daily-store-heat__meta small {
    color: var(--heat-rank);
    font-size: 10px;
    font-weight: 850;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .p10-daily-store-heat__meta > a {
    display: inline-flex;
    min-height: 44px;
    margin-left: auto;
    padding-inline: 11px;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
    border: 1px solid var(--heat-line);
    color: var(--heat-ink);
    font-size: 11px;
    font-weight: 850;
    letter-spacing: 0.035em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .p10-daily-store-heat__meta > a:hover {
    border-color: var(--heat-structure);
    background: #edf5f9;
  }

  .p10-daily-store-heat__item a:focus-visible {
    outline: 3px solid var(--heat-focus);
    outline-offset: -3px;
  }

  .p10-daily-store-heat__footer {
    position: relative;
    margin: 16px 0 0;
    padding-left: 18px;
    color: var(--heat-muted);
    font-size: 12px;
    line-height: 1.5;
  }

  .p10-daily-store-heat__footer::before {
    position: absolute;
    top: 0.7em;
    left: 0;
    width: 10px;
    height: 2px;
    background: var(--heat-accent);
    content: "";
  }

  .p10-daily-store-heat--count-1 .p10-daily-store-heat__ranking {
    grid-template-columns: 1fr;
    grid-template-rows: auto;
  }

  .p10-daily-store-heat--count-1 .p10-daily-store-heat__item--champion {
    grid-row: auto;
  }

  .p10-daily-store-heat--count-2 .p10-daily-store-heat__ranking {
    grid-template-rows: minmax(160px, auto);
  }

  .p10-daily-store-heat--count-2 .p10-daily-store-heat__item--champion {
    grid-row: 1 / span 1;
  }

  .p10-daily-store-heat--count-3 .p10-daily-store-heat__ranking {
    grid-template-rows: repeat(2, minmax(110px, auto));
  }

  .p10-daily-store-heat--count-3 .p10-daily-store-heat__item--champion {
    grid-row: 1 / span 2;
  }

  .p10-daily-store-heat--count-4 .p10-daily-store-heat__ranking {
    grid-template-rows: repeat(3, minmax(96px, auto));
  }

  .p10-daily-store-heat--count-4 .p10-daily-store-heat__item--champion {
    grid-row: 1 / span 3;
  }

  .p10-daily-store-heat--count-5 .p10-daily-store-heat__ranking {
    grid-template-rows: repeat(4, minmax(88px, auto));
  }

  .p10-daily-store-heat--count-5 .p10-daily-store-heat__item--champion {
    grid-row: 1 / span 4;
  }

  .p10-daily-store-heat__sr-only {
    position: absolute !important;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 989px) {
    .p10-daily-store-heat__header {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .p10-daily-store-heat__ranking,
    .p10-daily-store-heat--count-1 .p10-daily-store-heat__ranking,
    .p10-daily-store-heat--count-2 .p10-daily-store-heat__ranking,
    .p10-daily-store-heat--count-3 .p10-daily-store-heat__ranking,
    .p10-daily-store-heat--count-4 .p10-daily-store-heat__ranking,
    .p10-daily-store-heat--count-5 .p10-daily-store-heat__ranking {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }

    .p10-daily-store-heat .p10-daily-store-heat__item {
      grid-column: auto;
      grid-row: auto;
    }
  }

  @media (max-width: 430px) {
    .p10-daily-store-heat {
      padding-block: 28px;
      padding-inline: 14px;
    }

    .p10-daily-store-heat__header {
      margin-bottom: 12px;
      padding-bottom: 16px;
    }

    .p10-daily-store-heat__header h2 {
      font-size: clamp(28px, 10vw, 38px);
    }

    .p10-daily-store-heat__item:not(.p10-daily-store-heat__item--champion) {
      grid-template-columns: 48px 88px minmax(0, 1fr);
      min-height: 74px;
    }

    .p10-daily-store-heat__item--champion {
      grid-template-rows: minmax(250px, auto) auto;
    }

    .p10-daily-store-heat__item--champion .p10-daily-store-heat__media {
      min-height: 250px;
      padding: 14px;
    }

    .p10-daily-store-heat__rank {
      font-size: 30px;
    }

    .p10-daily-store-heat__body {
      padding: 9px 10px 10px;
    }

    .p10-daily-store-heat__item--champion .p10-daily-store-heat__body {
      padding: 15px 14px 16px;
    }

    .p10-daily-store-heat__meta > a {
      width: 100%;
      margin-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .p10-daily-store-heat *,
    .p10-daily-store-heat *::before,
    .p10-daily-store-heat *::after {
      animation: none !important;
      transition: none !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "P10 daily store heat",
  "tag": "section",
  "class": "section-p10-daily-store-heat",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show section",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "pakracards · DAILY RANKING"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "COLLECTOR HEAT / TOP 5"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Rolling 60-day ranking. Refreshed daily."
    },
    {
      "type": "text",
      "id": "footer",
      "label": "Footer",
      "default": "Ranked from recent store demand."
    },
    {
      "type": "color",
      "id": "accent",
      "label": "Accent",
      "default": "#f43f68"
    },
    {
      "type": "select",
      "id": "image_fit",
      "label": "Image fit",
      "default": "contain",
      "options": [
        {
          "value": "contain",
          "label": "Contain"
        },
        {
          "value": "cover",
          "label": "Cover"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "P10 daily store heat"
    }
  ]
}
{% endschema %}
