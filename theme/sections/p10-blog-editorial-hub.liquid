          "label": "Small label",
          "default": "01 · Product"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Product & Release Guides"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "New releases, product lines, and series-level collector guidance."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Category link"
        },
        {
          "type": "text",
          "id": "chapter_1",
          "label": "Chapter 1 label"
        },
        {
          "type": "url",
          "id": "chapter_1_link",
          "label": "Chapter 1 link"
        },
        {
          "type": "text",
          "id": "chapter_2",
          "label": "Chapter 2 label"
        },
        {
          "type": "url",
          "id": "chapter_2_link",
          "label": "Chapter 2 link"
        },
        {
          "type": "text",
          "id": "chapter_3",
          "label": "Chapter 3 label"
        },
        {
          "type": "url",
          "id": "chapter_3_link",
          "label": "Chapter 3 link"
        },
        {
          "type": "text",
          "id": "chapter_4",
          "label": "Chapter 4 label"
        },
        {
          "type": "url",
          "id": "chapter_4_link",
          "label": "Chapter 4 link"
        },
        {
          "type": "select",
          "id": "accent",
          "label": "Accent",
          "default": "coral",
          "options": [
            {
              "value": "coral",
              "label": "Coral"
            },
            {
              "value": "blue",
              "label": "Blue"
            },
            {
              "value": "mint",
              "label": "Mint"
            },
            {
              "value": "gold",
              "label": "Gold"
            }
          ]
        }
      ]
    },
    {
      "type": "filter_link",
      "name": "Research filter link",
      "settings": [
        {
          "type": "select",
          "id": "group",
          "label": "Group",
          "default": "category",
          "options": [
            {
              "value": "category",
              "label": "Category"
            },
            {
              "value": "series",
              "label": "Series"
            },
            {
              "value": "year",
              "label": "Year"
            }
          ]
