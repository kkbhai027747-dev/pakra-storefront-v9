          "value": "auto",
          "label": "Use article tag / BLOG-01 fallback"
        },
        {
          "value": "BLOG-01",
          "label": "BLOG-01 · Clean Feature"
        },
        {
          "value": "BLOG-02",
          "label": "BLOG-02 · Compact Split"
        },
        {
          "value": "BLOG-03",
          "label": "BLOG-03 · Caption Bridge"
        },
        {
          "value": "BLOG-04",
          "label": "BLOG-04 · Editorial Lead"
        },
        {
          "value": "BLOG-05",
          "label": "BLOG-05 · Side-by-Side Proof"
        },
        {
          "value": "BLOG-06",
