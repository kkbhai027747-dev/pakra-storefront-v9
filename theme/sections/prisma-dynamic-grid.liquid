{%- liquid
  assign layout_style = section.settings.layout_style | default: 'standard'
-%}

<style>
  .prisma-category-guide {
    --prisma-ink: #15151d;
    --prisma-muted: #5f6371;
    --prisma-line: rgba(21, 21, 29, 0.1);
    --prisma-panel: #ffffff;
    background: linear-gradient(180deg, #faf7f9 0%, #ffffff 48%, #f4fbf8 100%);
    border-block: 1px solid rgba(21, 21, 29, 0.08);
    color: var(--prisma-ink);
  }

  .prisma-category-guide__inner { width: min(1360px, calc(100% - 40px)); margin: 0 auto; padding: clamp(34px, 4.8vw, 62px) 0; }
  .prisma-category-guide__head { display: grid; grid-template-columns: minmax(0, 1fr) minmax(300px, 460px); align-items: end; gap: clamp(18px, 4vw, 54px); margin-bottom: clamp(18px, 2.8vw, 30px); }
  .prisma-category-guide__eyebrow { margin: 0 0 8px; color: #b9872f; font-size: 11px; font-weight: 950; line-height: 1; letter-spacing: 0.12em; text-transform: uppercase; }
  .prisma-category-guide h2 { margin: 0; color: var(--prisma-ink); font-size: clamp(30px, 3.2vw, 48px); font-weight: 950; line-height: 1; letter-spacing: 0; }
  .prisma-category-guide__text { margin: 0; padding-left: 18px; border-left: 2px solid rgba(185, 135, 47, 0.55); color: var(--prisma-muted); font-size: 14px; line-height: 1.55; }

  .prisma-path-carousel { display: grid; gap: 15px; }
  .prisma-rotation-tabs { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; justify-content: flex-start; }
  .prisma-rotation-tab { position: relative; display: inline-grid; min-height: 34px; min-width: 132px; align-items: center; overflow: hidden; border: 1px solid rgba(21, 21, 29, 0.1); border-radius: 7px; padding: 0 11px 3px; background: rgba(255, 255, 255, 0.78); color: var(--prisma-muted); cursor: pointer; font: inherit; text-align: left; box-shadow: 0 8px 24px rgba(28, 31, 42, 0.04); transition: border-color 0.2s ease, color 0.2s ease, background 0.2s ease; }
  .prisma-rotation-tab[aria-selected="true"] { border-color: var(--tab-accent, #d6a84f); background: #ffffff; color: var(--prisma-ink); }
  .prisma-rotation-tab__label { color: inherit; font-size: 11px; font-weight: 950; line-height: 1; letter-spacing: 0.06em; text-transform: uppercase; white-space: nowrap; }
  .prisma-rotation-tab__bar { position: absolute; inset: auto 8px 5px; height: 2px; overflow: hidden; border-radius: 999px; background: rgba(21, 21, 29, 0.08); }
  .prisma-rotation-tab__bar span { display: block; width: 100%; height: 100%; transform: scaleX(0); transform-origin: left center; background: var(--tab-accent, #d6a84f); }
  .prisma-rotation-tab[aria-selected="true"] .prisma-rotation-tab__bar span { animation: prisma-tab-progress 7s linear forwards; }
  [data-prisma-paused="true"] .prisma-rotation-tab[aria-selected="true"] .prisma-rotation-tab__bar span { animation-play-state: paused; }

  .prisma-path-carousel__stage { display: grid; }
  .prisma-path-slide { grid-area: 1 / 1; opacity: 0; visibility: hidden; transform: translateY(12px); pointer-events: none; transition: opacity 0.58s cubic-bezier(0.22, 1, 0.36, 1), transform 0.58s cubic-bezier(0.22, 1, 0.36, 1), visibility 0s linear 0.58s; }
  .prisma-path-slide.is-active { opacity: 1; visibility: visible; transform: translateY(0); pointer-events: auto; transition-delay: 0s; }

  .prisma-path-hub { display: grid; grid-template-columns: minmax(280px, 0.72fr) minmax(0, 2fr); gap: 16px; align-items: stretch; }
  .prisma-path-feature { position: relative; display: flex; min-height: 420px; flex-direction: column; justify-content: space-between; overflow: hidden; border-radius: 8px; padding: clamp(20px, 2.4vw, 28px); background: linear-gradient(135deg, rgba(255, 255, 255, 0.08) 0 1px, transparent 1px 18px), #11131a; color: #ffffff; box-shadow: 0 24px 54px rgba(17, 19, 26, 0.18); }
  .prisma-path-feature::after { content: ""; position: absolute; right: 22px; bottom: 22px; width: 96px; height: 2px; background: linear-gradient(90deg, #d6a84f, #68b9ac, #d96d8d); }
  .prisma-path-feature__eyebrow { color: #d6a84f; font-size: 11px; font-weight: 950; line-height: 1; letter-spacing: 0.12em; text-transform: uppercase; }
  .prisma-path-feature h3 { max-width: 320px; margin: 18px 0 0; color: #ffffff; font-size: clamp(24px, 2.35vw, 34px); font-weight: 950; line-height: 1.04; letter-spacing: 0; }
  .prisma-path-feature p { max-width: 340px; margin: 14px 0 0; color: rgba(255, 255, 255, 0.75); font-size: 14px; font-weight: 650; line-height: 1.55; }
  .prisma-path-feature__chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 28px; padding-right: 84px; }
  .prisma-path-feature__chips span { display: inline-flex; min-height: 28px; align-items: center; border: 1px solid rgba(255, 255, 255, 0.18); border-radius: 6px; padding: 0 9px; background: rgba(255, 255, 255, 0.08); color: rgba(255, 255, 255, 0.9); font-size: 11px; font-weight: 850; line-height: 1; }

  .prisma-dynamic-grid { counter-reset: prisma-path; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; }
  .prisma-category-guide--standard .prisma-dynamic-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; }

  .prisma-grid-item { --path-accent: #d6a84f; --path-tint: #fff7e4; counter-increment: prisma-path; position: relative; display: grid; grid-template-rows: auto 1fr auto; gap: 13px; min-width: 0; min-height: 203px; padding: 16px 16px 15px; overflow: hidden; border: 1px solid var(--prisma-line); border-radius: 8px; background: var(--prisma-panel); color: inherit; text-decoration: none; box-shadow: 0 16px 34px rgba(28, 31, 42, 0.07); transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease; }
  .prisma-grid-item:nth-child(2) { --path-accent: #d96d8d; --path-tint: #fff1f5; }
  .prisma-grid-item:nth-child(3) { --path-accent: #2f8e89; --path-tint: #ebfbf8; }
  .prisma-grid-item:nth-child(4) { --path-accent: #746bd3; --path-tint: #f2f1ff; }
  .prisma-grid-item:nth-child(5) { --path-accent: #df7838; --path-tint: #fff3ea; }
  .prisma-grid-item:nth-child(6) { --path-accent: #456fb3; --path-tint: #eef5ff; }
  .prisma-grid-item::before { content: ""; position: absolute; inset: 0 auto 0 0; width: 3px; background: var(--path-accent); }
  .prisma-grid-item:hover { border-color: var(--path-accent); transform: translateY(-2px); box-shadow: 0 20px 42px rgba(28, 31, 42, 0.11); }

  .prisma-path-map { display: grid; gap: 9px; min-height: 58px; padding: 0 0 13px 3px; border-bottom: 1px solid rgba(25, 28, 38, 0.08); }
  .prisma-path-map__top { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
  .prisma-path-number { color: var(--path-accent); font-size: 11px; font-weight: 950; line-height: 1; letter-spacing: 0.08em; }
  .prisma-path-label { color: var(--path-accent); font-size: 10px; font-weight: 950; line-height: 1; letter-spacing: 0.12em; text-transform: uppercase; }
  .prisma-path-signal { display: inline-flex; width: fit-content; max-width: 100%; padding: 6px 8px; border: 1px solid rgba(25, 28, 38, 0.08); border-radius: 6px; background: var(--path-tint); color: var(--prisma-ink); font-size: 11px; font-weight: 900; line-height: 1; white-space: nowrap; }

  .prisma-img-wrapper { display: grid; place-items: center; width: 100%; height: 160px; padding: 12px 18px; border: 1px solid rgba(25, 28, 38, 0.07); border-radius: 8px; overflow: hidden; background: linear-gradient(145deg, var(--path-tint), rgba(255, 255, 255, 0.96)), #ffffff; position: relative; }
  .prisma-img-wrapper img { display: block; width: auto; height: auto; max-width: 100%; max-height: 100%; object-fit: contain; filter: drop-shadow(0 8px 14px rgba(17, 17, 17, 0.1)); }
  .prisma-grid-copy { display: grid; gap: 0; min-width: 0; }
  .prisma-grid-title { display: block; min-height: 38px; color: var(--prisma-ink); font-size: 16px; font-weight: 950; line-height: 1.14; letter-spacing: 0; }
  .prisma-grid-kicker { display: none; }
  .prisma-grid-desc { display: -webkit-box; min-height: 50px; margin-top: 8px; overflow: hidden; color: var(--prisma-muted); font-size: 12px; font-weight: 700; line-height: 1.4; -webkit-box-orient: vertical; -webkit-line-clamp: 3; }
  .prisma-grid-action { display: inline-flex; align-items: center; align-self: end; gap: 7px; color: var(--prisma-ink); font-size: 11px; font-weight: 950; line-height: 1; text-transform: uppercase; }
  .prisma-grid-action::after { content: ">"; color: var(--path-accent); font-size: 13px; line-height: 1; transform: translateY(-1px); }
  .prisma-placeholder { display: flex; align-items: center; justify-content: center; width: 100%; height: 100%; color: var(--prisma-ink); font-size: 18px; font-weight: 950; line-height: 1; text-transform: uppercase; }

  @keyframes prisma-tab-progress { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @media screen and (min-width: 1100px) { .prisma-category-guide:not(.prisma-category-guide--standard) .prisma-dynamic-grid { grid-template-columns: repeat(6, minmax(0, 1fr)); } }
  @media screen and (max-width: 1080px) { .prisma-path-hub { grid-template-columns: 1fr; } .prisma-path-feature { min-height: 280px; } }
  @media screen and (max-width: 989px) { .prisma-category-guide__head { align-items: start; grid-template-columns: 1fr; gap: 8px; } .prisma-category-guide__text { max-width: 680px; } }
  @media screen and (max-width: 767px) { .prisma-category-guide__inner { width: min(100% - 22px, 620px); padding: 24px 0 32px; } .prisma-rotation-tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 7px; } .prisma-rotation-tab { min-width: 0; min-height: 36px; padding-inline: 8px; } .prisma-rotation-tab__label { font-size: 8.5px; letter-spacing: 0.02em; } .prisma-category-guide--standard .prisma-dynamic-grid { display: flex; grid-template-columns: none; gap: 10px; overflow-x: auto; padding: 1px 1px 3px; scrollbar-width: none; } .prisma-category-guide--standard .prisma-dynamic-grid::-webkit-scrollbar { display: none; } .prisma-grid-item { flex: 0 0 236px; min-height: 198px; padding: 14px; } .prisma-path-map { min-height: 54px; } .prisma-img-wrapper { height: 140px; padding-inline: 16px; } .prisma-path-feature { min-height: 240px; padding: 18px; } .prisma-path-feature__chips { padding-right: 0; } }
  @media (prefers-reduced-motion: reduce) { .prisma-path-slide, .prisma-grid-item, .prisma-rotation-tab { transition: none; } .prisma-rotation-tab__bar span { animation: none !important; } }
</style>
{%- if layout_style == 'database' -%}
  {{ 'p10-database.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'gsap.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'p10-database.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

<section class="prisma-category-guide prisma-category-guide--{{ layout_style }}" aria-label="Shop by collectible category" data-p10-context-section>
  <div class="prisma-category-guide__inner">
    {%- if layout_style == 'database' -%}
      <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "ItemList",
        "name": {{ section.settings.heading | default: 'KAYOU MLP card database' | json }},
        "itemListElement": [
          {%- for block in section.blocks -%}
            {
              "@type": "ListItem",
              "position": {{ forloop.index }},
              "name": {{ block.settings.title | json }},
              "url": {{ block.settings.collection_link | json }}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      }
      </script>
    {%- endif -%}
    <div class="prisma-category-guide__head">
      <div>
        {% if section.settings.eyebrow != blank %}
          <p class="prisma-category-guide__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2>{{ section.settings.heading | escape }}</h2>
        {% endif %}
      </div>
      {% if section.settings.text != blank %}
        <p class="prisma-category-guide__text">{{ section.settings.text | escape }}</p>
      {% endif %}
    </div>
    {%- if layout_style != 'database' -%}
      <div class="prisma-path-carousel" data-prisma-rotator>
        <div class="prisma-rotation-tabs" role="tablist" aria-label="Rotating Prisma category shelves">
          <button class="prisma-rotation-tab" style="--tab-accent: #d6a84f;" type="button" role="tab" aria-selected="true" aria-controls="prisma-slide-paths-{{ section.id }}" data-prisma-slide-trigger="0">
            <span class="prisma-rotation-tab__label">Collector paths</span>
            <span class="prisma-rotation-tab__bar" aria-hidden="true"><span></span></span>
          </button>
          <button class="prisma-rotation-tab" style="--tab-accent: #746bd3;" type="button" role="tab" aria-selected="false" aria-controls="prisma-slide-ip-{{ section.id }}" data-prisma-slide-trigger="1">
            <span class="prisma-rotation-tab__label">IP worlds</span>
            <span class="prisma-rotation-tab__bar" aria-hidden="true"><span></span></span>
          </button>
          <button class="prisma-rotation-tab" style="--tab-accent: #2f8e89;" type="button" role="tab" aria-selected="false" aria-controls="prisma-slide-tcg-{{ section.id }}" data-prisma-slide-trigger="2">
            <span class="prisma-rotation-tab__label">English & TCG</span>
            <span class="prisma-rotation-tab__bar" aria-hidden="true"><span></span></span>
          </button>
        </div>
        <div class="prisma-path-carousel__stage">
          <article class="prisma-path-slide is-active" id="prisma-slide-paths-{{ section.id }}" role="tabpanel" data-prisma-slide>
            <div class="prisma-path-hub">
              <aside class="prisma-path-feature" aria-label="Collector buying map">
                <div>
                  <span class="prisma-path-feature__eyebrow">Collector buying map</span>
                  <h3>Start from the reason you are shopping</h3>
                  <p>Find the right shelf for new releases, single-card finds, sealed boxes, gifts, and anime card ranges.</p>
                </div>
                <div class="prisma-path-feature__chips" aria-label="Popular shopping intents">
                  <span>New waves</span>
                  <span>Exact cards</span>
                  <span>Sealed boxes</span>
                  <span>Giftable merch</span>
                </div>
              </aside>
              <div class="prisma-dynamic-grid">
                {% for block in section.blocks %}
                  {%- liquid
                    assign featured_product = block.settings.featured_product
                    assign recommendation_collection = block.settings.collection
                    assign has_recommendation_context = false

                    if recommendation_collection != blank and recommendation_collection.products.size > 0
                      assign has_recommendation_context = true
                    elsif featured_product != blank
                      assign has_recommendation_context = true
                    endif

                    assign path_number = forloop.index
                    if forloop.index < 10
                      assign path_number = forloop.index | prepend: '0'
                    endif

                    assign intent_label = 'Buying route'
                    if block.settings.title contains 'MLP'
                      assign intent_label = 'Latest waves'
                    elsif block.settings.title contains 'Single'
                      assign intent_label = 'Exact card hunt'
                    elsif block.settings.title contains 'Boxes'
                      assign intent_label = 'Sealed opening'
                    elsif block.settings.title contains 'Plush'
                      assign intent_label = 'Gifts & display'
                    elsif block.settings.title contains 'Naruto'
                      assign intent_label = 'Anime range'
                    elsif block.settings.title contains 'Harry'
                      assign intent_label = 'Wizarding range'
                    endif
                  -%}
                  <a
                    href="{{ block.settings.collection_link }}"
                    class="prisma-grid-item"
                    {% if has_recommendation_context %}data-p10-context-button="{{ block.id }}" data-p10-context-label="{{ block.settings.title | escape }}"{% endif %}
                    {{ block.shopify_attributes }}
                  >
                    <span class="prisma-path-map" aria-hidden="true">
                      <span class="prisma-path-map__top">
                        <span class="prisma-path-number">{{ path_number }}</span>
                        {% if block.settings.kicker != blank %}
                          <span class="prisma-path-label">{{ block.settings.kicker | escape }}</span>
                        {% endif %}
                      </span>
                      <span class="prisma-path-signal">{{ intent_label | escape }}</span>
                    </span>
                    <span class="prisma-grid-copy">
                      <span class="prisma-grid-title">{{ block.settings.title | escape }}</span>
                      {% if block.settings.description != blank %}
                        <span class="prisma-grid-desc">{{ block.settings.description | escape }}</span>
                      {% endif %}
                    </span>
                    <span class="prisma-grid-action">Open path</span>
                  </a>
                {% endfor %}
              </div>
            </div>
          </article>

          <article class="prisma-path-slide" id="prisma-slide-ip-{{ section.id }}" role="tabpanel" data-prisma-slide aria-hidden="true">
            <div class="prisma-path-hub">
              <aside class="prisma-path-feature" aria-label="IP world spotlight">
                <div>
                  <span class="prisma-path-feature__eyebrow">IP world spotlight</span>
                  <h3>Give every universe a doorway</h3>
                  <p>Browse more character worlds from My Little Pony and Naruto to Harry Potter, Powerpuff Girls, Inuyasha, and collectible goods.</p>
                </div>
                <div class="prisma-path-feature__chips" aria-label="Featured IP shelves">
                  <span>MLP</span>
                  <span>Naruto</span>
                  <span>Harry Potter</span>
                  <span>Anime IP</span>
                </div>
              </aside>
              <div class="prisma-dynamic-grid">
                <a href="/collections/ip-my-little-pony" class="prisma-grid-item">
                  <span class="prisma-path-map" aria-hidden="true"><span class="prisma-path-map__top"><span class="prisma-path-number">01</span><span class="prisma-path-label">KAYOU MLP</span></span><span class="prisma-path-signal">Latest IP</span></span>
                  <span class="prisma-grid-copy"><span class="prisma-grid-title">My Little Pony cards</span><span class="prisma-grid-desc">Current KAYOU MLP releases, card boxes, and collector goods</span></span>
                  <span class="prisma-grid-action">Open IP</span>
                </a>
                <a href="/collections/ip-naruto" class="prisma-grid-item">
                  <span class="prisma-path-map" aria-hidden="true"><span class="prisma-path-map__top"><span class="prisma-path-number">02</span><span class="prisma-path-label">Anime cards</span></span><span class="prisma-path-signal">Anime range</span></span>
                  <span class="prisma-grid-copy"><span class="prisma-grid-title">Naruto card range</span><span class="prisma-grid-desc">KAYOU Naruto boxes and anime card listings</span></span>
                  <span class="prisma-grid-action">Open IP</span>
                </a>
                <a href="/collections/harry-potter" class="prisma-grid-item">
                  <span class="prisma-path-map" aria-hidden="true"><span class="prisma-path-map__top"><span class="prisma-path-number">03</span><span class="prisma-path-label">Wizarding cards</span></span><span class="prisma-path-signal">Wizarding IP</span></span>
                  <span class="prisma-grid-copy"><span class="prisma-grid-title">Harry Potter range</span><span class="prisma-grid-desc">Wizarding card boxes and collector listings</span></span>
                  <span class="prisma-grid-action">Open IP</span>
                </a>
                <a href="/collections/the-powerpuff-girls" class="prisma-grid-item">
                  <span class="prisma-path-map" aria-hidden="true"><span class="prisma-path-map__top"><span class="prisma-path-number">04</span><span class="prisma-path-label">Cartoon IP</span></span><span class="prisma-path-signal">Extra shelf</span></span>
                  <span class="prisma-grid-copy"><span class="prisma-grid-title">Powerpuff Girls cards</span><span class="prisma-grid-desc">A dedicated entrance for the Powerpuff Girls collection</span></span>
                  <span class="prisma-grid-action">Open IP</span>
                </a>
                <a href="/collections/inuyasha" class="prisma-grid-item">
                  <span class="prisma-path-map" aria-hidden="true"><span class="prisma-path-map__top"><span class="prisma-path-number">05</span><span class="prisma-path-label">Classic anime</span></span><span class="prisma-path-signal">Anime IP</span></span>
                  <span class="prisma-grid-copy"><span class="prisma-grid-title">Inuyasha cards</span><span class="prisma-grid-desc">Classic anime listings get a visible homepage path</span></span>
                  <span class="prisma-grid-action">Open IP</span>
                </a>
                <a href="/collections/type-merchandise" class="prisma-grid-item">
                  <span class="prisma-path-map" aria-hidden="true"><span class="prisma-path-map__top"><span class="prisma-path-number">06</span><span class="prisma-path-label">Character goods</span></span><span class="prisma-path-signal">Merch shelf</span></span>
                  <span class="prisma-grid-copy"><span class="prisma-grid-title">Plush & IP merch</span><span class="prisma-grid-desc">Plush blind boxes, charms, gifts, and display goods</span></span>
                  <span class="prisma-grid-action">Open IP</span>
                </a>
              </div>
            </div>
          </article>

          <article class="prisma-path-slide" id="prisma-slide-tcg-{{ section.id }}" role="tabpanel" data-prisma-slide aria-hidden="true">
            <div class="prisma-path-hub">
              <aside class="prisma-path-feature" aria-label="English and TCG shelf">
                <div>
                  <span class="prisma-path-feature__eyebrow">English / TCG shelf</span>
                  <h3>Surface the sections collectors ask for</h3>
                  <p>Explore English-version boxes, Chinese releases, playable TCG products, SEA / English TCG, and collector guide content.</p>
                </div>
                <div class="prisma-path-feature__chips" aria-label="English and TCG shelves">
                  <span>English cards</span>
                  <span>TCG cards</span>
                  <span>CN cards</span>
                  <span>Database</span>
                </div>
              </aside>
              <div class="prisma-dynamic-grid">
                <a href="/collections/type-sealed-cards" class="prisma-grid-item">
                  <span class="prisma-path-map" aria-hidden="true"><span class="prisma-path-map__top"><span class="prisma-path-number">01</span><span class="prisma-path-label">English cards</span></span><span class="prisma-path-signal">English version</span></span>
                  <span class="prisma-grid-copy"><span class="prisma-grid-title">English card boxes</span><span class="prisma-grid-desc">SEA and English-version card boxes for language-led browsing</span></span>
                  <span class="prisma-grid-action">Open shelf</span>
                </a>
                <a href="/collections/type-sealed-cards" class="prisma-grid-item">
                  <span class="prisma-path-map" aria-hidden="true"><span class="prisma-path-map__top"><span class="prisma-path-number">02</span><span class="prisma-path-label">Chinese cards</span></span><span class="prisma-path-signal">CN releases</span></span>
                  <span class="prisma-grid-copy"><span class="prisma-grid-title">Chinese card boxes</span><span class="prisma-grid-desc">CN card releases, boxes, and sealed card products</span></span>
                  <span class="prisma-grid-action">Open shelf</span>
                </a>
                <a href="/collections/type-sealed-cards" class="prisma-grid-item">
                  <span class="prisma-path-map" aria-hidden="true"><span class="prisma-path-map__top"><span class="prisma-path-number">03</span><span class="prisma-path-label">TCG cards</span></span><span class="prisma-path-signal">Playable TCG</span></span>
                  <span class="prisma-grid-copy"><span class="prisma-grid-title">TCG card boxes</span><span class="prisma-grid-desc">Trading card game boxes and starter-friendly products</span></span>
                  <span class="prisma-grid-action">Open shelf</span>
                </a>
                <a href="/collections/type-sealed-cards" class="prisma-grid-item">
                  <span class="prisma-path-map" aria-hidden="true"><span class="prisma-path-map__top"><span class="prisma-path-number">04</span><span class="prisma-path-label">CN TCG</span></span><span class="prisma-path-signal">Game cards</span></span>
                  <span class="prisma-grid-copy"><span class="prisma-grid-title">CN TCG cards</span><span class="prisma-grid-desc">Chinese TCG card boxes and game-focused releases</span></span>
                  <span class="prisma-grid-action">Open shelf</span>
                </a>
                <a href="/collections/type-sealed-cards" class="prisma-grid-item">
                  <span class="prisma-path-map" aria-hidden="true"><span class="prisma-path-map__top"><span class="prisma-path-number">05</span><span class="prisma-path-label">SEA TCG</span></span><span class="prisma-path-signal">English TCG</span></span>
                  <span class="prisma-grid-copy"><span class="prisma-grid-title">SEA / English TCG</span><span class="prisma-grid-desc">SEA and English TCG cards with a direct buying path</span></span>
                  <span class="prisma-grid-action">Open shelf</span>
                </a>
                <a href="/blogs/tcg-database" class="prisma-grid-item">
                  <span class="prisma-path-map" aria-hidden="true"><span class="prisma-path-map__top"><span class="prisma-path-number">06</span><span class="prisma-path-label">Research hub</span></span><span class="prisma-path-signal">TCG database</span></span>
                  <span class="prisma-grid-copy"><span class="prisma-grid-title">TCG database</span><span class="prisma-grid-desc">Collector guides, release notes, and card database content</span></span>
                  <span class="prisma-grid-action">Open guide</span>
                </a>
              </div>
            </div>
          </article>
        </div>
      </div>
    {%- else -%}
      <div class="prisma-dynamic-grid">
        {% for block in section.blocks %}
          {%- liquid
            assign fallback_initial = block.settings.title | slice: 0, 2
            assign featured_product = block.settings.featured_product
            assign guide_image = blank
            assign guide_image_alt = block.settings.title
            assign image_render_width = 1200
            assign image_render_widths = '360, 540, 720, 900, 1200'
            assign image_render_sizes = '(min-width: 1200px) 302px, (min-width: 768px) 45vw, calc(100vw - 56px)'

            if block.settings.collection_image != blank
              assign guide_image = block.settings.collection_image
            elsif featured_product != blank and featured_product.featured_image != blank
              assign guide_image = featured_product.featured_image
              assign guide_image_alt = featured_product.title
            endif
          -%}
          <a href="{{ block.settings.collection_link }}" class="prisma-grid-item" {{ block.shopify_attributes }}>
            <span class="prisma-img-wrapper">
              {% if guide_image != blank %}
                {{ guide_image | image_url: width: image_render_width | image_tag:
                  loading: 'lazy',
                  widths: image_render_widths,
                  sizes: image_render_sizes,
                  alt: guide_image_alt
                }}
              {% else %}
                <span class="prisma-placeholder">{{ fallback_initial | escape }}</span>
              {% endif %}
            </span>
            <span class="prisma-grid-copy">
              {% if block.settings.kicker != blank %}
                <span class="prisma-grid-kicker">{{ block.settings.kicker | escape }}</span>
              {% endif %}
              <span class="prisma-grid-title">{{ block.settings.title | escape }}</span>
              {% if block.settings.description != blank %}
                <span class="prisma-grid-desc">{{ block.settings.description | escape }}</span>
              {% endif %}
            </span>
            <span class="prisma-grid-action">Open database</span>
          </a>
        {% endfor %}
      </div>
    {%- endif -%}

    {%- if layout_style != 'database' -%}
      <div class="p10-context-drawer" data-p10-recommendation-root hidden>
        <div class="p10-context-drawer__panel" role="dialog" aria-label="Category product recommendations">
          <button class="p10-context-drawer__close" type="button" data-p10-context-close aria-label="Close recommendations">&times;</button>
          {%- for block in section.blocks -%}
            {%- liquid
              assign recommendation_collection = block.settings.collection
              assign featured_product = block.settings.featured_product
              assign has_recommendation_context = false
              if recommendation_collection != blank and recommendation_collection.products.size > 0
                assign has_recommendation_context = true
              elsif featured_product != blank
                assign has_recommendation_context = true
              endif
            -%}
            {%- if has_recommendation_context -%}
              {%- render 'p10-context-recommendation-panel',
                context_id: block.id,
                title: block.settings.title,
                kicker: block.settings.kicker,
                link: block.settings.collection_link,
                context_collection: recommendation_collection,
                featured_product: featured_product,
                search_query: block.settings.title
              -%}
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (() => {
    const initPrismaRotator = (root) => {
      if (!root || root.dataset.prismaRotatorReady === 'true') return;
      const slides = Array.from(root.querySelectorAll('[data-prisma-slide]'));
      const triggers = Array.from(root.querySelectorAll('[data-prisma-slide-trigger]'));
      if (slides.length < 2 || triggers.length < 2) return;

      root.dataset.prismaRotatorReady = 'true';
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let activeIndex = 0;
      let timer = null;
      let paused = false;
      let inView = false;

      const activate = (nextIndex) => {
        activeIndex = (nextIndex + slides.length) % slides.length;
        slides.forEach((slide, index) => {
          const isActive = index === activeIndex;
          slide.classList.toggle('is-active', isActive);
          slide.setAttribute('aria-hidden', isActive ? 'false' : 'true');
        });
        triggers.forEach((trigger, index) => {
          trigger.setAttribute('aria-selected', index === activeIndex ? 'true' : 'false');
        });
      };

      const stop = () => {
        if (timer) window.clearInterval(timer);
        timer = null;
      };

      const start = () => {
        stop();
        if (!prefersReducedMotion && !paused && inView && !document.hidden) {
          timer = window.setInterval(() => activate(activeIndex + 1), 7000);
        }
      };

      const setInView = (nextInView) => {
        inView = nextInView;
        if (inView) {
          start();
        } else {
          stop();
        }
      };

      triggers.forEach((trigger, index) => {
        trigger.addEventListener('click', () => {
          paused = false;
          root.dataset.prismaPaused = 'false';
          activate(index);
          start();
        });
      });

      root.addEventListener('mouseenter', () => {
        paused = true;
        root.dataset.prismaPaused = 'true';
        stop();
      });
      root.addEventListener('mouseleave', () => {
        paused = false;
        root.dataset.prismaPaused = 'false';
        start();
      });
      root.addEventListener('focusin', () => {
        paused = true;
        root.dataset.prismaPaused = 'true';
        stop();
      });
      root.addEventListener('focusout', () => {
        paused = false;
        root.dataset.prismaPaused = 'false';
        start();
      });
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          stop();
        } else {
          start();
        }
      });

      activate(0);
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.target === root) setInView(entry.isIntersecting);
          });
        }, { rootMargin: '220px 0px' });
        observer.observe(root);
      } else {
        setInView(true);
      }
    };

    const initAllPrismaRotators = (scope = document) => {
      scope.querySelectorAll('[data-prisma-rotator]').forEach(initPrismaRotator);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => initAllPrismaRotators());
    } else {
      initAllPrismaRotators();
    }

    document.addEventListener('shopify:section:load', (event) => initAllPrismaRotators(event.target));
  })();
</script>

