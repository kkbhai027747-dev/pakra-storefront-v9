{%- if section.settings.display_section -%}
{{ 'component-toolbar-mobile.aio.min.css' | asset_url | stylesheet_tag }}
<div class="halo-sticky-toolbar-mobile">
    <div class="bottom-bar">
        <ul class="bottom-bar--list">
            {%- liquid
                assign font_size = section.settings.font_size | append: 'px'
                assign font_weight = section.settings.font_weight
                assign icon_size = section.settings.icon_size | append: 'px'
                assign uses_legacy_account = false
                if routes.account_login_url contains '/account/login'
                    assign uses_legacy_account = true
                endif
            -%}

            {%- for block in section.blocks -%}
                {%- liquid
                    assign icon = block.settings.icon
                    assign text = block.settings.text
                    assign action_icon = block.settings.action_to
                    assign link = blank
                    assign opens_new_tab = false

                    if block.type == 'link'
                        assign link = block.settings.link
                        if link contains 'http://'
                            assign opens_new_tab = true
                        elsif link contains 'https://'
                            assign opens_new_tab = true
                        endif
                    elsif block.type == 'content'
                        assign link = '#' | append: block.id
                    elsif action_icon == 'cart'
                        assign link = routes.cart_url
                    elsif action_icon == 'search'
                        assign link = routes.search_url
                    elsif action_icon == 'account'
                        if customer
                            assign link = routes.account_url
                        else
                            assign link = routes.account_login_url
                        endif
                    endif

                    assign is_active = false
                    if link != blank and request.path == link
                        assign is_active = true
                    elsif action_icon == 'cart' and request.path == routes.cart_url
                        assign is_active = true
                    elsif action_icon == 'account' and request.path contains '/account'
                        assign is_active = true
                    endif
                -%}
                {%- if icon != blank or text != blank -%}
                    <li class="list-item{% if is_active %} list-item--active{% endif %}{% if action_icon == 'account' %}{% unless shop.customer_accounts_enabled %} customer_accounts_disable{% endunless %}{% endif %}" style="--font-size: {{ font_size }}; --font-weight: {{ font_weight }}; --icon-size: {{ icon_size }}" {{ block.shopify_attributes }}>
                        <a href="{{ link | default: routes.root_url }}"{% if is_active %} aria-current="page"{% endif %}{% if opens_new_tab %} target="_blank" rel="noopener noreferrer"{% endif %}{% if block.type == 'content' %} data-bar-content{% elsif block.type == 'action' %}{% if action_icon == 'cart' %}{% if settings.show_quick_cart %} data-cart-sidebar{% else %} class="list-item-cart"{% endif %}{% elsif action_icon == 'search' %} data-search-mobile{% elsif action_icon == 'account' %}{% unless customer %}{% if uses_legacy_account %} data-open-auth-sidebar{% endif %}{% endunless %}{% endif %}{% endif %}>
                            <span class="icon" aria-hidden="true">{{ icon }}</span>
                            <span class="text">{{ text }}</span>
                            {%- if action_icon == 'cart' -%}
                                <div class="cart-count-bubble" style="--color-bubble: {{ section.settings.bg_color }}; --bg-bubble: {{ section.settings.color_icon }}">
                                    <span class="text" aria-hidden="true" data-cart-count>{{ cart.item_count }}</span>
                                    <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
                                </div>
                            {%- endif -%}
                        </a>
                        {%- if block.type == 'content' -%}
                            <div class="block-content bottom-bar--content" id="{{ block.id }}">
                                <button type="button" class="bottom-bar--close halo-sidebar-close clearfix" data-close-content-sidebar aria-label="{{ 'general.common.close' | t }}">{% render 'icon-close' %}{{ 'general.common.close' | t }}</button>
                                <div class="rte">{{ block.settings.content }}</div>
                            </div>
                        {% endif %}
                    </li>
                {%- endif -%}
            {%- endfor -%}
        </ul>
    </div>
</div>
<style>
    {%- liquid
        assign color_icon = section.settings.color_icon
        assign bg_color = section.settings.bg_color
        assign bg_color_gradient = section.settings.bg_color_gradient
        assign border_color = section.settings.border_color
    -%}
    .halo-sticky-toolbar-mobile {background: {% if bg_color_gradient != blank %}{{bg_color_gradient}}{% else %}{{bg_color}}{% endif %};border: 1px solid {{border_color}}}
    .halo-sticky-toolbar-mobile span {color: {{color_icon}}}
    .halo-sticky-toolbar-mobile span.icon svg {fill: {{color_icon}}}
    .halo-sticky-toolbar-mobile .bottom-bar {padding-bottom: calc(3px + env(safe-area-inset-bottom))}
    .halo-sticky-toolbar-mobile .bottom-bar--list .list-item {flex: 1 1 0;min-width: 0}
    .halo-sticky-toolbar-mobile .bottom-bar--list .list-item > a {position: relative;width: 100%;min-height: 54px;display: flex;flex-direction: column;align-items: center;justify-content: center}
    .halo-sticky-toolbar-mobile .bottom-bar--list .cart-count-bubble {right: calc(50% - 19px)}
    .halo-sticky-toolbar-mobile .bottom-bar--list .list-item--active > a::after {content: '';position: absolute;right: 20%;bottom: 1px;left: 20%;height: 2px;background: {{ color_icon }}}
    .halo-sticky-toolbar-mobile .bottom-bar--list .list-item--active .text {font-weight: 700}
    @media (max-width: 1024px) {.sticky-toolbar-mobile .footer {padding-bottom: calc(60px + env(safe-area-inset-bottom))}}
</style>
<script>
  (() => {
    const buttons = document.querySelectorAll('[data-bar-content]');
    if (buttons.length) {
        buttons.forEach((button) => {
            if (button.dataset.barReady === 'true') return;
            button.dataset.barReady = 'true';
            button.addEventListener('click', (event) => {
                event.preventDefault();
                const content = button.closest('.list-item').querySelector('.bottom-bar--content');
                if (!content) return;
                if (content.classList.contains('show')) {
                    content.classList.remove('show');
                    document.querySelector('body').classList.remove('show-sidebar-content');
                } else {
                    content.classList.add('show');
                    document.querySelector('body').classList.add('show-sidebar-content');
                }
            })
        });
        document.querySelectorAll('[data-close-content-sidebar]').forEach((button) => {
            button.addEventListener('click', (event) => {
                event.target.closest('.bottom-bar--content').classList.remove('show');
                document.querySelector('body').classList.remove('show-sidebar-content');
            });
        })
    }
    document.body.classList.add('sticky-toolbar-mobile');
  })();
</script>
{%- endif -%}

{% schema %}
{
    "name": "t:sections.sticky_toolbar_mobile.name",
    "tag": "section",
    "max_blocks": 6,
    "settings": [
    {
        "type": "checkbox",
        "id": "display_section",
        "label": "t:sections.layout.display_block",
        "default": true
    },
    {
        "type": "paragraph",
        "content": "t:sections.sticky_toolbar_mobile.settings.paragraph"
    },
    {
        "type": "range",
        "id": "font_size",
        "label": "t:settings_schema.typography.settings.font_size.label",
        "min": 8,
        "max": 20,
        "step": 1,
        "unit": "t:sections.footer.settings.footer_top.pdtop_footer_top.unit",
        "default": 12
    },
    {
        "type": "select",
        "id": "font_weight",
        "label": "t:settings_schema.typography.settings.font_weight.label",
        "default": "500",
        "options": [
        {
            "value": "400",
            "label": "t:settings_schema.typography.settings.font_weight.options__1"
        },
        {
            "value": "500",
            "label": "t:settings_schema.typography.settings.font_weight.options__2"
        },
        {
            "value": "600",
            "label": "t:settings_schema.typography.settings.font_weight.options__3"
        },
        {
            "value": "700",
            "label": "t:settings_schema.typography.settings.font_weight.options__4"
        },
        {
            "value": "800",
            "label": "t:settings_schema.typography.settings.font_weight.options__5"
        },
        {
            "value": "900",
            "label": "t:settings_schema.typography.settings.font_weight.options__6"
        }]
