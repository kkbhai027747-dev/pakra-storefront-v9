{% liquid
  assign desktop_asset = section.settings.desktop_image_asset | strip
  assign mobile_asset = section.settings.mobile_image_asset | strip
  assign heading = section.settings.heading | default: 'KAYOU MLP Quying 8'
  assign alt_text = section.settings.alt_text | default: heading
%}

<style>
  .v2-qy08-hero-{{ section.id }} {
    width: 100vw;
    position: relative;
    left: 50%;
    margin-left: -50vw;
    background: #050505;
    overflow: hidden;
  }

  .v2-qy08-hero-{{ section.id }} .v2-qy08-hero__target {
    display: block;
    position: relative;
    color: inherit;
    text-decoration: none;
  }

  .v2-qy08-hero-{{ section.id }} .v2-qy08-hero__image {
    display: block;
    width: 100%;
    height: auto;
  }

  .v2-qy08-hero-{{ section.id }} .v2-qy08-hero__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>

<section class="v2-qy08-hero-{{ section.id }}" aria-label="{{ heading | escape }}">
  {% if section.settings.button_link != blank %}
    <a class="v2-qy08-hero__target" href="{{ section.settings.button_link }}">
  {% else %}
    <div class="v2-qy08-hero__target">
  {% endif %}
      <picture>
        {% if mobile_asset != blank %}
          <source media="(max-width: 749px)" srcset="{{ mobile_asset | asset_url }}">
        {% endif %}
        {% if desktop_asset != blank %}
          <img class="v2-qy08-hero__image" src="{{ desktop_asset | asset_url }}" alt="{{ alt_text | escape }}" loading="eager" fetchpriority="high">
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg v2-qy08-hero__image' }}
        {% endif %}
      </picture>
      <span class="v2-qy08-hero__sr">
        {{ heading }}{% if section.settings.text != blank %}. {{ section.settings.text }}{% endif %}
      </span>
  {% if section.settings.button_link != blank %}
    </a>
  {% else %}
    </div>
  {% endif %}
</section>

{% schema %}
{
  "name": "V2 QY08 hero",
  "settings": [
    {
      "type": "text",
      "id": "desktop_image_asset",
      "label": "Desktop image asset",
      "default": "qy08-world-cup-hero-desktop.jpg"
    },
    {
      "type": "text",
      "id": "mobile_image_asset",
      "label": "Mobile image asset",
      "default": "qy08-world-cup-hero-mobile.jpg"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Accessible heading",
      "default": "KAYOU MLP Quying 8"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Accessible description",
      "default": "Football season My Little Pony Friendship Eternal card release."
    },
    {
      "type": "text",
      "id": "alt_text",
      "label": "Image alt text",
      "default": "KAYOU My Little Pony Quying 8 football season card release"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Hero link"
    }
  ],
  "presets": [
    {
      "name": "V2 QY08 hero"
    }
  ]
}
{% endschema %}
