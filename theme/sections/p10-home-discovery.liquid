{% liquid
  assign section_id = 'p10-home-discovery-' | append: section.id
  assign hero_asset = section.settings.hero_asset | strip
  if hero_asset == blank
    assign hero_asset = 'qy08-football-home-hero-desktop-v3.webp'
  endif
  assign hero_asset_mobile = section.settings.hero_asset_mobile | strip
  if hero_asset_mobile == blank
    assign hero_asset_mobile = 'qy08-football-home-hero-mobile-v3.webp'
  endif
  assign primary_link = section.settings.primary_link | default: '/collections/featured-new-arrivals'
  assign secondary_link = section.settings.secondary_link | default: '/collections/type-merchandise'
  assign hero_left_link = section.settings.hero_left_link
  assign hero_right_link = section.settings.hero_right_link
  assign split_hero_enabled = false
  if hero_left_link != blank and hero_right_link != blank
    assign split_hero_enabled = true
  endif
  assign hero_slides = section.blocks | where: 'type', 'hero_slide'
  assign retired_hero_ids = 'hero_fx02' | split: ','
  assign hero_slide_count = 0
  for block in hero_slides
    unless retired_hero_ids contains block.id
      assign hero_slide_count = hero_slide_count | plus: 1
    endunless
  endfor
%}

<section id="{{ section_id }}" class="p10-home-discovery" data-p10-home-discovery>
  <div class="p10-home-discovery__shell">
    <div
      class="p10-home-discovery__carousel"
      data-p10-hero-carousel
      data-home-discovery-reveal
      data-autoplay="{{ section.settings.hero_autoplay }}"
      data-interval="{{ section.settings.rotation_interval | default: 7 | times: 1000 }}"
    >
      <div class="p10-home-discovery__stage-track">
        {% if hero_slide_count > 0 %}
          {% assign hero_render_index = 0 %}
          {% for block in hero_slides %}
            {% if retired_hero_ids contains block.id %}{% continue %}{% endif %}
            {% liquid
              assign hero_is_first = false
              if hero_render_index == 0
                assign hero_is_first = true
              endif
              assign desktop_image = block.settings.desktop_image
              assign mobile_image = block.settings.mobile_image
              assign desktop_asset = block.settings.desktop_image_asset | strip
              assign mobile_asset = block.settings.mobile_image_asset | strip
              if desktop_image != blank
                assign desktop_src = desktop_image | image_url: width: 2400
              else
                assign desktop_src = desktop_asset | asset_url
              endif
              if mobile_image != blank
                assign mobile_src = mobile_image | image_url: width: 1200
              elsif mobile_asset != blank
                assign mobile_src = mobile_asset | asset_url
              else
                assign mobile_src = desktop_src
              endif
              assign slide_primary_link = block.settings.primary_link | default: '/collections/featured-new-arrivals'
              assign slide_secondary_link = block.settings.secondary_link
              assign slide_split_enabled = false
              if block.id == 'hero_heimantou' and slide_primary_link != blank and slide_secondary_link != blank
                assign slide_split_enabled = true
              endif
            %}
            <header
              class="p10-home-discovery__stage{% if desktop_asset == 'p10-pokemon-30th-hero-desktop.webp' %} p10-home-discovery__stage--pokemon-30th{% endif %}{% if hero_is_first %} is-active{% endif %}"
              data-p10-hero-slide
              aria-hidden="{% if hero_is_first %}false{% else %}true{% endif %}"
              {{ block.shopify_attributes }}
            >
              <picture class="p10-home-discovery__stage-media">
                <source media="(max-width: 760px)" srcset="{{ mobile_src }}">
                <img
                  src="{{ desktop_src }}"
                  alt="{{ block.settings.image_alt | default: block.settings.heading | escape }}"
                  width="1920"
                  height="720"
                  loading="{% if hero_is_first %}eager{% else %}lazy{% endif %}"
                  {% if hero_is_first %}fetchpriority="high"{% endif %}
                  decoding="async"
                >
              </picture>
              {% if block.id == 'hero_heimantou' %}
                <span class="p10-home-discovery__heimantou-brand" data-p10-heimantou-brand>PAKRACARDS × HEIMANTOU</span>
              {% endif %}
              {% if slide_split_enabled %}
                <nav class="p10-home-discovery__split-links" aria-label="{{ block.settings.heading | default: 'Community collaboration bundles' | escape }}">
                  <a class="p10-home-discovery__split-link p10-home-discovery__split-link--flower" href="{{ slide_primary_link }}" aria-label="{{ block.settings.primary_label | escape }}">
                    <span class="p10-home-discovery__visually-hidden">{{ block.settings.primary_label | escape }}</span>
                  </a>
                  <a class="p10-home-discovery__split-link p10-home-discovery__split-link--ultimate" href="{{ slide_secondary_link }}" aria-label="{{ block.settings.secondary_label | escape }}">
                    <span class="p10-home-discovery__visually-hidden">{{ block.settings.secondary_label | escape }}</span>
                  </a>
                </nav>
              {% elsif slide_primary_link != blank %}
                <a class="p10-home-discovery__full-link" href="{{ slide_primary_link }}" aria-label="{{ block.settings.primary_label | default: block.settings.heading | escape }}">
                  <span class="p10-home-discovery__visually-hidden">{{ block.settings.primary_label | default: block.settings.heading | escape }}</span>
                </a>
              {% else %}
              <span class="p10-home-discovery__stage-shade" aria-hidden="true"></span>
              <span class="p10-home-discovery__stage-hint" aria-hidden="true">
                {{ block.settings.hint | default: 'Explore the feature' | escape }} <span>&rarr;</span>
              </span>
              <div class="p10-home-discovery__stage-copy" data-home-stage-copy>
                <div class="p10-home-discovery__stage-message">
                  <p class="p10-home-discovery__eyebrow">{{ block.settings.eyebrow | default: 'COLLECTOR STORE' | escape }}</p>
                  {% if hero_is_first %}
                    <h2 class="p10-home-discovery__stage-title">{{ block.settings.heading | default: 'pakracards' | escape }}</h2>
                  {% else %}
                    <h2 class="p10-home-discovery__stage-title">{{ block.settings.heading | default: 'pakracards' | escape }}</h2>
                  {% endif %}
                  <p class="p10-home-discovery__intro">{{ block.settings.text | escape }}</p>
                </div>
                <div class="p10-home-discovery__actions">
                  <a class="p10-home-discovery__button p10-home-discovery__button--primary" href="{{ slide_primary_link }}"{% unless hero_is_first %} tabindex="-1"{% endunless %}>
                    {{ block.settings.primary_label | default: 'Shop the release' | escape }}
                  </a>
                  {% if slide_secondary_link != blank and block.settings.secondary_label != blank %}
                    <a class="p10-home-discovery__button p10-home-discovery__button--secondary" href="{{ slide_secondary_link }}"{% unless hero_is_first %} tabindex="-1"{% endunless %}>
                      {{ block.settings.secondary_label | escape }}
                    </a>
                  {% endif %}
                </div>
              </div>
              {% endif %}
            </header>
            {% assign hero_render_index = hero_render_index | plus: 1 %}
          {% endfor %}
        {% else %}
          <header class="p10-home-discovery__stage is-active" data-p10-hero-slide aria-hidden="false">
            <picture class="p10-home-discovery__stage-media">
              <source media="(max-width: 760px)" srcset="{{ hero_asset_mobile | asset_url }}">
              <img src="{{ hero_asset | asset_url }}" alt="{{ section.settings.hero_alt | default: 'Featured pakracards collector release' | escape }}" width="1920" height="720" loading="eager" fetchpriority="high" decoding="async">
            </picture>
            {% if split_hero_enabled %}
              <nav class="p10-home-discovery__split-links" aria-label="Community collaboration bundles">
                <a class="p10-home-discovery__split-link p10-home-discovery__split-link--flower" href="{{ hero_left_link }}" aria-label="{{ section.settings.hero_left_label | escape }}">
                  <span class="p10-home-discovery__visually-hidden">{{ section.settings.hero_left_label | escape }}</span>
                </a>
                <a class="p10-home-discovery__split-link p10-home-discovery__split-link--ultimate" href="{{ hero_right_link }}" aria-label="{{ section.settings.hero_right_label | escape }}">
                  <span class="p10-home-discovery__visually-hidden">{{ section.settings.hero_right_label | escape }}</span>
                </a>
              </nav>
            {% else %}
              <span class="p10-home-discovery__stage-shade" aria-hidden="true"></span>
              <span class="p10-home-discovery__stage-hint" aria-hidden="true">Explore the feature <span>&rarr;</span></span>
              <div class="p10-home-discovery__stage-copy" data-home-stage-copy>
                <div class="p10-home-discovery__stage-message">
                  <p class="p10-home-discovery__eyebrow">{{ section.settings.eyebrow | default: 'COLLECTOR STORE' | escape }}</p>
                  <h2 class="p10-home-discovery__stage-title">{{ section.settings.heading | default: 'pakracards' | escape }}</h2>
                  <p class="p10-home-discovery__intro">{{ section.settings.text | default: 'Collect by universe. Browse cards and character goods through clear, separate paths.' | escape }}</p>
                </div>
                <div class="p10-home-discovery__actions">
                  <a class="p10-home-discovery__button p10-home-discovery__button--primary" href="{{ primary_link }}">{{ section.settings.primary_label | default: 'Shop new arrivals' | escape }}</a>
                  <a class="p10-home-discovery__button p10-home-discovery__button--secondary" href="{{ secondary_link }}">{{ section.settings.secondary_label | default: 'Browse character goods' | escape }}</a>
                </div>
              </div>
            {% endif %}
          </header>
        {% endif %}
      </div>

      {% if hero_slide_count > 1 %}
        <div class="p10-home-discovery__hero-controls" role="group" aria-label="Featured releases">
          {% assign hero_dot_index = 0 %}
          {% for block in hero_slides %}
            {% if retired_hero_ids contains block.id %}{% continue %}{% endif %}
            <button
              type="button"
              class="p10-home-discovery__hero-dot{% if hero_dot_index == 0 %} is-active{% endif %}"
              data-p10-hero-dot
              aria-label="Show {{ block.settings.heading | default: 'featured release' | escape }}"
              aria-pressed="{% if hero_dot_index == 0 %}true{% else %}false{% endif %}"
            ><span>{{ hero_dot_index | plus: 1 }}</span></button>
            {% assign hero_dot_index = hero_dot_index | plus: 1 %}
          {% endfor %}
        </div>
      {% endif %}
    </div>

    <div class="p10-home-discovery__path-head" data-home-discovery-reveal>
      <div>
        <p class="p10-home-discovery__eyebrow p10-home-discovery__eyebrow--ink">Store directory</p>
        <h2>{{ section.settings.directory_heading | default: 'Start with what you know.' | escape }}</h2>
      </div>
      <p>{{ section.settings.directory_text | default: 'Choose a universe or jump straight to the product type you want.' | escape }}</p>
    </div>

    <div class="p10-home-discovery__directory">
      <section class="p10-home-discovery__axis" aria-labelledby="{{ section_id }}-ip-heading">
        <div class="p10-home-discovery__axis-head">
          <div>
            <span>01</span>
            <h3 id="{{ section_id }}-ip-heading">Shop by IP</h3>
          </div>
          <a href="{{ section.settings.ip_all_link | default: '/collections/group-shop-by-ip' }}">View all IP</a>
        </div>
        {% assign ip_routes = section.blocks | where: 'type', 'ip_route' %}
        {% if ip_routes.size > 0 %}
          <div class="p10-home-discovery__ip-showcase" data-home-ip-showcase>
            <div class="p10-home-discovery__ip-selector" role="tablist" aria-label="Featured IP series" aria-orientation="vertical">
              {% for block in ip_routes %}
                <button
                  class="p10-home-discovery__ip-tab{% if forloop.first %} is-active{% endif %}"
                  type="button"
                  id="{{ section_id }}-ip-series-tab-{{ block.id }}"
                  role="tab"
                  aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
                  aria-controls="{{ section_id }}-ip-series-panel-{{ block.id }}"
                  tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
                  data-home-ip-tab="{{ block.id }}"
                  style="--route-accent: {{ block.settings.accent_color }};"
                >
                  <span>{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
                  <strong>{{ block.settings.title | escape }}</strong>
                  <small>{{ block.settings.series_title | escape }}</small>
                </button>
              {% endfor %}
            </div>

            <div class="p10-home-discovery__ip-panels">
              {% for block in ip_routes %}
                {% liquid
                  assign featured_product = block.settings.product
                  assign feature_image = block.settings.feature_image
                  assign feature_asset = block.settings.feature_image_asset | strip
                  assign feature_clip = block.settings.feature_clip | strip
                  assign feature_crop = block.settings.feature_crop | split: ' '
                  assign crop_x = feature_crop[0] | plus: 0
                  assign crop_y = feature_crop[1] | plus: 0
                  assign crop_width = feature_crop[2] | plus: 0
                  assign crop_height = feature_crop[3] | plus: 0
                  assign source_width = feature_crop[4] | plus: 0
                  assign source_height = feature_crop[5] | plus: 0
                  assign crop_right = crop_x | plus: crop_width
                  assign crop_bottom = crop_y | plus: crop_height
                  assign valid_feature_crop = false
                  if feature_crop.size == 6 and crop_x >= 0 and crop_y >= 0 and crop_width > 0 and crop_height > 0 and crop_right <= source_width and crop_bottom <= source_height
                    assign valid_feature_crop = true
                  endif
                  if valid_feature_crop or block.settings.feature_is_card
                    assign feature_clip = ''
                  endif
                  if feature_image == blank and feature_asset == blank
                    assign feature_image = featured_product.featured_image
                  endif
                  assign box_image = block.settings.box_image
                  assign box_asset = block.settings.box_image_asset | strip
                  if box_image == blank and box_asset == blank
                    assign box_image = featured_product.featured_image
                  endif
                  assign route_link = block.settings.link | default: featured_product.url
                  assign shop_link = block.settings.shop_link | default: route_link
                  assign feature_link = block.settings.feature_link | default: route_link
                  assign product_title = featured_product.title | default: block.settings.series_title
                  assign card_count = 0
                  for card_index in (1..4)
                    assign card_image_key = 'card_image_' | append: card_index
                    assign card_asset_key = 'card_image_asset_' | append: card_index
                    assign card_image = block.settings[card_image_key]
                    assign card_asset = block.settings[card_asset_key] | strip
                    if card_image != blank or card_asset != blank
                      assign card_count = card_count | plus: 1
                    endif
                  endfor
                %}
                <article
                  class="p10-home-discovery__ip-panel{% if forloop.first %} is-active{% endif %}"
                  id="{{ section_id }}-ip-series-panel-{{ block.id }}"
                  role="tabpanel"
                  aria-labelledby="{{ section_id }}-ip-series-tab-{{ block.id }}"
                  aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
                  data-home-ip-panel="{{ block.id }}"
                  style="--route-accent: {{ block.settings.accent_color }};"
                  {% unless forloop.first %}hidden{% endunless %}
                  {{ block.shopify_attributes }}
                >
                  <div class="p10-home-discovery__ip-visual{% if card_count == 0 %} p10-home-discovery__ip-visual--single{% endif %}">
                    {% if feature_image != blank or feature_asset != blank %}
                      <a class="p10-home-discovery__ip-feature{% if block.settings.feature_is_card or valid_feature_crop %} p10-home-discovery__ip-feature--card{% endif %}{% if feature_clip != blank %} p10-home-discovery__ip-feature--cutout{% endif %}"{% if feature_clip != blank %} style="--feature-clip: polygon({{ feature_clip | escape }});"{% endif %}{% if feature_link != blank %} href="{{ feature_link }}"{% endif %} aria-label="{{ block.settings.feature_image_alt | default: product_title | escape }}">
                        {% if valid_feature_crop %}
                          {% liquid
                            if feature_image != blank
                              assign source_url = feature_image | image_url: width: source_width
                            else
                              assign source_url = feature_asset | asset_url
                            endif
                          %}
                          <svg class="p10-home-discovery__ip-card-crop" viewBox="{{ crop_x }} {{ crop_y }} {{ crop_width }} {{ crop_height }}" width="{{ crop_width }}" height="{{ crop_height }}" aria-hidden="true" focusable="false">
                            <image href="{{ source_url | escape }}" width="{{ source_width }}" height="{{ source_height }}" />
                          </svg>
                        {% elsif feature_image != blank %}
                          {{ feature_image | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '360, 600, 900, 1200', sizes: '(max-width: 760px) 60vw, 30vw', alt: block.settings.feature_image_alt }}
                        {% else %}
                          <img
                            src="{{ feature_asset | asset_url }}"
                            alt="{{ block.settings.feature_image_alt | default: block.settings.series_title | escape }}"
                            width="1200"
                            height="900"
                            loading="lazy"
                            decoding="async"
                          >
                        {% endif %}
                      </a>
                    {% else %}
                      <div class="p10-home-discovery__ip-media-pending">
                        <span>Series showcase ready</span>
                        <strong>{{ block.settings.series_title | escape }}</strong>
                        <small>Store artwork will be added with the release.</small>
                      </div>
                    {% endif %}

                    {% if card_count > 0 %}
                      <div class="p10-home-discovery__ip-cards" aria-label="{{ block.settings.series_title | escape }} featured card artwork" style="--card-count: {{ card_count }};">
                        {% for card_index in (1..4) %}
                          {% liquid
                            assign card_image_key = 'card_image_' | append: card_index
                            assign card_asset_key = 'card_image_asset_' | append: card_index
                            assign card_image = block.settings[card_image_key]
                            assign card_asset = block.settings[card_asset_key] | strip
                            assign card_link_key = 'card_link_' | append: card_index
                            assign card_label_key = 'card_label_' | append: card_index
                            assign card_link = block.settings[card_link_key] | default: route_link
                            assign card_label = block.settings[card_label_key] | default: product_title
                            assign card_crop_key = 'card_crop_' | append: card_index
                            assign card_crop = block.settings[card_crop_key] | split: ' '
                            assign crop_x = card_crop[0] | plus: 0
                            assign crop_y = card_crop[1] | plus: 0
                            assign crop_width = card_crop[2] | plus: 0
                            assign crop_height = card_crop[3] | plus: 0
                            assign source_width = card_crop[4] | plus: 0
                            assign source_height = card_crop[5] | plus: 0
                            assign crop_right = crop_x | plus: crop_width
                            assign crop_bottom = crop_y | plus: crop_height
                            assign valid_card_crop = false
                            if card_crop.size == 6 and crop_x >= 0 and crop_y >= 0 and crop_width > 0 and crop_height > 0 and crop_right <= source_width and crop_bottom <= source_height
                              assign valid_card_crop = true
                            endif
                          %}
                          {% if card_image != blank or card_asset != blank %}
                            <a class="p10-home-discovery__ip-card"{% if card_link != blank %} href="{{ card_link }}"{% endif %} aria-label="{{ card_label | escape }}" style="--card-index: {{ card_index }};">
                              {% if valid_card_crop %}
                                {% liquid
                                  if card_image != blank
                                    assign source_url = card_image | image_url: width: source_width
                                  else
                                    assign source_url = card_asset | asset_url
                                  endif
                                %}
                                <svg class="p10-home-discovery__ip-card-crop" viewBox="{{ crop_x }} {{ crop_y }} {{ crop_width }} {{ crop_height }}" width="{{ crop_width }}" height="{{ crop_height }}" aria-hidden="true" focusable="false">
                                  <image href="{{ source_url | escape }}" width="{{ source_width }}" height="{{ source_height }}" />
                                </svg>
                              {% elsif card_image != blank %}
                                {{ card_image | image_url: width: 480 | image_tag: loading: 'lazy', widths: '180, 300, 480', sizes: '(max-width: 760px) 24vw, 7vw', alt: block.settings.series_title }}
                              {% else %}
                                <img
                                  src="{{ card_asset | asset_url }}"
                                  alt="{{ block.settings.series_title | escape }} featured card {{ card_index }}"
                                  width="420"
                                  height="590"
                                  loading="lazy"
                                  decoding="async"
                                >
                              {% endif %}
                            </a>
                          {% endif %}
                        {% endfor %}
                      </div>
                    {% endif %}

                  </div>

                  <div class="p10-home-discovery__ip-details">
                    <p>{{ block.settings.label | default: block.settings.title | escape }}</p>
                    <h4>{{ block.settings.series_title | escape }}</h4>
                    {% if block.settings.series_local_title != blank %}
                      <strong>{{ block.settings.series_local_title | escape }}</strong>
                    {% endif %}
                    {% if block.settings.text != blank %}
                      <div>{{ block.settings.text | escape | newline_to_br }}</div>
                    {% endif %}
                    {% if box_image != blank or box_asset != blank %}
                      <figure class="p10-home-discovery__ip-product">
                        <a class="p10-home-discovery__ip-product-link"{% if route_link != blank %} href="{{ route_link }}"{% endif %} aria-label="{{ product_title | escape }}">
                          <span class="p10-home-discovery__ip-product-image">
                            {% if box_image != blank %}
                              {{ box_image | image_url: width: 720 | image_tag: loading: 'lazy', widths: '240, 480, 720', sizes: '(max-width: 760px) 80vw, 28vw', alt: product_title }}
                            {% else %}
                              <img src="{{ box_asset | asset_url }}" alt="{{ block.settings.box_image_alt | default: product_title | escape }}" width="720" height="720" loading="lazy" decoding="async">
                            {% endif %}
                          </span>
                          <span class="p10-home-discovery__ip-product-title">{{ product_title | escape }} <span aria-hidden="true">&rarr;</span></span>
                          {% if featured_product != blank and featured_product.available == false %}
                            <span class="p10-home-discovery__ip-product-status">{{ 'products.product.sold_out' | t }}</span>
                          {% endif %}
                        </a>
                      </figure>
                    {% endif %}
                    {% if shop_link != blank %}
                      <a class="p10-home-discovery__ip-shop" href="{{ shop_link }}">
                        {{ block.settings.shop_label | default: 'Shop Now' | escape }} <span aria-hidden="true">&rarr;</span>
                      </a>
                    {% else %}
                      <small>Product link will be added when this series is ready.</small>
                    {% endif %}
                  </div>
                </article>
              {% endfor %}
            </div>
          </div>
        {% endif %}
      </section>

    </div>
  </div>
</section>

{% stylesheet %}
  .p10-home-discovery {
    --home-ink: #16171a;
    --home-paper: #ffffff;
    --home-soft: #f4f5f3;
    --home-muted: #656a72;
    --home-line: #d9dce0;
    --home-focus: #2e7fdb;
    padding: 18px 0 54px;
    background: var(--home-paper);
    color: var(--home-ink);
  }

  .p10-home-discovery *,
  .p10-home-discovery *::before,
  .p10-home-discovery *::after {
    box-sizing: border-box;
  }

  .p10-home-discovery__shell {
    width: min(1320px, calc(100% - 32px));
    margin: 0 auto;
  }

  .p10-home-discovery__carousel {
    position: relative;
  }

  .p10-home-discovery__stage-track {
    display: grid;
  }

  .p10-home-discovery__stage {
    grid-area: 1 / 1;
    position: relative;
    isolation: isolate;
    display: grid;
    align-items: end;
    min-height: 480px;
    max-height: 540px;
    overflow: hidden;
    border: 1px solid rgba(22, 23, 26, 0.18);
    border-radius: 8px;
    background: #1a1b1e;
    color: #ffffff;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 320ms ease-out, visibility 0s linear 320ms;
  }

  .p10-home-discovery__stage.is-active {
    z-index: 1;
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition-delay: 0s;
  }

  .p10-home-discovery__hero-controls {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 7;
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 6px;
    border: 1px solid rgba(255, 255, 255, 0.56);
    border-radius: 999px;
    background: rgba(18, 20, 26, 0.58);
    backdrop-filter: blur(8px);
  }

  .p10-home-discovery__hero-dot {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 50%;
    background: transparent;
    color: rgba(255, 255, 255, 0.72);
    cursor: pointer;
    font: 800 10px/1 var(--font-body-family, inherit);
    transition: background-color 120ms ease-out, color 120ms ease-out, transform 120ms ease-out;
  }

  .p10-home-discovery__hero-dot:hover,
  .p10-home-discovery__hero-dot:focus-visible {
