{% javascript %}
  (() => {
    const init = () => {
      document.querySelectorAll('[data-p10-home-discovery]').forEach((root) => {
        if (root.dataset.homeDiscoveryReady === 'true') return;
        root.dataset.homeDiscoveryReady = 'true';

        const reduced = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
        const carousel = root.querySelector('[data-p10-hero-carousel]');
        const slides = carousel ? [...carousel.querySelectorAll('[data-p10-hero-slide]')] : [];
        const dots = carousel ? [...carousel.querySelectorAll('[data-p10-hero-dot]')] : [];
        const ipShowcase = root.querySelector('[data-home-ip-showcase]');

        if (ipShowcase) {
          const ipSelector = ipShowcase.querySelector('[role="tablist"]');
          const ipTabs = [...ipShowcase.querySelectorAll('[data-home-ip-tab]')];
          const ipPanels = [...ipShowcase.querySelectorAll('[data-home-ip-panel]')];
          const mobileIpLayout = window.matchMedia('(max-width: 760px)');
          const updateIpOrientation = () => ipSelector?.setAttribute('aria-orientation', mobileIpLayout.matches ? 'horizontal' : 'vertical');
          updateIpOrientation();
          mobileIpLayout.addEventListener('change', updateIpOrientation);
          const activateIp = (key, moveFocus = false) => {
            const nextTab = ipTabs.find((tab) => tab.dataset.homeIpTab === key);
            const nextPanel = ipPanels.find((panel) => panel.dataset.homeIpPanel === key);
            if (!nextTab || !nextPanel) return;

            ipTabs.forEach((tab) => {
              const active = tab === nextTab;
              tab.classList.toggle('is-active', active);
              tab.setAttribute('aria-selected', active ? 'true' : 'false');
              tab.tabIndex = active ? 0 : -1;
            });
            ipPanels.forEach((panel) => {
              const active = panel === nextPanel;
              panel.classList.toggle('is-active', active);
              panel.hidden = !active;
              panel.setAttribute('aria-hidden', active ? 'false' : 'true');
            });
            if (moveFocus) nextTab.focus();
            if (mobileIpLayout.matches) {
              ipSelector.scrollTo({ left: nextTab.offsetLeft - ipSelector.offsetLeft, behavior: reduced ? 'instant' : 'smooth' });
            }
          };

          activateIp(ipTabs[0]?.dataset.homeIpTab);
          ipShowcase.addEventListener('click', (event) => {
            if (!(event.target instanceof Element)) return;
            const nextTab = event.target.closest('[data-home-ip-tab]');
            if (!nextTab || !ipShowcase.contains(nextTab)) return;
            activateIp(nextTab.dataset.homeIpTab);
          });
          ipSelector?.addEventListener('keydown', (event) => {
            if (!(event.target instanceof Element)) return;
            const currentTab = event.target.closest('[data-home-ip-tab]');
            const currentIndex = ipTabs.indexOf(currentTab);
            if (currentIndex < 0) return;

            let nextIndex = null;
            if (event.key === (mobileIpLayout.matches ? 'ArrowRight' : 'ArrowDown')) nextIndex = (currentIndex + 1) % ipTabs.length;
            if (event.key === (mobileIpLayout.matches ? 'ArrowLeft' : 'ArrowUp')) nextIndex = (currentIndex - 1 + ipTabs.length) % ipTabs.length;
            if (event.key === 'Home') nextIndex = 0;
            if (event.key === 'End') nextIndex = ipTabs.length - 1;
            if (nextIndex === null) return;
            event.preventDefault();
            activateIp(ipTabs[nextIndex].dataset.homeIpTab, true);
          });
          root.addEventListener('shopify:block:select', (event) => activateIp(event.detail.blockId));
        }

        if (carousel && slides.length > 0) {
          let current = Math.max(0, slides.findIndex((slide) => slide.classList.contains('is-active')));
          let timer = 0;
          let inViewport = true;
          const paused = new Set();
          const interval = Math.max(3000, Number.parseInt(carousel.dataset.interval || '7000', 10));
          const autoplay = carousel.dataset.autoplay === 'true' && !reduced && slides.length > 1;

          const setSlideInteractive = (slide, active) => {
            slide.classList.toggle('is-active', active);
            slide.setAttribute('aria-hidden', active ? 'false' : 'true');
            slide.querySelectorAll('a, button, input, select, textarea, [tabindex]').forEach((element) => {
              if (active) {
                if (element.dataset.carouselTabindex !== undefined) {
                  const previous = element.dataset.carouselTabindex;
                  if (previous === '') element.removeAttribute('tabindex');
                  else element.setAttribute('tabindex', previous);
                  delete element.dataset.carouselTabindex;
                }
              } else {
                if (element.dataset.carouselTabindex === undefined) {
                  element.dataset.carouselTabindex = element.getAttribute('tabindex') || '';
                }
                element.setAttribute('tabindex', '-1');
              }
            });
          };

          const schedule = () => {
            window.clearTimeout(timer);
            if (!autoplay || paused.size > 0 || !inViewport || document.hidden) return;
            timer = window.setTimeout(() => show(current + 1), interval);
          };

          const show = (nextIndex) => {
            current = (nextIndex + slides.length) % slides.length;
            slides.forEach((slide, index) => setSlideInteractive(slide, index === current));
            dots.forEach((dot, index) => {
              const active = index === current;
              dot.classList.toggle('is-active', active);
              dot.setAttribute('aria-pressed', active ? 'true' : 'false');
            });
            schedule();
          };

          const pause = (reason) => {
            paused.add(reason);
            window.clearTimeout(timer);
          };
          const resume = (reason) => {
            paused.delete(reason);
            schedule();
          };

          dots.forEach((dot, index) => dot.addEventListener('click', () => show(index)));
          carousel.addEventListener('mouseenter', () => pause('hover'));
          carousel.addEventListener('mouseleave', () => resume('hover'));
          carousel.addEventListener('focusin', () => pause('focus'));
          carousel.addEventListener('focusout', () => {
            window.setTimeout(() => {
              if (!carousel.contains(document.activeElement)) resume('focus');
            }, 0);
          });
          document.addEventListener('visibilitychange', schedule);

          if ('IntersectionObserver' in window) {
            const observer = new IntersectionObserver((entries) => {
              inViewport = entries[0]?.isIntersecting ?? true;
              schedule();
            }, { threshold: 0.18 });
            observer.observe(carousel);
          }

          show(current);
        }

        if (reduced || !window.gsap) return;

        const items = [
          ...root.querySelectorAll('[data-home-discovery-reveal]'),
          ...root.querySelectorAll('[data-route-kind]'),
        ].filter((item, index, array) => item && array.indexOf(item) === index);

        window.gsap.fromTo(
          items,
          { autoAlpha: 0, y: 14 },
          { autoAlpha: 1, y: 0, duration: 0.38, stagger: 0.035, ease: 'power2.out', clearProps: 'transform,opacity,visibility' }
        );
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      init();
    }
    document.addEventListener('shopify:section:load', init);
  })();
{% endjavascript %}

