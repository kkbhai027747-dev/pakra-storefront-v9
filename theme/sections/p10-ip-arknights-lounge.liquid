{% liquid
  assign section_id = 'p10-ip-arknights-' | append: section.id
  assign arknights_collection = section.settings.source_collection
  if arknights_collection == blank
    assign arknights_collection = collections['arknights']
  endif

  assign collection_url = section.settings.primary_link
  if collection_url == blank and arknights_collection != blank
    assign collection_url = arknights_collection.url
  endif
  if collection_url == blank
    assign collection_url = '/collections/arknights'
  endif

  assign card_box_url = section.settings.card_box_link
  if card_box_url == blank
    assign card_box_url = collection_url
  endif
%}

<section id="{{ section_id }}" class="p10-ip-arknights" data-p10-ip-arknights>
  <div class="p10-ip-arknights__anchor" id="{{ section.settings.anchor_id | default: 'arknights-collector-zone' | escape }}"></div>
  <div class="p10-ip-arknights__void" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
    <span></span>
    <span></span>
    <span></span>
  </div>
  <div class="p10-ip-arknights__split-field" aria-hidden="true">
    <span></span>
    <span></span>
    <span></span>
    <span></span>
  </div>
  <div class="p10-ip-arknights__motion-archive" aria-hidden="true">
    <div class="p10-ip-arknights__motion-panel">
      <img
        src="{{ 'p10-arknights-pageantry-archive.jpg' | asset_url }}"
        alt=""
        width="910"
        height="751"
        loading="eager"
        decoding="async"
      >
    </div>
    <div class="p10-ip-arknights__motion-logo">
      <img
        src="{{ 'p10-ip-arknights.png' | asset_url }}"
        alt=""
        width="720"
        height="720"
        loading="eager"
        decoding="async"
      >
    </div>
    <span class="p10-ip-arknights__motion-slice"></span>
    <span class="p10-ip-arknights__motion-slice"></span>
    <span class="p10-ip-arknights__motion-slice"></span>
    <span class="p10-ip-arknights__motion-signal"></span>
    <span class="p10-ip-arknights__motion-signal"></span>
    <span class="p10-ip-arknights__motion-signal"></span>
  </div>

  <div class="p10-ip-arknights__nav">
    <a class="p10-ip-arknights__back" href="{{ section.settings.back_link | default: '/collections' }}">
      <span aria-hidden="true">&larr;</span>
      <span>{{ section.settings.back_label | default: 'Back' | escape }}</span>
    </a>
  </div>

  <div class="p10-ip-arknights__layout">
    <div class="p10-ip-arknights__hero">
      <div class="p10-ip-arknights__cut-index" aria-hidden="true">
        <span>01</span>
        <span>02</span>
        <span>03</span>
      </div>
      <div class="p10-ip-arknights__copy">
        <p class="p10-ip-arknights__eyebrow" data-arknights-intro>{{ section.settings.eyebrow | default: 'Arknights collector zone' | escape }}</p>
        <h1 class="p10-ip-arknights__heading" data-arknights-intro>{{ section.settings.heading | default: 'Arknights' | escape }}</h1>
        <p class="p10-ip-arknights__subheading" data-arknights-intro>
          {{ section.settings.subheading | default: 'A focused V4 destination for Arknights cards, character goods, and blind-box formats.' | escape }}
        </p>
        <div class="p10-ip-arknights__actions" data-arknights-intro>
          <a class="p10-ip-arknights__primary-link" href="{{ collection_url }}">Shop Arknights</a>
          <a class="p10-ip-arknights__secondary-link" href="{{ card_box_url }}">View card box</a>
        </div>
      </div>

      <div class="p10-ip-arknights__map" aria-label="Arknights shopping paths" data-arknights-intro>
        <div class="p10-ip-arknights__map-brand">
          <span class="p10-ip-arknights__logo-frame">
            <img
              src="{{ 'p10-ip-arknights.png' | asset_url }}"
              alt="Rhodes Island"
              width="720"
              height="720"
              loading="eager"
              decoding="async"
            >
          </span>
          <span>
            <b>Rhodes Island</b>
            <small>Arknights route index</small>
          </span>
        </div>

        <div class="p10-ip-arknights__path-grid">
          <a href="{{ card_box_url }}">
            <span>Cards</span>
            <strong>Sealed box / badges</strong>
          </a>
          <a href="{{ collection_url }}">
            <span>Character goods</span>
            <strong>Plush and acrylic</strong>
          </a>
          <a href="{{ collection_url }}">
            <span>Blind boxes</span>
            <strong>Figures and charms</strong>
          </a>
        </div>

        <div class="p10-ip-arknights__filter-bar" aria-label="Product categories">
          <span>Card box</span>
          <span>Plush</span>
          <span>Blind box</span>
          <span>Acrylic</span>
          <span>Badge</span>
          <span>Stationery</span>
        </div>
      </div>
    </div>
  </div>

  <div id="arknights-product-paths" class="p10-ip-arknights__products">
    <div class="p10-ip-arknights__products-header" data-arknights-reveal>
      <div>
        <p class="p10-ip-arknights__eyebrow">Product paths</p>
        <h2>Arknights arrivals</h2>
      </div>
      <a href="{{ collection_url }}">View all</a>
    </div>

    <div class="p10-ip-arknights__lane">
      {% if arknights_collection != blank and arknights_collection.all_products_count > 0 %}
        {% for product in arknights_collection.products limit: 8 %}
          {% liquid
            assign product_image_alt = product.title
            if product.featured_image != blank and product.featured_image.alt != blank
              assign product_image_alt = product.featured_image.alt
            endif
          %}
          <article class="p10-ip-arknights__tile" data-arknights-tile>
            <a class="p10-ip-arknights__tile-image" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              {% if product.featured_image != blank %}
                {{
                  product.featured_image
                  | image_url: width: 520
                  | image_tag:
                    loading: 'eager',
                    decoding: 'async',
                    widths: '220, 320, 420, 520',
                    sizes: '(min-width: 990px) 18vw, 44vw',
                    alt: product_image_alt,
                    class: 'p10-ip-arknights__tile-img'
                }}
              {% else %}
                <img
                  src="{{ 'p10-ip-arknights.png' | asset_url }}"
                  alt="{{ product.title | escape }}"
                  width="520"
                  height="520"
                  loading="eager"
                  decoding="async"
                  class="p10-ip-arknights__tile-img"
                >
              {% endif %}
            </a>
            <div class="p10-ip-arknights__tile-body">
              <h3>{{ product.title | escape }}</h3>
              <div class="p10-ip-arknights__tile-meta">
                <span>{{ product.variants.size }} option{% unless product.variants.size == 1 %}s{% endunless %}</span>
                <span>{{ product.price_min | money }}</span>
              </div>
            </div>
          </article>
        {% endfor %}
      {% else %}
        <article class="p10-ip-arknights__empty">
          <strong>Arknights collection connected</strong>
          <span>Products will appear here when the collection is available in this theme preview.</span>
        </article>
      {% endif %}
    </div>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js" defer></script>
<script>
  (() => {
    const rootId = {{ section_id | json }};

    function initArknightsMotion(tries = 0) {
      const root = document.getElementById(rootId);
      if (!root || root.p10ArknightsMotionReady) return;
      if (!window.gsap) {
        if (tries < 22) window.setTimeout(() => initArknightsMotion(tries + 1), 90);
        return;
      }

      const gsap = window.gsap;
      const ScrollTrigger = window.ScrollTrigger;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (ScrollTrigger) gsap.registerPlugin(ScrollTrigger);

      const q = gsap.utils.selector(root);
      const introItems = gsap.utils.toArray(q('[data-arknights-intro]'));
      const routeItems = gsap.utils.toArray(q('.p10-ip-arknights__path-grid a, .p10-ip-arknights__filter-bar span'));
      const revealItems = gsap.utils.toArray(q('[data-arknights-reveal]'));
      const productTiles = gsap.utils.toArray(q('[data-arknights-tile]'));
      const vectorLines = gsap.utils.toArray(q('.p10-ip-arknights__void span, .p10-ip-arknights__split-field span'));
      const motionArchive = q('.p10-ip-arknights__motion-archive')[0];

      root.p10ArknightsMotionReady = true;
      root.setAttribute('data-p10-arknights-motion', 'ready');
      gsap.set([...introItems, ...routeItems, ...revealItems, ...productTiles], { autoAlpha: 1 });
      if (reduceMotion) return;

      const introLift = gsap.utils.distribute({ base: 12, amount: 18, from: 'start' });
      gsap.timeline({ defaults: { duration: 0.64, ease: 'power3.out' } })
        .fromTo(introItems, { y: (index) => introLift(index), autoAlpha: 0 }, { y: 0, autoAlpha: 1, stagger: 0.055 })
        .fromTo(routeItems, { y: 14, autoAlpha: 0 }, { y: 0, autoAlpha: 1, stagger: 0.035 }, '<0.18');

      productTiles.slice(0, 10).forEach((tile) => {
        const xTo = gsap.quickTo(tile, 'x', { duration: 0.22, ease: 'power2.out' });
        const yTo = gsap.quickTo(tile, 'y', { duration: 0.22, ease: 'power2.out' });
        tile.addEventListener('pointermove', (event) => {
          if (window.innerWidth < 990) return;
          const rect = tile.getBoundingClientRect();
          const xRatio = (event.clientX - rect.left) / rect.width - 0.5;
          const yRatio = (event.clientY - rect.top) / rect.height - 0.5;
          xTo(gsap.utils.clamp(-6, 6, xRatio * 8));
          yTo(gsap.utils.clamp(-5, 5, yRatio * 7));
        });
        tile.addEventListener('pointerleave', () => {
          xTo(0);
          yTo(0);
        });
      });

      if (!ScrollTrigger) return;

      ScrollTrigger.batch(revealItems, {
        start: 'top 88%',
        once: true,
        onEnter: (batch) => {
          gsap.fromTo(
            batch,
            { y: 18, autoAlpha: 0 },
            { y: 0, autoAlpha: 1, duration: 0.5, stagger: 0.06, ease: 'power2.out', overwrite: true }
          );
        }
      });

      ScrollTrigger.batch(productTiles, {
        start: 'top 90%',
        once: true,
        batchMax: () => (window.innerWidth < 760 ? 2 : 4),
        onEnter: (batch) => {
          gsap.fromTo(
            batch,
            { y: 24, autoAlpha: 0, scale: 0.985 },
            { y: 0, autoAlpha: 1, scale: 1, duration: 0.52, stagger: 0.055, ease: 'power2.out', overwrite: true }
          );
        }
      });

      if (motionArchive) {
        gsap.to(motionArchive, {
          yPercent: () => (window.innerWidth < 990 ? -3 : -9),
          ease: 'none',
          scrollTrigger: {
            trigger: root,
            start: 'top bottom',
            end: 'bottom top',
            scrub: 1
          }
        });
      }

      gsap.to(vectorLines.slice(0, 8), {
        x: (index) => gsap.utils.clamp(-22, 22, (index % 2 === 0 ? 1 : -1) * (10 + index * 2)),
        y: (index) => gsap.utils.clamp(-16, 16, ((index % 3) - 1) * 8),
        ease: 'none',
        scrollTrigger: {
          trigger: root,
          start: 'top bottom',
          end: 'bottom top',
          scrub: 1.2
        }
      });

      window.setTimeout(() => ScrollTrigger.refresh(), 300);
    }

    function boot() {
      initArknightsMotion();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot, { once: true });
    } else {
      boot();
    }
    window.addEventListener('load', () => initArknightsMotion(), { once: true });
  })();
</script>

{% stylesheet %}
  .p10-ip-arknights {
    --p10-void-ink: #111018;
    --p10-void-muted: #666170;
    --p10-void-blue: #4f63c6;
    --p10-void-line: rgba(17,16,24,0.14);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 36px 0 88px;
    background:
      linear-gradient(103deg, rgba(255,255,255,0.99) 0 38%, rgba(242,240,242,0.96) 38% 61%, rgba(255,255,255,0.99) 61%),
      repeating-linear-gradient(90deg, rgba(17,16,24,0.035) 0 1px, transparent 1px 92px),
      repeating-linear-gradient(0deg, rgba(17,16,24,0.025) 0 1px, transparent 1px 118px);
    color: var(--p10-void-ink);
  }

  .p10-ip-arknights::before,
  .p10-ip-arknights::after {
    position: absolute;
    z-index: 0;
    content: "";
    pointer-events: none;
  }

  .p10-ip-arknights::before {
    top: 102px;
    left: 6%;
    width: min(64vw, 940px);
    height: 470px;
    border: 1px solid rgba(17,16,24,0.12);
    border-right: 0;
    clip-path: polygon(0 0, 91% 0, 100% 100%, 6% 100%);
    transform: skewX(-11deg);
    transform-origin: top left;
  }

  .p10-ip-arknights::after {
    right: 8%;
    bottom: 18%;
    width: min(38vw, 520px);
    height: 1px;
    background: rgba(17,16,24,0.18);
    transform: rotate(-18deg);
  }

  .p10-ip-arknights *,
  .p10-ip-arknights *::before,
  .p10-ip-arknights *::after {
    box-sizing: border-box;
  }

  .p10-ip-arknights__anchor {
    position: absolute;
    top: 0;
  }

  .p10-ip-arknights__void {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .p10-ip-arknights__void span {
    position: absolute;
    display: block;
    opacity: 0.72;
  }

  .p10-ip-arknights__void span:nth-child(1) {
    top: 178px;
    left: 52%;
    width: 34vw;
    height: 1px;
    background: rgba(17,16,24,0.24);
    transform: rotate(-28deg);
  }

  .p10-ip-arknights__void span:nth-child(2) {
    top: 332px;
    right: 11%;
    width: 168px;
    height: 168px;
    border: 1px solid rgba(17,16,24,0.11);
    border-left: 0;
  }

  .p10-ip-arknights__void span:nth-child(3) {
    top: 540px;
    left: 17%;
    width: 30vw;
    height: 1px;
    background: rgba(79,99,198,0.3);
    transform: rotate(11deg);
  }

  .p10-ip-arknights__void span:nth-child(4) {
    right: 28%;
    bottom: 340px;
    width: 1px;
    height: 210px;
    background: rgba(17,16,24,0.16);
    transform: rotate(17deg);
  }

  .p10-ip-arknights__void span:nth-child(5) {
    top: 118px;
    right: 23%;
    width: 62px;
    height: 7px;
    border-top: 1px solid rgba(17,16,24,0.4);
    border-bottom: 1px solid rgba(17,16,24,0.22);
  }

  .p10-ip-arknights__void span:nth-child(6) {
    left: 7%;
    bottom: 620px;
    width: 130px;
    height: 86px;
    border: 1px dashed rgba(17,16,24,0.17);
    border-right: 0;
  }

  .p10-ip-arknights__split-field {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .p10-ip-arknights__split-field span {
    position: absolute;
    display: block;
    border: 1px solid rgba(17,16,24,0.14);
    background: rgba(255,255,255,0.32);
  }

  .p10-ip-arknights__split-field span:nth-child(1) {
    top: 132px;
    left: 7%;
    width: min(47vw, 680px);
    height: 500px;
    border-right: 0;
    clip-path: polygon(0 0, 87% 0, 100% 100%, 0 100%);
    transform: skewX(-13deg) translateX(-52px);
  }

  .p10-ip-arknights__split-field span:nth-child(2) {
    top: 206px;
    right: 5%;
    width: min(38vw, 560px);
    height: 390px;
    border-left: 3px solid rgba(17,16,24,0.82);
    clip-path: polygon(11% 0, 100% 0, 100% 100%, 0 100%);
    transform: translate(58px, -30px);
  }

  .p10-ip-arknights__split-field span:nth-child(3) {
    top: 360px;
    left: 33%;
    width: min(50vw, 760px);
    height: 2px;
    border: 0;
    background: rgba(79,99,198,0.46);
    transform: rotate(13deg);
  }

  .p10-ip-arknights__split-field span:nth-child(4) {
    top: 96px;
    left: 58%;
    width: 2px;
    height: 570px;
    border: 0;
    background: rgba(17,16,24,0.26);
    transform: rotate(15deg);
  }

  .p10-ip-arknights__motion-archive {
    position: absolute;
    inset: 74px 0 auto;
    z-index: 0;
    height: 610px;
    overflow: hidden;
    pointer-events: none;
  }

  .p10-ip-arknights__motion-panel {
    position: absolute;
    top: 42px;
    right: min(8vw, 110px);
    width: min(52vw, 720px);
    height: 420px;
    opacity: 0.18;
    clip-path: polygon(16% 0, 100% 0, 86% 100%, 0 100%);
    filter: grayscale(1) contrast(1.08);
    mix-blend-mode: multiply;
    transform: rotate(-2deg) translate3d(0,0,0);
    transform-origin: center;
    animation: p10-archive-breathe 16s ease-in-out infinite alternate;
    will-change: transform, opacity;
  }

  .p10-ip-arknights__motion-panel::before,
  .p10-ip-arknights__motion-panel::after {
    position: absolute;
    inset: 0;
    z-index: 1;
    content: "";
  }

  .p10-ip-arknights__motion-panel::before {
    background:
      repeating-linear-gradient(90deg, rgba(17,16,24,0.16) 0 1px, transparent 1px 34px),
      repeating-linear-gradient(0deg, rgba(255,255,255,0.2) 0 1px, transparent 1px 17px);
    opacity: 0.34;
    animation: p10-scan-drift 9s linear infinite;
  }

  .p10-ip-arknights__motion-panel::after {
    background:
      linear-gradient(105deg, transparent 0 42%, rgba(255,255,255,0.72) 42% 46%, transparent 46% 100%),
      linear-gradient(180deg, rgba(255,255,255,0.4), rgba(255,255,255,0.05));
    opacity: 0.58;
  }

  .p10-ip-arknights__motion-panel img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.05);
    animation: p10-image-drift 18s ease-in-out infinite alternate;
    will-change: transform;
  }

  .p10-ip-arknights__motion-logo {
    position: absolute;
    top: 248px;
    left: 46%;
    width: 118px;
    aspect-ratio: 1;
    opacity: 0.13;
    filter: grayscale(1) contrast(1.6);
    transform: rotate(12deg);
    animation: p10-logo-pulse 11s ease-in-out infinite;
    will-change: transform, opacity;
  }

  .p10-ip-arknights__motion-logo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .p10-ip-arknights__motion-slice,
  .p10-ip-arknights__motion-signal {
    position: absolute;
    display: block;
    pointer-events: none;
    will-change: translate, opacity;
  }

  .p10-ip-arknights__motion-slice:nth-of-type(1) {
    top: 108px;
    right: 23%;
    width: 360px;
    height: 18px;
    background: rgba(17,16,24,0.8);
    transform: rotate(-13deg);
    animation: p10-slice-drift-a 10s ease-in-out infinite alternate;
  }

  .p10-ip-arknights__motion-slice:nth-of-type(2) {
    top: 246px;
    right: 8%;
    width: 290px;
    height: 2px;
    background: rgba(79,99,198,0.52);
    transform: rotate(8deg);
    animation: p10-slice-drift-b 13s ease-in-out infinite alternate;
  }

  .p10-ip-arknights__motion-slice:nth-of-type(3) {
    top: 430px;
    right: 35%;
    width: 210px;
    height: 10px;
    background: rgba(17,16,24,0.18);
    transform: rotate(-20deg);
    animation: p10-slice-drift-c 12s ease-in-out infinite alternate;
  }

  .p10-ip-arknights__motion-signal:nth-of-type(4) {
    top: 168px;
    right: 14%;
    width: 1px;
    height: 310px;
    background: rgba(17,16,24,0.26);
    transform: rotate(9deg);
    animation: p10-signal-breathe 8s ease-in-out infinite alternate;
  }

  .p10-ip-arknights__motion-signal:nth-of-type(5) {
    top: 68px;
    left: 16%;
    width: min(54vw, 770px);
    height: 1px;
    background: rgba(17,16,24,0.24);
    transform: rotate(-7deg);
    animation: p10-signal-slide 15s ease-in-out infinite alternate;
  }

  .p10-ip-arknights__motion-signal:nth-of-type(6) {
    right: 11%;
    bottom: 46px;
    width: 150px;
    height: 86px;
    border: 1px solid rgba(17,16,24,0.12);
    border-left: 0;
    animation: p10-signal-box 12s ease-in-out infinite alternate;
  }

  .p10-ip-arknights__void span,
  .p10-ip-arknights__split-field span,
  .p10-ip-arknights__hero::before,
  .p10-ip-arknights__hero::after,
  .p10-ip-arknights__cut-index {
    will-change: translate, opacity;
  }

  .p10-ip-arknights__void span:nth-child(1),
  .p10-ip-arknights__split-field span:nth-child(3) {
    animation: p10-line-float-a 12s ease-in-out infinite alternate;
  }

  .p10-ip-arknights__void span:nth-child(3),
  .p10-ip-arknights__split-field span:nth-child(4) {
    animation: p10-line-float-b 16s ease-in-out infinite alternate;
  }

  .p10-ip-arknights__void span:nth-child(4),
  .p10-ip-arknights__split-field span:nth-child(1) {
    animation: p10-line-float-c 14s ease-in-out infinite alternate;
  }

  .p10-ip-arknights__void span:nth-child(2),
  .p10-ip-arknights__void span:nth-child(5),
  .p10-ip-arknights__void span:nth-child(6),
  .p10-ip-arknights__split-field span:nth-child(2) {
    animation: p10-line-pulse 10s ease-in-out infinite alternate;
  }

  .p10-ip-arknights__cut-index {
    animation: p10-index-tick 7s steps(2, end) infinite alternate;
  }

  @keyframes p10-archive-breathe {
    0% {
      opacity: 0.14;
      transform: rotate(-2deg) translate3d(-12px, 2px, 0) scale(0.995);
    }
    100% {
