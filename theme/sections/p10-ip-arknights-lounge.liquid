    .p10-ip-arknights__split-field span:nth-child(2) {
      top: 410px;
      right: -36%;
      width: 66vw;
      height: 260px;
      border-left-width: 1px;
      opacity: 0.12;
    }

    .p10-ip-arknights__split-field span:nth-child(3) {
      top: 560px;
      left: 42%;
      width: 50vw;
      opacity: 0.18;
    }

    .p10-ip-arknights__split-field span:nth-child(4) {
      top: 236px;
      right: 8px;
      left: auto;
      height: 260px;
      opacity: 0.12;
    }

    .p10-ip-arknights__cut-index {
      top: -4px;
      right: 4px;
      left: auto;
      gap: 10px;
      opacity: 0.34;
      transform: translateY(-12px) rotate(4deg);
    }

    .p10-ip-arknights__copy,
    .p10-ip-arknights__map {
      transform: none;
    }

    .p10-ip-arknights__map {
      clip-path: none;
    }

    .p10-ip-arknights__copy {
      z-index: 2;
      padding: 16px 0 18px 16px;
      border-left-width: 6px;
      background: linear-gradient(90deg, rgba(255,255,255,0.9) 0%, rgba(255,255,255,0.72) 72%, rgba(255,255,255,0) 100%);
    }

    .p10-ip-arknights__copy::before {
      top: -18px;
      left: -18px;
      width: calc(100% + 30px);
      height: calc(100% + 34px);
      opacity: 0.52;
      background: rgba(255,255,255,0.58);
    }

    .p10-ip-arknights__copy::after {
      right: 10px;
      bottom: -10px;
      width: 84px;
      height: 5px;
      opacity: 0.14;
    }

    .p10-ip-arknights__heading {
      font-size: clamp(38px, 12vw, 58px);
    }

    .p10-ip-arknights__subheading {
      max-width: 340px;
      color: rgba(17,16,24,0.7);
    }

    .p10-ip-arknights__void span:nth-child(1),
    .p10-ip-arknights__void span:nth-child(3),
    .p10-ip-arknights__void span:nth-child(4) {
      opacity: 0.34;
    }

    .p10-ip-arknights__path-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .p10-ip-arknights__path-grid a,
    .p10-ip-arknights__tile:nth-child(n) {
      transform: none;
    }

    .p10-ip-arknights__lane {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      gap: 10px !important;
    }
  }

  @media (max-width: 520px) {
    .p10-ip-arknights__map {
      padding: 14px;
    }

    .p10-ip-arknights__map-brand {
      align-items: flex-start;
    }

    .p10-ip-arknights__logo-frame {
      width: 86px;
      flex: 0 0 86px;
    }

    .p10-ip-arknights__map-brand b {
      font-size: 20px;
    }

    .p10-ip-arknights__actions {
      flex-direction: column;
    }

    .p10-ip-arknights__primary-link,
    .p10-ip-arknights__secondary-link {
      width: 100%;
    }

    .p10-ip-arknights__tile-body {
      min-height: 112px;
      padding: 11px;
    }

    .p10-ip-arknights__tile-image {
      aspect-ratio: 1 / 0.86;
      padding: 8px;
    }

    .p10-ip-arknights__tile-body h3 {
      min-height: 48px;
      font-size: 12px;
      line-height: 1.24;
    }

    .p10-ip-arknights__tile-meta {
      padding-top: 10px;
      font-size: 10px;
    }
  }
{% endstylesheet %}

