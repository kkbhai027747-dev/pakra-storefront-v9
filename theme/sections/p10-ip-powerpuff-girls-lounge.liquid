      "default": "The Powerpuff Girls"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "A bright collector zone for Powerpuff Girls badges, charms, figures, plush goods, acrylic standees, and display-box formats."
    },
    {
      "type": "url",
      "id": "primary_link",
      "label": "Primary link"
    },
    {
      "type": "url",
      "id": "badge_link",
      "label": "Badge link"
    },
    {
      "type": "url",
      "id": "charm_link",
      "label": "Charm link"
    },
    {
      "type": "url",
      "id": "figure_link",
      "label": "Figure link"
    },
    {
      "type": "url",
      "id": "plush_link",
      "label": "Plush link"
    },
    {
      "type": "url",
      "id": "standee_link",
      "label": "Standee link"
    },
    {
      "type": "url",
      "id": "back_link",
      "label": "Back link"
    },
    {
      "type": "text",
      "id": "back_label",
