{% liquid
  assign section_id = 'p10-ip-naruto-' | append: section.id
  assign naruto_collection = section.settings.source_collection
  if naruto_collection == blank
    assign naruto_collection = collections['ninjia']
  endif
  if naruto_collection == blank
    assign naruto_collection = collections['naruto']
  endif

  assign collection_url = section.settings.primary_link
  if collection_url == blank and naruto_collection != blank
    assign collection_url = naruto_collection.url
  endif
  if collection_url == blank
    assign collection_url = '/collections/ninjia'
  endif

  assign display_box_url = section.settings.display_box_link
  if display_box_url == blank
    assign display_box_url = collection_url
  endif

  assign booster_box_url = section.settings.booster_box_link
  if booster_box_url == blank
    assign booster_box_url = collection_url
  endif

  assign sea_url = section.settings.sea_link
  if sea_url == blank
    assign sea_url = collection_url
  endif

  assign chinese_url = section.settings.chinese_link
  if chinese_url == blank
    assign chinese_url = '/collections/cn-naruto-card-boxes'
  endif
%}

<section id="{{ section_id }}" class="p10-ip-naruto" data-p10-ip-naruto>
  <div class="p10-ip-naruto__anchor" id="{{ section.settings.anchor_id | default: 'naruto-collector-zone' | escape }}"></div>

  <div class="p10-ip-naruto__slashes" aria-hidden="true">
    <span class="p10-ip-naruto__slash"></span>
    <span class="p10-ip-naruto__slash"></span>
    <span class="p10-ip-naruto__slash"></span>
    <span class="p10-ip-naruto__ring"></span>
  </div>

  <div class="p10-ip-naruto__nav">
    <a class="p10-ip-naruto__back" href="{{ section.settings.back_link | default: '/collections' }}">
      <span aria-hidden="true">&larr;</span>
      <span>{{ section.settings.back_label | default: 'Back' | escape }}</span>
    </a>
  </div>

  <div class="p10-ip-naruto__hero">
    <div class="p10-ip-naruto__copy">
      <p class="p10-ip-naruto__eyebrow" data-naruto-intro>{{ section.settings.eyebrow | default: 'KAYOU-produced card route' | escape }}</p>
      <h1 class="p10-ip-naruto__heading" data-naruto-intro>{{ section.settings.heading | default: 'Naruto' | escape }}</h1>
      <p class="p10-ip-naruto__subheading" data-naruto-intro>
        {{ section.settings.subheading | default: 'A focused collector zone for Naruto sealed card boxes, booster-style formats, SEA editions, and Chinese edition paths.' | escape }}
      </p>

      <details class="p10-ip-naruto__read-more" data-naruto-intro>
        <summary>Details</summary>
        <p>{{ section.settings.subheading | default: 'A focused collector zone for Naruto sealed card boxes, booster-style formats, SEA editions, and Chinese edition paths.' | escape }}</p>
      </details>

      <div class="p10-ip-naruto__actions" data-naruto-intro>
        <a class="p10-ip-naruto__primary" href="{{ collection_url }}">Shop Naruto</a>
        <a class="p10-ip-naruto__secondary" href="#{{ section_id }}-products">Compare boxes</a>
      </div>

      <div class="p10-ip-naruto__badges" aria-label="Naruto shopping formats" data-naruto-intro>
        <span>Display boxes</span>
        <span>Booster boxes</span>
        <span>SEA edition</span>
        <span>Chinese edition</span>
      </div>
    </div>

    <div class="p10-ip-naruto__stage" aria-label="Naruto product preview" data-naruto-intro>
      <div class="p10-ip-naruto__emblem">
        <img
          src="{{ 'p10-ip-naruto.webp' | asset_url }}"
          alt="Naruto"
          width="800"
          height="800"
          loading="eager"
          decoding="async"
        >
      </div>

      <div class="p10-ip-naruto__scroll">
        <span>Mission scroll</span>
        <strong>{% if naruto_collection != blank %}{{ naruto_collection.all_products_count }} items{% else %}Card box route{% endif %}</strong>
        <small>Start from format, then check language and sealed/random notes on each product page.</small>
      </div>

      <div class="p10-ip-naruto__hero-products" aria-label="Naruto product cards">
        {% if naruto_collection != blank and naruto_collection.all_products_count > 0 %}
          {% for product in naruto_collection.products limit: 4 %}
            {% liquid
              assign hero_image_alt = product.title
              if product.featured_image != blank and product.featured_image.alt != blank
                assign hero_image_alt = product.featured_image.alt
              endif
            %}
            <a class="p10-ip-naruto__hero-product" href="{{ product.url }}" style="--p10-card: {{ forloop.index0 }};" aria-label="{{ product.title | escape }}">
              {% if product.featured_image != blank %}
                {{
                  product.featured_image
                  | image_url: width: 520
                  | image_tag:
                    loading: 'eager',
                    widths: '180, 260, 360, 520',
                    sizes: '(min-width: 990px) 10vw, 32vw',
                    alt: hero_image_alt,
                    class: 'p10-ip-naruto__hero-img'
                }}
              {% else %}
                <img
                  src="{{ 'p10-ip-naruto.webp' | asset_url }}"
                  alt="{{ product.title | escape }}"
                  width="520"
                  height="520"
                  loading="eager"
                  decoding="async"
                  class="p10-ip-naruto__hero-img"
                >
              {% endif %}
            </a>
          {% endfor %}
        {% else %}
          <span class="p10-ip-naruto__hero-product p10-ip-naruto__hero-product--empty">
            <img
              src="{{ 'p10-ip-naruto.webp' | asset_url }}"
              alt=""
              width="520"
              height="520"
              loading="eager"
              decoding="async"
              class="p10-ip-naruto__hero-img"
            >
          </span>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="p10-ip-naruto__paths" aria-label="Naruto shopping paths" data-naruto-reveal>
    <a class="p10-ip-naruto__path" href="{{ display_box_url }}">
      <span>01</span>
      <strong>Display boxes</strong>
      <small>Best for sealed box collectors</small>
    </a>
    <a class="p10-ip-naruto__path" href="{{ booster_box_url }}">
      <span>02</span>
      <strong>Booster boxes</strong>
      <small>Compare pack and box formats</small>
    </a>
    <a class="p10-ip-naruto__path" href="{{ sea_url }}">
      <span>03</span>
      <strong>SEA editions</strong>
      <small>Global-friendly language route</small>
    </a>
    <a class="p10-ip-naruto__path" href="{{ chinese_url }}">
      <span>04</span>
      <strong>Chinese editions</strong>
      <small>Mainland card-box route</small>
    </a>
  </div>

  <div class="p10-ip-naruto__products" id="{{ section_id }}-products" data-naruto-reveal>
    <div class="p10-ip-naruto__products-head">
      <div>
        <p class="p10-ip-naruto__eyebrow">Shinobi card routes</p>
        <h2>Naruto card boxes</h2>
      </div>
      <a href="{{ collection_url }}">Open collection</a>
    </div>

    <div class="p10-ip-naruto__filters" aria-label="Naruto product filters">
      <button class="is-active" type="button" data-naruto-filter="all" aria-pressed="true">All</button>
      <button type="button" data-naruto-filter="display" aria-pressed="false">Display</button>
      <button type="button" data-naruto-filter="booster" aria-pressed="false">Booster</button>
      <button type="button" data-naruto-filter="sea" aria-pressed="false">SEA</button>
      <button type="button" data-naruto-filter="chinese" aria-pressed="false">Chinese</button>
      <button type="button" data-naruto-filter="stock" aria-pressed="false">In stock</button>
    </div>

    <div class="p10-ip-naruto__lane" data-naruto-products>
      {% if naruto_collection != blank and naruto_collection.all_products_count > 0 %}
        {% for product in naruto_collection.products limit: 16 %}
          {% liquid
            assign product_image_alt = product.title
            if product.featured_image != blank and product.featured_image.alt != blank
              assign product_image_alt = product.featured_image.alt
            endif

            assign product_tags_text = product.tags | join: ' '
            assign product_variant_text = ''
            for variant in product.variants
              assign product_variant_text = product_variant_text | append: ' ' | append: variant.title
            endfor
            assign product_search_text = product.title | append: ' ' | append: product.handle | append: ' ' | append: product.type | append: ' ' | append: product_tags_text | append: ' ' | append: product_variant_text | downcase
            assign filter_tokens = 'all'

            if product_search_text contains 'display' or product_search_text contains 'box'
              assign filter_tokens = filter_tokens | append: ' display'
            endif
            if product_search_text contains 'booster' or product_search_text contains 'pack'
              assign filter_tokens = filter_tokens | append: ' booster'
            endif
            if product_search_text contains 'sea' or product_search_text contains 'english'
              assign filter_tokens = filter_tokens | append: ' sea'
            endif
            if product_search_text contains 'chinese' or product_search_text contains 'cn-' or product_search_text contains 'china'
              assign filter_tokens = filter_tokens | append: ' chinese'
            endif
            if product.available
              assign filter_tokens = filter_tokens | append: ' stock'
            endif
          %}
          <article class="p10-ip-naruto__tile" data-naruto-token="{{ filter_tokens | escape }}">
            <a class="p10-ip-naruto__tile-image" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              {% if product.featured_image != blank %}
                {{
                  product.featured_image
                  | image_url: width: 560
                  | image_tag:
                    loading: 'lazy',
                    widths: '220, 320, 420, 560',
                    sizes: '(min-width: 990px) 18vw, 44vw',
                    alt: product_image_alt,
                    class: 'p10-ip-naruto__tile-img'
                }}
              {% else %}
                <img
                  src="{{ 'p10-ip-naruto.webp' | asset_url }}"
                  alt="{{ product.title | escape }}"
                  width="560"
                  height="560"
                  loading="lazy"
                  decoding="async"
                  class="p10-ip-naruto__tile-img"
                >
              {% endif %}
            </a>
            <div class="p10-ip-naruto__tile-body">
              <span>{{ product.vendor | default: 'KAYOU' | escape }}</span>
              <h3>{{ product.title | escape }}</h3>
              <div class="p10-ip-naruto__tile-meta">
                <span>{{ product.variants.size }} option{% unless product.variants.size == 1 %}s{% endunless %}</span>
                <span>{% if product.available %}In stock{% else %}View details{% endif %}</span>
              </div>
              <div class="p10-ip-naruto__tile-price">
                <small>{% if product.price_varies %}From{% else %}Price{% endif %}</small>
                <strong>{{ product.price_min | money }}</strong>
              </div>
            </div>
          </article>
        {% endfor %}
      {% else %}
        <article class="p10-ip-naruto__empty">
          <strong>Naruto collection connected</strong>
          <span>Products will appear here when this collection is available in the theme preview.</span>
        </article>
      {% endif %}
    </div>
  </div>

  <div class="p10-ip-naruto__note" data-naruto-reveal>
    <strong>Collector note</strong>
    <span>Random sealed products vary by pack or box. No specific card, character, or rarity is guaranteed unless a product page says so.</span>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js" defer></script>
<script>
  (() => {
    const rootId = {{ section_id | json }};

    function initNarutoFilters() {
      const root = document.getElementById(rootId);
      if (!root || root.p10NarutoFiltersReady) return;

      const buttons = Array.from(root.querySelectorAll('[data-naruto-filter]'));
      const cards = Array.from(root.querySelectorAll('[data-naruto-token]'));
      if (!buttons.length || !cards.length) return;

      root.p10NarutoFiltersReady = true;

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const filter = button.getAttribute('data-naruto-filter') || 'all';
          buttons.forEach((item) => {
            const active = item === button;
            item.classList.toggle('is-active', active);
            item.setAttribute('aria-pressed', active ? 'true' : 'false');
          });

          const visibleCards = [];
          cards.forEach((card) => {
            const tokens = (card.getAttribute('data-naruto-token') || '').split(/\s+/);
            const visible = filter === 'all' || tokens.includes(filter);
            card.hidden = !visible;
            if (visible) visibleCards.push(card);
          });

          if (window.gsap && visibleCards.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            window.gsap.fromTo(
              visibleCards.slice(0, 10),
              { y: 14, autoAlpha: 0, scale: 0.98 },
              { y: 0, autoAlpha: 1, scale: 1, duration: 0.34, stagger: 0.035, ease: 'power2.out', overwrite: true }
            );
          }
        });
      });
    }

    function initNarutoMotion(tries = 0) {
      const root = document.getElementById(rootId);
      if (!root || root.p10NarutoMotionReady) return;
      if (!window.gsap) {
        if (tries < 18) window.setTimeout(() => initNarutoMotion(tries + 1), 90);
        return;
      }

      const gsap = window.gsap;
      const ScrollTrigger = window.ScrollTrigger;
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (ScrollTrigger) gsap.registerPlugin(ScrollTrigger);

      const introItems = gsap.utils.toArray(root.querySelectorAll('[data-naruto-intro]'));
      const heroCards = gsap.utils.toArray(root.querySelectorAll('.p10-ip-naruto__hero-product'));
      const revealItems = gsap.utils.toArray(root.querySelectorAll('[data-naruto-reveal]'));
      const missionMarks = gsap.utils.toArray(root.querySelectorAll('.p10-ip-naruto__slash'));
      const clampDrift = gsap.utils.clamp(-28, 28);

      root.p10NarutoMotionReady = true;
      gsap.set([...introItems, ...heroCards, ...revealItems], { autoAlpha: 1 });
      if (reduceMotion) return;

      gsap.timeline({ defaults: { duration: 0.62, ease: 'power3.out' } })
        .fromTo(introItems, { y: 22, autoAlpha: 0 }, { y: 0, autoAlpha: 1, stagger: 0.07 })
        .fromTo(heroCards, { y: 28, rotation: (index) => (index - 1.5) * 4, autoAlpha: 0 }, { y: 0, rotation: (index) => (index - 1.5) * 2, autoAlpha: 1, stagger: 0.08 }, '<0.1');

      if (!ScrollTrigger) return;

      ScrollTrigger.batch(revealItems, {
        start: 'top 86%',
        once: true,
        onEnter: (batch) => {
          gsap.fromTo(
            batch,
            { y: 24, autoAlpha: 0 },
            { y: 0, autoAlpha: 1, duration: 0.52, stagger: 0.06, ease: 'power2.out', overwrite: true }
          );
        }
      });

      gsap.to(missionMarks, {
        y: (index) => clampDrift(index % 2 === 0 ? 18 : -16),
        ease: 'none',
        scrollTrigger: {
          trigger: root,
          start: 'top bottom',
          end: 'bottom top',
          scrub: 1
        }
      });
    }

    function boot() {
      initNarutoFilters();
      initNarutoMotion();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', boot, { once: true });
    } else {
      boot();
    }
    window.addEventListener('load', () => initNarutoMotion(), { once: true });
  })();
</script>

{% stylesheet %}
  .p10-ip-naruto {
    --naruto-ink: #17100b;
    --naruto-black: #0f0c09;
    --naruto-paper: #fff2cb;
    --naruto-paper-deep: #e4a64e;
    --naruto-orange: #ff7a16;
    --naruto-red: #d8291d;
    --naruto-blue: #0e75c6;
    --naruto-metal: #d8d0c1;
    --naruto-cloud: #fffaf0;
    --naruto-muted: #72593a;
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 30px 0 76px;
    background:
      radial-gradient(circle at 10% 8%, rgba(255,255,255,0.38), transparent 22%),
      radial-gradient(circle at 86% 16%, rgba(14,117,198,0.18), transparent 28%),
      linear-gradient(180deg, #ff9c24 0, #ff7a16 228px, #ffd282 228px, #fff2cb 52%, #fff8e7 100%);
    color: var(--naruto-ink);
  }

  .p10-ip-naruto *,
  .p10-ip-naruto *::before,
  .p10-ip-naruto *::after {
    box-sizing: border-box;
  }

  .p10-ip-naruto::before,
  .p10-ip-naruto::after {
    position: absolute;
    inset: 0;
    z-index: 0;
    content: "";
    pointer-events: none;
  }

  .p10-ip-naruto::before {
    height: 720px;
    background:
      radial-gradient(circle at 18% 18%, rgba(23,16,11,0.12) 0 2px, transparent 2.6px),
      radial-gradient(circle at 22% 26%, rgba(23,16,11,0.09) 0 1.4px, transparent 2px),
      radial-gradient(circle at 74% 12%, rgba(255,255,255,0.24), transparent 18%),
      repeating-linear-gradient(0deg, rgba(90,49,15,0.12) 0 1px, transparent 1px 24px);
    opacity: 0.55;
  }

  .p10-ip-naruto::after {
    top: 222px;
    background:
      radial-gradient(circle at 11% 28%, rgba(216,41,29,0.12) 0 1.3px, transparent 1.9px),
      radial-gradient(circle at 83% 42%, rgba(14,117,198,0.11) 0 1.5px, transparent 2px),
      linear-gradient(90deg, rgba(23,16,11,0.08) 0 1px, transparent 1px),
      linear-gradient(180deg, rgba(105,59,20,0.16), rgba(255,255,255,0) 26%);
    background-size: auto, auto, 72px 100%, auto;
  }

  .p10-ip-naruto__anchor {
    position: absolute;
    top: 0;
  }

  .p10-ip-naruto__slashes {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .p10-ip-naruto__slash {
    position: absolute;
    display: block;
    width: 86px;
    height: 86px;
    border: 3px solid rgba(23,16,11,0.22);
    border-radius: 50%;
    background:
      radial-gradient(circle at 50% 50%, rgba(255,250,240,0.86) 0 22%, transparent 23%),
      conic-gradient(from 24deg, rgba(216,41,29,0.2), rgba(255,122,22,0.44), rgba(14,117,198,0.18), rgba(216,41,29,0.2));
    opacity: 0.56;
    transform: rotate(-8deg);
    will-change: transform;
  }

  .p10-ip-naruto__slash::before {
    position: absolute;
    inset: 22px 16px;
    border: 4px solid rgba(23,16,11,0.42);
    border-left: 0;
    border-radius: 0 999px 999px 0;
    content: "";
  }

  .p10-ip-naruto__slash:nth-child(1) {
    top: 104px;
    left: 12%;
  }

  .p10-ip-naruto__slash:nth-child(2) {
    top: 136px;
    right: 13%;
    width: 112px;
    height: 112px;
    opacity: 0.36;
    transform: rotate(12deg);
  }

  .p10-ip-naruto__slash:nth-child(3) {
    bottom: 260px;
    left: 4%;
    width: 62px;
    height: 62px;
    opacity: 0.3;
    transform: rotate(-18deg);
  }

  .p10-ip-naruto__ring {
    display: none;
  }

  .p10-ip-naruto__nav,
  .p10-ip-naruto__hero,
  .p10-ip-naruto__paths,
  .p10-ip-naruto__products,
  .p10-ip-naruto__note {
    position: relative;
    z-index: 2;
    width: min(100% - 48px, 1280px);
    margin: 0 auto;
  }

  .p10-ip-naruto__nav {
    display: flex;
    padding-bottom: 24px;
  }

  .p10-ip-naruto__back {
    display: inline-flex;
    min-height: 36px;
    align-items: center;
    gap: 8px;
    padding: 0 14px;
    border: 2px solid rgba(23,16,11,0.84);
    border-radius: 6px;
    background: #fff2cb;
    color: var(--naruto-ink);
    box-shadow: 4px 4px 0 rgba(23,16,11,0.14);
    font-size: 11px;
    font-weight: 900;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
  }

  .p10-ip-naruto__hero {
    display: grid;
    grid-template-columns: minmax(360px, 0.86fr) minmax(520px, 1.14fr);
    align-items: center;
    gap: clamp(36px, 5vw, 74px);
    min-height: 570px;
    padding-bottom: 62px;
  }

  .p10-ip-naruto__copy {
    max-width: 660px;
    padding: 24px 0;
  }

  .p10-ip-naruto__eyebrow {
    margin: 0 0 14px;
    color: #27170a;
    font-size: 11px;
    font-weight: 950;
    letter-spacing: 0;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .p10-ip-naruto__heading {
    margin: 0;
    color: #fff7df;
    font-size: clamp(62px, 9vw, 124px);
    font-weight: 950;
    letter-spacing: 0;
    line-height: 0.84;
    text-transform: uppercase;
    text-shadow:
      3px 3px 0 var(--naruto-red),
      7px 7px 0 rgba(14,117,198,0.82),
      0 18px 28px rgba(70,32,8,0.2);
  }

  .p10-ip-naruto__subheading {
    max-width: 560px;
    margin: 24px 0 0;
    color: rgba(39,23,10,0.82);
    font-size: 15px;
    font-weight: 720;
    line-height: 1.72;
  }

  .p10-ip-naruto__read-more {
    display: none;
  }

  .p10-ip-naruto__actions,
  .p10-ip-naruto__badges {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .p10-ip-naruto__actions {
    margin-top: 28px;
  }

  .p10-ip-naruto__primary,
  .p10-ip-naruto__secondary,
  .p10-ip-naruto__products-head > a {
    display: inline-flex;
    min-height: 42px;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 950;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition: transform 180ms ease, box-shadow 180ms ease, background-color 180ms ease;
  }

  .p10-ip-naruto__primary {
    border: 2px solid rgba(23,16,11,0.92);
    background: linear-gradient(180deg, #ffb14a, #ff7417 56%, #d7251e);
    color: #120c08;
    box-shadow: 5px 6px 0 rgba(23,16,11,0.2);
  }

  .p10-ip-naruto__secondary {
    border: 2px solid rgba(23,16,11,0.88);
    background: #fff2cb;
    color: var(--naruto-ink);
    box-shadow: 5px 6px 0 rgba(23,16,11,0.12);
  }

  .p10-ip-naruto__products-head > a {
    border: 1px solid rgba(21,18,15,0.12);
    background: #15120f;
    color: #fff4d8;
  }

  .p10-ip-naruto__primary:hover,
  .p10-ip-naruto__secondary:hover,
  .p10-ip-naruto__products-head > a:hover {
    transform: translateY(-2px);
  }

  .p10-ip-naruto__badges {
    margin-top: 22px;
  }

  .p10-ip-naruto__badges span {
    display: inline-flex;
    min-height: 30px;
    align-items: center;
    padding: 0 10px;
    border: 2px solid rgba(23,16,11,0.72);
    border-radius: 999px;
    background: rgba(255,250,240,0.76);
    color: var(--naruto-ink);
    font-size: 11px;
    font-weight: 900;
    line-height: 1;
    white-space: nowrap;
  }

  .p10-ip-naruto__stage {
    position: relative;
    min-height: 470px;
    padding: 30px 24px 24px;
    border: 3px solid rgba(23,16,11,0.9);
    border-radius: 8px;
    background:
      radial-gradient(circle at 16% 18%, rgba(216,41,29,0.11) 0 1.6px, transparent 2.4px),
      radial-gradient(circle at 88% 36%, rgba(14,117,198,0.12) 0 1.6px, transparent 2.4px),
      repeating-linear-gradient(0deg, rgba(120,75,28,0.08) 0 1px, transparent 1px 26px),
      linear-gradient(180deg, rgba(255,250,240,0.98), rgba(255,233,177,0.98));
    box-shadow: 14px 16px 0 rgba(23,16,11,0.16), 0 26px 52px rgba(88,46,10,0.16);
  }

  .p10-ip-naruto__stage::before {
    position: absolute;
    top: 22px;
    left: 50%;
    width: min(72%, 430px);
    height: 72px;
    border: 3px solid rgba(23,16,11,0.86);
    border-radius: 999px;
    background:
      radial-gradient(circle at 10% 50%, #17100b 0 5px, transparent 6px),
      radial-gradient(circle at 90% 50%, #17100b 0 5px, transparent 6px),
      linear-gradient(90deg, #15110e 0 12%, #dcd4c5 12.4% 87.6%, #15110e 88% 100%);
    box-shadow: inset 0 2px 0 rgba(255,255,255,0.56), inset 0 -5px 12px rgba(23,16,11,0.16);
    content: "";
    transform: translateX(-50%);
    pointer-events: none;
  }

  .p10-ip-naruto__emblem {
    position: relative;
    z-index: 2;
    display: flex;
    width: min(58%, 320px);
    min-height: 120px;
    align-items: center;
    justify-content: center;
    margin: 22px auto 0;
    padding: 16px 24px;
    border: 3px solid rgba(23,16,11,0.82);
    border-radius: 6px;
    background:
      radial-gradient(circle at 50% 45%, rgba(255,122,22,0.14), transparent 58%),
      #fffaf0;
    box-shadow: 0 14px 24px rgba(84,47,13,0.2);
  }

  .p10-ip-naruto__emblem img {
    display: block;
    width: 100%;
    height: 86px;
    object-fit: contain;
    filter: drop-shadow(0 12px 18px rgba(21,18,15,0.28));
  }

  .p10-ip-naruto__scroll {
    position: relative;
    z-index: 3;
    display: grid;
    max-width: 430px;
    gap: 6px;
    margin: 28px auto 0;
    padding: 16px 34px;
    border: 2px solid rgba(103,61,22,0.52);
    border-radius: 6px;
    background:
      linear-gradient(90deg, rgba(255,250,240,0.96), rgba(255,229,164,0.94)),
      repeating-linear-gradient(0deg, rgba(99,70,28,0.08) 0 1px, transparent 1px 24px);
    color: var(--naruto-ink);
    text-align: center;
    box-shadow: 0 16px 28px rgba(84,47,13,0.16);
  }

  .p10-ip-naruto__scroll::before,
  .p10-ip-naruto__scroll::after {
    position: absolute;
    top: 50%;
    width: 20px;
    height: calc(100% + 18px);
    border: 2px solid rgba(23,16,11,0.5);
    border-radius: 999px;
    background: linear-gradient(180deg, #6f3a19, #c48132 38%, #6f3a19);
    box-shadow: inset 0 0 0 3px rgba(255,236,179,0.18);
    content: "";
    transform: translateY(-50%);
  }

  .p10-ip-naruto__scroll::before {
    left: -10px;
  }

  .p10-ip-naruto__scroll::after {
    right: -10px;
  }

  .p10-ip-naruto__scroll span,
  .p10-ip-naruto__path span,
  .p10-ip-naruto__tile-body > span {
    color: var(--naruto-red);
    font-size: 10px;
    font-weight: 950;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .p10-ip-naruto__scroll strong {
    font-size: 28px;
    font-weight: 950;
    line-height: 1;
    text-transform: uppercase;
  }

  .p10-ip-naruto__scroll small {
    color: var(--naruto-muted);
    font-size: 12px;
    font-weight: 760;
    line-height: 1.35;
  }

  .p10-ip-naruto__hero-products {
    position: relative;
    z-index: 4;
    display: flex;
    justify-content: center;
    gap: 0;
    margin-top: 24px;
    min-height: 190px;
  }

  .p10-ip-naruto__hero-products::before {
    position: absolute;
    top: 18px;
    right: 6%;
    left: 6%;
    height: 52px;
    border: 2px solid rgba(23,16,11,0.24);
    border-radius: 999px;
    background: rgba(255,122,22,0.18);
    content: "";
  }

  .p10-ip-naruto__hero-product {
    display: flex;
    flex: 0 0 min(28%, 150px);
    aspect-ratio: 0.74 / 1;
    min-width: 0;
    align-items: center;
    justify-content: center;
    margin: 0 -10px;
    padding: 10px;
    border: 2px solid rgba(21,18,15,0.86);
    border-radius: 8px;
    background: #fffaf0;
    box-shadow: 9px 12px 0 rgba(23,16,11,0.14);
    text-decoration: none;
    transform: translateY(calc((var(--p10-card) - 1.5) * 7px)) rotate(calc((var(--p10-card) - 1.5) * 4deg));
    transition: transform 190ms ease, box-shadow 190ms ease;
    will-change: transform;
  }

  .p10-ip-naruto__hero-product:hover,
  .p10-ip-naruto__hero-product:focus-visible {
    z-index: 8;
    box-shadow: 12px 16px 0 rgba(23,16,11,0.18);
    transform: translateY(-12px) rotate(0deg);
  }

  .p10-ip-naruto__hero-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .p10-ip-naruto__paths {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin-top: -32px;
  }

  .p10-ip-naruto__path {
    position: relative;
    display: grid;
    min-height: 136px;
    align-content: space-between;
    gap: 10px;
    overflow: hidden;
    padding: 15px;
    border: 2px solid rgba(23,16,11,0.88);
    border-radius: 8px;
    background:
      linear-gradient(180deg, rgba(255,250,240,0.98), rgba(255,233,179,0.95)),
      repeating-linear-gradient(0deg, rgba(99,70,28,0.07) 0 1px, transparent 1px 26px);
    color: var(--naruto-ink);
    text-decoration: none;
    box-shadow: 7px 7px 0 rgba(23,16,11,0.12);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .p10-ip-naruto__path::before {
    position: absolute;
    inset: 0 0 auto;
    height: 6px;
    background: linear-gradient(90deg, var(--naruto-orange), var(--naruto-red) 46%, var(--naruto-blue));
    content: "";
  }

  .p10-ip-naruto__path::after {
    position: absolute;
    right: 14px;
    bottom: 12px;
    width: 34px;
    height: 34px;
    border: 3px solid rgba(216,41,29,0.32);
    border-radius: 50%;
    content: "";
    transform: rotate(-12deg);
  }

  .p10-ip-naruto__path strong {
    font-size: 20px;
    font-weight: 950;
    line-height: 1.05;
    text-transform: uppercase;
  }

  .p10-ip-naruto__path small {
    color: var(--naruto-muted);
    font-size: 12px;
    font-weight: 800;
    line-height: 1.25;
  }

  .p10-ip-naruto__path:hover,
  .p10-ip-naruto__path:focus-visible,
  .p10-ip-naruto__tile:hover,
  .p10-ip-naruto__tile:focus-within {
    transform: translateY(-4px);
    box-shadow: 10px 10px 0 rgba(21,18,15,0.16);
  }

  .p10-ip-naruto__products {
    margin-top: 58px;
    padding: 22px;
    border: 2px solid rgba(21,18,15,0.88);
    border-radius: 8px;
    background:
      radial-gradient(circle at 12% 20%, rgba(255,122,26,0.12) 0 1.4px, transparent 2px),
      radial-gradient(circle at 82% 40%, rgba(22,117,209,0.1) 0 1.4px, transparent 2px),
      repeating-linear-gradient(90deg, rgba(120,75,28,0.05) 0 1px, transparent 1px 34px),
      rgba(255,250,240,0.95);
    box-shadow: 14px 14px 0 rgba(23,16,11,0.1);
  }

  .p10-ip-naruto__products-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 18px;
    margin-bottom: 16px;
  }

  .p10-ip-naruto__products-head h2 {
    margin: 6px 0 0;
    color: var(--naruto-ink);
    font-size: 40px;
    font-weight: 950;
    letter-spacing: 0;
    line-height: 1;
    text-transform: uppercase;
  }

  .p10-ip-naruto__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 18px;
  }

  .p10-ip-naruto__filters button {
    display: inline-flex;
    min-height: 34px;
    align-items: center;
    padding: 0 12px;
    border: 2px solid rgba(21,18,15,0.88);
    border-radius: 999px;
    background: #fffaf0;
    color: var(--naruto-ink);
    cursor: pointer;
    font-size: 11px;
    font-weight: 950;
    line-height: 1;
    text-transform: uppercase;
  }

  .p10-ip-naruto__filters button.is-active {
    background: var(--naruto-ink);
    color: #fff4d8;
  }

  .p10-ip-naruto__lane {
    display: grid !important;
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    gap: 14px !important;
  }

  .p10-ip-naruto__tile,
  .p10-ip-naruto__empty {
    overflow: hidden;
    width: auto !important;
    min-width: 0 !important;
    max-width: none !important;
    flex: none !important;
    border: 2px solid rgba(23,16,11,0.88);
    border-radius: 8px;
    background: #fffdf7;
    box-shadow: 6px 6px 0 rgba(23,16,11,0.1);
    transition: transform 180ms ease, box-shadow 180ms ease;
  }

  .p10-ip-naruto__tile[hidden] {
    display: none !important;
  }

  .p10-ip-naruto__tile-image {
    display: flex;
    aspect-ratio: 1 / 0.78;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background:
      radial-gradient(circle at 20% 18%, rgba(216,41,29,0.13) 0 1.2px, transparent 2px),
      linear-gradient(135deg, rgba(255,122,26,0.11), rgba(14,117,198,0.09)),
      #fffaf0;
  }

  .p10-ip-naruto__tile-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .p10-ip-naruto__tile-body {
    display: flex;
    min-height: 170px;
    flex-direction: column;
    gap: 9px;
    padding: 13px;
  }

  .p10-ip-naruto__tile-body h3 {
    display: -webkit-box;
    min-height: 58px;
    margin: 0;
    overflow: hidden;
    color: var(--naruto-ink);
    font-size: 13px;
    font-weight: 900;
    line-height: 1.3;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .p10-ip-naruto__tile-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    color: var(--naruto-muted);
    font-size: 11px;
    font-weight: 850;
    line-height: 1.15;
  }

  .p10-ip-naruto__tile-price {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    min-height: 34px;
    margin-top: auto;
    padding: 8px 10px;
    border-radius: 6px;
    background: #15120f;
    color: #fff4d8;
  }

  .p10-ip-naruto__tile-price small {
    color: #ffb14a;
    font-size: 10px;
    font-weight: 950;
    line-height: 1;
    text-transform: uppercase;
  }

  .p10-ip-naruto__tile-price strong {
    font-size: 15px;
    font-weight: 950;
    line-height: 1;
  }

  .p10-ip-naruto__empty {
    grid-column: 1 / -1;
    padding: 22px;
  }

  .p10-ip-naruto__empty strong,
  .p10-ip-naruto__empty span {
    display: block;
  }

  .p10-ip-naruto__empty strong {
    font-size: 18px;
    font-weight: 950;
  }

  .p10-ip-naruto__empty span {
    margin-top: 8px;
    color: var(--naruto-muted);
    font-size: 13px;
    font-weight: 760;
  }

  .p10-ip-naruto__note {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    margin-top: 18px;
    padding: 16px 18px;
    border: 2px solid rgba(21,18,15,0.88);
    border-left: 10px solid var(--naruto-orange);
    border-radius: 8px;
    background: rgba(255,250,240,0.92);
    color: var(--naruto-muted);
    font-size: 13px;
    font-weight: 760;
    line-height: 1.5;
  }

  .p10-ip-naruto__note strong {
    flex: 0 0 auto;
    color: var(--naruto-ink);
    font-size: 12px;
    font-weight: 950;
    line-height: 1.2;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .p10-ip-naruto *,
    .p10-ip-naruto *::before,
    .p10-ip-naruto *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }

  @media (max-width: 1120px) {
    .p10-ip-naruto__hero {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
    }

    .p10-ip-naruto__copy {
      max-width: 760px;
    }

    .p10-ip-naruto__paths {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: -20px;
    }

    .p10-ip-naruto__lane {
      grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    }
  }

  @media (max-width: 760px) {
    .p10-ip-naruto {
      padding: 18px 0 54px;
      background:
        radial-gradient(circle at 8% 7%, rgba(255,255,255,0.36), transparent 24%),
        linear-gradient(180deg, #ff9522 0, #ff7a16 188px, #ffd58b 188px, #fff2cb 52%, #fff8e7 100%);
    }

    .p10-ip-naruto__nav,
    .p10-ip-naruto__hero,
    .p10-ip-naruto__paths,
    .p10-ip-naruto__products,
    .p10-ip-naruto__note {
      width: min(100% - 24px, 900px);
    }

    .p10-ip-naruto__nav {
      padding-bottom: 12px;
    }

    .p10-ip-naruto__hero {
      gap: 18px;
      padding-bottom: 28px;
    }

    .p10-ip-naruto__heading {
      font-size: 44px;
      line-height: 0.94;
      text-shadow:
        2px 2px 0 var(--naruto-red),
        5px 5px 0 rgba(14,117,198,0.76);
    }

    .p10-ip-naruto__subheading {
      display: none;
    }

    .p10-ip-naruto__read-more {
      display: block;
      margin-top: 12px;
      overflow: hidden;
      border: 2px solid rgba(23,16,11,0.78);
      border-radius: 6px;
      background: rgba(255,250,240,0.78);
      color: rgba(39,23,10,0.82);
    }

    .p10-ip-naruto__read-more summary {
      display: flex;
      min-height: 34px;
      align-items: center;
      padding: 0 12px;
      color: var(--naruto-ink);
      cursor: pointer;
      font-size: 12px;
      font-weight: 950;
      line-height: 1;
      text-transform: uppercase;
    }

    .p10-ip-naruto__read-more p {
      margin: 0;
      padding: 0 12px 12px;
      font-size: 12px;
      line-height: 1.55;
    }

    .p10-ip-naruto__actions {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
      margin-top: 14px;
    }

    .p10-ip-naruto__primary,
    .p10-ip-naruto__secondary {
      width: 100%;
      min-height: 38px;
      padding: 0 10px;
      font-size: 10px;
    }

    .p10-ip-naruto__secondary {
      background: #fff2cb;
    }

    .p10-ip-naruto__badges {
      flex-wrap: nowrap;
      gap: 6px;
      margin-top: 12px;
      overflow-x: auto;
      padding-bottom: 2px;
      scrollbar-width: none;
    }

    .p10-ip-naruto__badges::-webkit-scrollbar {
      display: none;
    }

    .p10-ip-naruto__badges span {
      min-height: 26px;
      padding: 0 8px;
      font-size: 10px;
    }

    .p10-ip-naruto__stage {
      min-height: 0;
      padding: 14px;
    }

    .p10-ip-naruto__stage::before {
      top: 14px;
      width: min(84%, 300px);
      height: 52px;
    }

    .p10-ip-naruto__emblem {
      width: min(100%, 260px);
      min-height: 92px;
      margin-top: 12px;
      padding: 12px;
    }

    .p10-ip-naruto__emblem img {
      height: 72px;
    }

    .p10-ip-naruto__scroll {
      margin-top: 12px;
      padding: 12px 26px;
      text-align: left;
    }

    .p10-ip-naruto__scroll strong {
      font-size: 22px;
    }

    .p10-ip-naruto__hero-products {
      justify-content: flex-start;
      min-height: 0;
      overflow-x: auto;
      padding: 2px 2px 10px;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
    }

    .p10-ip-naruto__hero-products::-webkit-scrollbar {
      display: none;
    }

    .p10-ip-naruto__hero-product {
      flex: 0 0 132px;
      margin: 0 8px 0 0;
      scroll-snap-align: start;
      transform: none;
    }

    .p10-ip-naruto__paths {
      display: flex;
      gap: 8px;
      margin-top: 10px;
      overflow-x: auto;
      padding-bottom: 8px;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
    }

    .p10-ip-naruto__paths::-webkit-scrollbar {
      display: none;
    }

    .p10-ip-naruto__path {
      flex: 0 0 164px;
      min-height: 96px;
      padding: 13px;
      scroll-snap-align: start;
    }

    .p10-ip-naruto__path strong {
      font-size: 15px;
    }

    .p10-ip-naruto__path small {
      font-size: 11px;
    }

    .p10-ip-naruto__products {
      margin-top: 30px;
      padding: 14px;
    }

    .p10-ip-naruto__products-head {
      align-items: flex-start;
      flex-direction: column;
      gap: 10px;
    }

    .p10-ip-naruto__products-head h2 {
      font-size: 28px;
    }

    .p10-ip-naruto__products-head > a {
      width: 100%;
    }

    .p10-ip-naruto__filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      padding-bottom: 2px;
      scrollbar-width: none;
    }

    .p10-ip-naruto__filters::-webkit-scrollbar {
      display: none;
    }

    .p10-ip-naruto__filters button {
      flex: 0 0 auto;
    }

    .p10-ip-naruto__lane {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      gap: 10px !important;
    }

    .p10-ip-naruto__tile-image {
      aspect-ratio: 1 / 0.68;
      padding: 12px;
    }

    .p10-ip-naruto__tile-body {
      min-height: 168px;
      padding: 11px;
    }

    .p10-ip-naruto__tile-body h3 {
      min-height: 66px;
      font-size: 11.5px;
      line-height: 1.3;
      overflow-wrap: anywhere;
      -webkit-line-clamp: 4;
    }

    .p10-ip-naruto__tile-meta {
      align-items: flex-start;
      flex-direction: column;
      gap: 4px;
      font-size: 10px;
    }

    .p10-ip-naruto__tile-price {
      min-height: 32px;
      padding: 7px 8px;
    }

    .p10-ip-naruto__tile-price strong {
      font-size: 14px;
    }

    .p10-ip-naruto__note {
      flex-direction: column;
      gap: 6px;
      margin-top: 14px;
    }
  }
{% endstylesheet %}

