{{ 'p10-new-arrivals-rotator.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign p10_arrival_collection = section.settings.source_collection
  assign p10_arrival_limit = section.settings.product_limit | default: 8
  assign p10_arrival_scan_limit = section.settings.scan_limit | default: 24
  assign p10_arrival_count = 0

  if p10_arrival_collection != blank and p10_arrival_collection.products.size > 0
    for product in p10_arrival_collection.products limit: p10_arrival_scan_limit
      assign p10_arrival_signature = product.title | append: ' ' | append: product.handle | append: ' ' | append: product.type | append: ' ' | append: product.tags | downcase
      assign p10_arrival_blocked = false
      if product.available == false
        assign p10_arrival_blocked = true
      endif
      if product.type == 'MLP Single Card' or product.type == 'MLP Single Card Bundle' or product.type == 'MLP Private Custom Bundle' or product.type == 'Trading Card Boxes'
        assign p10_arrival_blocked = true
      endif
      if p10_arrival_signature contains 'private' or p10_arrival_signature contains 'client hold' or p10_arrival_signature contains 'unlisted'
        assign p10_arrival_blocked = true
      endif
      if p10_arrival_signature contains 'single card' or p10_arrival_signature contains 'card brick' or p10_arrival_signature contains 'starter deck' or p10_arrival_signature contains 'trading card'
        assign p10_arrival_blocked = true
      endif
      if p10_arrival_signature contains 'booster' or p10_arrival_signature contains 'bonus' or p10_arrival_signature contains 'free gift' or p10_arrival_signature contains 'welfare'
        assign p10_arrival_blocked = true
      endif
      if p10_arrival_signature contains 'display box' or p10_arrival_signature contains 'card sleeve' or p10_arrival_signature contains 'magnetic card holder' or p10_arrival_signature contains 'armor kit'
        assign p10_arrival_blocked = true
      endif
      unless p10_arrival_blocked
        assign p10_arrival_count = p10_arrival_count | plus: 1
      endunless
    endfor
  endif
-%}

{%- if p10_arrival_count > 0 -%}
  <section
    id="p10-new-arrivals-{{ section.id }}"
    class="p10-new-arrivals"
    data-p10-new-arrivals
    data-interval="{{ section.settings.rotation_interval | default: 15 | times: 1000 }}"
  >
    <div class="p10-new-arrivals__inner">
      <header class="p10-new-arrivals__header">
        <div>
          {%- if section.settings.eyebrow != blank -%}
            <p class="p10-new-arrivals__eyebrow">{{ section.settings.eyebrow | escape }}</p>
          {%- endif -%}
          {%- if section.settings.heading != blank -%}
            <h2>{{ section.settings.heading | escape }}</h2>
          {%- endif -%}
        </div>
        {%- if section.settings.button_label != blank and p10_arrival_collection.url != blank -%}
          <a class="p10-new-arrivals__link" href="{{ p10_arrival_collection.url }}">
            {{ section.settings.button_label | escape }}
          </a>
        {%- endif -%}
      </header>

      <div class="p10-new-arrivals__shell">
        <div class="p10-new-arrivals__stage" data-p10-arrival-stage>
          {%- assign p10_arrival_index = 0 -%}
          {%- for product in p10_arrival_collection.products limit: p10_arrival_scan_limit -%}
            {%- liquid
              assign p10_arrival_signature = product.title | append: ' ' | append: product.handle | append: ' ' | append: product.type | append: ' ' | append: product.tags | downcase
              assign p10_arrival_blocked = false
              if product.available == false
                assign p10_arrival_blocked = true
              endif
              if product.type == 'MLP Single Card' or product.type == 'MLP Single Card Bundle' or product.type == 'MLP Private Custom Bundle' or product.type == 'Trading Card Boxes'
                assign p10_arrival_blocked = true
              endif
              if p10_arrival_signature contains 'private' or p10_arrival_signature contains 'client hold' or p10_arrival_signature contains 'unlisted'
                assign p10_arrival_blocked = true
              endif
              if p10_arrival_signature contains 'single card' or p10_arrival_signature contains 'card brick' or p10_arrival_signature contains 'starter deck' or p10_arrival_signature contains 'trading card'
                assign p10_arrival_blocked = true
              endif
              if p10_arrival_signature contains 'booster' or p10_arrival_signature contains 'bonus' or p10_arrival_signature contains 'free gift' or p10_arrival_signature contains 'welfare'
                assign p10_arrival_blocked = true
              endif
              if p10_arrival_signature contains 'display box' or p10_arrival_signature contains 'card sleeve' or p10_arrival_signature contains 'magnetic card holder' or p10_arrival_signature contains 'armor kit'
                assign p10_arrival_blocked = true
              endif
            -%}
            {%- if p10_arrival_blocked == false and p10_arrival_index < p10_arrival_limit -%}
              <article
                class="p10-new-arrivals__slide{% if p10_arrival_index == 0 %} is-active{% endif %}"
                data-p10-arrival-slide
                data-index="{{ p10_arrival_index }}"
                {% unless p10_arrival_index == 0 %}aria-hidden="true"{% endunless %}
              >
                <a class="p10-new-arrivals__media" href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
                  {%- if product.featured_image -%}
                    {%- assign p10_arrival_image_alt = product.featured_image.alt | default: product.title | escape -%}
                    {{ product.featured_image | image_url: width: 900 | image_tag:
                      loading: 'lazy',
                      widths: '320, 520, 720, 900',
                      sizes: '(min-width: 990px) 38vw, 92vw',
                      alt: p10_arrival_image_alt
                    }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </a>
                <div class="p10-new-arrivals__body">
                  <div>
                    {%- if product.type != blank -%}
                      <span class="p10-new-arrivals__type">{{ product.type | escape }}</span>
                    {%- endif -%}
                    <h3>
                      <a href="{{ product.url }}">{{ product.title | escape }}</a>
                    </h3>
                  </div>
                  <div class="p10-new-arrivals__meta">
                    <span>{% if product.price_varies %}From {% endif %}{{ product.price_min | money }}</span>
                    <a href="{{ product.url }}">View product</a>
                  </div>
                </div>
              </article>
              {%- assign p10_arrival_index = p10_arrival_index | plus: 1 -%}
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if p10_arrival_count > 1 -%}
          <div class="p10-new-arrivals__side">
            <div class="p10-new-arrivals__controls" aria-label="New arrival controls">
              <button type="button" data-p10-arrival-prev aria-label="Previous new arrival">&larr;</button>
              <button type="button" data-p10-arrival-next aria-label="Next new arrival">&rarr;</button>
            </div>
            <div class="p10-new-arrivals__thumbs" role="tablist" aria-label="New arrivals">
              {%- assign p10_thumb_index = 0 -%}
              {%- for product in p10_arrival_collection.products limit: p10_arrival_scan_limit -%}
                {%- liquid
                  assign p10_arrival_signature = product.title | append: ' ' | append: product.handle | append: ' ' | append: product.type | append: ' ' | append: product.tags | downcase
                  assign p10_arrival_blocked = false
                  if product.available == false
                    assign p10_arrival_blocked = true
                  endif
                  if product.type == 'MLP Single Card' or product.type == 'MLP Single Card Bundle' or product.type == 'MLP Private Custom Bundle' or product.type == 'Trading Card Boxes'
                    assign p10_arrival_blocked = true
                  endif
                  if p10_arrival_signature contains 'private' or p10_arrival_signature contains 'client hold' or p10_arrival_signature contains 'unlisted'
                    assign p10_arrival_blocked = true
                  endif
                  if p10_arrival_signature contains 'single card' or p10_arrival_signature contains 'card brick' or p10_arrival_signature contains 'starter deck' or p10_arrival_signature contains 'trading card'
                    assign p10_arrival_blocked = true
                  endif
                  if p10_arrival_signature contains 'booster' or p10_arrival_signature contains 'bonus' or p10_arrival_signature contains 'free gift' or p10_arrival_signature contains 'welfare'
                    assign p10_arrival_blocked = true
                  endif
                  if p10_arrival_signature contains 'display box' or p10_arrival_signature contains 'card sleeve' or p10_arrival_signature contains 'magnetic card holder' or p10_arrival_signature contains 'armor kit'
                    assign p10_arrival_blocked = true
                  endif
                -%}
                {%- if p10_arrival_blocked == false and p10_thumb_index < p10_arrival_limit -%}
                  <button
                    type="button"
                    class="p10-new-arrivals__thumb{% if p10_thumb_index == 0 %} is-active{% endif %}"
                    data-p10-arrival-thumb="{{ p10_thumb_index }}"
                    role="tab"
                    aria-selected="{% if p10_thumb_index == 0 %}true{% else %}false{% endif %}"
                  >
                    <span>{{ product.title | escape }}</span>
                    <small>{% if product.price_varies %}From {% endif %}{{ product.price_min | money }}</small>
                  </button>
                  {%- assign p10_thumb_index = p10_thumb_index | plus: 1 -%}
                {%- endif -%}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>

    <script src="{{ 'p10-new-arrivals-rotator.js' | asset_url }}" defer="defer"></script>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "P10 new arrivals",
  "settings": [
    {
      "type": "collection",
      "id": "source_collection",
      "label": "Source collection"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "New arrivals"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Fresh MLP merch"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "View all"
    },
    {
      "type": "range",
      "id": "product_limit",
      "label": "Products to show",
      "min": 3,
      "max": 10,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "scan_limit",
      "label": "Products to scan",
      "min": 8,
      "max": 40,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "rotation_interval",
      "label": "Rotation interval seconds",
      "min": 5,
      "max": 30,
      "step": 1,
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "P10 new arrivals"
    }
  ]
}
{% endschema %}
