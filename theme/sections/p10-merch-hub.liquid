{% javascript %}
  (() => {
    const initVisualCarousel = (carousel) => {
      if (carousel.dataset.merchVisualReady === 'true') return;
      carousel.dataset.merchVisualReady = 'true';

      const slides = Array.from(carousel.querySelectorAll('[data-merch-visual-slide]'));
      const dots = Array.from(carousel.querySelectorAll('[data-merch-visual-dot]'));
      const previous = carousel.querySelector('[data-merch-visual-prev]');
      const next = carousel.querySelector('[data-merch-visual-next]');
      const toggle = carousel.querySelector('[data-merch-visual-toggle]');
      const reduced = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
      const interval = Math.max(3000, Number(carousel.dataset.autoplayMs) || 5000);
      let index = Math.max(0, slides.findIndex((slide) => slide.classList.contains('is-active')));
      let timer = null;
      let manuallyPaused = false;
      let hovered = false;
      let focusWithin = false;
      let pointerStart = null;

      if (slides.length <= 1) return;

      const updateToggle = () => {
        if (!toggle) return;
        const paused = reduced || manuallyPaused;
        toggle.setAttribute('aria-label', paused ? 'Play product image rotation' : 'Pause product image rotation');
        const icon = toggle.querySelector('[aria-hidden="true"]');
        if (icon) icon.textContent = paused ? '\u25B6' : 'II';
      };

      const show = (requestedIndex) => {
        index = (requestedIndex + slides.length) % slides.length;
        slides.forEach((slide, slideIndex) => {
          const active = slideIndex === index;
          slide.classList.toggle('is-active', active);
          slide.setAttribute('aria-hidden', active ? 'false' : 'true');
          slide.inert = !active;
        });
        dots.forEach((dot, dotIndex) => {
          const active = dotIndex === index;
          dot.classList.toggle('is-active', active);
          dot.setAttribute('aria-current', active ? 'true' : 'false');
        });
        carousel.dataset.visualIndex = String(index);
      };

      const stopTimer = () => {
        if (timer) window.clearTimeout(timer);
        timer = null;
      };

      const schedule = () => {
        stopTimer();
        if (reduced || manuallyPaused || hovered || focusWithin || document.hidden) return;
        timer = window.setTimeout(() => {
          show(index + 1);
          schedule();
        }, interval);
      };

      previous?.addEventListener('click', () => {
        show(index - 1);
        schedule();
      });
      next?.addEventListener('click', () => {
        show(index + 1);
        schedule();
      });
      dots.forEach((dot) => {
        dot.addEventListener('click', () => {
          show(Number(dot.dataset.merchVisualDot));
          schedule();
        });
      });
      toggle?.addEventListener('click', () => {
        manuallyPaused = !manuallyPaused;
        updateToggle();
        schedule();
      });

      carousel.addEventListener('mouseenter', () => {
        hovered = true;
        stopTimer();
      });
      carousel.addEventListener('mouseleave', () => {
        hovered = false;
        schedule();
      });
      carousel.addEventListener('focusin', () => {
        focusWithin = true;
        stopTimer();
      });
      carousel.addEventListener('focusout', () => {
        window.setTimeout(() => {
          focusWithin = carousel.contains(document.activeElement);
          schedule();
        }, 0);
      });
      carousel.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        show(index + (event.key === 'ArrowRight' ? 1 : -1));
        schedule();
      });
      carousel.addEventListener('pointerdown', (event) => {
        pointerStart = { x: event.clientX, y: event.clientY };
      });
      carousel.addEventListener('pointerup', (event) => {
        if (!pointerStart) return;
        const deltaX = event.clientX - pointerStart.x;
        const deltaY = event.clientY - pointerStart.y;
        pointerStart = null;
        if (Math.abs(deltaX) < 42 || Math.abs(deltaX) <= Math.abs(deltaY)) return;
        show(index + (deltaX < 0 ? 1 : -1));
        schedule();
      });
      carousel.addEventListener('pointercancel', () => { pointerStart = null; });
      document.addEventListener('visibilitychange', schedule);

      if (reduced && toggle) toggle.hidden = true;
      show(index);
      updateToggle();
      schedule();
    };

    const initCatalog = (root) => {
      if (root.dataset.merchCatalogReady === 'true') return;
      root.dataset.merchCatalogReady = 'true';

      root.querySelectorAll('[data-merch-visual-carousel]').forEach(initVisualCarousel);

      const state = { ip: 'all', kind: 'all' };
      const cards = Array.from(root.querySelectorAll('[data-p10-merch-product]'));
      const buttons = Array.from(root.querySelectorAll('[data-filter-axis]'));
      const count = root.querySelector('[data-merch-count]');
      const empty = root.querySelector('[data-merch-empty]');
      const mobileKind = root.querySelector('[data-mobile-kind-filter]');
      const mobileKindLabel = root.querySelector('[data-mobile-kind-label]');

      const updateButtons = () => {
        buttons.forEach((button) => {
          const axis = button.dataset.filterAxis;
          const active = state[axis] === button.dataset.filterValue;
          button.classList.toggle('is-active', active);
          button.setAttribute('aria-pressed', active ? 'true' : 'false');
        });

        const activeKind = buttons.find((button) => button.dataset.filterAxis === 'kind' && button.dataset.filterValue === state.kind);
        if (mobileKindLabel && activeKind) mobileKindLabel.textContent = activeKind.textContent.trim();
      };

      const applyFilters = (animate = false) => {
        const visible = [];
        cards.forEach((card) => {
          const ipMatches = state.ip === 'all' || card.dataset.merchIp === state.ip;
          const kindMatches = state.kind === 'all' || card.dataset.merchKind === state.kind;
          const show = ipMatches && kindMatches;
          card.hidden = !show;
          if (show) visible.push(card);
        });

        if (count) count.textContent = `${visible.length} character good${visible.length === 1 ? '' : 's'} shown`;
        if (empty) empty.hidden = visible.length !== 0;

        const reduced = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
        if (animate && !reduced && window.gsap && visible.length) {
          window.gsap.fromTo(
            visible.slice(0, 12),
            { autoAlpha: 0, y: 8 },
            { autoAlpha: 1, y: 0, duration: 0.22, stagger: 0.018, ease: 'power2.out', overwrite: true, clearProps: 'transform,opacity,visibility' }
          );
        }
      };

      const setFilter = (axis, value, animate = true) => {
        if (!Object.prototype.hasOwnProperty.call(state, axis)) return;
        state[axis] = value || 'all';
        updateButtons();
        applyFilters(animate);
        if (axis === 'kind' && mobileKind?.open) mobileKind.removeAttribute('open');
      };

      buttons.forEach((button) => {
        button.addEventListener('click', () => setFilter(button.dataset.filterAxis, button.dataset.filterValue));
      });

      root.querySelectorAll('[data-merch-shortcut]').forEach((button) => {
        button.addEventListener('click', () => {
          setFilter('kind', button.dataset.merchShortcut);
          root.querySelector('.p10-merch-catalog__browse')?.scrollIntoView({ behavior: window.matchMedia?.('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
        });
      });

      root.querySelectorAll('[data-merch-reset]').forEach((button) => {
        button.addEventListener('click', () => {
          state.ip = 'all';
          state.kind = 'all';
          updateButtons();
          applyFilters(true);
        });
      });

      root.querySelector('[data-mobile-kind-close]')?.addEventListener('click', () => mobileKind?.removeAttribute('open'));

      const params = new URLSearchParams(window.location.search);
      const requestedIp = params.get('ip');
      const requestedKind = params.get('kind');
      if (requestedIp && buttons.some((button) => button.dataset.filterAxis === 'ip' && button.dataset.filterValue === requestedIp)) {
        state.ip = requestedIp;
      }
      if (requestedKind && buttons.some((button) => button.dataset.filterAxis === 'kind' && button.dataset.filterValue === requestedKind)) {
        state.kind = requestedKind;
      }

      updateButtons();
      applyFilters(false);

      const reduced = window.matchMedia?.('(prefers-reduced-motion: reduce)').matches;
      if (!reduced && window.gsap) {
        const revealItems = Array.from(root.querySelectorAll('[data-merch-reveal]'));
        window.gsap.fromTo(revealItems, { autoAlpha: 0, y: 12 }, {
          autoAlpha: 1,
          y: 0,
          duration: 0.34,
          stagger: 0.045,
          ease: 'power2.out',
          clearProps: 'transform,opacity,visibility',
        });
      }
    };

    const init = () => document.querySelectorAll('[data-p10-merch-catalog]').forEach(initCatalog);
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init, { once: true });
    } else {
      init();
    }
  })();
{% endjavascript %}

{% schema %}
{
  "name": "P10 merch catalog",
  "tag": "section",
  "class": "section-p10-merch-catalog",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "MERCH DIRECTORY" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Character Goods" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Browse plush, charms, figures, blind boxes, acrylic goods, bags, and display pieces by IP and product type." },
    { "type": "url", "id": "back_link", "label": "Back link" },
    { "type": "text", "id": "back_label", "label": "Back label", "default": "Shop by IP" },
    { "type": "collection", "id": "featured_collection", "label": "Merch source collection" },
    { "type": "url", "id": "collection_link", "label": "Shop all merch link" },
    { "type": "text", "id": "collection_label", "label": "Shop all merch label", "default": "Shop all merch" },
    { "type": "text", "id": "visual_label", "label": "Carousel label", "default": "Featured character goods" },
    { "type": "range", "id": "visual_interval", "label": "Rotation interval", "min": 3, "max": 9, "step": 1, "unit": "s", "default": 5 },
    { "type": "range", "id": "product_limit", "label": "Products to scan", "min": 12, "max": 50, "step": 1, "default": 48 }
  ],
