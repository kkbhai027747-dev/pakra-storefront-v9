{% liquid
  assign section_id = 'p10-merch-catalog-' | append: section.id
  assign merch_collection = section.settings.featured_collection
  if merch_collection == blank
    assign merch_collection = collections['plushies-merch']
  endif

  assign back_link = section.settings.back_link | default: '/collections'
  assign collection_link = section.settings.collection_link
  if collection_link == blank and merch_collection != blank
    assign collection_link = merch_collection.url
  endif
  if collection_link == blank
    assign collection_link = '/collections/plushies-merch'
  endif
%}

<section id="{{ section_id }}" class="p10-merch-catalog" data-p10-merch-catalog>
  <div class="p10-merch-catalog__shell">
    <nav class="p10-merch-catalog__crumb" aria-label="Merch navigation">
      <a href="{{ back_link }}"><span aria-hidden="true">&larr;</span> {{ section.settings.back_label | default: 'Shop by IP' | escape }}</a>
      <span aria-hidden="true">/</span>
      <span>Character goods</span>
    </nav>

    <header class="p10-merch-catalog__header" data-merch-reveal>
      <div class="p10-merch-catalog__header-copy">
        <p class="p10-merch-catalog__eyebrow">{{ section.settings.eyebrow | default: 'MERCH DIRECTORY' | escape }}</p>
        <h1>{{ section.settings.heading | default: 'Character Goods' | escape }}</h1>
        <p>{{ section.settings.subheading | default: 'Browse plush, charms, figures, blind boxes, acrylic goods, bags, and display pieces by IP and product type.' | escape }}</p>
        <div class="p10-merch-catalog__header-actions">
          <a class="p10-merch-catalog__primary-link" href="{{ collection_link }}">{{ section.settings.collection_label | default: 'Shop all merch' | escape }}</a>
          <button type="button" data-merch-shortcut="plush">Plush</button>
          <button type="button" data-merch-shortcut="charms">Charms</button>
          <button type="button" data-merch-shortcut="blind-box">Blind boxes</button>
        </div>
      </div>

      {% liquid
        assign visual_slides = section.blocks | where: 'type', 'visual_slide'
        assign visual_interval_ms = section.settings.visual_interval | default: 5 | times: 1000
      %}
      <div
        class="p10-merch-catalog__header-visual"
        aria-label="{{ section.settings.visual_label | default: 'Featured character goods' | escape }}"
        aria-roledescription="carousel"
        data-merch-visual-carousel
        data-autoplay-ms="{{ visual_interval_ms }}"
        role="region"
        tabindex="0"
      >
        <div class="p10-merch-catalog__visual-stage">
          {% if visual_slides.size > 0 %}
            {% for block in visual_slides %}
              <article
                class="p10-merch-catalog__visual-slide{% if forloop.first %} is-active{% endif %}"
                aria-hidden="{% if forloop.first %}false{% else %}true{% endif %}"
                aria-label="{{ forloop.index }} of {{ visual_slides.size }}"
                aria-roledescription="slide"
                data-merch-visual-slide
                data-slide-index="{{ forloop.index0 }}"
                role="group"
                {% unless forloop.first %}inert{% endunless %}
                {{ block.shopify_attributes }}
              >
                <img
                  src="{{ block.settings.image_asset | asset_url }}"
                  alt="{{ block.settings.image_alt | default: block.settings.heading | escape }}"
                  width="1000"
                  height="1000"
                  loading="eager"
                  decoding="async"
                >
                <div class="p10-merch-catalog__visual-feature">
                  <div>
                    <span>{{ block.settings.kicker | default: 'Featured shelf' | escape }}</span>
                    <strong>{{ block.settings.heading | default: 'Character goods' | escape }}</strong>
                  </div>
                  <button type="button" data-merch-shortcut="{{ block.settings.kind | default: 'all' }}">
                    {{ block.settings.action_label | default: 'Browse goods' | escape }} <span aria-hidden="true">&rarr;</span>
                  </button>
                </div>
              </article>
            {% endfor %}
          {% else %}
            <article
              class="p10-merch-catalog__visual-slide is-active"
              aria-hidden="false"
              aria-label="1 of 1"
              aria-roledescription="slide"
              data-merch-visual-slide
              data-slide-index="0"
              role="group"
            >
              <img
                src="{{ 'p10-merch-route-plush.webp' | asset_url }}"
                alt="My Little Pony Rainbow Dash plush in a character goods display"
                width="1000"
                height="750"
                loading="eager"
                decoding="async"
              >
              <div class="p10-merch-catalog__visual-feature">
                <div>
                  <span>Featured shelf</span>
                  <strong>Plush companions</strong>
                </div>
                <button type="button" data-merch-shortcut="plush">Browse plush <span aria-hidden="true">&rarr;</span></button>
              </div>
            </article>
          {% endif %}
        </div>

        {% if visual_slides.size > 1 %}
          <div class="p10-merch-catalog__visual-nav" aria-label="Product image controls">
            <button type="button" data-merch-visual-prev aria-label="Previous product image">&larr;</button>
            <div class="p10-merch-catalog__visual-dots" aria-label="Choose product image">
              {% for block in visual_slides %}
                <button
                  type="button"
                  class="{% if forloop.first %}is-active{% endif %}"
                  data-merch-visual-dot="{{ forloop.index0 }}"
                  aria-label="Show product image {{ forloop.index }}"
                  aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
                ></button>
              {% endfor %}
            </div>
            <button type="button" data-merch-visual-next aria-label="Next product image">&rarr;</button>
            <button type="button" data-merch-visual-toggle aria-label="Pause product image rotation"><span aria-hidden="true">II</span></button>
          </div>
        {% endif %}
      </div>
    </header>

    <section class="p10-merch-catalog__browse" aria-labelledby="{{ section_id }}-browse-heading">
      <div class="p10-merch-catalog__browse-head" data-merch-reveal>
        <div>
          <p class="p10-merch-catalog__eyebrow">IP x Product type</p>
          <h2 id="{{ section_id }}-browse-heading">Find the shelf you want.</h2>
        </div>
        <p>Use either filter on its own or combine both.</p>
      </div>

      <div class="p10-merch-catalog__filters" data-merch-reveal>
        <div class="p10-merch-catalog__filter-row p10-merch-catalog__filter-row--ip" aria-label="Filter merch by IP">
          <span class="p10-merch-catalog__filter-label">IP</span>
          <div class="p10-merch-catalog__filter-scroll">
            <button type="button" class="is-active" data-filter-axis="ip" data-filter-value="all" aria-pressed="true">All IP</button>
            <button type="button" data-filter-axis="ip" data-filter-value="mlp" aria-pressed="false">My Little Pony</button>
            <button type="button" data-filter-axis="ip" data-filter-value="powerpuff" aria-pressed="false">Powerpuff Girls</button>
            <button type="button" data-filter-axis="ip" data-filter-value="harry-potter" aria-pressed="false">Harry Potter</button>
            <button type="button" data-filter-axis="ip" data-filter-value="naruto" aria-pressed="false">Naruto</button>
            <button type="button" data-filter-axis="ip" data-filter-value="arknights" aria-pressed="false">Arknights</button>
            <button type="button" data-filter-axis="ip" data-filter-value="other" aria-pressed="false">More IP</button>
          </div>
        </div>

        <div class="p10-merch-catalog__filter-row p10-merch-catalog__filter-row--kind" aria-label="Filter merch by product type">
          <span class="p10-merch-catalog__filter-label">Product type</span>
          <div class="p10-merch-catalog__filter-scroll">
            <button type="button" class="is-active" data-filter-axis="kind" data-filter-value="all" aria-pressed="true">All types</button>
            <button type="button" data-filter-axis="kind" data-filter-value="plush" aria-pressed="false">Plush</button>
            <button type="button" data-filter-axis="kind" data-filter-value="charms" aria-pressed="false">Charms & keychains</button>
            <button type="button" data-filter-axis="kind" data-filter-value="blind-box" aria-pressed="false">Blind boxes</button>
            <button type="button" data-filter-axis="kind" data-filter-value="figures" aria-pressed="false">Figures</button>
            <button type="button" data-filter-axis="kind" data-filter-value="acrylic" aria-pressed="false">Acrylic & display</button>
            <button type="button" data-filter-axis="kind" data-filter-value="bags" aria-pressed="false">Bags & pouches</button>
            <button type="button" data-filter-axis="kind" data-filter-value="accessories" aria-pressed="false">Accessories</button>
            <button type="button" data-filter-axis="kind" data-filter-value="other" aria-pressed="false">Other goods</button>
          </div>
        </div>

        <details class="p10-merch-catalog__mobile-kind" data-mobile-kind-filter>
          <summary>Product type <span data-mobile-kind-label>All types</span></summary>
          <div class="p10-merch-catalog__mobile-panel">
            <div class="p10-merch-catalog__mobile-panel-head">
              <strong>Product type</strong>
              <button type="button" data-mobile-kind-close aria-label="Close product type filter">&times;</button>
            </div>
            <div class="p10-merch-catalog__mobile-kind-grid">
              <button type="button" class="is-active" data-filter-axis="kind" data-filter-value="all" aria-pressed="true">All types</button>
              <button type="button" data-filter-axis="kind" data-filter-value="plush" aria-pressed="false">Plush</button>
              <button type="button" data-filter-axis="kind" data-filter-value="charms" aria-pressed="false">Charms & keychains</button>
              <button type="button" data-filter-axis="kind" data-filter-value="blind-box" aria-pressed="false">Blind boxes</button>
              <button type="button" data-filter-axis="kind" data-filter-value="figures" aria-pressed="false">Figures</button>
              <button type="button" data-filter-axis="kind" data-filter-value="acrylic" aria-pressed="false">Acrylic & display</button>
              <button type="button" data-filter-axis="kind" data-filter-value="bags" aria-pressed="false">Bags & pouches</button>
              <button type="button" data-filter-axis="kind" data-filter-value="accessories" aria-pressed="false">Accessories</button>
              <button type="button" data-filter-axis="kind" data-filter-value="other" aria-pressed="false">Other goods</button>
            </div>
          </div>
        </details>

        <div class="p10-merch-catalog__filter-status">
          <p data-merch-count aria-live="polite">Loading merch...</p>
          <button type="button" data-merch-reset>Reset filters</button>
        </div>
      </div>

      {% if merch_collection != blank and merch_collection.products.size > 0 %}
        <div class="p10-merch-catalog__grid" data-merch-grid>
          {% for product in merch_collection.products limit: section.settings.product_limit %}
            {% liquid
              assign classifier = product.title | append: ' ' | append: product.type | append: ' ' | append: product.tags | downcase
              assign is_card_product = false
              if classifier contains 'trading card' or classifier contains 'sealed card' or classifier contains 'card box' or classifier contains 'card binder' or classifier contains 'booster' or classifier contains 'card pack' or classifier contains 'single card' or classifier contains 'kayou card' or classifier contains '卡牌'
                assign is_card_product = true
              endif

              assign merch_ip = 'other'
              if classifier contains 'my little pony' or classifier contains 'mlp'
                assign merch_ip = 'mlp'
              elsif classifier contains 'powerpuff'
                assign merch_ip = 'powerpuff'
              elsif classifier contains 'harry potter'
                assign merch_ip = 'harry-potter'
              elsif classifier contains 'naruto'
                assign merch_ip = 'naruto'
              elsif classifier contains 'arknights'
                assign merch_ip = 'arknights'
              endif

              assign merch_kind = 'other'
              if classifier contains 'blind box' or classifier contains 'surprise box' or classifier contains '盲盒'
                assign merch_kind = 'blind-box'
              elsif classifier contains 'plush' or classifier contains 'stuffed' or classifier contains '毛绒'
                assign merch_kind = 'plush'
              elsif classifier contains 'keychain' or classifier contains 'key chain' or classifier contains 'charm' or classifier contains 'dangler' or classifier contains 'fidget'
                assign merch_kind = 'charms'
              elsif classifier contains 'figure' or classifier contains 'figurine' or classifier contains 'doll'
                assign merch_kind = 'figures'
              elsif classifier contains 'acrylic' or classifier contains 'standee' or classifier contains 'badge' or classifier contains 'epoxy' or classifier contains 'tin badge' or classifier contains 'laser ticket' or classifier contains 'display'
                assign merch_kind = 'acrylic'
              elsif classifier contains 'bag' or classifier contains 'pouch' or classifier contains 'backpack' or classifier contains 'wallet' or classifier contains 'shoulder'
                assign merch_kind = 'bags'
              elsif classifier contains 'ring' or classifier contains 'bracelet' or classifier contains 'necklace' or classifier contains 'earring' or classifier contains 'jewelry' or classifier contains 'bottle' or classifier contains 'accessory'
                assign merch_kind = 'accessories'
              endif

              assign product_alt = product.featured_image.alt | default: product.title
            %}
            {% unless is_card_product %}
              <article
                class="p10-merch-catalog__product"
                data-p10-merch-product
                data-merch-ip="{{ merch_ip }}"
                data-merch-kind="{{ merch_kind }}"
              >
                <a href="{{ product.url }}">
                  <span class="p10-merch-catalog__media">
                    {% if product.featured_image != blank %}
                      {{
                        product.featured_image
                        | image_url: width: 800
                        | image_tag:
                          loading: 'lazy',
                          widths: '240, 360, 520, 640, 800',
                          sizes: '(min-width: 1100px) 25vw, (min-width: 760px) 33vw, 50vw',
                          alt: product_alt
                      }}
                    {% else %}
                      {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {% endif %}
                    <span class="p10-merch-catalog__kind-label">{{ merch_kind | replace: '-', ' ' | escape }}</span>
                  </span>
                  <span class="p10-merch-catalog__body">
                    <span class="p10-merch-catalog__meta">{{ product.vendor | default: 'Character goods' | escape }}</span>
                    <strong>{{ product.title | escape }}</strong>
                    <span class="p10-merch-catalog__foot">
                      <span class="p10-merch-catalog__price">{% if product.price_varies %}From {% endif %}{{ product.price_min | money }}</span>
                      {% if product.available == false and product.price_min == 1 %}
                        <small class="p10-merch-catalog__display-only">Display only</small>
                      {% elsif product.available %}
                        <small class="p10-merch-catalog__in-stock">In stock</small>
                      {% else %}
                        <small>Sold out</small>
                      {% endif %}
                    </span>
                  </span>
                </a>
              </article>
            {% endunless %}
          {% endfor %}
        </div>
      {% else %}
        <div class="p10-merch-catalog__missing">
          <strong>Merch collection unavailable</strong>
          <span>Use the IP and category links above to keep browsing.</span>
        </div>
      {% endif %}

      <div class="p10-merch-catalog__empty" data-merch-empty hidden>
        <strong>No matching character goods</strong>
        <span>Try another IP or product type.</span>
        <button type="button" data-merch-reset>Reset filters</button>
      </div>
    </section>
  </div>
</section>

{% stylesheet %}
  .p10-merch-catalog {
    --merch-ink: #16171a;
    --merch-paper: #ffffff;
    --merch-soft: #f4f5f3;
    --merch-line: #d9dce0;
    --merch-muted: #656a72;
    --merch-pink: #ed8fb1;
    --merch-mint: #79cdb6;
    --merch-yellow: #e7c74f;
    --merch-blue: #83b8ee;
    --merch-focus: #2e7fdb;
    padding: 16px 0 68px;
    background: var(--merch-paper);
    color: var(--merch-ink);
  }

  .p10-merch-catalog *,
  .p10-merch-catalog *::before,
  .p10-merch-catalog *::after {
    box-sizing: border-box;
  }

  .p10-merch-catalog__shell {
    width: min(1320px, calc(100% - 32px));
    margin: 0 auto;
  }

  .p10-merch-catalog__crumb {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 38px;
    margin-bottom: 10px;
    color: var(--merch-muted);
    font-size: 11px;
    font-weight: 750;
  }

  .p10-merch-catalog__crumb a {
    color: var(--merch-ink);
    text-decoration: none;
  }

  .p10-merch-catalog__header {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(520px, 1.1fr);
    min-height: 0;
    overflow: hidden;
    border: 1px solid var(--merch-line);
    border-radius: 8px;
    background: var(--merch-soft);
  }

  .p10-merch-catalog__header-copy {
    display: grid;
    align-content: center;
    padding: 42px;
    border-right: 1px solid var(--merch-line);
    background: #ffffff;
  }

  .p10-merch-catalog__eyebrow {
    margin: 0 0 9px;
    color: #d94c72;
    font-size: 10px;
    font-weight: 900;
    line-height: 1.2;
    letter-spacing: 0;
    text-transform: uppercase;
  }

  .p10-merch-catalog h1,
  .p10-merch-catalog h2,
  .p10-merch-catalog h3,
  .p10-merch-catalog strong {
    letter-spacing: 0;
  }

  .p10-merch-catalog h1 {
    max-width: 520px;
    margin: 0;
    font-size: 48px;
    font-weight: 900;
    line-height: 1.02;
  }

  .p10-merch-catalog__header-copy > p:not(.p10-merch-catalog__eyebrow) {
    max-width: 520px;
    margin: 16px 0 0;
    color: var(--merch-muted);
    font-size: 14px;
    line-height: 1.58;
  }

  .p10-merch-catalog__header-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin-top: 24px;
  }

  .p10-merch-catalog__header-actions a,
  .p10-merch-catalog__header-actions button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 40px;
    padding: 0 13px;
    border: 1px solid var(--merch-line);
    border-radius: 4px;
    background: #ffffff;
    color: var(--merch-ink);
    cursor: pointer;
    font: inherit;
    font-size: 11px;
    font-weight: 850;
    line-height: 1;
    letter-spacing: 0;
    text-decoration: none;
    transition: border-color 140ms ease, background-color 140ms ease, color 140ms ease, transform 140ms ease;
  }

  .p10-merch-catalog__header-actions .p10-merch-catalog__primary-link {
    border-color: var(--merch-ink);
    background: var(--merch-ink);
    color: #ffffff;
  }

  .p10-merch-catalog__header-actions a:hover,
  .p10-merch-catalog__header-actions button:hover {
    border-color: var(--merch-ink);
    transform: translateY(-2px);
  }

  .p10-merch-catalog button:active,
  .p10-merch-catalog a:active {
    transform: translateY(0);
  }

  .p10-merch-catalog button:focus-visible,
  .p10-merch-catalog a:focus-visible,
  .p10-merch-catalog summary:focus-visible {
    outline: 3px solid var(--merch-focus);
    outline-offset: 3px;
  }

  .p10-merch-catalog__header-visual {
    position: relative;
    min-width: 0;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: #eedee8;
    touch-action: pan-y;
  }

  .p10-merch-catalog__visual-stage,
  .p10-merch-catalog__visual-slide {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .p10-merch-catalog__visual-slide {
    z-index: 0;
    opacity: 0;
    visibility: hidden;
    transform: scale(0.985);
    pointer-events: none;
    transition: opacity 320ms ease, transform 420ms ease, visibility 0s linear 420ms;
  }

  .p10-merch-catalog__visual-slide.is-active {
    z-index: 1;
    opacity: 1;
    visibility: visible;
    transform: scale(1);
    pointer-events: auto;
    transition-delay: 0s;
  }

  .p10-merch-catalog__visual-slide > img {
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    max-height: none;
    object-fit: cover;
    object-position: center;
  }

  .p10-merch-catalog__visual-feature {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 18px;
    padding: 15px 18px;
    background: rgba(17, 18, 22, 0.9);
    color: #ffffff;
  }

  .p10-merch-catalog__visual-feature > div {
    display: grid;
    gap: 3px;
  }

  .p10-merch-catalog__visual-feature > div > span {
    color: #f3a7bf;
    font-size: 9px;
    font-weight: 900;
    text-transform: uppercase;
  }

  .p10-merch-catalog__visual-feature strong {
    font-size: 18px;
    line-height: 1.1;
  }

  .p10-merch-catalog__visual-feature button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    min-height: 38px;
    padding: 0 12px;
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 4px;
    background: transparent;
    color: #ffffff;
    cursor: pointer;
    font: inherit;
    font-size: 10px;
    font-weight: 850;
    white-space: nowrap;
  }

  .p10-merch-catalog__visual-nav {
    position: absolute;
    top: 14px;
    right: 14px;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 5px;
    border: 1px solid rgba(255, 255, 255, 0.52);
    border-radius: 5px;
    background: rgba(17, 18, 22, 0.78);
    color: #ffffff;
  }

  .p10-merch-catalog__visual-nav > button {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.34);
    border-radius: 3px;
    background: transparent;
    color: #ffffff;
    cursor: pointer;
    font: inherit;
    font-size: 13px;
    font-weight: 900;
  }

  .p10-merch-catalog__visual-nav > button:hover {
    border-color: #ffffff;
    background: rgba(255, 255, 255, 0.12);
  }

  .p10-merch-catalog__visual-dots {
    display: flex;
    align-items: center;
    gap: 5px;
    padding: 0 3px;
  }

  .p10-merch-catalog__visual-dots button {
    width: 7px;
    height: 7px;
    padding: 0;
    border: 1px solid rgba(255, 255, 255, 0.8);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }

  .p10-merch-catalog__visual-dots button.is-active {
    background: #ffffff;
  }

  .p10-merch-catalog__browse {
    padding-top: 44px;
  }

  .p10-merch-catalog__browse-head {
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(260px, 0.52fr);
    align-items: end;
    gap: 30px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--merch-line);
  }

  .p10-merch-catalog__browse-head h2 {
    margin: 0;
    font-size: 36px;
    font-weight: 900;
    line-height: 1.05;
  }

  .p10-merch-catalog__browse-head > p {
    margin: 0;
    color: var(--merch-muted);
    font-size: 13px;
    line-height: 1.5;
  }

  .p10-merch-catalog__filters {
    position: sticky;
    top: 0;
    z-index: 8;
    display: grid;
    gap: 10px;
    margin: 14px 0 22px;
    padding: 12px;
    border: 1px solid var(--merch-line);
    border-radius: 6px;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 8px 24px rgba(20, 22, 26, 0.08);
    backdrop-filter: blur(10px);
  }

  .p10-merch-catalog__filter-row {
    display: grid;
