{% liquid
  assign section_id = 'p10-ip-mlp-' | append: section.id
  assign mlp_collection = section.settings.source_collection
  if mlp_collection == blank
    assign mlp_collection = collections['ip-my-little-pony']
  endif

  assign card_box_url = section.settings.card_box_link
  if card_box_url == blank
    assign card_box_url = '/collections/cn-mlp-card-boxes'
  endif

  assign merch_url = section.settings.merch_link
  if merch_url == blank
    assign merch_url = '/collections/plushies-merch/mlp'
  endif

  assign tcg_url = section.settings.tcg_link
  if tcg_url == blank or tcg_url == '/pages/tcg-battle'
    assign tcg_url = '/collections/tcg-card-boxes'
  endif

  assign guide_url = section.settings.guide_link
  if guide_url == blank
    assign guide_url = '/blogs/guide/safe-shipping-mlp-kayou-cards'
  endif

  assign english_cards_url = '/collections/english-card-boxes'
  assign fun_moments_url = '/collections/cn-shadow-edition-card-boxes'
  assign moon_url = '/collections/cn-moon-edition-card-boxes'
  assign rainbow_url = '/collections/cn-rainbow-edition-card-boxes'
  assign star_url = '/collections/cn-fan-xin-edition-card-boxes'
  assign reesee_filter_url = '/collections/ip-my-little-pony/reesee'
  assign auldey_filter_url = '/collections/ip-my-little-pony/auldey'
  assign miniso_filter_url = '/collections/ip-my-little-pony/miniso'
  assign funism_url = '/collections/mlp-funism'
  assign charms_url = '/collections/mlp-baimao'

  assign card_box_collection = collections['cn-mlp-card-boxes']
  assign hero_collection = card_box_collection
  if hero_collection == blank
    assign hero_collection = mlp_collection
  endif
%}

<section id="{{ section_id }}" class="p10-ip-mlp" data-p10-ip-mlp>
  <div class="p10-ip-mlp__anchor" id="{{ section.settings.anchor_id | default: 'my-little-pony-collector-zone' | escape }}"></div>

  <div class="p10-ip-mlp__sky" aria-hidden="true">
    <span class="p10-ip-mlp__sky-band"></span>
    <span class="p10-ip-mlp__sky-band"></span>
    <span class="p10-ip-mlp__sky-band"></span>
    <span class="p10-ip-mlp__spark"></span>
    <span class="p10-ip-mlp__spark"></span>
    <span class="p10-ip-mlp__spark"></span>
    <span class="p10-ip-mlp__sticker p10-ip-mlp__sticker--moon"></span>
    <span class="p10-ip-mlp__sticker p10-ip-mlp__sticker--rainbow"></span>
  </div>

  <div class="p10-ip-mlp__nav">
    <a class="p10-ip-mlp__back" href="{{ section.settings.back_link | default: '/collections' }}">
      <span aria-hidden="true">&larr;</span>
      <span>{{ section.settings.back_label | default: 'Back' | escape }}</span>
    </a>
  </div>

  <div class="p10-ip-mlp__hero">
    <div class="p10-ip-mlp__hero-copy">
      <p class="p10-ip-mlp__eyebrow" data-mlp-hero-item>{{ section.settings.eyebrow | default: 'KAYOU My Little Pony collector zone' | escape }}</p>
      <h1 class="p10-ip-mlp__heading" data-mlp-hero-item>{{ section.settings.heading | default: 'My Little Pony' | escape }}</h1>
      <p class="p10-ip-mlp__subheading" data-mlp-hero-item>
        {{ section.settings.subheading | default: 'Shop KAYOU MLP sealed card boxes, starter decks, figures, plush, charms, and collector merch in one place.' | escape }}
      </p>

      <div class="p10-ip-mlp__series-strip" aria-label="Featured KAYOU My Little Pony paths" data-mlp-hero-item>
        <span><b>Fun</b> T2</span>
        <span><b>Rainbow</b> T3</span>
        <span><b>Moon</b> T4</span>
        <span><b>Star</b> T5</span>
      </div>

      <form class="p10-ip-mlp__search" action="/search" method="get" role="search" data-mlp-hero-item>
        <input type="hidden" name="options[prefix]" value="last">
        <input type="hidden" name="options[fields]" value="title,tag,product_type,variants.title,vendor">
        <input type="hidden" name="type" value="product">
        <label for="{{ section_id }}-search">Find</label>
        <input id="{{ section_id }}-search" type="search" name="q" placeholder="Search products or series">
        <button type="submit">Search</button>
      </form>

      <div class="p10-ip-mlp__quick-links" aria-label="Original My Little Pony category shortcuts" data-mlp-hero-item>
        <button class="is-active" type="button" data-mlp-filter="sealed-cards" data-mlp-scope="sealed-cards" data-kicker="SEALED CARD BOXES" data-title="Sealed card boxes" data-copy="Browse KAYOU MLP display boxes, booster-style releases, and starter decks. Merchandise and single cards stay in their own paths." data-url="{{ card_box_url }}" data-link-label="Browse sealed card boxes" data-mlp-products-url="/collections/cn-mlp-card-boxes/products.json?limit=24||/collections/english-card-boxes/products.json?limit=24||/collections/tcg-card-boxes/products.json?limit=24" aria-pressed="true">Card boxes</button>
        <button type="button" data-mlp-filter="chinese-cards" data-mlp-scope="sealed-cards" data-kicker="CHINESE CARD BOXES" data-title="Chinese sealed card boxes" data-copy="Browse KAYOU My Little Pony Chinese display boxes and booster-style releases without single-card or merchandise listings." data-url="{{ card_box_url }}" data-mlp-products-url="/collections/cn-mlp-card-boxes/products.json?limit=24" data-mlp-search-query="KAYOU MLP Chinese card box" aria-pressed="false">Chinese cards</button>
        <button type="button" data-mlp-filter="english-cards" data-mlp-scope="sealed-cards" data-kicker="ENGLISH CARD BOXES" data-title="English sealed card boxes" data-copy="Browse My Little Pony English sealed boxes and decks without single-card or merchandise listings." data-url="{{ english_cards_url }}" data-mlp-products-url="/collections/english-card-boxes/products.json?limit=24" data-mlp-search-query="MLP English card box" aria-pressed="false">English cards</button>
        <button type="button" data-mlp-filter="tcg" data-mlp-scope="sealed-cards" data-kicker="TCG CARD PRODUCTS" data-title="Playable TCG boxes and decks" data-copy="Browse sealed playable trading-card products separately from collectible merchandise and individual cards." data-url="{{ tcg_url }}" data-mlp-products-url="/collections/tcg-card-boxes/products.json?limit=24" data-mlp-search-query="MLP TCG cards" aria-pressed="false">TCG cards</button>
        <button type="button" data-mlp-filter="merch" data-mlp-scope="merch" data-kicker="MLP MERCH &amp; COLLECTIBLES" data-title="Merch &amp; collectibles" data-copy="Browse acrylic stands, figures, plush, charms, blind boxes, and display goods without card-box or single-card listings." data-url="{{ merch_url }}" data-link-label="Browse MLP merch" data-mlp-products-url="/collections/mlp-reesee/products.json?limit=24||/collections/mlp-auldey/products.json?limit=24||/collections/mlp-funism/products.json?limit=24||/collections/mlp-searchfun/products.json?limit=24||/collections/mlp-pinkypinky/products.json?limit=24||/collections/mlp-baimao/products.json?limit=24||/collections/mlp-kader-kaduo/products.json?limit=24" data-mlp-search-query="MLP merch" aria-pressed="false">MLP merch</button>
      </div>
    </div>

    <div class="p10-ip-mlp__stage" aria-label="My Little Pony card preview" data-mlp-hero-item>
      <div class="p10-ip-mlp__stage-glow" aria-hidden="true"></div>
      <div class="p10-ip-mlp__logo-lockup">
        <img
          src="{{ 'p10-ip-my-little-pony.webp' | asset_url }}"
          alt="My Little Pony"
          width="700"
          height="700"
          loading="eager"
          decoding="async"
        >
        <span>
          <b>KAYOU MLP boxes &amp; merch</b>
          <small>Curated product zone</small>
        </span>
      </div>

      <div class="p10-ip-mlp__stage-badges" aria-label="Collection highlights">
        <span>Sealed boxes</span>
        <span>Figures &amp; plush</span>
        <span>Merch gifts</span>
      </div>

      <div class="p10-ip-mlp__hero-products">
        {% assign hero_product_count = 0 %}
        {% if hero_collection != blank and hero_collection.all_products_count > 0 %}
          {% for product in hero_collection.products limit: 24 %}
            {% liquid
              assign hero_tags_text = product.tags | join: ' '
              assign hero_scope_text = product.title | append: ' ' | append: product.handle | append: ' ' | append: product.type | append: ' ' | append: hero_tags_text | downcase
              assign hero_is_single_card = false
              if hero_scope_text contains 'single card' or hero_scope_text contains 'single-card' or hero_scope_text contains 'single_card' or hero_scope_text contains 'card bundle' or hero_scope_text contains 'individual card'
                assign hero_is_single_card = true
              endif
            %}
            {% unless hero_is_single_card %}
            <a class="p10-ip-mlp__hero-product" href="{{ product.url }}" style="--item: {{ hero_product_count }};">
              {% if product.featured_image != blank %}
                {{
                  product.featured_image
                  | image_url: width: 420
                  | image_tag:
                    loading: 'eager',
                    widths: '220, 320, 420',
                    sizes: '(min-width: 990px) 10vw, 35vw',
                    alt: product.title,
                    class: 'p10-ip-mlp__hero-img'
                }}
              {% else %}
                <img
                  src="{{ 'p10-ip-my-little-pony.webp' | asset_url }}"
                  alt="{{ product.title | escape }}"
                  width="420"
                  height="420"
                  loading="eager"
                  decoding="async"
                  class="p10-ip-mlp__hero-img"
                >
              {% endif %}
            </a>
            {% assign hero_product_count = hero_product_count | plus: 1 %}
            {% if hero_product_count >= 4 %}{% break %}{% endif %}
            {% endunless %}
          {% endfor %}
        {% endif %}
        {% if hero_product_count == 0 %}
          <span class="p10-ip-mlp__hero-product p10-ip-mlp__hero-product--empty">
            <img
              src="{{ 'p10-ip-my-little-pony.webp' | asset_url }}"
              alt=""
              width="420"
              height="420"
              loading="eager"
              decoding="async"
              class="p10-ip-mlp__hero-img"
            >
          </span>
        {% endif %}
      </div>
    </div>
  </div>

  <div class="p10-ip-mlp__browser" id="mlp-product-paths" data-mlp-browser data-mlp-reveal aria-label="My Little Pony category browser">
    <aside class="p10-ip-mlp__sidebar" aria-label="My Little Pony page filters">
      <div class="p10-ip-mlp__sidebar-head">
        <p class="p10-ip-mlp__eyebrow">Category map</p>
        <h2>Browse MLP paths</h2>
      </div>

      <div class="p10-ip-mlp__sidebar-group">
        <span>Choose product type</span>
        <button class="p10-ip-mlp__filter is-active" type="button" data-mlp-filter="sealed-cards" data-mlp-scope="sealed-cards" data-kicker="SEALED CARD BOXES" data-title="Sealed card boxes" data-copy="Browse KAYOU MLP display boxes, booster-style releases, and starter decks. Merchandise and single cards stay in their own paths." data-url="{{ card_box_url }}" data-link-label="Browse sealed card boxes" data-mlp-products-url="/collections/cn-mlp-card-boxes/products.json?limit=24||/collections/english-card-boxes/products.json?limit=24||/collections/tcg-card-boxes/products.json?limit=24" aria-pressed="true">
          <strong>Sealed card boxes</strong>
          <small>Boxes, decks, and sealed card releases</small>
        </button>
        <button class="p10-ip-mlp__filter" type="button" data-mlp-filter="merch" data-mlp-scope="merch" data-kicker="MLP MERCH &amp; COLLECTIBLES" data-title="Merch &amp; collectibles" data-copy="Browse acrylic stands, figures, plush, charms, blind boxes, and display goods without card-box or single-card listings." data-url="{{ merch_url }}" data-link-label="Browse MLP merch" data-mlp-products-url="/collections/mlp-reesee/products.json?limit=24||/collections/mlp-auldey/products.json?limit=24||/collections/mlp-funism/products.json?limit=24||/collections/mlp-searchfun/products.json?limit=24||/collections/mlp-pinkypinky/products.json?limit=24||/collections/mlp-baimao/products.json?limit=24||/collections/mlp-kader-kaduo/products.json?limit=24" data-mlp-search-query="MLP merch" aria-pressed="false">
          <strong>Merch &amp; collectibles</strong>
          <small>Figures, plush, charms, and display goods</small>
        </button>
      </div>

      <div class="p10-ip-mlp__sidebar-group">
        <span>Cards</span>
        <button class="p10-ip-mlp__filter" type="button" data-mlp-filter="chinese-cards" data-mlp-scope="sealed-cards" data-kicker="CHINESE CARD BOXES" data-title="Chinese sealed card boxes" data-copy="Browse KAYOU My Little Pony Chinese display boxes and booster-style releases without single-card or merchandise listings." data-url="{{ card_box_url }}" data-mlp-products-url="/collections/cn-mlp-card-boxes/products.json?limit=24" data-mlp-search-query="KAYOU MLP card boxes" aria-pressed="false">
          <strong>Chinese card boxes</strong>
          <small>Sealed Chinese card releases</small>
        </button>
      </div>

      <div class="p10-ip-mlp__sidebar-group">
        <span>CCG Card Boxes</span>
        <button class="p10-ip-mlp__filter" type="button" data-mlp-filter="fun-moments" data-mlp-scope="sealed-cards" data-kicker="Fun Moments / T2" data-title="Fun Moments Edition" data-copy="Budget-friendly KAYOU MLP openings with bright character moments and accessible sealed boxes." data-url="{{ fun_moments_url }}" data-mlp-products-url="/collections/cn-shadow-edition-card-boxes/products.json?limit=24" data-mlp-search-query="KAYOU MLP Fun Moments Edition" aria-pressed="false">
          <strong>Fun Moments Edition</strong>
          <small>Accessible box path</small>
        </button>
        <button class="p10-ip-mlp__filter" type="button" data-mlp-filter="moon" data-mlp-scope="sealed-cards" data-kicker="Moon / T4" data-title="Moon Edition" data-copy="Browse Moon Edition sealed boxes and booster-style products in a focused collector path." data-url="{{ moon_url }}" data-mlp-products-url="/collections/cn-moon-edition-card-boxes/products.json?limit=24" data-mlp-search-query="KAYOU MLP Moon Edition box" aria-pressed="false">
          <strong>Moon Edition</strong>
          <small>Sealed box path</small>
        </button>
        <button class="p10-ip-mlp__filter" type="button" data-mlp-filter="rainbow" data-mlp-scope="sealed-cards" data-kicker="Rainbow / T3" data-title="Rainbow Edition" data-copy="Colorful card art and balanced chase paths for Rainbow Edition collectors." data-url="{{ rainbow_url }}" data-mlp-products-url="/collections/cn-rainbow-edition-card-boxes/products.json?limit=24" data-mlp-search-query="KAYOU MLP Rainbow Edition" aria-pressed="false">
          <strong>Rainbow Edition</strong>
          <small>Colorful box path</small>
        </button>
        <button class="p10-ip-mlp__filter" type="button" data-mlp-filter="star" data-mlp-scope="sealed-cards" data-kicker="Star / T5" data-title="Star Edition" data-copy="Premium display cards and collector boxes for the Star Edition path." data-url="{{ star_url }}" data-mlp-products-url="/collections/cn-fan-xin-edition-card-boxes/products.json?limit=24" data-mlp-search-query="KAYOU MLP Star Edition" aria-pressed="false">
          <strong>Star Edition</strong>
          <small>Premium box path</small>
        </button>
      </div>

      <div class="p10-ip-mlp__sidebar-group">
        <span>Merch by Brand</span>
        <button class="p10-ip-mlp__filter" type="button" data-mlp-filter="reesee" data-mlp-scope="merch" data-kicker="Merch by Brand" data-title="Reesee plush and merch" data-copy="Soft goods, plush, and gift-friendly My Little Pony collectible goods." data-url="{{ reesee_filter_url }}" data-mlp-products-url="/collections/mlp-reesee/products.json?limit=24" data-mlp-search-query="Reesee MLP" aria-pressed="false">
          <strong>Reesee plush and merch</strong>
          <small>Soft goods and gifts</small>
        </button>
        <button class="p10-ip-mlp__filter" type="button" data-mlp-filter="auldey" data-mlp-scope="merch" data-kicker="Merch by Brand" data-title="AULDEY toys and dioramas" data-copy="Character toys and diorama-style collectibles grouped away from trading cards." data-url="{{ auldey_filter_url }}" data-mlp-search-query="AULDEY MLP" aria-pressed="false">
          <strong>AULDEY toys and dioramas</strong>
          <small>Character toys</small>
        </button>
        <button class="p10-ip-mlp__filter" type="button" data-mlp-filter="miniso" data-mlp-scope="merch" data-kicker="Merch by Brand" data-title="MINISO figures" data-copy="Figure and blind-box browsing for My Little Pony display collectors." data-url="{{ miniso_filter_url }}" data-mlp-search-query="MINISO MLP" aria-pressed="false">
          <strong>MINISO figures</strong>
          <small>Figures and blind boxes</small>
        </button>
        <button class="p10-ip-mlp__filter" type="button" data-mlp-filter="charms" data-mlp-scope="merch" data-kicker="Merch by Brand" data-title="Keychains and charms" data-copy="Small display goods, charms, and easy gift add-ons in the My Little Pony zone." data-url="{{ charms_url }}" data-mlp-products-url="/collections/mlp-baimao/products.json?limit=24" data-mlp-search-query="MLP charm keychain" aria-pressed="false">
          <strong>Keychains and charms</strong>
          <small>Small display goods</small>
        </button>
      </div>

      <p class="p10-ip-mlp__sidebar-note">This zone is reserved for boxed products and merchandise. Single cards remain in the separate Single Cards area.</p>
    </aside>

    <div class="p10-ip-mlp__mobile-picker" data-mlp-mobile-picker>
      <label for="{{ section_id }}-mobile-path">
        <span>MLP path</span>
        <strong data-mlp-mobile-current>Sealed card boxes</strong>
      </label>
      <select id="{{ section_id }}-mobile-path" data-mlp-mobile-select aria-label="Choose My Little Pony product path"></select>
    </div>

    <div class="p10-ip-mlp__result-stage" data-mlp-result-stage aria-live="polite">
      <div class="p10-ip-mlp__result-head">
        <div>
          <p class="p10-ip-mlp__eyebrow" data-mlp-result-kicker>SEALED CARD BOXES</p>
          <h2 data-mlp-result-title>Sealed card boxes</h2>
          <p data-mlp-result-copy>Browse KAYOU MLP display boxes, booster-style releases, and starter decks. Merchandise and single cards stay in their own paths.</p>
        </div>
        <div class="p10-ip-mlp__result-actions">
          <a href="{{ card_box_url }}" data-mlp-result-link>Browse sealed card boxes</a>
          <span data-mlp-result-count>Showing preview items</span>
        </div>
      </div>

      <div class="p10-ip-mlp__lane p10-ip-mlp__lane--filtered" data-mlp-results>
      {% if card_box_collection != blank and card_box_collection.all_products_count > 0 %}
        {% assign rendered_product_count = 0 %}
        {% assign rendered_product_handles = '|' %}
        {% for product in card_box_collection.products limit: 250 %}
          {% liquid
            assign product_image_alt = product.title
            if product.featured_image != blank and product.featured_image.alt != blank
              assign product_image_alt = product.featured_image.alt
            endif
            assign product_tags_text = product.tags | join: ' '
            assign product_search_text = product.title | append: ' ' | append: product.handle | append: ' ' | append: product.type | append: ' ' | append: product_tags_text | downcase
            assign product_handle_token = '|' | append: product.handle | append: '|'
            assign product_is_mlp = false
            assign product_is_single_card = false
            assign product_is_merch = false
            assign product_is_duplicate = false
            if product_search_text contains 'mlp' or product_search_text contains 'my little pony'
              assign product_is_mlp = true
            endif
            if product_search_text contains 'single card' or product_search_text contains 'single-card' or product_search_text contains 'single_card' or product_search_text contains 'card bundle' or product_search_text contains 'individual card'
              assign product_is_single_card = true
            endif
            if product_search_text contains 'collectible merch' or product_search_text contains 'collector merch' or product_search_text contains 'mlp merch' or product_search_text contains 'plushies & merch' or product_search_text contains 'acrylic' or product_search_text contains 'plush' or product_search_text contains 'keychain' or product_search_text contains 'charm' or product_search_text contains 'sticker' or product_search_text contains 'figure' or product_search_text contains 'blind box'
              assign product_is_merch = true
            endif
            if rendered_product_handles contains product_handle_token
              assign product_is_duplicate = true
            endif
            assign filter_tokens = 'all'

            if product_search_text contains 'card' or product_search_text contains 'kayou' or product_search_text contains 'ccg'
              assign filter_tokens = filter_tokens | append: ' cards'
            endif
            if product_search_text contains 'box' or product_search_text contains 'booster' or product_search_text contains 'sealed' or product_search_text contains 'display'
              assign filter_tokens = filter_tokens | append: ' card-boxes'
            endif
            if product_search_text contains 'fun moments' or product_search_text contains 'shadow'
              assign filter_tokens = filter_tokens | append: ' fun-moments card-boxes cards'
            endif
            if product_search_text contains 'moon' or product_search_text contains 't4w'
              assign filter_tokens = filter_tokens | append: ' moon cards'
            endif
            if product_search_text contains 'rainbow'
              assign filter_tokens = filter_tokens | append: ' rainbow cards'
            endif
            if product_search_text contains 'star' or product_search_text contains 'fan xin' or product_search_text contains 'fanxin'
              assign filter_tokens = filter_tokens | append: ' star cards'
            endif
            if product_search_text contains 'tcg'
              assign filter_tokens = filter_tokens | append: ' tcg cards'
            endif
            if product_search_text contains 'reesee'
              assign filter_tokens = filter_tokens | append: ' reesee merch'
            endif
            if product_search_text contains 'auldey'
              assign filter_tokens = filter_tokens | append: ' auldey merch'
            endif
            if product_search_text contains 'miniso'
              assign filter_tokens = filter_tokens | append: ' miniso merch'
            endif
            if product_search_text contains 'charm' or product_search_text contains 'keychain' or product_search_text contains 'baimao'
              assign filter_tokens = filter_tokens | append: ' charms merch'
            endif
            if product_search_text contains 'plush' or product_search_text contains 'figure' or product_search_text contains 'blind box' or product_search_text contains 'diorama' or product_search_text contains 'toy'
              assign filter_tokens = filter_tokens | append: ' merch'
            endif
          %}
          {% if product_is_mlp and product_is_single_card == false and product_is_merch == false and product_is_duplicate == false %}
          <article class="p10-ip-mlp__tile" data-mlp-result-card data-mlp-local-card data-mlp-filter-tags="{{ filter_tokens | strip | escape }}">
            <a class="p10-ip-mlp__tile-image" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              {% if product.featured_image != blank %}
                {{
                  product.featured_image
                  | image_url: width: 520
                  | image_tag:
                    loading: 'lazy',
                    widths: '220, 320, 420, 520',
                    sizes: '(min-width: 990px) 18vw, 44vw',
                    alt: product_image_alt,
                    class: 'p10-ip-mlp__tile-img'
                }}
              {% else %}
                <img
                  src="{{ 'p10-ip-my-little-pony.webp' | asset_url }}"
                  alt="{{ product.title | escape }}"
                  width="520"
                  height="520"
                  loading="lazy"
                  decoding="async"
                  class="p10-ip-mlp__tile-img"
                >
              {% endif %}
            </a>
            <div class="p10-ip-mlp__tile-body">
              <h3>{{ product.title | escape }}</h3>
              <div class="p10-ip-mlp__tile-meta">
                <span>{{ product.variants.size }} option{% unless product.variants.size == 1 %}s{% endunless %}</span>
                <span>{{ product.price_min | money }}</span>
              </div>
            </div>
          </article>
          {% assign rendered_product_handles = rendered_product_handles | append: product.handle | append: '|' %}
          {% assign rendered_product_count = rendered_product_count | plus: 1 %}
          {% if rendered_product_count >= 24 %}{% break %}{% endif %}
          {% endif %}
        {% endfor %}
      {% else %}
        <article class="p10-ip-mlp__empty">
          <strong>My Little Pony collection connected</strong>
          <span>Products will appear here when the collection is available in this theme preview.</span>
        </article>
        {% endif %}
        <div class="p10-ip-mlp__selection-empty" data-mlp-empty hidden>
          <strong>No preview item matched this filter yet.</strong>
          <span>Use the full collection link above to browse the complete live path for this category.</span>
        </div>
      </div>
    </div>
  </div>

  <div class="p10-ip-mlp__guide-band" aria-label="Collector guide shortcuts" data-mlp-reveal>
    <div>
      <p class="p10-ip-mlp__eyebrow">Collector guide</p>
      <h2>Choose by format first</h2>
    </div>
    <div class="p10-ip-mlp__guide-grid">
      <a href="{{ guide_url }}">
        <span>Shipping notes</span>
        <strong>Card protection and buying confidence</strong>
      </a>
      <a href="/pages/mlp-t4">
        <span>Moon guide</span>
        <strong>Visual references for Moon Edition collectors</strong>
      </a>
      <a href="/pages/mlp-t3">
        <span>Rainbow guide</span>
        <strong>Series browsing before choosing a product</strong>
      </a>
    </div>
  </div>

  <div class="p10-ip-mlp__buyer-note" data-mlp-reveal>
    <strong>Buyer note</strong>
    <span>Random sealed products vary by pack or box. Card selection, characters, and rarity are not guaranteed unless a product page states it directly.</span>
  </div>
</section>

<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js" defer></script>
<script>
  (() => {
    const rootId = {{ section_id | json }};

    function initMlpFilters() {
      const root = document.getElementById(rootId);
      if (!root || root.p10MlpFilterReady) return;

      const buttons = Array.from(root.querySelectorAll('[data-mlp-filter]'));
      const localCards = Array.from(root.querySelectorAll('[data-mlp-local-card]'));
      const resultGrid = root.querySelector('[data-mlp-results]');
      const resultStage = root.querySelector('[data-mlp-result-stage]');
      const kicker = root.querySelector('[data-mlp-result-kicker]');
      const title = root.querySelector('[data-mlp-result-title]');
      const copy = root.querySelector('[data-mlp-result-copy]');
      const link = root.querySelector('[data-mlp-result-link]');
      const count = root.querySelector('[data-mlp-result-count]');
      const empty = root.querySelector('[data-mlp-empty]');
      const mobileSelect = root.querySelector('[data-mlp-mobile-select]');
      const mobileCurrent = root.querySelector('[data-mlp-mobile-current]');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
      const fallbackImage = {{ 'p10-ip-my-little-pony.webp' | asset_url | json }};
      const remoteCache = new Map();

      if (!buttons.length || !resultStage || !resultGrid) return;
      root.p10MlpFilterReady = true;

      const cardMatches = (card, filter) => {
        if (filter === 'all') return true;
        return (card.dataset.mlpFilterTags || '').split(/\s+/).includes(filter);
      };

      const escapeHtml = (value) => String(value || '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');

      const money = (value) => {
        const amount = Number.parseFloat(String(value || '').replace(/[^\d.]/g, ''));
        if (!Number.isFinite(amount) || amount <= 0) return '';
        return `$${amount.toFixed(2)}`;
      };

      const cleanProductUrl = (product) => {
        if (product.url) return String(product.url).split('?')[0];
        if (product.handle) return `/products/${product.handle}`;
        return '#';
      };

      const normaliseTags = (tags) => Array.isArray(tags)
        ? tags
        : String(tags || '').split(',').map((tag) => tag.trim()).filter(Boolean);

      const normaliseCollectionProduct = (product) => ({
        title: product.title || '',
        handle: product.handle || '',
        url: cleanProductUrl(product),
        image: product.images?.[0]?.src || product.featured_image || fallbackImage,
        imageAlt: product.images?.[0]?.alt || product.title || 'My Little Pony product',
        optionCount: product.variants?.length || 1,
        price: money(product.variants?.[0]?.price || product.price_min || product.price),
        tags: normaliseTags(product.tags),
        productType: product.product_type || product.type || ''
      });

      const normaliseSearchProduct = (product) => ({
        title: product.title || '',
        handle: product.handle || '',
        url: cleanProductUrl(product),
        image: product.featured_image?.url || product.image || fallbackImage,
        imageAlt: product.featured_image?.alt || product.title || 'My Little Pony product',
        optionCount: product.variants?.length || 1,
        price: money(product.price_min || product.price),
        tags: normaliseTags(product.tags),
        productType: product.product_type || product.type || ''
      });

      const productLooksMlp = (product) => {
        const text = `${product.title || ''} ${product.handle || ''} ${product.productType || ''} ${(product.tags || []).join(' ')}`.toLowerCase();
        return text.includes('mlp') || text.includes('my little pony');
      };

      const productIsSingleCard = (product) => {
        const text = `${product.title || ''} ${product.handle || ''} ${product.productType || ''} ${(product.tags || []).join(' ')}`.toLowerCase();
        return text.includes('single card')
          || text.includes('single-card')
          || text.includes('single_card')
          || text.includes('card bundle')
          || text.includes('individual card');
      };

      const productIsMerch = (product) => {
        const text = `${product.title || ''} ${product.handle || ''} ${product.productType || ''} ${(product.tags || []).join(' ')}`.toLowerCase();
        return text.includes('collectible merch')
          || text.includes('collector merch')
          || text.includes('mlp merch')
          || text.includes('plushies & merch')
          || text.includes('acrylic')
          || text.includes('plush')
          || text.includes('keychain')
          || text.includes('charm')
          || text.includes('sticker')
          || text.includes('figure')
          || text.includes('blind box')
          || text.includes('diorama')
          || text.includes('display goods');
      };

      const productIsSealedCardProduct = (product) => {
        if (productIsSingleCard(product) || productIsMerch(product)) return false;
        const text = `${product.title || ''} ${product.handle || ''} ${product.productType || ''} ${(product.tags || []).join(' ')}`.toLowerCase();
        return text.includes('trading cards')
          || text.includes('trading card box')
          || text.includes('card packs')
          || text.includes('booster box')
          || text.includes('starter deck')
          || text.includes('sealed card')
          || text.includes('mlp card box')
          || text.includes('ccg cards')
          || text.includes('tcg cards');
      };

      const productMatchesScope = (product, scope) => {
        if (scope === 'sealed-cards') return productIsSealedCardProduct(product);
        if (scope === 'merch') return productIsMerch(product) && !productIsSealedCardProduct(product);
        return true;
      };

      const fetchRemoteProducts = async (button) => {
        const cacheKey = [
          button.dataset.mlpFilter || '',
          button.dataset.mlpScope || '',
          button.dataset.mlpProductsUrl || '',
          button.dataset.mlpSearchQuery || ''
        ].join('|');
        if (remoteCache.has(cacheKey)) return remoteCache.get(cacheKey);

        let products = [];
        const productUrls = String(button.dataset.mlpProductsUrl || '')
          .split('||')
          .map((url) => url.trim())
          .filter(Boolean);
        if (productUrls.length) {
          const productGroups = await Promise.all(productUrls.map(async (productsUrl) => {
            try {
              const response = await fetch(productsUrl, { headers: { Accept: 'application/json' } });
              if (!response.ok) return [];
              const data = await response.json();
              return (data.products || []).map(normaliseCollectionProduct);
            } catch (error) {
              console.warn('MLP category collection fetch failed', productsUrl, error);
              return [];
            }
          }));
          const longestGroup = Math.max(0, ...productGroups.map((group) => group.length));
          for (let productIndex = 0; productIndex < longestGroup; productIndex += 1) {
            productGroups.forEach((group) => {
              if (group[productIndex]) products.push(group[productIndex]);
            });
          }
        }

        const searchQuery = button.dataset.mlpSearchQuery;
        if (!products.length && searchQuery) {
          try {
            const suggestUrl = `/search/suggest.json?q=${encodeURIComponent(searchQuery)}&resources[type]=product&resources[limit]=24&resources[options][unavailable_products]=last&resources[options][fields]=title,tag,product_type,variants.title,vendor`;
            const response = await fetch(suggestUrl, { headers: { Accept: 'application/json' } });
            if (response.ok) {
              const data = await response.json();
              products = (data.resources?.results?.products || [])
                .map(normaliseSearchProduct)
                .filter((product) => product.title);
            }
          } catch (error) {
            console.warn('MLP category search fetch failed', error);
          }
        }

        const seenProductUrls = new Set();
        const productScope = button.dataset.mlpScope || '';
        products = products
          .filter((product) => product.title && productLooksMlp(product) && !productIsSingleCard(product))
          .filter((product) => productMatchesScope(product, productScope))
          .filter((product) => {
            const key = product.url || product.handle || product.title;
            if (seenProductUrls.has(key)) return false;
            seenProductUrls.add(key);
            return true;
          })
          .slice(0, 24);
        remoteCache.set(cacheKey, products);
        return products;
      };

      const renderRemoteCard = (product, filter) => `
        <article class="p10-ip-mlp__tile" data-mlp-result-card data-mlp-remote-card data-mlp-remote-filter="${escapeHtml(filter)}" data-mlp-filter-tags="${escapeHtml(filter)}">
          <a class="p10-ip-mlp__tile-image" href="${escapeHtml(product.url)}" aria-label="${escapeHtml(product.title)}">
            <img
              src="${escapeHtml(product.image || fallbackImage)}"
              alt="${escapeHtml(product.imageAlt || product.title)}"
              width="520"
              height="520"
              loading="lazy"
              decoding="async"
              class="p10-ip-mlp__tile-img"
            >
          </a>
          <div class="p10-ip-mlp__tile-body">
            <h3>${escapeHtml(product.title)}</h3>
            <div class="p10-ip-mlp__tile-meta">
              <span>${product.optionCount || 1} option${product.optionCount === 1 ? '' : 's'}</span>
              <span>${escapeHtml(product.price || '')}</span>
            </div>
          </div>
        </article>
      `;

      const animateSelection = (visibleCards) => {
        if (!window.gsap || reduceMotion.matches) return;
        const gsap = window.gsap;
        const cards = gsap.utils.toArray(visibleCards).slice(0, 12);
        const yByGrid = gsap.utils.distribute({ base: 10, amount: 12, from: 'center' });
        gsap.fromTo(
          resultStage,
          { y: 8, autoAlpha: 0.88 },
          { y: 0, autoAlpha: 1, duration: 0.24, ease: 'power2.out', overwrite: true }
        );
        if (cards.length) {
          gsap.fromTo(
            cards,
            { y: (index, target, targets) => yByGrid(index, target, targets), scale: 0.975, autoAlpha: 0 },
            { y: 0, scale: 1, autoAlpha: 1, duration: 0.36, stagger: { each: 0.028, from: 'center' }, ease: 'power2.out', overwrite: true }
          );
        }
      };

      const setVisibleCards = (visibleCards, filter, animate) => {
        if (empty) empty.hidden = visibleCards.length > 0;
        if (count) {
          count.textContent = visibleCards.length
            ? `${visibleCards.length} shown on this page`
            : 'Open full collection for this path';
        }
        root.dataset.mlpActiveFilter = filter;
        if (animate) animateSelection(visibleCards);
      };

      const buildMobileSelect = () => {
        if (!mobileSelect || mobileSelect.options.length) return;
        const groups = Array.from(root.querySelectorAll('.p10-ip-mlp__sidebar-group'));
        groups.forEach((group) => {
          const groupLabel = group.querySelector(':scope > span')?.textContent?.trim() || 'MLP paths';
          const optgroup = document.createElement('optgroup');
          optgroup.label = groupLabel;

          Array.from(group.querySelectorAll('.p10-ip-mlp__filter')).forEach((button) => {
            const option = document.createElement('option');
            option.value = button.dataset.mlpFilter || '';
            option.textContent = button.querySelector('strong')?.textContent?.trim() || button.textContent.trim();
            optgroup.appendChild(option);
          });

          if (optgroup.children.length) mobileSelect.appendChild(optgroup);
        });
      };

      const applyFilter = async (sourceButton, animate = true) => {
        const filter = sourceButton.dataset.mlpFilter || 'all';
        buttons.forEach((button) => {
          const active = button.dataset.mlpFilter === filter;
          button.classList.toggle('is-active', active);
          button.setAttribute('aria-pressed', active ? 'true' : 'false');
        });

        if (kicker) kicker.textContent = sourceButton.dataset.kicker || sourceButton.textContent.trim();
        if (title) title.textContent = sourceButton.dataset.title || sourceButton.textContent.trim();
        if (copy) copy.textContent = sourceButton.dataset.copy || '';
        if (link) {
          link.textContent = sourceButton.dataset.linkLabel || 'Open full collection';
          link.hidden = !sourceButton.dataset.url;
          if (sourceButton.dataset.url) link.setAttribute('href', sourceButton.dataset.url);
        }
        if (mobileSelect && Array.from(mobileSelect.options).some((option) => option.value === filter)) {
          mobileSelect.value = filter;
        }
        if (mobileCurrent) {
          mobileCurrent.textContent = sourceButton.querySelector('strong')?.textContent?.trim() || sourceButton.textContent.trim();
        }

        const usesRemoteSource = Boolean(sourceButton.dataset.mlpProductsUrl || sourceButton.dataset.mlpSearchQuery);

        if (usesRemoteSource) {
          if (count) count.textContent = 'Loading products...';
          if (empty) empty.hidden = true;
          Array.from(root.querySelectorAll('[data-mlp-result-card]')).forEach((card) => {
            card.hidden = true;
            card.classList.add('is-filtered-out');
          });

          const products = await fetchRemoteProducts(sourceButton);
          if (!products.length && filter === 'all') {
            const visibleCards = [];
            localCards.forEach((card) => {
              card.hidden = false;
              card.classList.remove('is-filtered-out');
              visibleCards.push(card);
            });
            setVisibleCards(visibleCards, filter, animate);
            return;
          }
          const existingRemote = Array.from(root.querySelectorAll('[data-mlp-remote-card]'))
            .filter((card) => card.dataset.mlpRemoteFilter === filter);
          if (!existingRemote.length && products.length) {
            empty.insertAdjacentHTML('beforebegin', products.map((product) => renderRemoteCard(product, filter)).join(''));
          }

          const visibleCards = [];
          Array.from(root.querySelectorAll('[data-mlp-result-card]')).forEach((card) => {
            const visible = card.dataset.mlpRemoteFilter === filter;
            card.hidden = !visible;
            card.classList.toggle('is-filtered-out', !visible);
            if (visible) visibleCards.push(card);
          });
          setVisibleCards(visibleCards, filter, animate);
          return;
        }

        const visibleCards = [];
        Array.from(root.querySelectorAll('[data-mlp-remote-card]')).forEach((card) => {
          card.hidden = true;
          card.classList.add('is-filtered-out');
        });
        localCards.forEach((card) => {
          const visible = cardMatches(card, filter);
          card.hidden = !visible;
          card.classList.toggle('is-filtered-out', !visible);
          if (visible) visibleCards.push(card);
        });

        setVisibleCards(visibleCards, filter, animate);
      };

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          applyFilter(button);
        });
      });

      buildMobileSelect();
      if (mobileSelect) {
        mobileSelect.addEventListener('change', () => {
          const selected = mobileSelect.value;
          const source = Array.from(root.querySelectorAll('.p10-ip-mlp__sidebar [data-mlp-filter]'))
            .find((button) => button.dataset.mlpFilter === selected);
          if (source) applyFilter(source);
        });
      }

      applyFilter(buttons.find((button) => button.classList.contains('is-active')) || buttons[0], false);
    }

    function initMlpMotion() {
      const root = document.getElementById(rootId);
      if (!root || !window.gsap) return;

      const gsap = window.gsap;
      const ScrollTrigger = window.ScrollTrigger;
      if (ScrollTrigger) gsap.registerPlugin(ScrollTrigger);

      if (root.p10MlpMotion && typeof root.p10MlpMotion.revert === 'function') {
        root.p10MlpMotion.revert();
      }

      const mm = gsap.matchMedia();
      root.p10MlpMotion = mm;

      mm.add(
        {
          isDesktop: '(min-width: 990px)',
          reduceMotion: '(prefers-reduced-motion: reduce)'
        },
        (context) => {
          const reduceMotion = context.conditions.reduceMotion;
          const heroItems = root.querySelectorAll('[data-mlp-hero-item]');
          const heroCards = root.querySelectorAll('.p10-ip-mlp__hero-product');
          const revealItems = root.querySelectorAll('[data-mlp-reveal]');
          const skyBands = root.querySelectorAll('.p10-ip-mlp__sky-band');
          const stickers = root.querySelectorAll('.p10-ip-mlp__sticker');
          const productTiles = root.querySelectorAll('.p10-ip-mlp__tile');
          const introTargets = [...heroItems, ...heroCards, ...revealItems];

          gsap.set(introTargets, { autoAlpha: 1 });
          if (reduceMotion) return;

          const heroItemArray = gsap.utils.toArray(heroItems);
          const heroCardArray = gsap.utils.toArray(heroCards);
          const introLift = gsap.utils.distribute({ base: 14, amount: 14, from: 'start' });
          const intro = gsap.timeline({ defaults: { duration: 0.68, ease: 'power3.out' } });
          intro
            .addLabel('copy')
            .fromTo(heroItemArray, { y: (index, target, targets) => introLift(index, target, targets), autoAlpha: 0 }, { y: 0, autoAlpha: 1, stagger: 0.075 }, 'copy')
            .addLabel('cards', '<0.18')
            .fromTo(heroCardArray, { y: 28, rotation: (index) => (index % 2 ? 1.8 : -1.8), scale: 0.95, autoAlpha: 0 }, { y: 0, rotation: 0, scale: 1, autoAlpha: 1, stagger: 0.07 }, 'cards')
            .fromTo(stickers, { y: 10, rotation: -4, autoAlpha: 0 }, { y: 0, rotation: 0, autoAlpha: 0.5, stagger: 0.08 }, '<0.08');

          if (ScrollTrigger) {
            ScrollTrigger.batch(revealItems, {
              start: 'top 86%',
              once: true,
              onEnter: (batch) => {
                gsap.fromTo(
                  batch,
                  { y: 24, autoAlpha: 0 },
                  { y: 0, autoAlpha: 1, duration: 0.58, stagger: { each: 0.06, from: 'start' }, ease: 'power2.out', overwrite: true }
                );
              }
            });

            ScrollTrigger.batch(productTiles, {
              start: 'top 92%',
              once: true,
              interval: 0.08,
              batchMax: () => (context.conditions.isDesktop ? 6 : 4),
              onEnter: (batch) => {
                gsap.fromTo(
                  batch,
                  { y: 18, scale: 0.985, autoAlpha: 0 },
                  { y: 0, scale: 1, autoAlpha: 1, duration: 0.34, stagger: { each: 0.035, from: 'start' }, ease: 'power2.out', overwrite: true }
                );
              }
            });

            if (context.conditions.isDesktop) {
              gsap.to(skyBands, {
                x: (index) => (index % 2 === 0 ? 24 : -24),
                ease: 'none',
                scrollTrigger: {
                  trigger: root,
                  start: 'top bottom',
                  end: 'bottom top',
                  scrub: 1
                }
              });

              gsap.to(stickers, {
                y: (index) => (index % 2 === 0 ? -28 : 22),
                rotation: (index) => (index % 2 === 0 ? 7 : -5),
                ease: 'none',
                scrollTrigger: {
                  trigger: root,
                  start: 'top bottom',
                  end: 'bottom top',
                  scrub: 1.2
                }
              });
            }
          }
        }
      );
    }

    function initMlpPage() {
      initMlpFilters();
      initMlpMotion();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initMlpPage, { once: true });
    } else {
      initMlpPage();
    }

    window.addEventListener('load', initMlpPage, { once: true });
    document.addEventListener('shopify:section:load', (event) => {
      if (event.target && event.target.querySelector && event.target.querySelector('[data-p10-ip-mlp]')) {
        initMlpPage();
      }
    });
  })();
</script>

{% stylesheet %}
  .p10-ip-mlp {
    --p10-mlp-ink: #201936;
    --p10-mlp-muted: #6f677d;
    --p10-mlp-line: rgba(32,25,54,0.12);
    --p10-mlp-gold: #d49a25;
    --p10-mlp-pink: #e85d9f;
    --p10-mlp-sky: #55a8df;
    --p10-mlp-mint: #58c7a9;
    --p10-mlp-violet: #8b72d9;
    --p10-mlp-rose: #ff8fc7;
    --p10-mlp-cream: #fff4d8;
    --p10-mlp-paper: #fffdf7;
    --p10-mlp-shadow: 0 24px 70px rgba(32,25,54,0.13);
    --p10-mlp-soft-shadow: 0 14px 34px rgba(32,25,54,0.08);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: 32px 0 84px;
    background:
      linear-gradient(180deg, rgba(255,248,253,0.96) 0%, rgba(244,251,255,0.98) 38%, rgba(255,253,244,0.96) 100%),
      repeating-linear-gradient(135deg, rgba(232,93,159,0.045) 0 1px, transparent 1px 18px),
      repeating-linear-gradient(45deg, rgba(85,168,223,0.035) 0 1px, transparent 1px 22px);
    color: var(--p10-mlp-ink);
  }

  .p10-ip-mlp::before {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image:
      linear-gradient(rgba(255,255,255,0.42) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.36) 1px, transparent 1px);
    background-size: 72px 72px;
    mask-image: linear-gradient(180deg, rgba(0,0,0,0.48), rgba(0,0,0,0.06) 62%, transparent);
    content: "";
  }

  .p10-ip-mlp *,
  .p10-ip-mlp *::before,
  .p10-ip-mlp *::after {
    box-sizing: border-box;
  }

  .p10-ip-mlp a {
    color: inherit;
  }

  .p10-ip-mlp__anchor {
    position: absolute;
    top: 0;
  }

  .p10-ip-mlp__sky {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .p10-ip-mlp__sky-band,
  .p10-ip-mlp__spark,
  .p10-ip-mlp__sticker {
    position: absolute;
    display: block;
  }

  .p10-ip-mlp__sky-band {
    left: 0;
    width: 100%;
    border-radius: 999px;
    opacity: 0.58;
  }

  .p10-ip-mlp__sky-band:nth-child(1) {
    top: 132px;
    height: 18px;
    background: linear-gradient(90deg, transparent 0 8%, rgba(232,93,159,0.44), rgba(212,154,37,0.36), rgba(88,199,169,0.34), rgba(85,168,223,0.36), transparent 92% );
  }

  .p10-ip-mlp__sky-band:nth-child(2) {
    top: 164px;
    height: 12px;
    background: linear-gradient(90deg, transparent 0 18%, rgba(139,114,217,0.28), rgba(85,168,223,0.28), rgba(232,93,159,0.28), transparent 82% );
  }

  .p10-ip-mlp__sky-band:nth-child(3) {
    bottom: 74px;
    height: 16px;
    background: linear-gradient(90deg, transparent 0 14%, rgba(88,199,169,0.22), rgba(212,154,37,0.2), rgba(232,93,159,0.22), transparent 88% );
  }

  .p10-ip-mlp__spark {
    width: 26px;
