    },
    {
      "type": "url",
      "id": "card_box_link",
      "label": "Card box link"
    },
    {
      "type": "url",
      "id": "merch_link",
      "label": "Merch link"
    },
    {
      "type": "url",
      "id": "tcg_link",
      "label": "TCG link"
    },
    {
      "type": "url",
      "id": "guide_link",
      "label": "Guide link"
    },
    {
      "type": "url",
      "id": "back_link",
      "label": "Back link"
    },
    {
      "type": "text",
      "id": "back_label",
      "label": "Back label",
      "default": "Back"
    }
  ],
  "presets": [
    {
      "name": "P10 MLP IP Lounge"
    }
  ]
}
{% endschema %}
