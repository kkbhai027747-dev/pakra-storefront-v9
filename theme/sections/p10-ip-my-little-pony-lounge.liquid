  }

  .p10-ip-mlp__selection-empty strong {
    color: var(--p10-mlp-ink);
    font-size: 15px;
    font-weight: 950;
    line-height: 1.2;
  }

  .p10-ip-mlp__selection-empty span {
    color: var(--p10-mlp-muted);
    font-size: 12px;
    font-weight: 720;
    line-height: 1.35;
  }

  .p10-ip-mlp__products {
    margin-top: 74px;
  }

  .p10-ip-mlp__products-header,
  .p10-ip-mlp__guide-band {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
  }

  .p10-ip-mlp__products-header {
    margin-bottom: 18px;
  }

  .p10-ip-mlp__lane {
    display: grid !important;
    grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
    gap: 14px !important;
  }

  .p10-ip-mlp__lane.p10-ip-mlp__lane--filtered {
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
  }

  .p10-ip-mlp__tile,
  .p10-ip-mlp__empty {
    position: relative;
    width: auto !important;
    min-width: 0 !important;
    max-width: none !important;
    flex: none !important;
    overflow: hidden;
    border: 1px solid rgba(32,25,54,0.1);
    border-radius: 16px;
    background: rgba(255,255,255,0.9);
    box-shadow: 0 14px 34px rgba(32,25,54,0.07);
    transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
  }

  .p10-ip-mlp__tile::before {
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: linear-gradient(90deg, var(--p10-mlp-pink), var(--p10-mlp-gold), var(--p10-mlp-mint), var(--p10-mlp-sky));
    opacity: 0.62;
    content: "";
  }

  .p10-ip-mlp__tile-image {
    display: flex;
    aspect-ratio: 1 / 0.72;
    align-items: center;
    justify-content: center;
    padding: 18px;
    background:
      linear-gradient(180deg, rgba(255,250,252,0.9), rgba(247,252,255,0.88)),
      repeating-linear-gradient(135deg, transparent 0 18px, rgba(232,93,159,0.045) 18px 20px),
      #ffffff;
  }

  .p10-ip-mlp__tile-img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 10px 16px rgba(32,25,54,0.11));
    transition: transform 220ms ease;
  }

  .p10-ip-mlp__tile:hover .p10-ip-mlp__tile-img,
  .p10-ip-mlp__tile:focus-within .p10-ip-mlp__tile-img {
    transform: translateY(-4px) scale(1.03);
  }

  .p10-ip-mlp__tile-body {
    display: flex;
    min-height: 140px;
    flex-direction: column;
    padding: 14px;
  }

  .p10-ip-mlp__tile-body h3 {
    display: -webkit-box;
    min-height: 54px;
    margin: 0;
    overflow: hidden;
    color: var(--p10-mlp-ink);
    font-size: 14px;
    font-weight: 900;
    line-height: 1.28;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 3;
  }

  .p10-ip-mlp__tile-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-top: auto;
    padding-top: 12px;
    color: var(--p10-mlp-gold);
    font-size: 11px;
    font-weight: 900;
    line-height: 1.1;
  }

  .p10-ip-mlp__tile-meta span {
    display: inline-flex;
    min-height: 22px;
    align-items: center;
    padding: 5px 7px;
    border-radius: 999px;
    background: rgba(255,246,220,0.84);
    white-space: nowrap;
  }

  .p10-ip-mlp__tile-meta span:last-child {
    background: rgba(255,255,255,0.72);
    color: #bd7f0b;
  }

  .p10-ip-mlp__empty {
    grid-column: 1 / -1;
    padding: 22px;
  }

  .p10-ip-mlp__empty strong,
  .p10-ip-mlp__empty span {
    display: block;
  }

  .p10-ip-mlp__empty strong {
    color: var(--p10-mlp-ink);
    font-size: 18px;
    font-weight: 950;
  }

  .p10-ip-mlp__empty span {
    margin-top: 8px;
    color: var(--p10-mlp-muted);
    font-size: 13px;
    font-weight: 750;
  }

  .p10-ip-mlp__guide-band {
    align-items: center;
    margin-top: 74px;
  }

  .p10-ip-mlp__guide-grid {
    display: grid;
    width: min(58%, 660px);
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  .p10-ip-mlp__guide-grid a {
    position: relative;
    display: grid;
    min-height: 112px;
    align-content: space-between;
    gap: 12px;
    padding: 14px;
    border: 1px solid rgba(32,25,54,0.1);
    overflow: hidden;
    border-radius: 16px;
    background:
      linear-gradient(180deg, rgba(255,255,255,0.92), rgba(255,250,254,0.88)),
      linear-gradient(90deg, rgba(232,93,159,0.08), rgba(85,168,223,0.06));
    text-decoration: none;
    box-shadow: var(--p10-mlp-soft-shadow);
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .p10-ip-mlp__guide-grid a::before {
    position: absolute;
    inset: 0 0 auto;
    height: 4px;
    background: linear-gradient(90deg, var(--p10-mlp-gold), var(--p10-mlp-pink), var(--p10-mlp-sky));
    content: "";
  }

  .p10-ip-mlp__guide-grid a:hover,
  .p10-ip-mlp__guide-grid a:focus-visible {
    border-color: rgba(232,93,159,0.25);
    box-shadow: 0 18px 38px rgba(32,25,54,0.11);
    transform: translateY(-3px);
  }

  .p10-ip-mlp__guide-grid strong {
    font-size: 13px;
    font-weight: 900;
    line-height: 1.25;
  }

  .p10-ip-mlp__buyer-note {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    margin-top: 18px;
    padding: 16px 18px;
    border-left: 4px solid var(--p10-mlp-gold);
    border-radius: 12px;
    background: rgba(255,255,255,0.82);
    color: var(--p10-mlp-muted);
    font-size: 13px;
    font-weight: 650;
    line-height: 1.5;
  }

  .p10-ip-mlp__buyer-note strong {
    flex: 0 0 auto;
    color: var(--p10-mlp-ink);
    font-size: 12px;
    font-weight: 950;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .p10-ip-mlp *,
    .p10-ip-mlp *::before,
    .p10-ip-mlp *::after {
      animation: none !important;
      transition: none !important;
      scroll-behavior: auto !important;
    }
  }

  @media (max-width: 1180px) {
    .p10-ip-mlp__browser {
      grid-template-columns: 248px minmax(0, 1fr);
      gap: 18px;
    }

    .p10-ip-mlp__guide-band {
      align-items: flex-start;
      flex-direction: column;
    }

    .p10-ip-mlp__guide-grid {
      width: 100%;
    }
  }

  @media (max-width: 989px) {
    .p10-ip-mlp {
      padding: 26px 0 58px;
    }

    .p10-ip-mlp__nav,
    .p10-ip-mlp__hero,
    .p10-ip-mlp__browser,
    .p10-ip-mlp__products,
    .p10-ip-mlp__guide-band,
    .p10-ip-mlp__buyer-note {
      width: min(100% - 32px, 900px);
    }

    .p10-ip-mlp__nav {
      padding-bottom: 28px;
    }

    .p10-ip-mlp__hero {
      grid-template-columns: minmax(0, 1fr);
      min-height: 0;
      gap: 30px;
    }

    .p10-ip-mlp__hero-copy::before {
      left: -12px;
      width: 5px;
    }

    .p10-ip-mlp__heading {
      font-size: clamp(42px, 12vw, 64px);
    }

    .p10-ip-mlp__stage {
      min-height: 360px;
    }

    .p10-ip-mlp__browser {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 40px;
    }

    .p10-ip-mlp__sidebar {
      display: none;
    }

    .p10-ip-mlp__mobile-picker {
      display: grid;
      gap: 8px;
      padding: 12px;
      border: 1px solid rgba(232,93,159,0.16);
      border-radius: 14px;
      background:
        linear-gradient(180deg, rgba(255,255,255,0.94), rgba(255,249,254,0.9)),
        linear-gradient(90deg, rgba(232,93,159,0.08), rgba(85,168,223,0.06));
      box-shadow: 0 14px 34px rgba(32,25,54,0.07);
    }

    .p10-ip-mlp__mobile-picker label {
      display: grid;
      gap: 3px;
    }

    .p10-ip-mlp__mobile-picker label span {
      color: var(--p10-mlp-gold);
      font-size: 10px;
      font-weight: 950;
      line-height: 1.2;
      text-transform: uppercase;
    }

    .p10-ip-mlp__mobile-picker label strong {
      color: var(--p10-mlp-ink);
      font-size: 16px;
      font-weight: 950;
      line-height: 1.1;
    }

    .p10-ip-mlp__mobile-picker select {
      width: 100%;
      min-height: 46px;
      padding: 0 40px 0 12px;
      border: 1px solid rgba(32,25,54,0.14);
      border-radius: 10px;
      background: #fff;
      color: var(--p10-mlp-ink);
      font: inherit;
      font-size: 13px;
      font-weight: 850;
    }

    .p10-ip-mlp__result-head {
      grid-template-columns: minmax(0, 1fr);
    }

    .p10-ip-mlp__result-actions {
      justify-items: start;
    }

    .p10-ip-mlp__lane {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      gap: 10px !important;
    }

    .p10-ip-mlp__lane.p10-ip-mlp__lane--filtered {
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
    }

    .p10-ip-mlp__products-header {
      align-items: flex-start;
    }
  }

  @media (max-width: 640px) {
    .p10-ip-mlp__search {
      grid-template-columns: 1fr;
    }

    .p10-ip-mlp__search label,
    .p10-ip-mlp__search button {
      width: 100%;
    }

    .p10-ip-mlp__hero-products {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .p10-ip-mlp__series-strip {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 6px;
    }

    .p10-ip-mlp__series-strip span {
      min-height: 42px;
      padding: 7px 6px;
      font-size: 9px;
    }

    .p10-ip-mlp__series-strip b {
      font-size: 10px;
    }

    .p10-ip-mlp__stage {
      min-height: 0;
      padding: 18px;
      border-radius: 18px;
    }

    .p10-ip-mlp__hero-product {
      aspect-ratio: 0.86 / 1;
      padding: 8px;
    }

    .p10-ip-mlp__stage-badges {
      gap: 6px;
    }

    .p10-ip-mlp__stage-badges span {
      min-height: 24px;
      padding: 6px 8px;
      font-size: 9px;
    }

    .p10-ip-mlp__hero-product:nth-child(2),
    .p10-ip-mlp__hero-product:nth-child(4) {
      translate: 0;
    }

    .p10-ip-mlp__sticker {
      display: none;
    }

    .p10-ip-mlp__result-stage {
      padding: 18px 14px 18px 18px;
      border-radius: 18px;
    }

    .p10-ip-mlp__result-stage::before {
      inset: 18px auto 18px 8px;
      width: 4px;
    }

    .p10-ip-mlp__guide-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .p10-ip-mlp__products-header {
      flex-direction: column;
      gap: 12px;
    }

    .p10-ip-mlp__products-header a {
      width: 100%;
    }

    .p10-ip-mlp__tile-image {
      aspect-ratio: 1 / 0.62;
      padding: 12px;
    }

    .p10-ip-mlp__tile-body {
      min-height: 132px;
      padding: 12px;
    }

    .p10-ip-mlp__tile-body h3 {
      min-height: 62px;
      font-size: 12px;
      line-height: 1.28;
      overflow-wrap: anywhere;
      -webkit-line-clamp: 4;
    }

    .p10-ip-mlp__tile-meta {
      min-height: 20px;
      margin-top: 8px;
      padding-top: 10px;
      font-size: 10px;
      gap: 4px;
    }

    .p10-ip-mlp__tile-meta span {
      min-height: 20px;
      padding: 4px 5px;
    }

    .p10-ip-mlp__buyer-note {
      flex-direction: column;
      gap: 6px;
    }
  }
{% endstylesheet %}

