{{ 'component-header-classic.aio.min.css' | asset_url | stylesheet_tag }}
{{ 'p10-partner-routing.css' | asset_url | stylesheet_tag }}
<style>
  @media screen and (min-width: 1025px) {
    .header-classic .p10-track-order-utility {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      margin-right: 20px;
      color: #323232;
      font-size: 12px;
      font-weight: 700;
      line-height: 1;
      text-decoration: none;
      white-space: nowrap;
    }

    .header-classic .p10-track-order-utility svg {
      width: 15px;
      height: 15px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.6;
    }

    .header-classic .p10-track-order-utility:hover,
    .header-classic .p10-track-order-utility:focus-visible {
      color: #ec5f86;
    }
  }
</style>
{{ 'p10-header-navigation-modern.css' | asset_url | stylesheet_tag }}
<header class="header header-classic" style="--spacing-l-r: {{ section.settings.padding_full_width }}px; --bg-color: {% if section.settings.gradient != blank %}{{ section.settings.gradient }}{% else %}{{ section.settings.background }}{% endif %}; --p-top: {{ section.settings.padding_top }}px; --p-bottom: {{ section.settings.padding_bottom }}px">
    <div class="container container-{{ section.settings.container }}">
        <div class="header-classic__content header-classic__content--size-{{ section.blocks.size }}">
            {%- for block in section.blocks -%}
                <div class="header-classic__item header-classic__item--{{ block.type }}" style="--spacing-bottom: {{ block.settings.spacing }}px">
                    {%- case block.type -%}
                        {%- when 'logo' -%}
                            <div class="header__logo" style="--logo-width: {% if block.settings.logo == blank %}auto; --logo-svg-width: {% endif %}{{ block.settings.logo_width }}px; --font-size: {{ block.settings.logo_font_size }}px; --font-weight: {{ block.settings.logo_font_weight }}; --color: {{ block.settings.logo_color }}">
                                <div class="header__heading">
                                        {%- if block.settings.logo != blank -%}
                                    <a href="{{ routes.root_url }}" class="header__heading-link focus-inset">
                                            {%- liquid 
                                                assign logo = block.settings.logo
                                                assign logo_width = block.settings.logo_width
                                                assign logo_height = logo_width | divided_by: logo.aspect_ratio | round
                                                assign logo_alt = logo.alt | default: shop.name | escape
                                            -%}
                                            {{ logo | image_url: width: 300 | image_tag:
                                                class: 'header__heading-logo motion-reduce',
                                                widths: '50, 100, 150, 200, 250, 300, 400, 500',
                                                height: logo_height,
                                                width: logo_width,
                                                alt: logo_alt
                                            }}
                                    </a>
                                        {%- else -%}
                                            <style>
                                                .header-classic .prisma-logo-link {
                                                    width: auto;
                                                    max-width: min(100%, 560px);
                                                    display: inline-flex;
                                                    align-items: center;
                                                    text-decoration: none;
                                                }

                                                .prisma-logo-pc a {
                                                    position: relative;
                                                    z-index: 1;
                                                    display: inline-flex;
                                                    align-items: center;
                                                    color: inherit;
                                                    text-decoration: none;
                                                    pointer-events: auto;
                                                }

                                                .prisma-logo-pc a:focus-visible {
                                                    outline: 2px solid #111827;
                                                    outline-offset: 4px;
                                                }

                                                .prisma-logo-pc {
                                                    display: inline-flex;
                                                    align-items: center;
                                                    justify-content: flex-start;
                                                    gap: clamp(8px, 0.9vw, 14px);
                                                    max-width: 100%;
                                                    min-width: 0;
                                                    white-space: nowrap;
                                                }

                                                .prisma-logo-pc .text-p {
                                                    margin: 0;
                                                    color: #000;
                                                    font-family: 'Cinzel', serif;
                                                    font-size: clamp(24px, 2.1vw, 32px);
                                                    font-weight: 700;
                                                    letter-spacing: clamp(1.5px, 0.22vw, 4px);
                                                    line-height: 1;
                                                    text-transform: uppercase;
                                                }

                                                .prisma-logo-pc .text-x {
                                                    flex: 0 0 auto;
                                                    margin: 0;
                                                    color: #94a3b8;
                                                    font-family: 'Cinzel', serif;
                                                    font-size: clamp(18px, 1.6vw, 24px);
                                                    line-height: 1;
                                                }

                                                .prisma-logo-pc .img-k {
                                                    display: block;
                                                    flex: 0 1 auto;
                                                    width: auto !important;
                                                    height: clamp(42px, 3.8vw, 58px) !important;
                                                    max-width: min(220px, 32vw);
                                                    margin: 0;
                                                    object-fit: contain;
                                                    transform: none !important;
                                                }

                                                @media (min-width: 1025px) and (max-width: 1200px) {
                                                    .header-classic .prisma-logo-link {
                                                        max-width: 430px;
                                                    }

                                                    .prisma-logo-pc .text-p {
                                                        font-size: 24px;
                                                        letter-spacing: 2px;
                                                    }

                                                    .prisma-logo-pc .img-k {
                                                        height: 42px !important;
                                                        max-width: 160px;
                                                    }
                                                }
                                            </style>
                                            <span class="header__heading-link focus-inset prisma-logo-link" role="group" aria-label="{{ shop.name | escape }}">
                                            <span class="prisma-logo-pc">
                                                <a href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }} home">
                                                    <span class="text-p">pakracards</span>
                                                </a>
                                            </span>
                                            </span>
            {%- endif -%}
                                </div>
                            </div>
                        {%- when 'service' -%}
                            <div class="header-top-right-group header-language_currency" style="--text-color: {{ block.settings.text_color }}">
                                {%- if block.settings.customer_service_text != blank -%}
                                    <div class="customer-service-text">{{ block.settings.customer_service_text }}</div>
                                {%- endif -%}
                                {% if block.settings.show_search %}
                                        <details-modal class="header__iconItem header__search" style="--search-color: {{ block.settings.search_color }}; --search-bg-color: {{ block.settings.bg_search_color }}; --search-border-color: {{ block.settings.search_border_color }}; --search-icon-color: {{ block.settings.search_icon_color }}">
                                            {%- if settings.show_quick_search -%}
                                                <predictive-search class="search-modal__form" data-loading-text="{{ 'accessibility.loading' | t }}" data-product-to-show="{{ settings.quick_search_to_show }}">
                                            {%- endif -%}
                                            <details class="search_details">
                                                <summary class="header__search-full" aria-haspopup="dialog" aria-label="{{ 'general.search.search' | t }}">
                                                    <button type="button" class="header-search-close" aria-label="{{ 'general.common.close' | t }}">{% render 'icon-close' %}</button>
                                                    <form action="{{ routes.search_url }}" method="get" role="search" class="search search-modal__form">
  <input type="hidden" name="options[prefix]" value="last">
  <input type="hidden" name="options[fields]" value="title,tag,product_type,variants.title,vendor">
                                                        <div class="field">
                                                            <input class="search__input field__input form-input-placeholder" id="Search-In-Modal-Classic" type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search for products, cards, and more..." autocomplete="off" {%- if settings.show_quick_search -%}role="combobox" aria-expanded="false" aria-owns="predictive-search-results-list" aria-controls="predictive-search-results-list" aria-haspopup="listbox" aria-autocomplete="list" autocorrect="off" autocomplete="off" autocapitalize="off" spellcheck="false"{%- endif -%}>   

                                                            <input type="hidden" name="type" value="product">
                                                            <label class="field__label hiddenLabels" for="Search-In-Modal-Classic">{{ 'general.search.search' | t }}</label>
                                                            <button class="button search__button field__button focus-inset" aria-label="{{ 'general.search.search' | t }}">{% render 'icon-search' %}</button>
                                                        </div>
                                                        {%- if settings.show_quick_search -%}
                                                            {%- if settings.show_search_trending or settings.show_search_product -%}
                                                                {%- render 'quick-searching-trending-products' -%}
                                                            {%- endif -%}
                                                            {%- render 'predictive-search-results' -%}
                                                        {%- endif -%}
                                                    </form>
                                                </summary>
                                            </details>
                                            {%- if settings.show_quick_search -%}
                                                </predictive-search>
                                            {%- endif -%}
                                        </details-modal>
                                    <div class="search-modal modal__content{% if settings.show_quick_search %} quickSearch{% endif %}" role="dialog" aria-modal="true" aria-label="{{ 'general.search.search' | t }}">
                                        {%- if settings.show_quick_search -%}
                                            {% render 'halo-quick-search' %}
                                        {%- endif -%}
                                    </div>
                                {% endif %}
                            </div>
                        {%- when 'text' -%}
                            {%- if block.settings.free_shipping_text != blank -%}
                                <div class="free-shipping-text" style="--text-color: {{ block.settings.text_color }}">{{ block.settings.free_shipping_text }}</div>
                            {%- endif -%}
                        {%- when 'group' -%}
                            {%- if block.settings.show_cart or block.settings.show_wishlist or block.settings.show_customer -%}
                                <div class="header__iconItem header__group">
                                    {%- liquid
                                        assign p10_track_order_url = '/apps/track123'
                                        for p10_nav_link in linklists['v6-shop-navigation'].links
                                            assign p10_nav_title = p10_nav_link.title | downcase | handle
                                            if p10_nav_title == 'track-order'
                                                assign p10_track_order_url = p10_nav_link.url
                                                break
                                            endif
                                        endfor
                                    -%}
                                    <a href="{{ p10_track_order_url }}" class="p10-track-order-utility link focus-inset" aria-label="Track order">
                                      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 7.5v5l3.2 2"></path></svg>
                                      <span>Track Order</span>
                                    </a>
                                    <div class="p10-header-language" aria-label="Language">
                                        <span class="p10-header-utility-label">Language</span>
                                        {% render 'halo-top-language', icon: 'default' %}
                                    </div>
                                    {%- if block.settings.show_wishlist -%}
                                        <a href="{% if settings.link_wishlist != blank %}{{ settings.link_wishlist }}{% else %}{{ pages['wish-list'].url }}{% endif %}" class="header__icon header__icon--wishlist link link--text focus-inset" style="--text-color: {{ block.settings.wishlist_color }}">{% render 'icon-heart-2' %} <span class="wishlist-text">{{ 'wishlist.general.title' | t }}</span></a>
                                    {%- endif -%}
                                    {%- if shop.customer_accounts_enabled and block.settings.show_customer -%}
                                        <div class="customer-links" style="--text-color: {{ block.settings.customer_color }}">
                                            <span class="p10-account-icon" aria-hidden="true">{% render 'icon-account-2' %}</span>
                                            {%- if customer -%}
                                                <a class="header__link--account" id="customer_logout_link" href="{{ routes.account_logout_url }}">{{ 'customer.log_out' | t }}</a>
                                                <span> / </span>
                                                <a class="header__link--account" href="{{ routes.account_url }}">{{ 'customer.account.my_account' | t }}</a>
                                            {%- else -%}
                                                {% if routes.account_login_url contains '/account/login' %}
                                                    {% assign is_contained = true %}
                                                {% else %}
                                                    {% assign is_contained = false %}
                                                {% endif %}
                                                <a class="header__link--account customer_login_link" href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}" {% if is_contained %}data-open-auth-sidebar{% endif %}>{{ 'customer.sign_in' | t }}</a>
                                                {%- if is_contained -%}
                                                    <span class="or-text"> {{ 'customer.or' | t }}</span>
                                                    <a class="header__link--account customer_register_link" href="{{ routes.account_register_url }}">{{ 'customer.create_account' | t }}</a>
                                                {%- endif -%}
                                            {%- endif -%}
                                        </div>
                                    {%- endif -%}
                                    {% render 'p10-theme-toggle', placement: 'desktop' %}
                                    {%- if block.settings.show_cart -%}
                                        <a href="{{ routes.cart_url }}" class="header__icon header__icon--cart link link--text focus-inset cart-icon-bubble" {% if settings.show_quick_cart %} data-cart-sidebar{% endif %} style="--text-color: {{ block.settings.cart_color }}; --item-color: {{ block.settings.cart_color_item }}; --bg-item-color: {{ block.settings.cart_bg_item }}">
                                            {% render 'icon-cart-02' %} <span class="cart-text">{{ 'general.cart.shopping_cart' | t }}</span>
                                            <div class="cart-count-bubble">
                                                {%- if cart.item_count < 100 -%}
                                                    <span class="text" aria-hidden="true" data-cart-count>{{ cart.item_count }}</span>
                                                {%- endif -%}
                                                <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
                                            </div>
                                        </a>
                                    {%- endif -%}
                                </div>
                            {%- endif -%}
                    {%- endcase -%}
                </div>
            {%- endfor -%}
        </div>
    </div>
</header>

{% schema %}
{
    "name": "t:sections.header.layouts.classic.label",
    "limit": 1,
    "class": "section-header-classic",
    "settings": [
        {
            "type": "paragraph",
            "content": "*You should only activate \/ use \"Header\" you want, don't use the redundant headers which may not optimize for performance."
        },
        {
            "type": "select",
            "id": "container",
            "label": "t:sections.layout.container.option",
            "default": "1170",
            "options": [
                {
                    "value": "1170",
                    "label": "t:sections.layout.container.option4"
                },
                {
                    "value": "1370",
                    "label": "t:sections.layout.container.option8"
                },
                {
                    "value": "1470",
                    "label": "t:sections.layout.container.option5"
                },
                {
                    "value": "1570",
                    "label": "t:sections.layout.container.option6"
                },
                {
                    "value": "1770",
                    "label": "t:sections.layout.container.option3"
                },
                {
                    "value": "full",
                    "label": "t:sections.layout.container.option2"
                }
            ]
        },
        {
            "type": "range",
            "id": "padding_full_width",
            "label": "t:sections.layout.container.padding_full_width",
            "min": 0,
            "max": 75,
            "step": 5,
            "unit": "t:sections.layout.fontsize.fontsize_title.unit",
            "default": 0,
            "info": "t:sections.layout.container.info_full_width"
        },
        {
            "type": "color",
            "id": "background",
            "label": "t:settings_schema.colors.settings.colors_name.background_color",
            "default": "#ffffff"
        },
        {
            "type": "color_background",
            "id": "gradient",
            "label": "t:settings_schema.colors.settings.colors_name.background_color_gradient"
        },
        {
            "type": "header",
            "content": "t:sections.main-product.settings.general.spacing"
        },
        {
            "type": "range",
            "id": "padding_top",
            "min": 0,
            "max": 50,
            "step": 1,
            "unit": "px",
            "label": "t:sections.main-list-collections.settings.spacing.mg_top",
            "default": 15
        },
        {
            "type": "range",
            "id": "padding_bottom",
            "min": 0,
            "max": 50,
            "step": 1,
            "unit": "px",
            "label": "t:sections.main-list-collections.settings.spacing.mg_bottom",
            "default": 16
        }
    ],
    "blocks": [
        {
            "type": "logo",
            "name": "t:sections.header.blocks.header__2.content",
            "limit": 1,
            "settings": [
                {
                    "type": "header",
                    "content": "t:sections.header.settings.logo.label__1"
                },
                {
                    "type": "image_picker",
                    "id": "logo",
                    "label": "t:settings_schema.quick_view.settings.header__2.content"
                },
                {
                    "type": "range",
                    "id": "logo_width",
                    "min": 50,
                    "max": 300,
                    "step": 10,
                    "unit": "t:sections.header.settings.logo_width.unit",
                    "label": "t:sections.header.settings.logo_width.label__1",
                    "default": 90
                },
                {
                    "type": "header",
                    "content": "t:sections.header.settings.menu_tab.label__3"
                },
                {
                    "type": "textarea",
                    "id": "logo_text",
                    "label": "t:sections.header.settings.logo.label__7"
                },
                {
                    "type": "range",
                    "id": "logo_font_size",
                    "label": "t:settings_schema.typography.settings.font_size.label",
                    "min": 15,
                    "max": 60,
                    "step": 1,
                    "unit": "t:sections.header.settings.logo.unit",
                    "default": 30
                },
                {
                    "type": "select",
                    "id": "logo_font_weight",
                    "label": "t:settings_schema.typography.settings.font_weight.label",
                    "default": "900",
                    "options": [
                    {
                        "value": "400",
                        "label": "t:settings_schema.typography.settings.font_weight.options__1"
                    },
                    {
                        "value": "500",
                        "label": "t:settings_schema.typography.settings.font_weight.options__2"
                    },
                    {
                        "value": "600",
                        "label": "t:settings_schema.typography.settings.font_weight.options__3"
                    },
                    {
                        "value": "700",
                        "label": "t:settings_schema.typography.settings.font_weight.options__4"
                    },
                    {
                        "value": "800",
                        "label": "t:settings_schema.typography.settings.font_weight.options__5"
                    },
                    {
                        "value": "900",
                        "label": "t:settings_schema.typography.settings.font_weight.options__6"
