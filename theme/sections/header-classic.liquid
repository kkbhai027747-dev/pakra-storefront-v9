                    "id": "search_border_color",
                    "label": "t:sections.header.settings.header_top.search_border_color",
                    "default": "#e7e7e7"
                },
                {
                    "type": "color",
                    "id": "search_icon_color",
                    "label": "t:sections.header.settings.header_top.search_color_icon",
