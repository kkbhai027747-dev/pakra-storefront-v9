{%- liquid
    assign request_only = false
    if product_card_product.price_min == 1 and product_card_product.price_max == 1
        assign request_only = true
    endif
-%}
{%- if request_only -%}
    {{ 'component-request-only.css' | asset_url | stylesheet_tag }}
{%- endif -%}

{%- if product_card_product.featured_media -%}
    {%- if variant_img != blank -%}
        {%- if settings.quick_shop_type == '2' -%}
            {%- assign width = product_card_product.featured_media.width -%}
            {%- assign height = product_card_product.featured_media.width | divided_by: product_card_product.featured_media.aspect_ratio | round -%}
            <img {% render 'lazyload',preview_img: product_card_product.featured_media, class: true, width: width, height: height, enable_rtl: settings.enable_layout_rtl %} />
        {%- else -%}
            {%- assign width = variant_img.width -%}
            {%- assign height = variant_img.width | divided_by: variant_img.aspect_ratio | round -%}
            <img {% render 'lazyload',preview_img: variant_img, class: true, enable_rtl: settings.enable_layout_rtl  %} />
        {%- endif -%}
    {%- else -%}
        {%- assign width = product_card_product.featured_media.width -%}
        {%- assign height = product_card_product.featured_media.width | divided_by: product_card_product.featured_media.aspect_ratio | round -%}
        <img {% render 'lazyload',preview_img: product_card_product.featured_media, class: true, enable_rtl: settings.enable_layout_rtl  %} />
    {%- endif -%}
    {%- if product_card_product.media[1] != nil and settings.show_image_swap -%}
        {%- if has_video != blank and settings.enable_hover_video_product_items -%}
        {{ has_video[0] | video_tag: muted: true, loop: true, image_size: '50x' }}
        {%- else -%}
        {%- assign width = product_card_product.media[1].width -%}
        {%- assign height = product_card_product.media[1].width | divided_by: product_card_product.media[1].aspect_ratio | round -%}
        <img {% render 'lazyload',preview_img: product_card_product.media[1], class: true, width: width, height: height, enable_rtl: settings.enable_layout_rtl %} />
        {%- endif -%}
    {%- endif -%}

    {%- if product_card_product.images.size > 1 -%}
        <template data-p10-card-hover-gallery>
            {%- for p10_gallery_image in product_card_product.images limit: 5 -%}
                <span
                    data-p10-gallery-src="{{ p10_gallery_image | image_url: width: 900 }}"
                    data-p10-gallery-srcset="{{ p10_gallery_image | image_url: width: 360 }} 360w, {{ p10_gallery_image | image_url: width: 540 }} 540w, {{ p10_gallery_image | image_url: width: 720 }} 720w, {{ p10_gallery_image | image_url: width: 900 }} 900w"
                ></span>
            {%- endfor -%}
        </template>
    {%- endif -%}

    {%- if settings.enable_lazyload -%}<span class="data-lazy-loading"></span>{%- endif -%}
{%- else -%}
    {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
    {{ 'product-' | append: current | placeholder_svg_tag: 'placeholder-svg' }}
{%- endif -%}

{%- if request_only -%}
    <span class="request-only-overlay" aria-label="Available Upon Request">
        <span class="request-only-overlay__label">Available Upon Request</span>
    </span>
{%- endif -%}
