{% liquid
    assign url = shop.url
    assign page_type = request.page_type
%}
{%- if page_type == 'product' -%}
    {%- liquid
        assign fa_current_variant = product.selected_or_first_available_variant
        assign fa_variant_count = product.variants | size
        assign fa_count = 0
    -%}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "Product",
        "name": {{ product.title | strip_html | json }},
        "url": {{ url | append: product.url | json }},
        {%- if product.variants.first.sku != blank -%}
            "sku": {{ product.variants.first.sku | json }},
        {%- else -%}
            "sku": {{ product.variants.first.id | append: '' | json }},
        {%- endif -%}
        {%- if product.variants.first.barcode.size == 12 -%}
            "gtin12": {{ product.variants.first.barcode | json }},
        {%- endif -%}
        {%- if product.variants.first.barcode.size == 13 -%}
            "gtin13": {{ product.variants.first.barcode | json }},
        {%- endif -%}
        {%- if product.variants.first.barcode.size == 14 -%}
            "gtin14": {{ product.variants.first.barcode | json }},
        {%- endif -%}
        "productID": {{ product.id | append: '' | json }},
        "brand": {
            "@type": "Brand",
            "name": {{ product.vendor | json }}
        },
        "description": {{ product.description | strip_html | strip | strip_newlines | json }},
        "image": {{ product.featured_image | image_url: width: 5760 | prepend: 'https:' | json }},
        {%- if product.variants -%}
            {%- assign fa_count = fa_count | plus: 1 -%}
            "offers": {% if product.variants.size > 1 %}[{% endif %}
            {
                "@type": "Offer",
                "priceCurrency": {{ cart.currency.iso_code | default: shop.currency | json }},
                "price": {{ fa_current_variant.price | divided_by: 100.0 | json }},
                "itemCondition": "https://schema.org/NewCondition",
                "availability": "https://schema.org/{% if fa_current_variant.available %}InStock{% else %}OutOfStock{% endif %}",
                "url": {{ url | append: fa_current_variant.url | json }},
                {%- if fa_current_variant.image -%}
                    "image": {{ fa_current_variant.image | image_url: width: fa_current_variant.image.width | prepend: 'https:' | json }},
                {%- else -%}
                    "image": {{ product.featured_image | image_url: width: 5760 | prepend: 'https:' | json }},
                {%- endif -%}
                {%- if fa_current_variant.title != 'Default Title' -%}
                    "name": {{ product.title | strip_html | append: ' - ' | append: fa_current_variant.title | json }},
                {%- else -%}
                    "name": {{ product.title | strip_html | json }},
                {%- endif -%}
                {%- if fa_current_variant.barcode.size == 12 -%}
                    "gtin12": {{ fa_current_variant.barcode | json }},
                {%- endif -%}
                {%- if fa_current_variant.barcode.size == 13 -%}
                    "gtin13": {{ fa_current_variant.barcode | json }},
                {%- endif -%}
                {%- if fa_current_variant.barcode.size == 14 -%}
                    "gtin14": {{ fa_current_variant.barcode | json }},
                {%- endif -%}
                {%- if fa_current_variant.sku != blank -%}
                    "sku": {{ fa_current_variant.sku | json }},
                {%- else -%}
                    "sku": {{ fa_current_variant.id | append: '' | json }},
                {%- endif -%}
                {%- if product.description != blank -%}
                    "description": {{ product.description | strip_html | strip | strip_newlines | json }},
                {%- endif -%}
                "priceValidUntil": "{{ 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d' }}"
            }{%- if product.variants.size != 1 -%},{%- endif -%}
            {%- for variant in product.variants -%}
                {%- if variant != product.selected_or_first_available_variant -%}
                    {%- assign fa_count = fa_count | plus: 1 -%}
                    {
                        "@type": "Offer",
                        "priceCurrency": {{ cart.currency.iso_code | default: shop.currency | json }},
                        "price": {{ variant.price | divided_by: 100.0 | json }},
                        "itemCondition": "https://schema.org/NewCondition",
                        "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
                        "url": {{ url | append: variant.url | json }},
                        {%- if variant.image -%}
                            "image": {{ variant.image | image_url: width: variant.image.width | prepend: 'https:' | json }},
                        {%- else -%}
                            "image": {{ product.featured_image | image_url: width: 5760 | prepend: 'https:' | json }},
                        {%- endif -%}
                        {%- if variant.title != 'Default Title' -%}
                            "name": {{ product.title | strip_html | append: ' - ' | append: variant.title | json }},
                        {%- else -%}
                            "name": {{ product.title | strip_html | json }},
                        {%- endif -%}
                        {%- if variant.barcode.size == 12 -%}
                            "gtin12": {{ variant.barcode | json }},
                        {%- endif -%}
                        {%- if variant.barcode.size == 13 -%}
                            "gtin13": {{ variant.barcode | json }},
                        {%- endif -%}
                        {%- if variant.barcode.size == 14 -%}
                            "gtin14": {{ variant.barcode | json }},
                        {%- endif -%}
                        {%- if variant.sku != blank -%}
                            "sku": {{ variant.sku | json }},
                        {%- else -%}
                            "sku": {{ variant.id | append: '' | json }},
                        {%- endif -%}
                        {%- if product.description != blank -%}
                            "description": {{ product.description | strip_html | strip | strip_newlines | json }},
                        {%- endif -%}
                        "priceValidUntil": "{{ 'now' | date: '%s' | plus: 31536000 | date: '%Y-%m-%d' }}"
                    }
                    {%- if fa_count < fa_variant_count -%}
                        {%- unless forloop.last %},{% endunless -%}
                    {%- endif -%}
                {%- endif -%}
            {%- endfor -%}
            {% if product.variants.size > 1 %}]{% endif %}
            {%- if product.metafields.spr.reviews -%}
                {%- assign fa_rating = product.metafields.spr.reviews | split: '"reviewCount": "' | last | split: '"' | first | plus: 0 -%}
                {%- if fa_rating > 0 -%}
                    ,"aggregateRating": {
                        "@type": "AggregateRating",
                        "ratingValue": {{ product.metafields.spr.reviews | split: '"ratingValue": "' | last | split: '"' | first | plus: 0 }},
                        "ratingCount": {{ product.metafields.spr.reviews | split: '"reviewCount": "' | last | split: '"' | first | plus: 0 }}
                    }
                {%- endif -%}
            {%- endif -%}
        {%- endif -%}
    }
    </script>
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [{
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": {{ url | json }}
        },
        {%- if collection -%}
            {
                "@type": "ListItem",
                "position": 2,
                "name": {{ collection.title | json }},
                "item": {{ url | append: collection.url | json }}
            },
            {
                "@type": "ListItem",
                "position": 3,
                "name": {{ product.title | json }},
                "item": {{ canonical_url | json }}
            }
        {%- else -%}
            {
                "@type": "ListItem",
                "position": 2,
                "name": {{ product.title | json }},
                "item": {{ canonical_url | json }}
            }
        {%- endif -%}]
    }
    </script>
{%- elsif page_type == 'article' -%}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [{
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": {{ url | json }}
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": {{ article.title | json }},
            "item": {{ canonical_url | json }}
        }]
    }
    </script>
{%- elsif page_type == 'collection' and collection.handle -%}
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "CollectionPage",
        "name": {{ collection.title | json }},
        "url": {{ canonical_url | json }},
        "description": {{ collection.description | split: '[lang2]' | first | strip_html | strip_newlines | json }}
    }
    </script>
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [{
            "@type": "ListItem",
            "position": 1,
            "name": "Home",
            "item": {{ url | json }}
        },
        {
            "@type": "ListItem",
            "position": 2,
            "name": {{ collection.title | json }},
            "item": {{ canonical_url | json }}
        }]
    }
    </script>
{%- endif -%}