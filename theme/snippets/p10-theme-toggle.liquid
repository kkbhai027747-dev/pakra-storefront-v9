<button
  type="button"
  class="p10-theme-toggle p10-theme-toggle--{{ placement | default: 'header' }}"
  data-p10-theme-toggle
  aria-pressed="false"
  aria-label="Switch to dark mode"
  title="Dark mode"
>
  <span class="p10-theme-toggle__icon" aria-hidden="true">
    <svg class="p10-theme-toggle__moon" viewBox="0 0 24 24" focusable="false">
      <path d="M20.2 15.4A8.4 8.4 0 0 1 8.6 3.8 8.6 8.6 0 1 0 20.2 15.4Z"></path>
    </svg>
    <svg class="p10-theme-toggle__sun" viewBox="0 0 24 24" focusable="false">
      <circle cx="12" cy="12" r="3.5"></circle>
      <path d="M12 2v2.2M12 19.8V22M4.9 4.9l1.6 1.6M17.5 17.5l1.6 1.6M2 12h2.2M19.8 12H22M4.9 19.1l1.6-1.6M17.5 6.5l1.6-1.6"></path>
    </svg>
  </span>
  <span class="visually-hidden" data-p10-theme-toggle-label>Switch to dark mode</span>
</button>
